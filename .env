# ==========================================
# 1. CẤU HÌNH MÔI TRƯỜNG DỰ ÁN
# ==========================================
COMPOSE_PROJECT_NAME=parish_system
ASPNETCORE_ENV=Development

# ==========================================
# 2. CẤU HÌNH POSTGRESQL DATABASE
# ==========================================
DB_HOST=db
DB_PORT=5432
DB_NAME=parish_management
DB_USER=postgres
DB_PASSWORD=dev_secret_password_123

# Tham số tối ưu bộ nhớ cho PostgreSQL (máy RAM 16GB)
PG_SHARED_BUFFERS=1024MB
PG_EFFECTIVE_CACHE_SIZE=3072MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_WORK_MEM=32MB

# ==========================================
# 3. CẤU HÌNH PGADMIN 4 (Giao diện web quản lý DB)
# ==========================================
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@parish.local
PGADMIN_PASSWORD=admin

# ==========================================
# 4. CẤU HÌNH CỔNG RA NGOÀI MÁY THẬT (HOST PORTS)
# ==========================================
WEB_PORT=80
DOTNET_PORT=5000