@model IEnumerable<ManagerStudentCaltholic.Models.Entities.User>
@using ManagerStudentCaltholic.Models.Entities
@{
    ViewData["Title"] = "Quản Trị Người Dùng";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-4 px-lg-4">
    <!-- Header & Bộ Lọc -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <h4 class="fw-bold text-dark mb-0">
                        <i class="bi bi-people-gear me-2 text-primary"></i>Danh Sách Tài Khoản Hệ Thống
                    </h4>
                    <small class="text-muted">Quản trị danh tính và vai trò thành viên gia đình giáo lý</small>
                </div>
                <div class="col-md-5">
                    <form method="get" class="d-flex gap-2">
                        <select name="role" class="form-select" onchange="this.form.submit()">
                            <!option value="ALL" @(ViewBag.SelectedRole == "ALL" ? "selected" : "")>-- Tất cả vai trò --</!option>
                            <!option value="@UserRole.Admin" @(ViewBag.SelectedRole == UserRole.Admin ? "selected" : "")>Admin Kỹ Thuật</!option>
                            <!option value="@UserRole.SpiritualDirector" @(ViewBag.SelectedRole == UserRole.SpiritualDirector ? "selected" : "")>Cha Tuyên Úy</!option>
                            <!option value="@UserRole.ExecutiveBoard" @(ViewBag.SelectedRole == UserRole.ExecutiveBoard ? "selected" : "")>Ban Điều Hành</!option>
                            <!option value="@UserRole.BranchHead" @(ViewBag.SelectedRole == UserRole.BranchHead ? "selected" : "")>Trưởng Khối</!option>
                            <!option value="@UserRole.Teacher" @(ViewBag.SelectedRole == UserRole.Teacher ? "selected" : "")>Giáo Lý Viên</!option>
                        </select>
                        <input type="text" name="search" class="form-control" placeholder="Tìm tên/username..." value="@ViewBag.SearchKeyword" />
                        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i></button>
                    </form>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-success rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#batchCreateModal">
                        <i class="bi bi-file-earmark-spreadsheet me-1"></i> Tạo Hàng Loạt GLV Mới
                    </button>
                    <button type="button" class="btn btn-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createUserModal">
                        <i class="bi bi-person-plus-fill me-1"></i> Tạo Tài Khoản Mới
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách tài khoản -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Tên Đăng Nhập</th>
                        <th>Họ Và Tên</th>
                        <th>Vai Trò</th>
                        <th>Số Điện Thoại</th>
                        <th>Trạng Thái</th>
                        <th>Đăng Nhập Gần Nhất</th>
                        <th class="text-center" style="width: 150px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var u in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold font-monospace text-dark">@u.Username</span>
                                    @if (!string.IsNullOrEmpty(u.Email))
                                    {
                                        <small class="d-block text-muted">@u.Email</small>
                                    }
                                </td>
                                <td class="fw-semibold">@u.FirstName @u.LastName</td>
                                <td>
                                    <span class="badge @(u.Role == UserRole.Admin ? "bg-danger" :
                                                                                                   u.Role == UserRole.SpiritualDirector ? "bg-info text-dark" :
                                                                                                   u.Role == UserRole.ExecutiveBoard ? "bg-primary" :
                                                                                                   u.Role == UserRole.BranchHead ? "bg-warning text-dark" : "bg-secondary") rounded-pill px-3 py-1">
                                @u.Role
                            </span>
                            @if (!string.IsNullOrEmpty(u.ManagedGradeLevel))
                            {
                                <span class="badge bg-primary-subtle text-primary border ms-1">
                                    Khối: @u.ManagedGradeLevel
                                </span>
                            }
                        </td>
                        <td>@(string.IsNullOrEmpty(u.PhoneNumber) ? "-" : u.PhoneNumber)</td>
                        <td>
                            @if (u.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">Đã khóa</span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @(u.LastLoginAt.HasValue? u.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa đăng nhập")
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-warning rounded-circle me-1"
                                            title="Đặt lại mật khẩu" onclick="openResetPasswordModal(@u.Id, '@u.Username')">
                                        <i class="bi bi-key-fill"></i>
                                    </button>
                                    <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-circle"
                                            title="@(u.IsActive ? "Khóa tài khoản" : "Mở khóa")" onclick="toggleUserStatus(@u.Id)">
                                        <i class="bi @(u.IsActive ? "bi-lock-fill" : "bi-unlock-fill")"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">Không tìm thấy tài khoản nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Tạo Tài Khoản -->
<div class="modal fade" id="createUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-primary"><i class="bi bi-person-plus me-1"></i>Tạo Tài Khoản Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="createUserForm">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tên đăng nhập <span class="text-danger">*</span></label>
                        <input type="text" id="newUsername" class="form-control" placeholder="glv_an, bdh_hoa..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                        <input type="password" id="newPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tên Thánh<span class="text-danger">*</span></label>
                        <input type="text" id="newChristianName" class="form-control" placeholder="Ví dụ: Phaolo" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Họ <span class="text-danger">*</span></label>
                        <input type="text" id="newFirstName" class="form-control" placeholder="Ví dụ: Ninh" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tên <span class="text-danger">*</span></label>
                        <input type="text" id="newLastName" class="form-control" placeholder="Ví dụ: Huân" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Vai trò</label>
                            <select id="newRole" class="form-select" onchange="toggleManagedGradeField()">
                                <option value="@UserRole.Teacher">Giáo Lý Viên</option>
                                <option value="@UserRole.BranchHead">Trưởng Khối</option>
                                <option value="@UserRole.ExecutiveBoard">Ban Điều Hành</option>
                                @if (User.IsInRole(UserRole.Admin))
                                {
                                    <option value="@UserRole.SpiritualDirector">Cha Tuyên Úy</option>
                                    <option value="@UserRole.Admin">Admin Kỹ Thuật</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 d-none" id="divManagedGrade">
                            <label class="form-label small fw-bold text-primary">Khối phụ trách <span class="text-danger">*</span></label>
                            <select id="newManagedGradeLevel" class="form-select border-primary">
                                <option value="Khai Tâm">Khối Khai Tâm</option>
                                <option value="Rước Lễ">Khối Rước Lễ</option>
                                <option value="Thêm Sức">Khối Thêm Sức</option>
                                <option value="Bao Đồng">Khối Bao Đồng</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Số điện thoại</label>
                            <input type="text" id="newPhone" class="form-control" placeholder="090..." />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Email (tùy chọn)</label>
                        <input type="email" id="newEmail" class="form-control" placeholder="email@domain.com" />
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary px-4" onclick="submitCreateUser()">Lưu Tài Khoản</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Đặt lại Mật Khẩu -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning-subtle">
                <h6 class="modal-title fw-bold text-dark"><i class="bi bi-key-fill me-1"></i>Đặt Lại Mật Khẩu</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <input type="hidden" id="resetUserId" />
                <p class="small text-muted mb-2">Đổi mật khẩu cho: <strong id="resetUsernameDisplay" class="text-dark"></strong></p>
                <input type="password" id="resetNewPassword" class="form-control form-control-sm" placeholder="Mật khẩu mới (>= 6 ký tự)" />
            </div>
            <div class="modal-footer bg-light p-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning btn-sm px-3 fw-bold" onclick="submitResetPassword()">Cập Nhật</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL TẠO HÀNG LOẠT GLV (TASK-814) -->
<div class="modal fade" id="batchCreateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold fs-6">
                    <i class="bi bi-person-plus-fill me-2"></i>Tạo Hàng Loạt GLV Mới (Sau Lễ Tuyên Hứa)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <ul class="nav nav-pills mb-3 nav-fill" id="pills-tab" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold small" id="pills-excel-tab" data-bs-toggle="pill" data-bs-target="#tabExcel">
                            <i class="bi bi-file-earmark-excel me-1"></i> Nạp Từ File Excel
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold small" id="pills-text-tab" data-bs-toggle="pill" data-bs-target="#tabManual">
                            <i class="bi bi-card-text me-1"></i> Nhập Nhanh Danh Sách (Text)
                        </button>
                    </li>
                </ul>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Mật khẩu khởi tạo chung cho đợt này</label>
                    <input type="text" id="batchDefaultPassword" class="form-control" value="GLV@2026!" />
                    <div class="form-text small text-muted">GLV sẽ dùng mật khẩu này để đăng nhập lần đầu và tự đổi trong Hồ sơ cá nhân.</div>
                </div>

                <div class="tab-content border rounded-3 p-3 bg-light-subtle">
                    <!-- TAB 1: NẠP TỪ FILE EXCEL -->
                    <div class="tab-pane fade show active" id="tabExcel">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="small text-muted">Tải file mẫu để điền danh sách GLV tuyên hứa:</span>
                            <a href="/Users/DownloadTeacherTemplate" class="btn btn-outline-primary btn-sm rounded-pill">
                                <i class="bi bi-download me-1"></i> Tải File Mẫu (.xlsx)
                            </a>
                        </div>
                        <div class="mb-3">
                            <input type="file" id="batchTeacherExcelFile" class="form-control" accept=".xlsx, .xls" />
                        </div>
                    </div>

                    <!-- TAB 2: NHẬP NHANH BẰNG TEXT -->
                    <div class="tab-pane fade" id="tabManual">
                        <div class="small text-muted mb-2">
                            Nhập mỗi GLV một dòng theo định dạng: <code>Tên Thánh | Họ và Tên đệm | Tên | SĐT | Khối</code>
                        </div>
                        <textarea id="batchTeacherRawText" class="form-control font-monospace small" rows="6"
                                  placeholder="Phaolô | Nguyễn Văn | An | 0901234567 | Khai Tâm&#10;Maria | Trần Thị | Bình | 0987654321 | Rước Lễ"></textarea>
                    </div>
                </div>

                <!-- Bảng kết quả hiển thị danh sách Username tự sinh -->
                <div id="batchResultArea" class="d-none mt-3">
                    <div class="alert alert-success border-0 small mb-2 fw-semibold" id="batchResultMsg"></div>
                    <div class="table-responsive" style="max-height: 200px; overflow-y: auto;">
                        <table class="table table-sm table-bordered table-striped small mb-0 font-monospace">
                            <thead class="table-dark">
                                <tr>
                                    <th>Username</th>
                                    <th>Họ và Tên</th>
                                    <th>SĐT</th>
                                    <th>Mật Khẩu</th>
                                    <th>Khối</th>
                                </tr>
                            </thead>
                            <tbody id="batchResultTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-success px-4 fw-bold" onclick="submitBatchCreateTeachers()">
                    <i class="bi bi-check2-circle me-1"></i> Bắt Đầu Khởi Tạo
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function submitCreateUser() {
            const username = document.getElementById("newUsername").value.trim();
            const password = document.getElementById("newPassword").value;
            const christianName = document.getElementById("newChristianName").value.trim();
            const firstName = document.getElementById("newFirstName").value.trim();
            const lastName = document.getElementById("newLastName").value.trim();
            const role = document.getElementById("newRole").value;
            const phone = document.getElementById("newPhone").value.trim();
            const email = document.getElementById("newEmail").value.trim();

            // Lấy giá trị khối nếu chọn BranchHead
            let managedGradeLevel = null;
            if (role === "@UserRole.BranchHead" || role === "BranchHead") {
                const gradeSelect = document.getElementById("newManagedGradeLevel");
                managedGradeLevel = gradeSelect ? gradeSelect.value : null;
            }

            if (!username || !password || !firstName || !lastName) {
                alert("Vui lòng điền đầy đủ các thông tin bắt buộc!");
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const payload = {
                username: username,
                password: password,
                christianName: christianName,
                firstName: firstName,
                lastName: lastName,
                role: role,
                phoneNumber: phone,
                email: email,
                managedGradeLevel: managedGradeLevel
            };
            try{
                const res = await fetch('/Users/Create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert("Không thể tạo tài khoản: " + data.message);
                }
            } catch (err) {
                console.error(err);
                alert("Có lỗi kết nối: " + err.message);
            }

        }

        function openResetPasswordModal(userId, username) {
            document.getElementById("resetUserId").value = userId;
            document.getElementById("resetUsernameDisplay").innerText = username;
            document.getElementById("resetNewPassword").value = "";
            new bootstrap.Modal(document.getElementById("resetPasswordModal")).show();
        }

        async function submitResetPassword() {
            const userId = document.getElementById("resetUserId").value;
            const newPassword = document.getElementById("resetNewPassword").value;

            if (!newPassword || newPassword.length < 6) {
                alert("Mật khẩu mới phải có ít nhất 6 ký tự!");
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            const res = await fetch('/Users/ResetPassword', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ userId: parseInt(userId), newPassword })
            });

            const data = await res.json();
            alert(data.message);
            if (data.success) {
                bootstrap.Modal.getInstance(document.getElementById("resetPasswordModal")).hide();
            }
        }

        async function toggleUserStatus(userId) {
            if (!confirm("Bạn có chắc chắn muốn thay đổi trạng thái hoạt động của tài khoản này?")) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            const res = await fetch(`/Users/ToggleStatus/${userId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                }
            });

            const data = await res.json();
            alert(data.message);
            if (data.success) {
                location.reload();
            }
        }

        function toggleManagedGradeField() {
            const role = document.getElementById("newRole").value;
            const divGrade = document.getElementById("divManagedGrade");
            if (role === "BranchHead") {
                divGrade.classList.remove("d-none");
            } else {
                divGrade.classList.add("d-none");
            }
        }

                async function submitBatchCreateTeachers() {
            const isExcelTab = document.getElementById('pills-excel-tab').classList.contains('active');
            const defaultPassword = document.getElementById('batchDefaultPassword').value.trim() || 'GLV@2026!';
            const resultArea = document.getElementById('batchResultArea');
            const resultMsg = document.getElementById('batchResultMsg');
            const tbody = document.getElementById('batchResultTableBody');

            resultArea.classList.add('d-none');
            tbody.innerHTML = '';

            if (isExcelTab) {
                // Nạp qua File Excel
                const fileInput = document.getElementById('batchTeacherExcelFile');
                if (!fileInput.files || fileInput.files.length === 0) {
                    alert("Vui lòng chọn file Excel để nạp!");
                    return;
                }

                const formData = new FormData();
                formData.append("file", fileInput.files[0]);
                formData.append("defaultPassword", defaultPassword);

                try {
                    const res = await fetch('/Users/ImportTeachersFromExcel', {
                        method: 'POST',
                        body: formData
                    });
                    const data = await res.json();
                    handleBatchResponse(data);
                } catch (err) {
                    alert("Lỗi khi tải file lên: " + err.message);
                }
            } else {
                // Nạp qua Textarea
                const rawText = document.getElementById('batchTeacherRawText').value.trim();
                if (!rawText) {
                    alert("Vui lòng nhập ít nhất một dòng thông tin GLV!");
                    return;
                }

                const lines = rawText.split('\n');
                const teachers = [];

                lines.forEach(l => {
                    const parts = l.split('|').map(p => p.trim());
                    if (parts.length >= 3) {
                        teachers.push({
                            christianName: parts[0] || '',
                            firstName: parts[1] || '',
                            lastName: parts[2] || '',
                            phoneNumber: parts[3] || '',
                            managedGradeLevel: parts[4] || null
                        });
                    }
                });

                if (teachers.length === 0) {
                    alert("Định dạng dữ liệu không đúng. Mỗi dòng cần có ít nhất: Tên Thánh | Họ và Đệm | Tên");
                    return;
                }

                try {
                    const res = await fetch('/Users/BatchCreateTeachers', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            defaultPassword: defaultPassword,
                            teachers: teachers
                        })
                    });
                    const data = await res.json();
                    handleBatchResponse(data);
                } catch (err) {
                    alert("Lỗi kết nối khi nạp danh sách: " + err.message);
                }
            }

            function handleBatchResponse(data) {
                if (data.success) {
                    resultMsg.className = "alert alert-success border-0 small mb-2 fw-semibold";
                    resultMsg.innerText = data.message;
                    tbody.innerHTML = '';

                    data.createdTeachers.forEach(t => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td class="fw-bold text-primary">${t.username}</td>
                            <td>${t.christianName} ${t.fullName}</td>
                            <td>${t.phoneNumber || '--'}</td>
                            <td><code>${t.initialPassword}</code></td>
                            <td><span class="badge bg-light text-dark border">${t.managedGradeLevel || 'Chưa gán'}</span></td>
                        `;
                        tbody.appendChild(tr);
                    });

                    resultArea.classList.remove('d-none');
                    setTimeout(() => {
                        // Tự động tải lại trang sau 3 giây để đồng bộ danh sách bên ngoài
                        location.reload();
                    }, 3500);
                } else {
                    alert("Lỗi: " + data.message);
                }
            }
        }
    </script>
}