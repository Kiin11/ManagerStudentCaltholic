@model IEnumerable<ManagerStudentCaltholic.Models.Entities.User>
@using ManagerStudentCaltholic.Models.Entities
@using ManagerStudentCaltholic.Extensions
@{
    ViewData["Title"] = "Quản Trị Người Dùng";
    bool isMobile = Context.Request.IsMobileDevice();
}

@Html.AntiForgeryToken()

@if (isMobile)
{
    <style>
        .mobile-users-wrap {
            padding-bottom: 2rem;
        }
        .mobile-users-wrap .form-control,
        .mobile-users-wrap .form-select {
            font-size: 16px !important;
            min-height: 44px;
            border-radius: 12px;
        }
        .mobile-user-card {
            border-radius: 16px;
            border: 1px solid #e9ecef;
            background: #ffffff;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);
            padding: 1rem;
            margin-bottom: 0.75rem;
        }
        .mobile-user-actions .btn {
            min-height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            font-weight: 600;
        }
        .mobile-modal-sheet .modal-content {
            border-radius: 20px;
        }
        .mobile-modal-sheet .form-control,
        .mobile-modal-sheet .form-select {
            font-size: 16px !important;
        }
    </style>

    <div class="mobile-users-wrap">
        <!-- Header & Bộ Lọc Mobile -->
        <div class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-people-gear me-2 text-primary"></i>Tài Khoản Hệ Thống
                    </h5>
                    <span class="badge bg-primary-subtle text-primary border rounded-pill px-2 py-1">
                        @Model.Count() tài khoản
                    </span>
                </div>
                <p class="text-muted small mb-3">Quản trị danh tính & vai trò các thành viên trong Xứ Đoàn</p>

                <!-- Bộ lọc tìm kiếm -->
                <form method="get" class="d-flex flex-column gap-2 mb-3">
                    <select name="role" class="form-select shadow-sm" onchange="this.form.submit()">
                        <!option value="ALL" @(ViewBag.SelectedRole == "ALL" ? "selected" : "")>-- Tất cả vai trò --</!option>
                        <!option value="@UserRole.Admin" @(ViewBag.SelectedRole == UserRole.Admin ? "selected" : "")>Admin Kỹ Thuật</!option>
                        <!option value="@UserRole.SpiritualDirector" @(ViewBag.SelectedRole == UserRole.SpiritualDirector ? "selected" : "")>Cha Tuyên Úy</!option>
                        <!option value="@UserRole.ExecutiveBoard" @(ViewBag.SelectedRole == UserRole.ExecutiveBoard ? "selected" : "")>Ban Điều Hành</!option>
                        <!option value="@UserRole.BranchHead" @(ViewBag.SelectedRole == UserRole.BranchHead ? "selected" : "")>Trưởng Khối</!option>
                        <!option value="@UserRole.Teacher" @(ViewBag.SelectedRole == UserRole.Teacher ? "selected" : "")>Giáo Lý Viên</!option>
                    </select>
                    <div class="input-group">
                        <input type="text" name="search" class="form-control" placeholder="Tìm tên hoặc username..." value="@ViewBag.SearchKeyword" />
                        <button type="submit" class="btn btn-primary px-3 touch-target-44"><i class="bi bi-search"></i></button>
                    </div>
                </form>

                <!-- 3 Nút tác vụ Mobile -->
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-primary rounded-pill py-2 fw-bold shadow-sm touch-target-44 d-inline-flex align-items-center justify-content-center"
                            data-bs-toggle="modal" data-bs-target="#createUserModal">
                        <i class="bi bi-person-plus-fill me-2"></i> Tạo Tài Khoản Mới
                    </button>
                    <div class="row g-2">
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-success rounded-pill w-100 py-2 small fw-semibold touch-target-44 d-inline-flex align-items-center justify-content-center"
                                    data-bs-toggle="modal" data-bs-target="#batchCreateModal">
                                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Tạo Hàng Loạt
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-danger rounded-pill w-100 py-2 small fw-semibold touch-target-44 d-inline-flex align-items-center justify-content-center"
                                    onclick="openBatchDeactivateModal()">
                                <i class="bi bi-person-x-fill me-1"></i> Rà Soát Nghỉ
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Danh Sách Tài Khoản Dạng Thẻ Mobile -->
        @if (Model.Any())
        {
            foreach (var u in Model)
            {
                <div class="mobile-user-card">
                    <!-- Header thẻ: Username + Badge vai trò & trạng thái -->
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <a href="/Account/Profile?id=@u.Id" class="fw-bold font-monospace text-primary text-decoration-none fs-6 d-inline-flex align-items-center gap-1" title="Xem hồ sơ cá nhân">
                                @u.Username <i class="bi bi-box-arrow-up-right" style="font-size: 0.75rem;"></i>
                            </a>
                            @if (!string.IsNullOrEmpty(u.Email))
                            {
                                <small class="text-muted d-block text-truncate" style="max-width: 200px;">@u.Email</small>
                            }
                        </div>
                        <div>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">Đã khóa</span>
                            }
                        </div>
                    </div>

                    <!-- Họ và tên & Vai trò -->
                    <div class="mb-2">
                        <div>
                            <a href="/Account/Profile?id=@u.Id" class="fw-bold text-dark text-decoration-none fs-6" title="Xem hồ sơ cá nhân">
                                @(!string.IsNullOrEmpty(u.ChristianName) ? $"{u.ChristianName} " : "")@u.FirstName @u.LastName
                            </a>
                        </div>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            <span class="badge @(u.Role == UserRole.Admin ? "bg-danger" :
                                                 u.Role == UserRole.SpiritualDirector ? "bg-info text-dark" :
                                                 u.Role == UserRole.ExecutiveBoard ? "bg-primary" :
                                                 u.Role == UserRole.BranchHead ? "bg-warning text-dark" : "bg-secondary") rounded-pill px-2 py-1">
                                @(u.Role == UserRole.Admin ? "Quản trị viên" : u.Role == UserRole.SpiritualDirector ? "Cha" :
                                  u.Role == UserRole.ExecutiveBoard ? "Ban Điều Hành" :
                                  u.Role == UserRole.BranchHead ? "Trưởng khối" : "Giáo lý viên / Dự bị")
                            </span>
                            @if (!string.IsNullOrEmpty(u.ManagedGradeLevel))
                            {
                                <span class="badge bg-primary-subtle text-primary border rounded-pill px-2 py-1">
                                    Khối: @u.ManagedGradeLevel
                                </span>
                            }
                        </div>
                    </div>

                    <!-- SĐT & Lần đăng nhập gần nhất -->
                    <div class="small text-muted mb-3 pt-2 border-top">
                        <div class="d-flex justify-content-between mb-1">
                            <span><i class="bi bi-telephone-fill me-1 text-secondary"></i>Số điện thoại:</span>
                            @if (!string.IsNullOrEmpty(u.PhoneNumber))
                            {
                                <a href="tel:@u.PhoneNumber" class="text-decoration-none fw-semibold text-primary">@u.PhoneNumber</a>
                            }
                            else
                            {
                                <span class="text-secondary">Chưa cập nhật</span>
                            }
                        </div>
                        <div class="d-flex justify-content-between">
                            <span><i class="bi bi-clock-history me-1 text-secondary"></i>Đăng nhập:</span>
                            <span>@(u.LastLoginAt.HasValue ? u.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa đăng nhập")</span>
                        </div>
                    </div>

                    <!-- Nút thao tác (Hồ Sơ, Đổi MK, Khóa/Mở) -->
                    <div class="row g-2 mobile-user-actions pt-2 border-top">
                        <div class="col-4">
                            <a href="/Account/Profile?id=@u.Id" class="btn btn-outline-primary w-100 rounded-pill touch-target-44" title="Xem hồ sơ / Lớp dạy">
                                <i class="bi bi-person-vcard me-1"></i> Hồ Sơ
                            </a>
                        </div>
                        <div class="col-4">
                            <button type="button" class="btn btn-outline-warning text-dark w-100 rounded-pill touch-target-44"
                                    onclick="openResetPasswordModal(@u.Id, '@u.Username')">
                                <i class="bi bi-key-fill me-1"></i> Đổi MK
                            </button>
                        </div>
                        <div class="col-4">
                            <button type="button" class="btn @(u.IsActive ? "btn-outline-danger" : "btn-outline-success") w-100 rounded-pill touch-target-44"
                                    onclick="toggleUserStatus(@u.Id)">
                                <i class="bi @(u.IsActive ? "bi-lock-fill" : "bi-unlock-fill") me-1"></i>
                                @(u.IsActive ? "Khóa" : "Mở")
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center text-muted">
                <i class="bi bi-person-x display-5 text-secondary mb-2"></i>
                <div class="fw-bold">Không tìm thấy tài khoản nào phù hợp</div>
                <small class="text-muted">Vui lòng thay đổi từ khóa hoặc bộ lọc vai trò</small>
            </div>
        }
    </div>
}
else
{
    <div class="container-fluid py-4 px-lg-4">
        <!-- Header & Bộ Lọc -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <h4 class="fw-bold text-dark mb-0">
                            <i class="bi bi-people-gear me-2 text-primary"></i>Danh Sách Tài Khoản Hệ Thống
                        </h4>
                        <small class="text-muted">Quản trị danh tính và vai trò thành viên gia đình giáo lý</small>
                    </div>
                    <div class="col-md-5">
                        <form method="get" class="d-flex gap-2">
                            <select name="role" class="form-select" onchange="this.form.submit()">
                                <!option value="ALL" @(ViewBag.SelectedRole == "ALL" ? "selected" : "")>-- Tất cả vai trò --</!option>
                                <!option value="@UserRole.Admin" @(ViewBag.SelectedRole == UserRole.Admin ? "selected" : "")>Admin Kỹ Thuật</!option>
                                <!option value="@UserRole.SpiritualDirector" @(ViewBag.SelectedRole == UserRole.SpiritualDirector ? "selected" : "")>Cha Tuyên Úy</!option>
                                <!option value="@UserRole.ExecutiveBoard" @(ViewBag.SelectedRole == UserRole.ExecutiveBoard ? "selected" : "")>Ban Điều Hành</!option>
                                <!option value="@UserRole.BranchHead" @(ViewBag.SelectedRole == UserRole.BranchHead ? "selected" : "")>Trưởng Khối</!option>
                                <!option value="@UserRole.Teacher" @(ViewBag.SelectedRole == UserRole.Teacher ? "selected" : "")>Giáo Lý Viên</!option>
                            </select>
                            <input type="text" name="search" class="form-control" placeholder="Tìm tên/username..." value="@ViewBag.SearchKeyword" />
                            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i></button>
                        </form>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-danger rounded-pill px-3 shadow-sm" onclick="openBatchDeactivateModal()">
                            <i class="bi bi-person-x-fill me-1"></i> Rà Soát GLV Nghỉ Năm Mới
                        </button>
                        <button type="button" class="btn btn-outline-success rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#batchCreateModal">
                            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Tạo Hàng Loạt GLV Mới
                        </button>
                        <button type="button" class="btn btn-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createUserModal">
                            <i class="bi bi-person-plus-fill me-1"></i> Tạo Tài Khoản Mới
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bảng danh sách tài khoản -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tên Đăng Nhập</th>
                            <th>Họ Và Tên</th>
                            <th>Vai Trò</th>
                            <th>Số Điện Thoại</th>
                            <th>Trạng Thái</th>
                            <th>Đăng Nhập Gần Nhất</th>
                            <th class="text-center" style="width: 150px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var u in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <a href="/Account/Profile?id=@u.Id" class="fw-bold font-monospace text-primary text-decoration-none" title="Xem hồ sơ cá nhân">
                                            @u.Username
                                        </a>
                                        @if (!string.IsNullOrEmpty(u.Email))
                                        {
                                            <small class="d-block text-muted">@u.Email</small>
                                        }
                                    </td>
                                    <td>
                                        <a href="/Account/Profile?id=@u.Id" class="fw-semibold text-dark text-decoration-none" title="Xem hồ sơ cá nhân">
                                            @(!string.IsNullOrEmpty(u.ChristianName) ? $"{u.ChristianName} " : "")@u.FirstName @u.LastName
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge @(u.Role == UserRole.Admin ? "bg-danger" :
                                                                                                       u.Role == UserRole.SpiritualDirector ? "bg-info text-dark" :
                                                                                                       u.Role == UserRole.ExecutiveBoard ? "bg-primary" :
                                                                                                       u.Role == UserRole.BranchHead ? "bg-warning text-dark" : "bg-secondary") rounded-pill px-3 py-1">
                                            @(u.Role == UserRole.Admin ? "Quản trị viên" : u.Role == UserRole.SpiritualDirector ? "Cha" :
                                                                            u.Role == UserRole.ExecutiveBoard ? "Ban Điều Hành" :
                                                                            u.Role == UserRole.BranchHead ? "Trưởng khối" : "Giáo lý viên / Dự bị")
                                        </span>
                                        @if (!string.IsNullOrEmpty(u.ManagedGradeLevel))
                                        {
                                            <span class="badge bg-primary-subtle text-primary border ms-1">
                                                Khối: @u.ManagedGradeLevel
                                            </span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrEmpty(u.PhoneNumber) ? "-" : u.PhoneNumber)</td>
                                    <td>
                                        @if (u.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">Đã khóa</span>
                                        }
                                    </td>
                                    <td class="small text-muted">
                                        @(u.LastLoginAt.HasValue? u.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa đăng nhập")
                                    </td>
                                    <td class="text-center">
                                        <a href="/Account/Profile?id=@u.Id" class="btn btn-sm btn-outline-primary rounded-circle me-1"
                                           title="Xem hồ sơ / Lớp dạy">
                                            <i class="bi bi-person-vcard"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-warning rounded-circle me-1"
                                                title="Đặt lại mật khẩu" onclick="openResetPasswordModal(@u.Id, '@u.Username')">
                                            <i class="bi bi-key-fill"></i>
                                        </button>
                                        <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-circle"
                                                title="@(u.IsActive ? "Khóa tài khoản" : "Mở khóa")" onclick="toggleUserStatus(@u.Id)">
                                            <i class="bi @(u.IsActive ? "bi-lock-fill" : "bi-unlock-fill")"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">Không tìm thấy tài khoản nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Modal Tạo Tài Khoản -->
<div class="modal fade mobile-modal-sheet" id="createUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-primary"><i class="bi bi-person-plus me-1"></i>Tạo Tài Khoản Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="createUserForm">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tên đăng nhập <span class="text-danger">*</span></label>
                        <input type="text" id="newUsername" class="form-control" placeholder="glv_an, bdh_hoa..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                        <input type="password" id="newPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tên Thánh<span class="text-danger">*</span></label>
                        <input type="text" id="newChristianName" class="form-control" placeholder="Ví dụ: Phaolo" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Họ <span class="text-danger">*</span></label>
                        <input type="text" id="newFirstName" class="form-control" placeholder="Ví dụ: Ninh" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tên <span class="text-danger">*</span></label>
                        <input type="text" id="newLastName" class="form-control" placeholder="Ví dụ: Huân" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Vai trò</label>
                            <select id="newRole" class="form-select" onchange="toggleManagedGradeField()">
                                <option value="@UserRole.Teacher">Giáo Lý Viên</option>
                                <option value="@UserRole.BranchHead">Trưởng Khối</option>
                                <option value="@UserRole.ExecutiveBoard">Ban Điều Hành</option>
                                @if (User.IsInRole(UserRole.Admin))
                                {
                                    <option value="@UserRole.SpiritualDirector">Cha Tuyên Úy</option>
                                    <option value="@UserRole.Admin">Admin Kỹ Thuật</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 d-none" id="divManagedGrade">
                            <label class="form-label small fw-bold text-primary">Khối phụ trách <span class="text-danger">*</span></label>
                            <select id="newManagedGradeLevel" class="form-select border-primary">
                                <option value="Khai Tâm">Khối Khai Tâm</option>
                                <option value="Rước Lễ">Khối Rước Lễ</option>
                                <option value="Thêm Sức">Khối Thêm Sức</option>
                                <option value="Bao Đồng">Khối Bao Đồng</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Số điện thoại</label>
                            <input type="tel" inputmode="tel" id="newPhone" class="form-control" placeholder="090..." />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Email (tùy chọn)</label>
                        <input type="email" id="newEmail" class="form-control" placeholder="email@domain.com" />
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary rounded-pill px-3 touch-target-44" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold touch-target-44" onclick="submitCreateUser()">Lưu Tài Khoản</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Đặt lại Mật Khẩu -->
<div class="modal fade mobile-modal-sheet" id="resetPasswordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning-subtle">
                <h6 class="modal-title fw-bold text-dark"><i class="bi bi-key-fill me-1"></i>Đặt Lại Mật Khẩu</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <input type="hidden" id="resetUserId" />
                <p class="small text-muted mb-2">Đổi mật khẩu cho: <strong id="resetUsernameDisplay" class="text-dark"></strong></p>
                <input type="password" id="resetNewPassword" class="form-control" placeholder="Mật khẩu mới (>= 6 ký tự)" />
            </div>
            <div class="modal-footer bg-light p-2">
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3 touch-target-44" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold text-dark touch-target-44" onclick="submitResetPassword()">Cập Nhật</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL TẠO HÀNG LOẠT GLV (TASK-814) -->
<div class="modal fade mobile-modal-sheet" id="batchCreateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold fs-6">
                    <i class="bi bi-person-plus-fill me-2"></i>Tạo Hàng Loạt GLV Mới (Sau Lễ Tuyên Hứa)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3 p-md-4">
                <ul class="nav nav-pills mb-3 nav-fill" id="pills-tab" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold small touch-target-44" id="pills-excel-tab" data-bs-toggle="pill" data-bs-target="#tabExcel">
                            <i class="bi bi-file-earmark-excel me-1"></i> Nạp Từ File Excel
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold small touch-target-44" id="pills-text-tab" data-bs-toggle="pill" data-bs-target="#tabManual">
                            <i class="bi bi-card-text me-1"></i> Nhập Nhanh (Text)
                        </button>
                    </li>
                </ul>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Mật khẩu khởi tạo chung cho đợt này</label>
                    <input type="text" id="batchDefaultPassword" class="form-control" value="GLV@2026!" />
                    <div class="form-text small text-muted">GLV sẽ dùng mật khẩu này để đăng nhập lần đầu và tự đổi trong Hồ sơ cá nhân.</div>
                </div>

                <div class="tab-content border rounded-3 p-3 bg-light-subtle">
                    <!-- TAB 1: NẠP TỪ FILE EXCEL -->
                    <div class="tab-pane fade show active" id="tabExcel">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <span class="small text-muted">Tải file mẫu để điền danh sách GLV tuyên hứa:</span>
                            <a href="/Users/DownloadTeacherTemplate" class="btn btn-outline-primary btn-sm rounded-pill touch-target-44 d-inline-flex align-items-center">
                                <i class="bi bi-download me-1"></i> Tải File Mẫu (.xlsx)
                            </a>
                        </div>
                        <div class="mb-3">
                            <input type="file" id="batchTeacherExcelFile" class="form-control" accept=".xlsx, .xls" />
                        </div>
                    </div>

                    <!-- TAB 2: NHẬP NHANH BẰNG TEXT -->
                    <div class="tab-pane fade" id="tabManual">
                        <div class="small text-muted mb-2">
                            Nhập mỗi GLV một dòng theo định dạng: <code>Tên Thánh | Họ và Tên đệm | Tên | SĐT | Khối</code>
                        </div>
                        <textarea id="batchTeacherRawText" class="form-control font-monospace small" rows="5"
                                  placeholder="Phaolô | Nguyễn Văn | An | 0901234567 | Khai Tâm&#10;Maria | Trần Thị | Bình | 0987654321 | Rước Lễ"></textarea>
                    </div>
                </div>

                <!-- Bảng kết quả hiển thị danh sách Username tự sinh -->
                <div id="batchResultArea" class="d-none mt-3">
                    <div class="alert alert-success border-0 small mb-2 fw-semibold" id="batchResultMsg"></div>
                    <div class="table-responsive" style="max-height: 200px; overflow-y: auto;">
                        <table class="table table-sm table-bordered table-striped small mb-0 font-monospace">
                            <thead class="table-dark">
                                <tr>
                                    <th>Username</th>
                                    <th>Họ và Tên</th>
                                    <th>SĐT</th>
                                    <th>Mật Khẩu</th>
                                    <th>Khối</th>
                                </tr>
                            </thead>
                            <tbody id="batchResultTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary rounded-pill px-3 touch-target-44" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-success rounded-pill px-4 fw-bold touch-target-44" onclick="submitBatchCreateTeachers()">
                    <i class="bi bi-check2-circle me-1"></i> Bắt Đầu Khởi Tạo
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DEACTIVATE HÀNG LOẠT GLV NGHỈ NIÊN KHÓA MỚI (TASK-815) -->
<div class="modal fade mobile-modal-sheet" id="batchDeactivateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold fs-6">
                    <i class="bi bi-person-slash me-2"></i>Rà Soát & Vô Hiệu Hóa GLV Nghỉ Dạy (Niên Khóa Mới)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3 p-md-4">
                <div class="alert alert-warning border-0 rounded-3 small mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Danh sách dưới đây là những Giáo lý viên <strong>đang hoạt động nhưng CHƯA ĐƯỢC PHÂN CÔNG</strong> vào lớp nào trong niên khóa hiện tại (<span id="spanDeactivateYear" class="fw-bold"></span>).
                    Bạn có thể chọn các GLV đã nghỉ dạy/tạm ngưng để vô hiệu hóa tài khoản.
                </div>

                <div class="row g-3 mb-3 align-items-center">
                    <div class="col-md-7">
                        <label class="form-label small fw-bold">Lý do vô hiệu hóa</label>
                        <input type="text" id="deactivateReason" class="form-control" value="Nghỉ dạy / Tạm ngưng sinh hoạt niên khóa mới" />
                    </div>
                    <div class="col-md-5 text-md-end mt-2 mt-md-4">
                        <span class="small text-muted me-2 d-inline-block mb-1">Đã chọn: <strong id="selectedDeactivateCount" class="text-danger fs-6">0</strong> GLV</span>
                        <div class="d-inline-flex gap-1">
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 touch-target-44" onclick="toggleSelectAllDeactivate(true)">Chọn Tất Cả</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 touch-target-44" onclick="toggleSelectAllDeactivate(false)">Bỏ Chọn</button>
                        </div>
                    </div>
                </div>

                <!-- Bảng danh sách GLV chưa phân công -->
                <div class="table-responsive border rounded-3" style="max-height: 380px; overflow-y: auto;">
                    <table class="table table-hover table-striped align-middle mb-0 small">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th style="width: 40px;" class="text-center">
                                    <input type="checkbox" class="form-check-input" id="chkSelectAllDeactivate" onchange="toggleSelectAllDeactivate(this.checked)" />
                                </th>
                                <th>Họ và Tên</th>
                                <th>Tên Đăng Nhập</th>
                                <th>Vai Trò / Khối Cũ</th>
                                <th>Số Điện Thoại</th>
                                <th>Đăng Nhập Gần Nhất</th>
                            </tr>
                        </thead>
                        <tbody id="unassignedTeachersTbody">
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <div class="spinner-border spinner-border-sm me-2"></div> Đang kiểm tra danh sách phân công lớp...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary rounded-pill px-3 touch-target-44" data-bs-dismiss="modal">Hủy Bỏ</button>
                <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold touch-target-44" onclick="submitBatchDeactivate()">
                    <i class="bi bi-person-x-fill me-1"></i> Xác Nhận Vô Hiệu Hóa
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function submitCreateUser() {
            const username = document.getElementById("newUsername").value.trim();
            const password = document.getElementById("newPassword").value;
            const christianName = document.getElementById("newChristianName").value.trim();
            const firstName = document.getElementById("newFirstName").value.trim();
            const lastName = document.getElementById("newLastName").value.trim();
            const role = document.getElementById("newRole").value;
            const phone = document.getElementById("newPhone").value.trim();
            const email = document.getElementById("newEmail").value.trim();

            // Lấy giá trị khối nếu chọn BranchHead
            let managedGradeLevel = null;
            if (role === "@UserRole.BranchHead" || role === "BranchHead") {
                const gradeSelect = document.getElementById("newManagedGradeLevel");
                managedGradeLevel = gradeSelect ? gradeSelect.value : null;
            }

            if (!username || !password || !firstName || !lastName) {
                alert("Vui lòng điền đầy đủ các thông tin bắt buộc!");
                return;
            }

            const payload = {
                username: username,
                password: password,
                christianName: christianName,
                firstName: firstName,
                lastName: lastName,
                role: role,
                phoneNumber: phone,
                email: email,
                managedGradeLevel: managedGradeLevel
            };
            try {
                const res = await fetch('/Users/Create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': getCsrfToken()
                    },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert("Không thể tạo tài khoản: " + data.message);
                }
            } catch (err) {
                console.error(err);
                alert("Có lỗi kết nối: " + err.message);
            }
        }

        function openResetPasswordModal(userId, username) {
            document.getElementById("resetUserId").value = userId;
            document.getElementById("resetUsernameDisplay").innerText = username;
            document.getElementById("resetNewPassword").value = "";
            new bootstrap.Modal(document.getElementById("resetPasswordModal")).show();
        }

        function getCsrfToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        async function submitResetPassword() {
            const userId = document.getElementById("resetUserId").value;
            const newPassword = document.getElementById("resetNewPassword").value;

            if (!newPassword || newPassword.length < 6) {
                alert("Mật khẩu mới phải có ít nhất 6 ký tự!");
                return;
            }

            try {
                const res = await fetch('/Users/ResetPassword', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': getCsrfToken()
                    },
                    body: JSON.stringify({ userId: parseInt(userId), newPassword })
                });

                const data = await res.json();
                alert(data.message);
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById("resetPasswordModal")).hide();
                }
            } catch (err) {
                alert("Lỗi kết nối khi đặt lại mật khẩu: " + err.message);
            }
        }

        async function toggleUserStatus(userId) {
            if (!confirm("Bạn có chắc chắn muốn thay đổi trạng thái hoạt động của tài khoản này?")) return;

            try {
                const res = await fetch(`/Users/ToggleStatus/${userId}`, {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': getCsrfToken()
                    }
                });

                const data = await res.json();
                alert(data.message);
                if (data.success) {
                    location.reload();
                }
            } catch (err) {
                alert("Lỗi kết nối: " + err.message);
            }
        }

        function toggleManagedGradeField() {
            const role = document.getElementById("newRole").value;
            const divGrade = document.getElementById("divManagedGrade");
            if (role === "BranchHead") {
                divGrade.classList.remove("d-none");
            } else {
                divGrade.classList.add("d-none");
            }
        }

        async function submitBatchCreateTeachers() {
            const isExcelTab = document.getElementById('pills-excel-tab').classList.contains('active');
            const defaultPassword = document.getElementById('batchDefaultPassword').value.trim() || 'GLV@2026!';
            const resultArea = document.getElementById('batchResultArea');
            const resultMsg = document.getElementById('batchResultMsg');
            const tbody = document.getElementById('batchResultTableBody');

            resultArea.classList.add('d-none');
            tbody.innerHTML = '';

            if (isExcelTab) {
                // Nạp qua File Excel
                const fileInput = document.getElementById('batchTeacherExcelFile');
                if (!fileInput.files || fileInput.files.length === 0) {
                    alert("Vui lòng chọn file Excel để nạp!");
                    return;
                }

                const formData = new FormData();
                formData.append("file", fileInput.files[0]);
                formData.append("defaultPassword", defaultPassword);

                try {
                    const res = await fetch('/Users/ImportTeachersFromExcel', {
                        method: 'POST',
                        headers: {
                            'X-CSRF-TOKEN': getCsrfToken()
                        },
                        body: formData
                    });
                    const data = await res.json();
                    handleBatchResponse(data);
                } catch (err) {
                    alert("Lỗi khi tải file lên: " + err.message);
                }
            } else {
                // Nạp qua Textarea
                const rawText = document.getElementById('batchTeacherRawText').value.trim();
                if (!rawText) {
                    alert("Vui lòng nhập ít nhất một dòng thông tin GLV!");
                    return;
                }

                const lines = rawText.split('\n');
                const teachers = [];

                lines.forEach(l => {
                    const parts = l.split('|').map(p => p.trim());
                    if (parts.length >= 3) {
                        teachers.push({
                            christianName: parts[0] || '',
                            firstName: parts[1] || '',
                            lastName: parts[2] || '',
                            phoneNumber: parts[3] || '',
                            managedGradeLevel: parts[4] || null
                        });
                    }
                });

                if (teachers.length === 0) {
                    alert("Định dạng dữ liệu không đúng. Mỗi dòng cần có ít nhất: Tên Thánh | Họ và Đệm | Tên");
                    return;
                }

                try {
                    const res = await fetch('/Users/BatchCreateTeachers', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': getCsrfToken()
                        },
                        body: JSON.stringify({
                            defaultPassword: defaultPassword,
                            teachers: teachers
                        })
                    });
                    const data = await res.json();
                    handleBatchResponse(data);
                } catch (err) {
                    alert("Lỗi kết nối khi nạp danh sách: " + err.message);
                }
            }

            function handleBatchResponse(data) {
                if (data.success) {
                    resultMsg.className = "alert alert-success border-0 small mb-2 fw-semibold";
                    resultMsg.innerText = data.message;
                    tbody.innerHTML = '';

                    data.createdTeachers.forEach(t => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td class="fw-bold text-primary">${t.username}</td>
                            <td>${t.christianName} ${t.fullName}</td>
                            <td>${t.phoneNumber || '--'}</td>
                            <td><code>${t.initialPassword}</code></td>
                            <td><span class="badge bg-light text-dark border">${t.managedGradeLevel || 'Chưa gán'}</span></td>
                        `;
                        tbody.appendChild(tr);
                    });

                    resultArea.classList.remove('d-none');
                    setTimeout(() => {
                        // Tự động tải lại trang sau 3.5 giây để đồng bộ danh sách bên ngoài
                        location.reload();
                    }, 3500);
                } else {
                    alert("Lỗi: " + data.message);
                }
            }
        }

        let unassignedTeachersList = [];

        // Mở modal và nạp danh sách GLV chưa được xếp lớp
        async function openBatchDeactivateModal() {
            const modalEl = document.getElementById('batchDeactivateModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();

            const tbody = document.getElementById('unassignedTeachersTbody');
            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm me-2"></div> Đang kiểm tra...</td></tr>';
            document.getElementById('selectedDeactivateCount').innerText = '0';
            document.getElementById('chkSelectAllDeactivate').checked = false;

            try {
                const res = await fetch('/Users/GetUnassignedTeachersForCurrentYear');
                const json = await res.json();

                if (json.success) {
                    document.getElementById('spanDeactivateYear').innerText = json.academicYearName;
                    unassignedTeachersList = json.data;
                    renderUnassignedTeachersTable();
                } else {
                    tbody.innerHTML = `<tr><td colspan="6" class="text-center py-3 text-danger">${json.message}</td></tr>`;
                }
            } catch (e) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center py-3 text-danger">Lỗi kết nối máy chủ: ${e.message}</td></tr>`;
            }
        }

        // Render dữ liệu lên bảng
        function renderUnassignedTeachersTable() {
            const tbody = document.getElementById('unassignedTeachersTbody');
            tbody.innerHTML = '';

            if (!unassignedTeachersList || unassignedTeachersList.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-success fw-bold"><i class="bi bi-check-circle me-1"></i>Tất cả các GLV đều đã được phân công lớp trong niên khóa này!</td></tr>';
                return;
            }

            unassignedTeachersList.forEach(t => {
                const tr = document.createElement('tr');
                const lastLogin = t.lastLoginAt ? new Date(t.lastLoginAt).toLocaleDateString('vi-VN') : 'Chưa đăng nhập';
                const gradeBadge = t.managedGradeLevel ? `<span class="badge bg-primary-subtle text-primary border ms-1">${t.managedGradeLevel}</span>` : '';

                tr.innerHTML = `
                    <td class="text-center">
                        <input type="checkbox" class="form-check-input chk-teacher-deactivate" value="${t.id}" onchange="updateSelectedDeactivateCount()" />
                    </td>
                    <td>
                        <strong class="text-dark">${t.christianName} ${t.fullName}</strong>
                    </td>
                    <td><code>${t.username}</code></td>
                    <td>
                        <span class="badge bg-secondary">${t.role}</span>
                        ${gradeBadge}
                    </td>
                    <td>${t.phoneNumber || '--'}</td>
                    <td class="text-muted">${lastLogin}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // Cập nhật số lượng checkbox đã chọn
        function updateSelectedDeactivateCount() {
            const checkboxes = document.querySelectorAll('.chk-teacher-deactivate:checked');
            document.getElementById('selectedDeactivateCount').innerText = checkboxes.length;
        }

        // Chọn tất cả hoặc bỏ chọn
        function toggleSelectAllDeactivate(checked) {
            const checkboxes = document.querySelectorAll('.chk-teacher-deactivate');
            checkboxes.forEach(cb => cb.checked = checked);
            document.getElementById('chkSelectAllDeactivate').checked = checked;
            updateSelectedDeactivateCount();
        }

        // Gửi yêu cầu vô hiệu hóa hàng loạt
        async function submitBatchDeactivate() {
            const selectedCheckboxes = document.querySelectorAll('.chk-teacher-deactivate:checked');
            const ids = Array.from(selectedCheckboxes).map(cb => parseInt(cb.value));
            const reason = document.getElementById('deactivateReason').value.trim();

            if (ids.length === 0) {
                alert("Vui lòng chọn ít nhất một Giáo lý viên để vô hiệu hóa!");
                return;
            }

            if (!confirm(`Bạn có chắc chắn muốn vô hiệu hóa ${ids.length} tài khoản Giáo lý viên đã chọn? Họ sẽ không thể đăng nhập cho đến khi được kích hoạt lại.`)) {
                return;
            }

            try {
                const res = await fetch('/Users/BatchDeactivateTeachers', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': getCsrfToken()
                    },
                    body: JSON.stringify({
                        userIds: ids,
                        reason: reason
                    })
                });

                const data = await res.json();
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert("Lỗi: " + data.message);
                }
            } catch (err) {
                alert("Lỗi kết nối máy chủ: " + err.message);
            }
        }
    </script>
}
