@model IEnumerable<ManagerStudentCaltholic.Models.Entities.AbsenceRequest>
@{
    ViewData["Title"] = "Duyệt Đơn Xin Phép Nghỉ Học & Nghỉ Lễ";
    var classes = ViewBag.Classes as List<ManagerStudentCaltholic.Models.Entities.ClassRoom> ?? new();
    var selectedClassId = ViewBag.SelectedClassId != null ? (int)ViewBag.SelectedClassId : 0;

    int totalCount = Model?.Count() ?? 0;
    int pendingCount = Model?.Count(r => r.Status == "PENDING") ?? 0;
    int approvedCount = Model?.Count(r => r.Status == "APPROVED") ?? 0;
    int rejectedCount = Model?.Count(r => r.Status == "REJECTED") ?? 0;
}
@Html.AntiForgeryToken()

<div class="container-fluid py-3">
    <!-- Header & Bộ lọc Lớp -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold text-primary mb-1">
                <i class="bi bi-envelope-paper-fill me-2"></i>Quản Lý & Duyệt Đơn Xin Phép Nghỉ
            </h4>
            <p class="text-muted small mb-0">
                Khi bấm <strong>Duyệt đơn</strong>, hệ thống sẽ tự động đồng bộ trạng thái <strong>Vắng có phép</strong> sang Sổ Điểm Danh của lớp.
            </p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <label class="small fw-bold text-secondary mb-0">Lớp phụ trách:</label>
            <select id="selectAbsenceClass" class="form-select form-select-sm fw-semibold w-auto"
                    onchange="window.location.href='/Absence/Manage?classId=' + this.value">
                @if (!classes.Any())
                {
                    <option value="0">-- Chưa có lớp được phân công --</option>
                }
                @foreach (var c in classes)
                {
                    <option value="@c.Id" selected="@(c.Id == selectedClassId)">
                        [@c.GradeLevel] @c.Name
                    </option>
                }
            </select>
            @if (selectedClassId > 0)
            {
                <a asp-controller="Attendance" asp-action="Index" asp-route-classId="@selectedClassId"
                   class="btn btn-outline-primary btn-sm rounded-pill px-3">
                    <i class="bi bi-card-checklist me-1"></i> Mở Sổ Điểm Danh Lớp
                </a>
            }
        </div>
    </div>

    <!-- Thẻ KPI Thống kê nhanh -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-primary border-4">
                <div class="text-muted small">Tổng số đơn</div>
                <div class="fs-3 fw-bold text-dark">@totalCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-warning border-4">
                <div class="text-muted small">Chờ duyệt (PENDING)</div>
                <div class="fs-3 fw-bold text-warning">@pendingCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-success border-4">
                <div class="text-muted small">Đã duyệt (APPROVED)</div>
                <div class="fs-3 fw-bold text-success">@approvedCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-danger border-4">
                <div class="text-muted small">Từ chối (REJECTED)</div>
                <div class="fs-3 fw-bold text-danger">@rejectedCount</div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách đơn xin nghỉ -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom">
            <h6 class="fw-bold text-dark mb-0">
                <i class="bi bi-list-ul text-primary me-2"></i>Danh Sách Đơn Xin Phép Nghỉ Của Phụ Huynh
            </h6>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-secondary active" onclick="filterAbsenceRows('ALL', this)">Tất cả (@totalCount)</button>
                <button type="button" class="btn btn-outline-warning text-dark" onclick="filterAbsenceRows('PENDING', this)">Chờ duyệt (@pendingCount)</button>
                <button type="button" class="btn btn-outline-success" onclick="filterAbsenceRows('APPROVED', this)">Đã duyệt (@approvedCount)</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small" id="absenceRequestsTable">
                <thead class="table-light text-secondary text-uppercase">
                    <tr>
                        <th class="ps-3">Thiếu Nhi</th>
                        <th>Ngày Xin Nghỉ</th>
                        <th>Buổi Xin Nghỉ</th>
                        <th>Lý Do Phụ Huynh Gửi</th>
                        <th>SĐT Phụ Huynh</th>
                        <th>Trạng Thái</th>
                        <th style="min-width: 220px;" class="pe-3">Ghi Chú & Xử Lý Của GLV</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var req in Model)
                        {
                            var student = req.Enrollment?.Student;
                            var studentName = student != null
                            ? $"{student.ChristianName} {student.FirstName} {student.LastName}".Trim()
                            : $"Học sinh #{req.EnrollmentId}";
                            var studentCode = student?.StudentCode ?? "--";

                            var sessionBadge = req.SessionType switch
                            {
                                "MASS" => ("Thánh Lễ", "bg-success-subtle text-success border-success-subtle"),
                                "CLASS" => ("Giờ Học Giáo Lý", "bg-primary-subtle text-primary border-primary-subtle"),
                                _ => ("Cả Lễ & Học Giáo Lý", "bg-warning-subtle text-dark border-warning-subtle")
                            };

                            <tr class="absence-row" data-status="@req.Status">
                                <td class="ps-3">
                                    <div class="fw-bold text-dark">@studentName</div>
                                    <span class="badge bg-light text-secondary border font-monospace">@studentCode</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-primary">@req.AbsenceDate.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">Gửi lúc: @req.CreatedAt.AddHours(7).ToString("dd/MM HH:mm")</small>
                                </td>
                                <td>
                                    <span class="badge border @sessionBadge.Item2 px-2 py-1">@sessionBadge.Item1</span>
                                </td>
                                <td class="text-break" style="max-width: 280px;">@req.Reason</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(req.ParentPhone))
                                    {
                                        <a href="tel:@req.ParentPhone" class="text-decoration-none fw-semibold">
                                            <i class="bi bi-telephone me-1"></i>@req.ParentPhone
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (req.Status == "APPROVED")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Đã duyệt
                                        </span>
                                    }
                                    else if (req.Status == "REJECTED")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i>Đã từ chối
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill px-2 py-1">
                                            <i class="bi bi-hourglass-split me-1"></i>Chờ duyệt
                                        </span>
                                    }
                                </td>
                                <td class="pe-3">
                                    @if (req.Status == "PENDING")
                                    {
                                        <input type="text" id="note-req-@req.Id" class="form-control form-control-sm mb-1"
                                               placeholder="Ghi chú duyệt (tùy chọn)..." />
                                        <div class="d-flex gap-1">
                                            <button type="button" class="btn btn-success btn-sm w-50 fw-bold"
                                                    onclick="submitReviewAbsence(@req.Id, true)">
                                                <i class="bi bi-check2"></i> Duyệt
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-sm w-50 fw-bold"
                                                    onclick="submitReviewAbsence(@req.Id, false)">
                                                <i class="bi bi-x"></i> Từ chối
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-dark">@(string.IsNullOrWhiteSpace(req.ReviewNote) ? "Không có ghi chú" : req.ReviewNote)</div>
                                        <small class="text-muted">
                                            Bởi: <strong>@(req.ReviewedBy ?? "GLV")</strong>
                                            @(req.ReviewedAt.HasValue ? $"({req.ReviewedAt.Value.AddHours(7):dd/MM HH:mm})" : "")
                                        </small>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Chưa có đơn xin phép nghỉ nào của lớp này.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getCsrfToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        function filterAbsenceRows(status, btn) {
            btn.parentElement.querySelectorAll('button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            document.querySelectorAll('#absenceRequestsTable tbody .absence-row').forEach(row => {
                const rowStatus = row.getAttribute('data-status');
                row.style.display = (status === 'ALL' || rowStatus === status) ? '' : 'none';
            });
        }

        async function submitReviewAbsence(requestId, isApproved) {
            const noteInput = document.getElementById(`note-req-${requestId}`);
            const note = noteInput ? noteInput.value.trim() : '';

            try {
                const res = await fetch('/Absence/Review', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': getCsrfToken()
                    },
                    body: JSON.stringify({
                        requestId: requestId,
                        isApproved: isApproved,
                        note: note
                    })
                });

                const data = await res.json();
                alert(data.message);
                if (data.success) {
                    location.reload();
                }
            } catch (err) {
                alert('Lỗi kết nối máy chủ: ' + err.message);
            }
        }
    </script>
}