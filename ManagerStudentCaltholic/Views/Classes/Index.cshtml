@model IEnumerable<ManagerStudentCaltholic.Models.Entities.ClassRoom>
@using System.Security.Claims
@using ManagerStudentCaltholic.Models.Entities
@{
    ViewData["Title"] = "Quản lý Lớp Học Giáo Lý";
    var selectedYearId = (int)ViewBag.SelectedYearId;
    var selectedGrade = (string)ViewBag.SelectedGrade;
    var currentUserIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
    long.TryParse(currentUserIdStr, out var currentUserId);
    var isLeadership = User.IsInRole(UserRole.Admin) ||
                       User.IsInRole(UserRole.SpiritualDirector) ||
                       User.IsInRole(UserRole.ExecutiveBoard);
    var managedGradeClaim = User.FindFirst("ManagedGradeLevel")?.Value;
    var canQuickCreateProbationary = User.IsInRole(UserRole.Admin) ||
                                     User.IsInRole(UserRole.ExecutiveBoard) ||
                                     (User.IsInRole(UserRole.BranchHead) && GradeLevel.IsProbationaryGrade(managedGradeClaim));
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom gap-2">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-mortarboard-fill me-2"></i>Danh Sách Lớp Học Giáo Lý
            </h3>
            <p class="text-muted mb-0">Thiết lập các lớp học theo từng khối ngành &amp; ca học (Ca Sáng / Ca Chiều) thuộc niên khóa vận hành</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (canQuickCreateProbationary)
            {
                <form asp-controller="Classes" asp-action="QuickCreateProbationaryClasses" method="post" class="d-inline"
                      onsubmit="return confirm('Khởi tạo nhanh 4 lớp chuẩn Khối Dự Bị (Dự Bị 1, 2, 3, 4 - Ca Chiều) cho niên khóa đang chọn?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="academicYearId" value="@selectedYearId" />
                    <button type="submit" class="btn btn-outline-primary px-3 shadow-sm">
                        <i class="bi bi-lightning-charge-fill me-1"></i> Tạo Nhanh 4 Lớp Dự Bị (Ca Chiều)
                    </button>
                </form>
            }
            @if (User.IsInRole(UserRole.Admin) || User.IsInRole(UserRole.ExecutiveBoard) || User.IsInRole(UserRole.BranchHead))
            {
                <button type="button" class="btn btn-primary px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createClassModal">
                    <i class="bi bi-plus-circle me-1"></i> Thêm Lớp Mới
                </button>
            }
        </div>
    </div>

    <!-- Alert Thông báo -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- THANH BỘ LỌC NIÊN KHÓA VÀ KHỐI NGÀNH -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-controller="Classes" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-secondary mb-1">Niên Khóa Học:</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span>
                        <select name="academicYearId" class="form-select fw-semibold" asp-items="ViewBag.AcademicYears" onchange="this.form.submit()"></select>
                    </div>
                </div>
                <div class="col-md-5">
                    <label class="form-label small fw-bold text-secondary mb-1">Khối / Ngành:</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-filter"></i></span>
                        <select name="gradeLevel" class="form-select fw-semibold" onchange="this.form.submit()">
                            <option value="ALL" selected="@(selectedGrade == "ALL")">-- Tất cả các khối ngành --</option>
                            <option value="Khai Tâm" selected="@(selectedGrade == "Khai Tâm")">Khối Khai Tâm (Ca Sáng • Lễ 6h30 / Học 9h00)</option>
                            <option value="Rước Lễ" selected="@(selectedGrade == "Rước Lễ")">Khối Rước Lễ (Ca Sáng • Lễ 6h30 / Học 9h00)</option>
                            <option value="Thêm Sức" selected="@(selectedGrade == "Thêm Sức")">Khối Thêm Sức (Ca Sáng • Lễ 6h30 / Học 9h00)</option>
                            <option value="Bao Đồng" selected="@(selectedGrade == "Bao Đồng")">Khối Bao Đồng (Ca Chiều • Lễ 6h30 / Học 15h00)</option>
                            <option value="Dự Bị" selected="@(selectedGrade == "Dự Bị" || selectedGrade == "DU_BI")">Khối Dự Bị (Ca Chiều • Cố định Dự Bị 1..4)</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại bộ lọc
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- HIỂN THỊ DẠNG THẺ GRID (CARD/GRID VIEW) -->
    <div class="row g-3">
        @if (Model != null && Model.Any())
        {
            @foreach (var c in Model)
            {
                bool isAfternoonClass = GradeLevel.IsAfternoonSession(c.Session, c.GradeLevel);
                bool isBranchHeadOfThisClass = User.IsInRole(UserRole.BranchHead) &&
                                               !string.IsNullOrWhiteSpace(managedGradeClaim) &&
                                               string.Equals(c.GradeLevel, managedGradeClaim, StringComparison.OrdinalIgnoreCase);
                bool isTeacherOfThisClass = currentUserId > 0 &&
                                            c.ClassTeachers != null &&
                                            c.ClassTeachers.Any(ct => ct.UserId == currentUserId) &&
                                            (!User.IsInRole(UserRole.ProbationaryTeacher) || !isAfternoonClass);
                bool canViewClassRoster = isLeadership || isBranchHeadOfThisClass || isTeacherOfThisClass;
                bool canManageEnrollment = User.IsInRole(UserRole.Admin) || User.IsInRole(UserRole.ExecutiveBoard);
                bool canAssignTeachers = User.IsInRole(UserRole.Admin) || User.IsInRole(UserRole.ExecutiveBoard) || isBranchHeadOfThisClass;
                int studentCount = c.Enrollments?.Count ?? 0;

                <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm rounded-3 class-card">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex flex-wrap align-items-center gap-1">
                                    @if (c.GradeLevel == "Khai Tâm")
                                    {
                                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-2 py-1 rounded-pill">Khai Tâm</span>
                                    }
                                    else if (c.GradeLevel == "Rước Lễ")
                                    {
                                        <span class="badge bg-info-subtle text-primary border border-info-subtle px-2 py-1 rounded-pill">Rước Lễ</span>
                                    }
                                    else if (c.GradeLevel == "Thêm Sức")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill">Thêm Sức</span>
                                    }
                                    else if (GradeLevel.IsProbationaryGrade(c.GradeLevel))
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill">Dự Bị</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">Bao Đồng</span>
                                    }

                                    <span class="badge @(isAfternoonClass ? "bg-dark-subtle text-dark" : "bg-light text-secondary border") px-2 py-1 rounded-pill" style="font-size: 0.7rem;">
                                        @(isAfternoonClass ? "Ca Chiều" : "Ca Sáng")
                                    </span>
                                </div>

                                @if (canManageEnrollment)
                                {
                                    <div class="dropdown">
                                        <button class="btn btn-link text-secondary p-0" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical fs-5"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                            <li>
                                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa lớp @c.Name không?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="bi bi-trash3 me-2"></i> Xóa Lớp Học
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                }
                            </div>

                            <h4 class="card-title fw-bold text-dark mb-1">@c.Name</h4>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-geo-alt me-1"></i>Phòng học: <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(c.RoomName) ? "Chưa bố trí" : c.RoomName)</span>
                            </p>

                        </div>

                        <!-- Danh sách GLV phụ trách -->
                        <div class="px-4 mb-3">
                            <div class="small fw-semibold text-secondary mb-1">
                                <i class="bi bi-person-badge me-1"></i>Phụ trách:
                            </div>
                            @if (c.ClassTeachers != null && c.ClassTeachers.Any())
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var t in c.ClassTeachers)
                                    {
                                        <span class="badge @(t.RoleInClass == "HEAD" ? "bg-primary text-white" : "bg-light text-dark border")" title="@t.PhoneNumber">
                                            @(t.RoleInClass == "HEAD" ? "[CN]" : "") @t.TeacherName
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small fst-italic">Chưa phân công GLV</span>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-center py-2 px-3 mx-4 bg-light rounded-2 mb-3">
                            <span class="text-secondary small">Sĩ số lớp:</span>
                            <span class="fw-bold fs-5 text-primary">@studentCount <small class="fs-6 fw-normal text-muted">em</small></span>
                        </div>

                        <div class="card-footer bg-white border-0 pt-0 pb-3 px-4 d-grid gap-2">
                            @if (canViewClassRoster)
                            {
                                <button type="button"
                                        class="btn btn-primary btn-sm w-100 rounded-pill fw-semibold shadow-sm"
                                        data-class-name="@c.Name"
                                        onclick="openClassRosterModal(@c.Id, this.getAttribute('data-class-name'))">
                                    <i class="bi bi-people-fill me-1"></i> Xem Danh Sách Lớp (@studentCount em)
                                </button>
                            }

                            @if (canManageEnrollment || canAssignTeachers)
                            {
                                <div class="row g-2">
                                    @if (canManageEnrollment)
                                    {
                                        <div class="@(canAssignTeachers ? "col-6" : "col-12")">
                                            <a asp-controller="Enrollments" asp-action="Manage" asp-route-classId="@c.Id" class="btn btn-outline-success btn-sm w-100 rounded-pill">
                                                <i class="bi bi-person-lines-fill me-1"></i> Xếp Lớp
                                            </a>
                                        </div>
                                    }
                                    @if (canAssignTeachers)
                                    {
                                        <div class="@(canManageEnrollment ? "col-6" : "col-12")">
                                            <button type="button" class="btn btn-outline-secondary btn-sm w-100 rounded-pill"
                                                    data-class-name="@c.Name"
                                                    onclick="openAssignModal(@c.Id, this.getAttribute('data-class-name'))">
                                                <i class="bi bi-person-badge me-1"></i> GLV
                                            </button>
                                        </div>
                                    }
                                </div>
                            }

                            @if (canViewClassRoster)
                            {
                                <div class="row g-2">
                                    <div class="col-6">
                                        <a asp-action="ExportExcel" asp-route-id="@c.Id" class="btn btn-outline-warning btn-sm w-100 rounded-pill">
                                            <i class="bi bi-file-earmark-excel me-1"></i> Xuất DS
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <a asp-controller="Students" asp-action="PrintBadges" asp-route-classId="@c.Id" target="_blank" class="btn btn-outline-info btn-sm w-100 rounded-pill">
                                            <i class="bi bi-qr-code me-1"></i> In Thẻ QR
                                        </a>
                                    </div>
                                </div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <a href="/Attendance/Index?classId=@c.Id" class="btn btn-outline-info btn-sm w-100 rounded-pill">
                                            <i class="bi bi-card-checklist me-1"></i> Điểm Danh
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <a href="/Grades/Index?classId=@c.Id" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                            <i class="bi bi-table me-1 text-warning"></i> Sổ Điểm
                                        </a>
                                    </div>
                                </div>
                            }
                            else if (!canManageEnrollment && !canAssignTeachers)
                            {
                                <div class="text-center text-muted small py-2 bg-light rounded-pill" title="Bạn chỉ có quyền xem danh sách các lớp được phân công">
                                    <i class="bi bi-lock me-1"></i>Chỉ xem danh sách lớp phụ trách
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 py-5 text-center text-muted">
                <i class="bi bi-folder-x fs-1 d-block mb-2"></i>
                Không tìm thấy lớp học nào phù hợp với bộ lọc hiện tại.
            </div>
        }
    </div>
</div>

<!-- ============================================================== -->
<!-- MODAL THÊM LỚP HỌC MỚI (TASK-204)                             -->
<!-- ============================================================== -->
<div class="modal fade" id="createClassModal" tabindex="-1" aria-labelledby="createClassModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-controller="Classes" asp-action="Create" method="post" class="modal-content border-0 shadow">
            @Html.AntiForgeryToken()
            <input type="hidden" id="modalAcademicYearId" name="AcademicYearId" value="@selectedYearId" />

            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-primary" id="createClassModalLabel">
                    <i class="bi bi-plus-circle me-1"></i> Tạo Lớp Học Mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tên Lớp Học <span class="text-danger">*</span></label>
                    <input type="text" name="Name" class="form-control" placeholder="Ví dụ: Khai Tâm 1A, Rước Lễ 2B..." required maxlength="50" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Khối / Ngành <span class="text-danger">*</span></label>
                    <select id="modalGradeLevelSelect" name="GradeLevel" class="form-select" required onchange="loadAvailableRoomsForModal()">
                        <option value="Khai Tâm">Khối Khai Tâm (Ca Sáng • Học sáng 9h00)</option>
                        <option value="Rước Lễ">Khối Rước Lễ (Ca Sáng • Học sáng 9h00)</option>
                        <option value="Thêm Sức">Khối Thêm Sức (Ca Sáng • Học sáng 9h00)</option>
                        <option value="Bao Đồng">Khối Bao Đồng (Ca Chiều • Học chiều 15h00)</option>
                        <option value="Dự Bị">Khối Dự Bị (Ca Chiều • Học chiều 15h00)</option>
                    </select>
                </div>

                <!-- THAY INPUT BẰNG DROPDOWNLIST PHÒNG CÒN TRỐNG THEO CA -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label fw-semibold mb-0">Phòng Học</label>
                        <span id="shiftBadge" class="badge bg-warning-subtle text-dark border">Ca Sáng</span>
                    </div>
                    <select id="modalRoomSelect" name="RoomName" class="form-select">
                        <option value="">-- Đang nạp danh sách phòng trống... --</option>
                    </select>
                    <div class="form-text small text-muted">
                        <i class="bi bi-info-circle me-1"></i>Chỉ hiển thị các phòng <strong>chưa có lớp nào dùng trong ca này</strong>.
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-save me-1"></i> Lưu Lớp Học
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ============================================================== -->
<!-- Modal Phân công GLV (TASK-207)                             -->
<!-- ============================================================== -->
<div class="modal fade" id="assignTeacherModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fs-6 fw-bold">
                    <i class="bi bi-person-plus me-2"></i>Phân Công GLV: <span id="modalClassName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="assignClassId" />

                <!-- Danh sách GLV hiện tại của lớp -->
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted text-uppercase">Danh sách GLV đang phụ trách</label>
                    <div id="currentTeachersList" class="list-group list-group-flush border rounded-3 mb-2" style="max-height: 180px; overflow-y: auto;">
                        <!-- Render danh sách qua Ajax -->
                    </div>
                </div>

                <hr class="my-3">

                <!-- Form gán GLV mới -->
                <div class="fw-bold small text-dark mb-2">Thêm GLV Phụ Trách Mới</div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Chọn tài khoản GLV <span class="text-danger">*</span></label>
                    <!-- THAY INPUT BẰNG SELECT USER -->
                    <select id="selectTeacherAccount" class="form-select">
                        <option value="">-- Đang nạp danh sách tài khoản... --</option>
                    </select>
                    <div class="form-text small text-muted">
                        <i class="bi bi-info-circle me-1 text-primary"></i>Quy định: GLV chính thức tối đa <strong>2 lớp</strong> (1 Ca Sáng + 1 Ca Chiều). <strong>Dự Bị</strong> chỉ được phân công trợ giảng <strong>Ca Sáng</strong> (Khai Tâm/Rước Lễ/Thêm Sức) và tự động ẩn khỏi lớp Ca Chiều (Bao Đồng/Dự Bị).
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Vai trò phụ trách</label>
                    <select id="teacherRoleSelect" class="form-select">
                        <option value="HEAD">Chủ Nhiệm Lớp</option>
                        <option value="MEMBER">Giáo Lý Viên</option>
                        <option value="DEPUTY">Dự Bị </option>
                    </select>
                </div>

                <button type="button" class="btn btn-primary w-100 fw-bold rounded-pill py-2 shadow-sm" onclick="submitAssignTeacher()">
                    <i class="bi bi-check2-circle me-1"></i> Xác Nhận Phân Công
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- Modal Xem Danh Sách Thiếu Nhi Theo Lớp (Theo Phân Quyền)       -->
<!-- ============================================================== -->
<div class="modal fade" id="classStudentsRosterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-primary text-white py-3">
                <div>
                    <h5 class="modal-title fw-bold mb-0">
                        <i class="bi bi-people-fill me-2"></i>Danh Sách Lớp: <span id="rosterModalClassName" class="text-warning"></span>
                    </h5>
                    <small id="rosterModalMeta" class="text-white-50"></small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-3 p-md-4">
                <div class="row g-2 align-items-center mb-3">
                    <div class="col-md-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                            <input type="text" id="classRosterSearchInput" class="form-control"
                                   placeholder="Lọc nhanh theo Mã QR, Tên Thánh, Họ tên, SĐT..."
                                   oninput="filterClassRosterRows(this.value)" />
                        </div>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-2" id="rosterTotalBadge">
                            0 thiếu nhi
                        </span>
                    </div>
                </div>

                <div id="classRosterError" class="alert alert-danger border-0 rounded-3 small d-none"></div>

                <div id="classRosterLoading" class="text-center py-5 d-none">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="small text-muted mt-2 mb-0">Đang tải danh sách thiếu nhi của lớp...</p>
                </div>

                <div class="table-responsive border rounded-3" id="classRosterTableWrapper">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center" style="width: 50px;">#</th>
                                <th>Mã QR</th>
                                <th>Tên Thánh &amp; Họ Tên</th>
                                <th>Giới Tính</th>
                                <th>Ngày Sinh</th>
                                <th>SĐT Phụ Huynh</th>
                                <th class="text-center">Trạng Thái</th>
                                <th class="text-end pe-3">Hồ Sơ</th>
                            </tr>
                        </thead>
                        <tbody id="classRosterTableBody"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light d-flex flex-wrap justify-content-between gap-2">
                <div class="d-flex flex-wrap gap-2">
                    <a id="rosterOpenStudentsPageLink" href="/Students/Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Mở Trang Hồ Sơ Lớp
                    </a>
                    <a id="rosterExportExcelLink" href="#" class="btn btn-outline-warning btn-sm rounded-pill px-3">
                        <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
                    </a>
                </div>
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getCsrfToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }
        let currentClassId = 0;
        let cachedAvailableTeachers = null;

        // Gọi API lấy danh sách GLV khả dụng theo từng lớp cụ thể
        async function loadAvailableTeachersForClass(classId) {
            try {
                const res = await fetch(`/Classes/GetAvailableTeachers?classRoomId=${classId}`);
                const json = await res.json();
                if (json.success) {
                    return json.data;
                }
            } catch (e) {
                console.error("Lỗi khi tải danh sách GLV theo ca:", e);
            }
            return [];
        }

                // Hàm mở Modal phân công lớp
        async function openAssignModal(classId, className) {
            document.getElementById('assignClassId').value = classId;
            document.getElementById('modalClassName').innerText = className;

            const modalEl = document.getElementById('assignTeacherModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();

            // 1. Nạp danh sách GLV hiện có của lớp
            await loadClassTeachers(classId);

            // 2. Nạp danh sách tài khoản đã lọc tự động theo ca của lớp này
            const selectEl = document.getElementById('selectTeacherAccount');
            selectEl.innerHTML = '<option value="">-- Đang lọc danh sách GLV phù hợp... --</option>';

            const teachers = await loadAvailableTeachersForClass(classId);
            selectEl.innerHTML = '<option value="">-- Chọn tài khoản Giáo lý viên --</option>';

            if (teachers.length === 0) {
                const emptyOpt = document.createElement('option');
                emptyOpt.value = "";
                emptyOpt.text = "Không có GLV nào khả dụng cho ca học này (tất cả đã nhận ca hoặc đủ định mức)";
                selectEl.appendChild(emptyOpt);
                return;
            }

            teachers.forEach(t => {
                const opt = document.createElement('option');
                opt.value = t.id;
                const phone = t.phoneNumber ? ` - SĐT: ${t.phoneNumber}` : '';
                const role = t.role === 'BranchHead'
                    ? ' [Trưởng khối]'
                    : (t.role === 'ProbationaryTeacher' ? ' [Dự Bị - Ca Sáng]' : '');
                const note = t.statusNote || '';
                opt.text = `${t.fullName} (${t.username})${role}${note}${phone}`;
                selectEl.appendChild(opt);
            });
        }

        // Nạp danh sách GLV của lớp vào khung danh sách
        async function loadClassTeachers(classId) {
            const listContainer = document.getElementById('currentTeachersList');
            listContainer.innerHTML = '<div class="p-3 text-center small text-muted"><div class="spinner-border spinner-border-sm me-2"></div>Đang tải...</div>';

            try {
                const res = await fetch(`/Classes/GetTeachers?classId=${classId}`);
                const json = await res.json();
                listContainer.innerHTML = '';

                if (!json.success || json.data.length === 0) {
                    listContainer.innerHTML = '<div class="p-3 text-center small text-muted fst-italic">Lớp này chưa có GLV nào phụ trách.</div>';
                    return;
                }

                json.data.forEach(t => {
                    const item = document.createElement('div');
                    item.className = 'list-group-item d-flex justify-content-between align-items-center py-2 px-3';
                    item.innerHTML = `
                        <div>
                            <span class="badge ${t.roleInClass === 'HEAD' ? 'bg-primary' : 'bg-secondary'} me-1">${t.roleName}</span>
                            <strong class="text-dark small">${t.teacherName}</strong>
                            ${t.phoneNumber ? `<small class="text-muted ms-2"><i class="bi bi-telephone"></i> ${t.phoneNumber}</small>` : ''}
                        </div>
                        <button type="button" class="btn btn-outline-danger btn-sm border-0 py-0 px-2" onclick="removeTeacher(${t.id}, ${classId})" title="Hủy phân công">
                            <i class="bi bi-trash"></i>
                        </button>
                    `;
                    listContainer.appendChild(item);
                });
            } catch (e) {
                listContainer.innerHTML = '<div class="p-2 text-danger small">Lỗi tải danh sách GLV.</div>';
            }
        }

        // Gửi API gán GLV (SEC-NEW-02 & 03 FIX: Bổ sung X-CSRF-TOKEN)
        async function submitAssignTeacher() {
            const classId = document.getElementById('assignClassId').value;
            const userId = document.getElementById('selectTeacherAccount').value;
            const roleInClass = document.getElementById('teacherRoleSelect')?.value || "MEMBER";

            if (!userId) {
                alert("Vui lòng chọn một tài khoản Giáo lý viên!");
                return;
            }

            try {
                const res = await fetch('/Classes/AssignTeacher', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': getCsrfToken(),
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({
                        classRoomId: parseInt(classId),
                        userId: parseInt(userId),
                        roleInClass: roleInClass
                    })
                });

                const json = await res.json();
                if (json.success) {
                    alert(json.message);
                    await loadClassTeachers(classId);
                    location.reload();
                } else {
                    alert("Lỗi: " + json.message);
                }
            } catch (e) {
                alert("Lỗi kết nối khi phân công: " + e.message);
            }
        }

        // Hủy phân công GLV (SEC-NEW-02 & 03 FIX: Bổ sung X-CSRF-TOKEN)
        async function removeTeacher(teacherAssignmentId, classId) {
            if (!confirm("Bạn có chắc chắn muốn hủy phân công GLV này khỏi lớp?")) return;

            try {
                const res = await fetch(`/Classes/RemoveTeacher?id=${teacherAssignmentId}`, {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': getCsrfToken()
                    }
                });
                const json = await res.json();
                if (json.success) {
                    await loadClassTeachers(classId);
                    location.reload();
                } else {
                    alert("Không thể xóa: " + json.message);
                }
            } catch (e) {
                alert("Lỗi kết nối máy chủ: " + e.message);
            }
        }
        
        // Gọi API lấy danh sách phòng còn trống khi thay đổi Khối/Ngành hoặc mở modal
        async function loadAvailableRoomsForModal() {
            const yearId = document.getElementById('modalAcademicYearId')?.value || @selectedYearId;
            const gradeLevel = document.getElementById('modalGradeLevelSelect')?.value || 'Khai Tâm';
            const roomSelect = document.getElementById('modalRoomSelect');
            const shiftBadge = document.getElementById('shiftBadge');

            if (!roomSelect) return;

            roomSelect.innerHTML = '<option value="">-- Đang nạp phòng trống... --</option>';

            try {
                const res = await fetch(`/Classes/GetAvailableRooms?academicYearId=${yearId}&gradeLevel=${encodeURIComponent(gradeLevel)}`);
                const json = await res.json();

                if (json.success) {
                    if (shiftBadge) shiftBadge.innerText = json.shiftName;

                    roomSelect.innerHTML = '<option value="">-- Chưa xếp phòng (Để trống) --</option>';

                    if (!json.data || json.data.length === 0) {
                        const opt = document.createElement('option');
                        opt.value = "";
                        opt.text = `(Hết phòng trống cho ${json.shiftName})`;
                        opt.disabled = true;
                        roomSelect.appendChild(opt);
                        return;
                    }

                    // Gom nhóm theo Khu vực (ZoneName)
                    const grouped = {};
                    json.data.forEach(r => {
                        if (!grouped[r.zoneName]) grouped[r.zoneName] = [];
                        grouped[r.zoneName].push(r);
                    });

                    for (const zone in grouped) {
                        const optgroup = document.createElement('optgroup');
                        optgroup.label = zone;

                        grouped[zone].forEach(r => {
                            const opt = document.createElement('option');
                            opt.value = r.roomName; // Lưu tên phòng vào RoomNumber
                            opt.setAttribute('data-id', r.id);
                            opt.text = `${r.roomName} (Tầng ${r.floorNumber} - Sức chứa: ${r.capacity} chỗ)`;
                            optgroup.appendChild(opt);
                        });

                        roomSelect.appendChild(optgroup);
                    }
                } else {
                    roomSelect.innerHTML = `<option value="">Lỗi: ${json.message}</option>`;
                }
            } catch (err) {
                roomSelect.innerHTML = '<option value="">Không thể tải danh sách phòng</option>';
            }
        }

        function escapeHtmlRoster(text) {
            if (text === null || text === undefined) return '';
            return String(text)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        async function openClassRosterModal(classId, className) {
            const modalEl = document.getElementById('classStudentsRosterModal');
            if (!modalEl) return;

            document.getElementById('rosterModalClassName').innerText = className || `#${classId}`;
            document.getElementById('rosterModalMeta').innerText = '';
            document.getElementById('rosterTotalBadge').innerText = 'Đang tải...';
            document.getElementById('classRosterSearchInput').value = '';
            document.getElementById('classRosterError').classList.add('d-none');
            document.getElementById('classRosterTableBody').innerHTML = '';
            document.getElementById('classRosterTableWrapper').classList.add('d-none');
            document.getElementById('classRosterLoading').classList.remove('d-none');

            document.getElementById('rosterOpenStudentsPageLink').href = `/Students/Index?classId=${classId}`;
            document.getElementById('rosterExportExcelLink').href = `/Classes/ExportExcel/${classId}`;

            bootstrap.Modal.getOrCreateInstance(modalEl).show();

            try {
                const res = await fetch(`/Classes/GetClassStudents?classId=${classId}`);
                const json = await res.json();

                document.getElementById('classRosterLoading').classList.add('d-none');

                if (!json.success) {
                    const errBox = document.getElementById('classRosterError');
                    errBox.innerText = json.message || 'Bạn không có quyền xem danh sách lớp này.';
                    errBox.classList.remove('d-none');
                    document.getElementById('rosterTotalBadge').innerText = 'Không thể truy cập';
                    return;
                }

                const info = json.data;
                document.getElementById('rosterModalClassName').innerText = info.className || className;
                document.getElementById('rosterModalMeta').innerText =
                    `Khối: ${info.gradeLevel} • ${info.sessionDisplay} • Phòng: ${info.roomName} • Niên khóa: ${info.academicYearName}`;
                document.getElementById('rosterTotalBadge').innerText = `${info.totalStudents} thiếu nhi`;

                const tbody = document.getElementById('classRosterTableBody');
                document.getElementById('classRosterTableWrapper').classList.remove('d-none');

                if (!info.students || info.students.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted fst-italic">Lớp này hiện chưa có thiếu nhi nào được xếp vào danh sách.</td></tr>';
                    return;
                }

                tbody.innerHTML = info.students.map((s, idx) => `
                    <tr>
                        <td class="text-center text-muted small">${idx + 1}</td>
                        <td><span class="badge bg-light text-dark border font-monospace">${escapeHtmlRoster(s.studentCode)}</span></td>
                        <td>
                            <div class="fw-semibold text-dark">${escapeHtmlRoster(s.christianName)} ${escapeHtmlRoster(s.fullName)}</div>
                        </td>
                        <td>
                            <span class="badge ${s.gender === 'Nam' ? 'bg-info-subtle text-primary' : 'bg-danger-subtle text-danger'} rounded-pill">
                                ${escapeHtmlRoster(s.gender)}
                            </span>
                        </td>
                        <td class="small">${escapeHtmlRoster(s.dateOfBirth)}</td>
                        <td class="small">
                            ${s.parentPhone
                                ? `<a href="tel:${escapeHtmlRoster(s.parentPhone)}" class="text-decoration-none"><i class="bi bi-telephone me-1"></i>${escapeHtmlRoster(s.parentPhone)}</a>`
                                : '<span class="text-muted fst-italic">Chưa có</span>'}
                        </td>
                        <td class="text-center">
                            ${s.isActive
                                ? '<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Đang học</span>'
                                : '<span class="badge bg-secondary-subtle text-secondary rounded-pill">Tạm nghỉ</span>'}
                        </td>
                        <td class="text-end pe-3">
                            <a href="/Students/Details/${s.id}" class="btn btn-outline-primary btn-sm rounded-pill px-2">
                                <i class="bi bi-person-vcard me-1"></i>Chi tiết
                            </a>
                        </td>
                    </tr>
                `).join('');
            } catch (e) {
                document.getElementById('classRosterLoading').classList.add('d-none');
                const errBox = document.getElementById('classRosterError');
                errBox.innerText = 'Lỗi kết nối khi tải danh sách thiếu nhi của lớp.';
                errBox.classList.remove('d-none');
            }
        }

        function filterClassRosterRows(keyword) {
            const kw = (keyword || '').trim().toLowerCase();
            document.querySelectorAll('#classRosterTableBody tr').forEach(tr => {
                const text = tr.innerText.toLowerCase();
                tr.style.display = (!kw || text.includes(kw)) ? '' : 'none';
            });
        }

        // Tự động nạp danh sách phòng trống ngay khi modal mở ra
        document.addEventListener('DOMContentLoaded', function () {
            const createClassModal = document.getElementById('createClassModal');
            if (createClassModal) {
                createClassModal.addEventListener('show.bs.modal', function () {
                    loadAvailableRoomsForModal();
                });
            }

            const params = new URLSearchParams(window.location.search);
            const openRosterClassId = parseInt(params.get('openRosterClassId'));
            if (openRosterClassId > 0) {
                openClassRosterModal(openRosterClassId, '');
            }
        });
    </script>
}