@model ManagerStudentCaltholic.Models.ViewModels.MasterWorkspaceViewModel

<div class="card border-0 shadow-sm rounded-4 mb-4 staff-quick-lookup-card overflow-hidden">
    <!-- Header của Widget -->
    <div class="card-header bg-white border-0 pt-4 px-3 px-md-4 pb-2">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center"
                     style="width: 42px; height: 42px; font-size: 1.25rem;">
                    <i class="bi bi-search-heart"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <span>Cổng Tra Cứu Tức Thời Thiếu Nhi</span>
                        <span class="badge bg-primary-subtle text-primary border rounded-pill px-2 py-1 small fw-semibold" style="font-size: 0.72rem;">
                            <i class="bi bi-shield-lock-fill me-1"></i>Nội Bộ GLV & BĐH
                        </span>
                    </h5>
                    <small class="text-muted">Tra cứu tức thời không cần ngày sinh/SĐT (Hiện tại + 2 Năm trước)</small>
                </div>
            </div>
            <div class="text-muted small d-none d-md-block">
                <i class="bi bi-info-circle me-1"></i>Hỗ trợ tìm theo: <strong>Họ tên</strong>, <strong>Tên Thánh</strong>, <strong>Mã hiện hành</strong> hoặc <strong>Mã năm cũ</strong>
            </div>
        </div>

        <!-- Hộp tìm kiếm thông minh -->
        <div class="position-relative mt-3">
            <div class="input-group input-group-lg shadow-sm rounded-4 overflow-hidden border border-2 border-primary border-opacity-25">
                <span class="input-group-text bg-white border-0 text-primary ps-3">
                    <i class="bi bi-search fs-5"></i>
                </span>
                <input type="text" id="staffStudentQuickSearchInput"
                       class="form-control border-0 px-2 py-3 fw-semibold text-dark"
                       placeholder="Nhập họ tên (Nguyễn Văn A), Tên Thánh (Giuse, Maria...), Mã hiện hành hoặc Mã năm cũ (TS2A001)..."
                       autocomplete="off" />
                <button class="btn btn-white border-0 text-secondary pe-3 d-none" id="btnClearStaffSearch" type="button" title="Xóa từ khóa">
                    <i class="bi bi-x-circle-fill fs-5"></i>
                </button>
                <div class="input-group-text bg-white border-0 pe-3 d-none" id="staffSearchSpinner">
                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                </div>
            </div>

            <!-- Dropdown danh sách gợi ý tìm kiếm tức thời -->
            <div id="staffSearchDropdownMenu" class="position-absolute w-100 shadow-lg rounded-4 bg-white border mt-1 overflow-hidden z-3 d-none"
                 style="max-height: 380px; overflow-y: auto;">
                <div id="staffSuggestionsList" class="list-group list-group-flush">
                    <!-- Dynamic rendering -->
                </div>
            </div>
        </div>

        <!-- Thanh danh sách vừa tra cứu gần đây (Sub-task 01.4.1) -->
        <div class="mt-3 d-flex flex-wrap align-items-center gap-2" id="staffRecentLookupsContainer">
            <span class="text-secondary small fw-bold text-uppercase d-flex align-items-center me-1" style="font-size: 0.72rem; letter-spacing: 0.04em;">
                <i class="bi bi-clock-history me-1 text-primary"></i>Đã xem gần đây:
            </span>
            <div class="d-flex flex-wrap gap-2" id="staffRecentChipsWrapper">
                @if (Model.RecentStaffLookups.Any())
                {
                    @foreach (var r in Model.RecentStaffLookups)
                    {
                        <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 py-1 text-dark shadow-2xs hover-primary staff-recent-chip"
                                onclick="fetchStudent360Detail(@r.StudentId, 'OVERVIEW', '@r.FullName')">
                            <span class="badge bg-secondary-subtle text-secondary me-1">@r.StudentCode</span>
                            <strong>@r.ChristianName @r.FullName</strong>
                            @if (!string.IsNullOrWhiteSpace(r.ClassName))
                            {
                                <span class="text-muted small ms-1">(@r.ClassName)</span>
                            }
                        </button>
                    }
                }
                else
                {
                    <span class="text-muted small fst-italic" id="noRecentLookupsNotice">Chưa có lịch sử tra cứu nào trong phiên này.</span>
                }
            </div>
        </div>
    </div>

    <!-- KHU VỰC THẺ KẾT QUẢ ĐA CHẾ ĐỘ 360 ĐỘ (Ban đầu ẩn, mở ra khi chọn học sinh) -->
    <div id="staffLookupResultWrapper" class="card-body p-3 p-md-4 border-top bg-light bg-opacity-50 d-none">
        <!-- 1. Header Hồ sơ tóm tắt của Thiếu nhi -->
        <div class="card border-0 shadow-sm rounded-4 p-3 mb-3 bg-white border-start border-4 border-primary">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold shadow-sm"
                         id="resAvatarCircle" style="width: 58px; height: 58px; font-size: 1.4rem;">
                        TN
                    </div>
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <h4 class="fw-bold text-dark mb-0" id="resStudentFullName">Tên Thiếu Nhi</h4>
                            <span class="badge bg-primary text-white rounded-pill px-3 py-1 fw-bold fs-6" id="resStudentCodeBadge">Mã Số</span>
                            <span class="badge bg-success-subtle text-success border rounded-pill px-2 py-1 small" id="resActiveClassBadge">Lớp Hiện Tại</span>
                        </div>
                        <div class="text-muted small d-flex flex-wrap align-items-center gap-3" id="resMetaSub">
                            <span><i class="bi bi-calendar3 me-1"></i>Niên khóa: <strong id="resAcademicYearName">2026-2027</strong></span>
                            <span><i class="bi bi-gender-ambiguous me-1"></i>Giới tính: <strong id="resGender">Nam</strong></span>
                            <span><i class="bi bi-cake2 me-1"></i>Ngày sinh: <strong id="resDob">01/01/2015</strong> (<span id="resAge">11</span> tuổi)</span>
                            <span><i class="bi bi-telephone me-1"></i>Phụ huynh: <strong id="resParentPhone">090xxxxxxx</strong></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 ms-auto">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="closeStaffLookupResult()" title="Đóng bảng kết quả">
                        <i class="bi bi-x-lg me-1"></i> Đóng
                    </button>
                </div>
            </div>
        </div>

        <!-- 2. THANH CHỌN OPTION KẾT QUẢ CHO GLV (Sub-task 01.4.2) -->
        <div class="mb-3">
            <div class="d-flex flex-wrap gap-2 p-1 bg-white rounded-4 shadow-sm border" id="staffOptionButtonGroup">
                <button type="button" class="btn btn-primary rounded-pill px-3 py-2 fw-bold flex-grow-1 flex-md-grow-0 staff-option-btn active"
                        data-option="OVERVIEW" onclick="switchLookupOptionTab('OVERVIEW')">
                    <i class="bi bi-person-badge me-1"></i> 1. Tổng quan
                </button>
                <button type="button" class="btn btn-outline-success rounded-pill px-3 py-2 fw-bold flex-grow-1 flex-md-grow-0 staff-option-btn"
                        data-option="ATTENDANCE_DETAIL" onclick="switchLookupOptionTab('ATTENDANCE_DETAIL')">
                    <i class="bi bi-calendar-check me-1"></i> 2. Chuyên cần & Chiến dịch
                </button>
                <button type="button" class="btn btn-outline-warning rounded-pill px-3 py-2 fw-bold flex-grow-1 flex-md-grow-0 staff-option-btn text-dark"
                        data-option="ACADEMIC_2Y_SACRAMENT" onclick="switchLookupOptionTab('ACADEMIC_2Y_SACRAMENT')">
                    <i class="bi bi-journal-bookmark me-1"></i> 3. Lịch sử 2 năm & Bí tích
                </button>
                <button type="button" class="btn btn-outline-info rounded-pill px-3 py-2 fw-bold flex-grow-1 flex-md-grow-0 staff-option-btn text-dark"
                        data-option="PARENT_CONTACT" onclick="switchLookupOptionTab('PARENT_CONTACT')">
                    <i class="bi bi-telephone me-1"></i> 4. Liên hệ phụ huynh
                </button>
            </div>
        </div>

        <!-- 3. CÁC PANEL NỘI DUNG TƯƠNG ỨNG 4 CHẾ ĐỘ XEM -->
        <!-- PANEL 1: TỔNG QUAN -->
        <div id="panelOptionOverview" class="staff-option-panel">
            <div class="row g-3">
                <!-- Thẻ Tóm tắt Chuyên cần -->
                <div class="col-12 col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="d-flex align-items-center gap-2 mb-2 text-success">
                            <i class="bi bi-calendar-check-fill fs-5"></i>
                            <h6 class="fw-bold mb-0 text-dark">Chuyên Cần Hiện Tại</h6>
                        </div>
                        <div class="mb-2">
                            <div class="text-muted small">Lễ Chúa Nhật gần nhất:</div>
                            <div id="resSundayStatusOverview" class="fw-bold text-dark mt-1">Đang cập nhật...</div>
                        </div>
                        <div class="mb-2">
                            <div class="text-muted small">Lễ Thứ Năm gần nhất:</div>
                            <div id="resThursdayStatusOverview" class="fw-bold text-dark mt-1">Đang cập nhật...</div>
                        </div>
                        <div class="mt-auto pt-2 border-top">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Tỷ lệ tham dự Thánh lễ:</span>
                                <strong id="resMassRateText" class="text-success">0%</strong>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-success" id="resMassRateBar" role="progressbar" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Thẻ Tóm tắt Học vụ & Điểm số -->
                <div class="col-12 col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="d-flex align-items-center gap-2 mb-2 text-warning">
                            <i class="bi bi-award-fill fs-5"></i>
                            <h6 class="fw-bold mb-0 text-dark">Học Lực Năm Hiện Hành</h6>
                        </div>
                        <div class="d-flex align-items-baseline gap-2 mb-2">
                            <h2 class="fw-bolder text-primary mb-0" id="resCurrentAvgScore">--</h2>
                            <span class="badge bg-primary-subtle text-primary border rounded-pill px-2 py-1" id="resCurrentClassification">Chưa xếp loại</span>
                        </div>
                        <p class="text-muted small mb-2" id="resGradeSummaryDesc">
                            Điểm trung bình các cột điểm đã nhập trong niên khóa hiện hành.
                        </p>
                        <div class="mt-auto pt-2 border-top small text-muted">
                            <i class="bi bi-door-closed me-1"></i>Phòng học: <strong id="resClassRoomName">Chưa xếp phòng</strong> - Ca: <strong id="resClassShift">Sáng</strong>
                        </div>
                    </div>
                </div>

                <!-- Thẻ Tóm tắt Bí tích -->
                <div class="col-12 col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="d-flex align-items-center gap-2 mb-2 text-info">
                            <i class="bi bi-stars fs-5"></i>
                            <h6 class="fw-bold mb-0 text-dark">Tiến Trình Bí Tích</h6>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small text-muted">Đã hoàn thành mốc:</span>
                            <span class="badge bg-info-subtle text-dark border rounded-pill px-2 py-1 fw-bold" id="resSacramentCompletedCount">0/4 mốc</span>
                        </div>
                        <div class="progress mb-3" style="height: 8px;">
                            <div class="progress-bar bg-info" id="resSacramentProgressBar" role="progressbar" style="width: 0%"></div>
                        </div>
                        <div class="d-flex flex-column gap-1 small" id="resSacramentQuickList">
                            <!-- Injected -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PANEL 2: CHUYÊN CẦN & CHIẾN DỊCH (Sub-task 01.2.2) -->
        <div id="panelOptionAttendance" class="staff-option-panel d-none">
            <div class="row g-3">
                <!-- Điểm danh Lễ Chúa Nhật & Thứ Năm gần nhất -->
                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-clock-history text-primary"></i>Điểm Danh Lễ & Giờ Học Gần Nhất
                        </h6>

                        <!-- Lễ Chúa Nhật -->
                        <div class="p-3 rounded-4 bg-light mb-3 border">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-dark"><i class="bi bi-sun-fill text-warning me-1"></i>Thánh Lễ Chúa Nhật</span>
                                <span class="badge bg-secondary" id="resSundayBadge">Chưa có dữ liệu</span>
                            </div>
                            <div class="small text-muted">
                                Ngày: <strong id="resSundayDate">--/--/----</strong> | Giờ check-in: <strong id="resSundayTime">--:--</strong>
                            </div>
                        </div>

                        <!-- Lễ Thứ Năm -->
                        <div class="p-3 rounded-4 bg-light mb-3 border">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-dark"><i class="bi bi-calendar-event text-info me-1"></i>Thánh Lễ Thứ Năm</span>
                                <span class="badge bg-secondary" id="resThursdayBadge">Chưa có dữ liệu</span>
                            </div>
                            <div class="small text-muted">
                                Ngày: <strong id="resThursdayDate">--/--/----</strong> | Giờ check-in: <strong id="resThursdayTime">--:--</strong>
                            </div>
                        </div>

                        <!-- Giờ học Giáo lý -->
                        <div class="p-3 rounded-4 bg-light border">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-dark"><i class="bi bi-book-half text-success me-1"></i>Giờ Học Giáo Lý Gần Nhất</span>
                                <span class="badge bg-secondary" id="resClassSessionBadge">Chưa có dữ liệu</span>
                            </div>
                            <div class="small text-muted">
                                Ngày: <strong id="resClassSessionDate">--/--/----</strong> | Giờ vào lớp: <strong id="resClassSessionTime">--:--</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Chiến dịch Đi Lễ 1 Tháng & Thống kê năm -->
                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center justify-content-between">
                            <span><i class="bi bi-fire text-danger me-1"></i>Chiến Dịch Đi Lễ 1 Tháng</span>
                            <span class="badge bg-danger rounded-pill px-2 py-1" id="resCampaignStreakBadge">🔥 Streak: 0 ngày</span>
                        </h6>

                        <div id="resCampaignContentWrapper">
                            <div class="p-3 rounded-4 border bg-danger bg-opacity-10 border-danger border-opacity-25 mb-3">
                                <h6 class="fw-bold text-dark mb-1" id="resCampaignTitle">Chiến dịch Mùa Phụng Vụ</h6>
                                <p class="small text-muted mb-2" id="resCampaignPeriod">Thời gian: --/--/---- đến --/--/----</p>
                                <div class="d-flex justify-content-between small fw-bold mb-1">
                                    <span>Tiến độ tham dự: <span id="resCampaignAttendedText">0/25 buổi</span></span>
                                    <span id="resCampaignRatePercent" class="text-danger">0%</span>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar bg-danger" id="resCampaignProgressBar" role="progressbar" style="width: 0%"></div>
                                </div>
                            </div>

                            <div class="small text-secondary fw-semibold mb-2">Các ngày tham dự gần nhất:</div>
                            <div class="d-flex flex-wrap gap-1 mb-3" id="resCampaignDatesList">
                                <span class="badge bg-light text-muted border">Chưa có ngày tham dự</span>
                            </div>
                        </div>

                        <!-- Thống kê tổng quan cả năm -->
                        <div class="mt-auto border-top pt-3">
                            <div class="row g-2 text-center">
                                <div class="col-6">
                                    <div class="p-2 rounded-3 bg-light border">
                                        <div class="small text-muted">Đi Lễ Năm Nay</div>
                                        <div class="fw-bold fs-6 text-success" id="resTotalMassStat">0 / 0 buổi (0%)</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 rounded-3 bg-light border">
                                        <div class="small text-muted">Đi Học Giáo Lý</div>
                                        <div class="fw-bold fs-6 text-primary" id="resTotalClassStat">0 / 0 buổi (0%)</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PANEL 3: LỊCH SỬ 2 NĂM & BÍ TÍCH (Sub-task 01.2.3) -->
        <div id="panelOptionAcademic" class="staff-option-panel d-none">
            <div class="row g-3">
                <!-- Bảng điểm chi tiết năm hiện hành -->
                <div class="col-12 col-xl-6">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="bi bi-card-checklist text-primary me-1"></i>Bảng Điểm Niên Khóa Hiện Hành
                            </h6>
                            <span class="badge bg-primary-subtle text-primary border" id="resCurGradeCount">0 cột điểm</span>
                        </div>
                        <div class="table-responsive" style="max-height: 250px;">
                            <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th>Cột điểm</th>
                                        <th class="text-center">Hệ số</th>
                                        <th class="text-center">Điểm</th>
                                        <th class="text-center">HK</th>
                                        <th>Ghi chú</th>
                                    </tr>
                                </thead>
                                <tbody id="resCurrentGradesTableBody">
                                    <tr>
                                        <td colspan="5" class="text-center py-3 text-muted">Chưa có cột điểm nào</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Tổng hợp 2 Niên khóa liền kề trước đó (Sub-task 01.2.3) -->
                <div class="col-12 col-xl-6">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="bi bi-clock-history text-warning me-1"></i>Lịch Sử 2 Niên Khóa Liền Kề Trước
                            </h6>
                            <span class="badge bg-warning-subtle text-dark border">ĐTB & Kết quả lên lớp</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle mb-0" style="font-size: 0.85rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th>Niên khóa</th>
                                        <th>Lớp học</th>
                                        <th class="text-center">ĐTB</th>
                                        <th class="text-center">Chuyên cần</th>
                                        <th class="text-center">Kết quả</th>
                                    </tr>
                                </thead>
                                <tbody id="resPastTwoYearsTableBody">
                                    <tr>
                                        <td colspan="5" class="text-center py-3 text-muted">Chưa có lịch sử năm trước</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="small text-muted mt-2">
                            <i class="bi bi-info-circle me-1"></i>Hệ thống tự động tra cứu mã năm cũ từ hồ sơ kết chuyển để kết nối dữ liệu.
                        </div>
                    </div>
                </div>

                <!-- 4 Mốc Bí tích chi tiết -->
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-award-fill text-info"></i>Hồ Sơ Sổ Bộ 4 Mốc Bí Tích
                        </h6>
                        <div class="row g-3" id="resSacramentDetailedCards">
                            <!-- 4 Cards will be injected by JS -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PANEL 4: LIÊN HỆ PHỤ HUYNH -->
        <div id="panelOptionParent" class="staff-option-panel d-none">
            <div class="row g-3">
                <!-- Thông tin liên lạc & Nút gọi/nhắn -->
                <div class="col-12 col-md-5">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                            <i class="bi bi-person-lines-fill text-info me-1"></i>Kênh Liên Hệ Phụ Huynh
                        </h6>

                        <div class="p-3 rounded-4 bg-info bg-opacity-10 border border-info border-opacity-25 mb-3 text-center">
                            <div class="small text-muted mb-1">Số điện thoại Phụ huynh</div>
                            <h3 class="fw-bold text-dark mb-2" id="resParentPhoneLarge">Chưa có SĐT</h3>
                            <div class="d-flex flex-wrap justify-content-center gap-2">
                                <a href="#" id="btnCallParent" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">
                                    <i class="bi bi-telephone-fill me-1"></i> Gọi Điện
                                </a>
