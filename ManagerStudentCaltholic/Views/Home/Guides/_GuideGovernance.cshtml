@model ManagerStudentCaltholic.Models.ViewModels.MasterWorkspaceViewModel

<div class="guide-container shadow-sm p-3 p-md-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 mb-4 border-bottom">
        <div>
            <span class="badge bg-danger-subtle text-danger border rounded-pill px-3 py-1 mb-1">
                <i class="bi bi-shield-lock-fill me-1"></i>Cẩm Nang Điều Hành — Phân Khu 5: Quản Trị & Hệ Thống
            </span>
            <h5 class="fw-bold text-dark mb-0">Hướng Dẫn Phân Tích Executive Dashboard, Quản Lý Nhân Sự & Phân Quyền Master UI</h5>
        </div>
        <div class="d-flex gap-2">
            <a href="/Dashboard/Index" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">
                <i class="bi bi-speedometer2 me-1"></i> Mở Executive Dashboard
            </a>
            @if (User.IsInRole("Admin") || User.IsInRole("ExecutiveBoard"))
            {
                <a href="/FeaturePermissions/Index" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold">
                    <i class="bi bi-sliders2-vertical me-1"></i> Phân Quyền Nút (UI)
                </a>
            }
        </div>
    </div>

    <!-- Hàng chỉ số vận hành nhanh -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="p-3 rounded-4 bg-light border text-center">
                <div class="small text-muted">Tổng Hồ Sơ Thiếu Nhi</div>
                <div class="fs-3 fw-bold text-primary">@Model.TotalStudents</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 rounded-4 bg-light border text-center">
                <div class="small text-muted">Thiếu Nhi Đã Xếp Lớp</div>
                <div class="fs-3 fw-bold text-success">@Model.TotalEnrolled</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 rounded-4 bg-light border text-center">
                <div class="small text-muted">Tổng Số Lớp Hiện Hành</div>
                <div class="fs-3 fw-bold text-info">@Model.TotalClasses</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 rounded-4 bg-light border text-center">
                <div class="small text-muted">Hồ Sơ Tuyển Sinh Chờ Duyệt</div>
                <div class="fs-3 fw-bold text-danger">@Model.PendingRegistrations</div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6 col-xl-3 workspace-searchable-item">
            <div class="guide-step-card">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="step-number-badge bg-primary text-white">01</span>
                        <span class="badge bg-primary-subtle text-primary border">Thống kê Toàn xứ</span>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Executive Dashboard & Heatmap Vắng Lễ</h6>
                    <p class="small text-secondary mb-2">
                        Theo dõi biểu đồ so sánh 4 khối ngành, bản đồ nhiệt (Heatmap) các ngày vắng cao điểm và danh sách thiếu nhi vắng nhiều cần quan tâm mục vụ.
                    </p>
                </div>
                <a href="/Dashboard/Index" class="btn btn-sm btn-outline-primary rounded-pill w-100 fw-semibold">
                    Xem Dashboard <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="col-md-6 col-xl-3 workspace-searchable-item">
            <div class="guide-step-card">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="step-number-badge bg-success text-white">02</span>
                        <span class="badge bg-success-subtle text-success border">Nhân sự Giáo lý viên</span>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Tạo Tài Khoản Hàng Loạt & Bàn Giao Nhiệm Kỳ</h6>
                    <p class="small text-secondary mb-2">
                        Nạp danh sách GLV mới tuyên hứa từ Excel, rà soát khóa tài khoản GLV nghỉ dạy đầu năm và luân chuyển Trưởng khối / Ban Điều Hành.
                    </p>
                </div>
                <div class="d-flex gap-1">
                    <a href="/Users/Index" class="btn btn-sm btn-outline-success rounded-pill w-50 fw-semibold">Tài khoản</a>
                    <a href="/Governance/Index" class="btn btn-sm btn-outline-warning text-dark rounded-pill w-50 fw-semibold">Nhiệm kỳ</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3 workspace-searchable-item">
            <div class="guide-step-card">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="step-number-badge bg-danger text-white">03</span>
                        <span class="badge bg-danger-subtle text-danger border">Master UI Config</span>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Phân Quyền Hiển Thị Nút Chức Năng</h6>
                    <p class="small text-secondary mb-2">
                        Cấu hình bật/tắt từng nút chức năng trên 5 trang Master theo từng Vai trò (Admin, Cha Xứ, BĐH, Trưởng khối, GLV) hoặc giới hạn riêng theo ID lớp.
                    </p>
                </div>
                <a href="/FeaturePermissions/Index" class="btn btn-sm btn-outline-danger rounded-pill w-100 fw-semibold">
                    Cấu hình Phân quyền UI <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="col-md-6 col-xl-3 workspace-searchable-item">
            <div class="guide-step-card">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="step-number-badge bg-dark text-white">04</span>
                        <span class="badge bg-secondary-subtle text-dark border">Hạ tầng & Kiểm toán</span>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">System Health, Audit Logs & Hangfire</h6>
                    <p class="small text-secondary mb-2">
                        Kiểm tra độ trễ PostgreSQL, Redis Cache, RAM, lọc nhật ký lỗi/Audit Log theo thời gian thực và quản lý hàng đợi tác vụ ngầm.
                    </p>
                </div>
                <div class="d-flex gap-1">
                    <a href="/AcademicYears/Index" class="btn btn-sm btn-outline-primary rounded-pill w-50 fw-semibold">Niên khóa</a>
                    <a href="/Admin/Logs" class="btn btn-sm btn-outline-dark rounded-pill w-50 fw-semibold">System Logs</a>
                </div>
            </div>
        </div>
    </div>
</div>