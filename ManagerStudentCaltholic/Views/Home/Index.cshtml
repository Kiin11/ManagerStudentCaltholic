@using ManagerStudentCaltholic.Models.Entities
@{
    ViewData["Title"] = "Bảng Điều Khiển Tổng Quan";
    var yearName = ViewBag.CurrentYearName as string;
    var totalStudents = (int)(ViewBag.TotalStudents ?? 0);
    var totalClasses = (int)(ViewBag.TotalClasses ?? 0);
    var totalEnrolled = (int)(ViewBag.TotalEnrolled ?? 0);
}

<div class="container-fluid px-0">
    <!-- Header Hero Banner -->
    <div class="card border-0 rounded-4 shadow-sm mb-4 text-white overflow-hidden"
         style="background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);">
        <div class="card-body p-4 p-lg-5">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <span class="badge bg-white bg-opacity-25 rounded-pill px-3 py-1 mb-2">
                        <i class="bi bi-calendar-event me-1"></i> Niên Khóa: @yearName
                    </span>
                    <h2 class="fw-bold mb-2">Gia Đình Giáo Lý</h2>
                    <p class="text-white-50 mb-4 fs-6">
                        Chào mừng bạn đến với Hệ Thống Quản Lý Giáo Lý. Theo dõi sĩ số, cập nhật điểm danh và phân công lớp học trực quan theo thời gian thực.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Attendance" asp-action="ScanQr" class="btn btn-warning text-dark fw-bold rounded-pill px-4 shadow-sm">
                                <i class="bi bi-qr-code-scan me-1"></i> Quét QR Check-in
                            </a>
                            <a asp-controller="Attendance" asp-action="Index" class="btn btn-outline-light rounded-pill px-4">
                                <i class="bi bi-card-checklist me-1"></i> Mở Sổ Điểm Danh
                            </a>
                        }
                        <a asp-controller="Lookup" asp-action="Index" class="btn btn-light text-primary fw-bold rounded-pill px-4 shadow-sm">
                            <i class="bi bi-search me-1"></i> Tra Cứu Qua Code
                        </a>
                    </div>
                </div>
                <div class="col-lg-4 d-none d-lg-flex justify-content-end">
                    <i class="bi bi-mortarboard-fill display-1 text-white opacity-25"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Hàng Thẻ Thống Kê KPI -->
    <div class="row g-3 mb-4">
        <!-- Tổng hồ sơ thiếu nhi -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 shadow-sm h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center"
                             style="width: 48px; height: 48px;">
                            <i class="bi bi-people-fill fs-4"></i>
                        </div>
                        <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1 small">Đang kích hoạt</span>
                    </div>
                    <div class="text-muted small fw-semibold">Tổng Hồ Sơ Thiếu Nhi</div>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@totalStudents</h3>
                </div>
            </div>
        </div>

        <!-- Đã xếp lớp niên khóa này -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 shadow-sm h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="rounded-3 bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center"
                             style="width: 48px; height: 48px;">
                            <i class="bi bi-person-check-fill fs-4"></i>
                        </div>
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-1 small">Niên khóa này</span>
                    </div>
                    <div class="text-muted small fw-semibold">Thiếu Nhi Đã Xếp Lớp</div>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@totalEnrolled</h3>
                </div>
            </div>
        </div>

        <!-- Tổng số lớp giáo lý -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 shadow-sm h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="rounded-3 bg-info bg-opacity-10 text-info d-flex align-items-center justify-content-center"
                             style="width: 48px; height: 48px;">
                            <i class="bi bi-building fs-4 text-info"></i>
                        </div>
                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1 small">4 Cấp ngành</span>
                    </div>
                    <div class="text-muted small fw-semibold">Lớp Giáo Lý Hoạt Động</div>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@totalClasses</h3>
                </div>
            </div>
        </div>

        <!-- THẺ THAY THẾ: CỔNG TRA CỨU ĐIỂM & ĐIỂM DANH QUA MÃ CODE -->
        <div class="col-12 col-sm-6 col-xl-3">
            <a asp-controller="Lookup" asp-action="Index" class="card border-0 rounded-4 shadow-sm h-100 bg-white text-decoration-none hover-shadow transition">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="rounded-3 bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center"
                             style="width: 48px; height: 48px;">
                            <i class="bi bi-search-heart fs-4 text-warning"></i>
                        </div>
                        <span class="badge bg-warning-subtle text-dark border rounded-pill px-2 py-1 small">Tra cứu nhanh</span>
                    </div>
                    <div class="text-muted small fw-semibold">Cổng Tra Cứu Thiếu Nhi</div>
                    <div class="d-flex align-items-center justify-content-between mt-2">
                        <span class="fw-bold text-primary fs-6">Xem Điểm & Chuyên Cần</span>
                        <i class="bi bi-arrow-right-circle text-primary fs-5"></i>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Phím tắt nghiệp vụ thường dùng -->
    <div class="card border-0 rounded-4 shadow-sm">
        <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-lightning-charge-fill text-warning me-2"></i>Thao Tác Thường Dùng
            </h5>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <a asp-controller="Classes" asp-action="Index" class="card border p-3 rounded-3 text-decoration-none h-100 hover-shadow transition">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-primary text-white p-3 rounded-3">
                                <i class="bi bi-mortarboard fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-1">Quản Lý Lớp Học</h6>
                                <small class="text-muted">Phân công GLV, xem danh sách lớp và xuất file in.</small>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-12 col-md-4">
                    <a asp-controller="Students" asp-action="Index" class="card border p-3 rounded-3 text-decoration-none h-100 hover-shadow transition">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-success text-white p-3 rounded-3">
                                <i class="bi bi-people fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-1">Hồ Sơ Thiếu Nhi</h6>
                                <small class="text-muted">Tra cứu lý lịch bí tích, nạp danh sách Excel hàng loạt.</small>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-12 col-md-4">
                    <a asp-controller="Attendance" asp-action="Statistics" class="card border p-3 rounded-3 text-decoration-none h-100 hover-shadow transition">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-info text-white p-3 rounded-3">
                                <i class="bi bi-bar-chart-line fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-1">Báo Cáo Chuyên Cần</h6>
                                <small class="text-muted">Xem tỷ lệ tham dự Thánh Lễ và Giờ học Giáo lý.</small>
                            </div>
                        </div>
                    </a>
                </div>
                @if (User.IsInRole(UserRole.Admin))
                {
                    <div class="col-12 col-md-4">
                        <a href="/Admin/Logs" class="card border p-3 rounded-3 text-decoration-none h-100 hover-shadow transition">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-danger text-white p-3 rounded-3">
                                    <i class="bi bi-terminal fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">Nhật Ký Hệ Thống</h6>
                                    <small class="text-muted">Đọc và lọc file Serilog, theo dõi ngoại lệ và lỗi máy chủ.</small>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>