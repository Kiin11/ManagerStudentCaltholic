@model ManagerStudentCaltholic.Models.ViewModels.MasterWorkspaceViewModel
@{
    ViewData["Title"] = "Không Gian Giáo Lý & Cổng Thông Tin";
    var activeMaster = Model.Masters.FirstOrDefault(m => m.MasterCode == Model.ActiveMasterCode)
                       ?? Model.Masters.FirstOrDefault();
    var deviceCtx = Model.DeviceStudentContext;
}

<style>
    .master-pill-nav .nav-link {
        border-radius: 999px;
        padding: 0.55rem 1.2rem;
        font-weight: 700;
        font-size: 0.9rem;
        color: #475569;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        transition: all 0.2s ease;
    }

        .master-pill-nav .nav-link:hover {
            border-color: #93c5fd;
            color: #1e40af;
            transform: translateY(-1px);
        }

        .master-pill-nav .nav-link.active {
            background: linear-gradient(135deg, #1e40af 0%, #2563eb 100%);
            color: #ffffff;
            border-color: transparent;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }

    .feature-action-card {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        transition: all 0.2s ease;
        text-decoration: none;
        background: #ffffff;
    }

        .feature-action-card:hover {
            transform: translateY(-4px);
            border-color: #93c5fd;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08) !important;
        }
</style>

<div class="container-fluid px-0">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 1. HERO BANNER & THÔNG TIN VAI TRÒ / NIÊN KHÓA -->
    <div class="card border-0 rounded-4 shadow-sm mb-4 text-white overflow-hidden"
         style="background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);">
        <div class="card-body p-4">
            <div class="row align-items-center g-3">
                <div class="col-lg-8">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="badge bg-white bg-opacity-25 rounded-pill px-3 py-1">
                            <i class="bi bi-calendar-event me-1"></i>Niên Khóa: @Model.CurrentAcademicYearName
                        </span>
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1 fw-bold">
                            <i class="bi bi-person-check-fill me-1"></i>@Model.CurrentUserRoleDisplay: @Model.CurrentUserFullName
                        </span>
                        @if (Model.AssignedClassNames.Any())
                        {
                            <span class="badge bg-info text-dark rounded-pill px-3 py-1 fw-semibold">
                                Phụ trách: @string.Join(", ", Model.AssignedClassNames)
                            </span>
                        }
                    </div>
                    <h3 class="fw-bold mb-1">Gia Đình Giáo Lý Giáo Xứ Phú Trung</h3>
                    <p class="text-white-50 mb-0 small">
                        Chọn phân khu trên thanh <strong>Master Taskbar</strong> bên dưới để truy cập nhanh các công cụ điểm danh, sổ điểm, xét duyệt Bí tích hoặc xem thông báo lớp học.
                    </p>
                </div>
                <div class="col-lg-4 d-flex flex-wrap justify-content-lg-end gap-2">
                    <a asp-controller="Lookup" asp-action="Index" class="btn btn-warning text-dark fw-bold rounded-pill px-3 shadow-sm">
                        <i class="bi bi-search me-1"></i> Tra Cứu Thiếu Nhi
                    </a>
                    @if (!Model.IsAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-light text-primary fw-bold rounded-pill px-3 shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập GLV
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Attendance" asp-action="ScanQr" class="btn btn-light text-primary fw-bold rounded-pill px-3 shadow-sm">
                            <i class="bi bi-qr-code-scan me-1"></i> Quét QR Ngay
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 2. THANH MASTER TASKBAR (5 PHÂN KHU NGHIỆP VỤ - FEAT-P4-06) -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
        <ul class="nav master-pill-nav gap-2">
            @foreach (var tab in Model.Masters)
            {
                <li class="nav-item">
                    <a class="nav-link @(tab.MasterCode == Model.ActiveMasterCode ? "active" : "")"
                       asp-controller="Home" asp-action="Index" asp-route-master="@tab.MasterCode">
                        <i class="bi @tab.IconClass me-1"></i>@tab.Title
                        <span class="badge @(tab.MasterCode == Model.ActiveMasterCode ? "bg-white text-primary" : "bg-light text-secondary border") rounded-pill ms-1">
                            @tab.Features.Count
                        </span>
                    </a>
                </li>
            }
        </ul>

        @if (User.IsInRole("Admin") || User.IsInRole("ExecutiveBoard"))
        {
            <a asp-controller="FeaturePermissions" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-sliders2-vertical me-1"></i> Phân quyền nút chức năng
            </a>
        }
    </div>

    <!-- 3. WIDGET NHẬN DIỆN THIẾU NHI TRÊN THIẾT BỊ & THÔNG BÁO RIÊNG CỦA LỚP (FEAT-P4-07) -->
    @if (deviceCtx != null && deviceCtx.HasRememberedStudents)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-primary">
            <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom">
                <div>
                    <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-1 mb-1">
                        <i class="bi bi-phone-vibrate-fill me-1"></i>Thiết Bị Đã Ghi Nhớ Hồ Sơ Thiếu Nhi
                    </span>
                    <h5 class="fw-bold text-dark mb-0">Thông Báo &amp; Dặn Dò Riêng Của Lớp Học</h5>
                </div>
                <form asp-controller="Home" asp-action="DetachRememberedStudent" method="post" class="m-0"
                      onsubmit="return confirm('Bạn muốn gỡ toàn bộ thiếu nhi đã ghi nhớ trên thiết bị này?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                        <i class="bi bi-link-45deg me-1"></i> Gỡ Ghi Nhớ Thiết Bị (Detach All)
                    </button>
                </form>
            </div>

            <div class="card-body p-3 p-md-4">
                <!-- Thanh chọn nhanh các thiếu nhi đã lưu trên máy (Student Switcher) -->
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3 pb-3 border-bottom">
                    <span class="small fw-bold text-secondary me-1">Thiếu nhi đã lưu:</span>
                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 student-filter-chip active"
                            onclick="filterDeviceClassAnnouncements(0, this)">
                        Tất cả (@deviceCtx.RememberedStudents.Count em)
                    </button>

                    @foreach (var stu in deviceCtx.RememberedStudents)
                    {
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-primary rounded-start-pill px-3 student-filter-chip"
                                    onclick="filterDeviceClassAnnouncements(@stu.ClassRoomId, this)">
                                <i class="bi bi-person-badge me-1"></i>@stu.ChristianName @stu.FullName
                                <span class="badge bg-primary-subtle text-primary ms-1">@stu.ClassName</span>
                            </button>
                            <a asp-controller="Lookup" asp-action="QuickView" asp-route-studentCode="@stu.StudentCode"
                               class="btn btn-outline-success px-2" title="Xem nhanh Điểm danh & Bảng điểm (1-Chạm)">
                                <i class="bi bi-box-arrow-up-right"></i> Xem KQ
                            </a>
                            <form asp-controller="Home" asp-action="DetachRememberedStudent" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="studentCode" value="@stu.StudentCode" />
                                <button type="submit" class="btn btn-outline-danger rounded-end-pill px-2" title="Gỡ bé này khỏi thiết bị">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>

                <!-- Danh sách Thông báo của Lớp & Khối tương ứng -->
                @if (deviceCtx.ClassAnnouncements.Any())
                {
                    <div class="row g-3" id="deviceAnnouncementsGrid">
                        @foreach (var ann in deviceCtx.ClassAnnouncements)
                        {
                            <div class="col-md-6 device-ann-card" data-class-id="@(ann.TargetClassRoomId ?? 0)">
                                <div class="p-3 rounded-4 border h-100 @(ann.IsPinned ? "bg-warning-subtle border-warning" : "bg-light-subtle")">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center gap-1">
                                            @if (ann.IsPinned)
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-pin-angle-fill me-1"></i>Ghim</span>
                                            }
                                            <span class="badge bg-primary">@ann.TargetDisplayBadge</span>
                                        </div>
                                        <small class="text-muted">@ann.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-1">@ann.Title</h6>
                                    <p class="small text-secondary mb-2" style="white-space: pre-line;">@ann.Content</p>
                                    <div class="small text-muted border-top pt-1">
                                        <i class="bi bi-person-check me-1"></i>Đăng bởi: <strong>@ann.AuthorName</strong>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-3 text-muted small">
                        <i class="bi bi-check2-circle text-success me-1"></i>Hiện tại lớp của thiếu nhi chưa có thông báo hoặc dặn dò mới trong tuần này.
                    </div>
                }
            </div>
        </div>
    }

    <!-- 4. LƯỚI CÁC NÚT CHỨC NĂNG THUỘC MASTER TAB ĐANG CHỌN (FEAT-P4-06) -->
    @if (activeMaster != null)
    {
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi @activeMaster.IconClass text-primary me-2"></i>@activeMaster.Title
                    </h5>
                    <small class="text-muted">@activeMaster.Description</small>
                </div>
            </div>

            <div class="row g-3">
                @foreach (var feat in activeMaster.Features)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <a href="@feat.TargetUrl" class="card feature-action-card shadow-sm h-100 p-3">
                            <div class="d-flex align-items-start gap-3">
                                <div class="rounded-4 bg-@feat.BadgeColor bg-opacity-10 text-@feat.BadgeColor d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width: 54px; height: 54px; font-size: 1.5rem;">
                                    <i class="bi @feat.IconClass"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h6 class="fw-bold text-dark mb-1">@feat.DisplayName</h6>
                                        <i class="bi bi-arrow-up-right-circle text-secondary"></i>
                                    </div>
                                    <p class="text-muted small mb-0">@feat.Description</p>
                                    @if (feat.SacramentClassesOnly)
                                    {
                                        <span class="badge bg-warning-subtle text-dark border mt-2" style="font-size: 0.7rem;">
                                            Dành cho lớp Bí tích (RL2, TS3, BĐ3, DB4)
                                        </span>
                                    }
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    }

    <!-- 5. THỐNG KÊ KPI NHANH (DÀNH CHO GIÁO LÝ VIÊN ĐÃ ĐĂNG NHẬP) & BẢNG TIN CHUNG TOÀN XỨ -->
    <div class="row g-4">
        @if (Model.IsAuthenticated)
        {
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-bar-chart-steps text-primary me-2"></i>Chỉ Số Vận Hành Niên Khóa @Model.CurrentAcademicYearName
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="p-3 rounded-3 bg-light border text-center">
                                    <div class="small text-muted">Tổng Thiếu Nhi</div>
                                    <div class="fs-3 fw-bold text-primary">@Model.TotalStudents</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 rounded-3 bg-light border text-center">
                                    <div class="small text-muted">Đã Xếp Lớp</div>
                                    <div class="fs-3 fw-bold text-success">@Model.TotalEnrolled</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 rounded-3 bg-light border text-center">
                                    <div class="small text-muted">Lớp Hoạt Động</div>
                                    <div class="fs-3 fw-bold text-info">@Model.TotalClasses</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 rounded-3 bg-light border text-center">
                                    <div class="small text-muted">Đơn Tuyển Sinh Chờ</div>
                                    <div class="fs-3 fw-bold text-danger">@Model.PendingRegistrations</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="@(Model.IsAuthenticated ? "col-lg-7" : "col-12")">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-megaphone-fill text-warning me-2"></i>Thông Báo Chung Toàn Giáo Xứ
                    </h6>
                    <a asp-controller="Announcements" asp-action="Index" class="btn btn-link btn-sm text-decoration-none p-0">
                        Xem tất cả <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <div class="card-body p-3">
                    @if (Model.PinAnnouncements.Any())
                    {
                        <div class="list-group list-group-flush small">
                            @foreach (var post in Model.PinAnnouncements)
                            {
                                <div class="list-group-item px-0 py-2">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div class="fw-bold text-dark">
                                            @if (post.IsPinned)
                                            {
                                                <i class="bi bi-pin-angle-fill text-warning me-1"></i>
                                            }
                                            @post.Title
                                        </div>
                                        <small class="text-muted">@post.CreatedAt.AddHours(7).ToString("dd/MM/yyyy")</small>
                                    </div>
                                    <div class="text-secondary text-break">@post.Content</div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">
                            Chưa có thông báo chung nào được ghim.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterDeviceClassAnnouncements(classId, btn) {
            document.querySelectorAll('.student-filter-chip').forEach(b => {
                b.classList.remove('btn-primary', 'active');
                b.classList.add('btn-outline-primary');
            });
            btn.classList.remove('btn-outline-primary');
            btn.classList.add('btn-primary', 'active');

            document.querySelectorAll('#deviceAnnouncementsGrid .device-ann-card').forEach(card => {
                const targetClassId = parseInt(card.getAttribute('data-class-id')) || 0;
                if (classId === 0 || targetClassId === 0 || targetClassId === classId) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>
}