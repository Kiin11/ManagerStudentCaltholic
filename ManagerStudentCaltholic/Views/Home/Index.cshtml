@model ManagerStudentCaltholic.Models.ViewModels.MasterWorkspaceViewModel
@{
    var activeMaster = Model.Masters.FirstOrDefault(m => m.MasterCode == Model.ActiveMasterCode)
                       ?? Model.Masters.FirstOrDefault();
    ViewData["Title"] = activeMaster != null ? activeMaster.Title : "Không Gian Giáo Lý";
    var deviceCtx = Model.DeviceStudentContext;

    string guidePartialPath = Model.ActiveMasterCode switch
    {
        "ATTENDANCE" => "~/Views/Home/Guides/_GuideAttendance.cshtml",
        "ACADEMIC" => "~/Views/Home/Guides/_GuideAcademic.cshtml",
        "SACRAMENT" => "~/Views/Home/Guides/_GuideSacrament.cshtml",
        "GOVERNANCE" => "~/Views/Home/Guides/_GuideGovernance.cshtml",
        _ => "~/Views/Home/Guides/_GuideCommon.cshtml"
    };
}

<style>
    /* Header phân khu hiện đại, gọn gàng */
    .workspace-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e40af 100%);
        border-radius: 20px;
        position: relative;
        overflow: hidden;
    }

        .workspace-hero::after {
            content: '';
            position: absolute;
            right: -40px;
            bottom: -60px;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.06);
            pointer-events: none;
        }

    /* Thẻ chức năng Quick-Launch */
    .feature-launch-card {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none;
        position: relative;
    }

        .feature-launch-card:hover {
            transform: translateY(-4px);
            border-color: #3b82f6;
            box-shadow: 0 12px 24px -6px rgba(30, 64, 175, 0.14) !important;
        }

        .feature-launch-card .launch-arrow {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #f1f5f9;
            color: #475569;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }

        .feature-launch-card:hover .launch-arrow {
            background: #2563eb;
            color: #ffffff;
            transform: translateX(2px);
        }

    /* Giao diện Cẩm nang Hướng dẫn chi tiết dùng chung cho 5 file _Guide */
    .guide-container {
        border-radius: 20px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
    }

    .guide-step-card {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        padding: 1.25rem;
        height: 100%;
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .guide-step-card:hover {
            background: #ffffff;
            border-color: #cbd5e1;
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
        }

    .step-number-badge {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        font-weight: 800;
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .guide-tip-box {
        border-radius: 14px;
        background: linear-gradient(90deg, #eff6ff 0%, #f8fafc 100%);
        border-left: 4px solid #2563eb;
        padding: 1rem 1.25rem;
    }
</style>

<div class="container-fluid px-0">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 1. HEADER PHÂN KHU HIỆN ĐẠI (KHÔNG LẶP LẠI NÚT CỦA TOPBAR) -->
    <div class="workspace-hero shadow-sm text-white p-3 p-md-4 mb-4">
        <div class="row align-items-center g-3">
            <div class="col-lg-7">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge bg-black bg-opacity-15 border border-white border-opacity-25 rounded-pill px-3 py-1">
                        <i class="bi bi-calendar3 me-1"></i>Niên khóa: @Model.CurrentAcademicYearName
                    </span>
                    <span class="badge bg-warning text-dark rounded-pill px-3 py-1 fw-bold">
                        <i class="bi bi-shield-check me-1"></i>@Model.CurrentUserRoleDisplay
                    </span>
                    @if (Model.AssignedClassNames.Any())
                    {
                        <span class="badge bg-info text-dark rounded-pill px-3 py-1 fw-semibold">
                            <i class="bi bi-door-open-fill me-1"></i>@string.Join(", ", Model.AssignedClassNames)
                        </span>
                    }
                </div>
                <h4 class="fw-bold mb-1 d-flex align-items-center">
                    <i class="bi @(activeMaster?.IconClass ?? "bi-grid-fill") text-warning me-2"></i>
                    <span>@(activeMaster?.Title ?? "Không Gian Giáo Lý Giáo Xứ Phú Trung")</span>
                </h4>
                <p class="text-white-50 mb-0 small">
                    @(activeMaster?.Description ?? "Chọn chức năng bên dưới hoặc xem quy trình hướng dẫn chi tiết cho từng nghiệp vụ.")
                </p>
            </div>

            <!-- Ô tìm kiếm nhanh chức năng & nút cấu hình phân quyền -->
            <div class="col-lg-5">
                <div class="d-flex flex-wrap justify-content-lg-end align-items-center gap-2">
                    <div class="input-group input-group-sm" style="max-width: 280px;">
                        <span class="input-group-text bg-white border-0 text-secondary">
                            <i class="bi bi-filter"></i>
                        </span>
                        <input type="text" id="quickFilterWorkspaceInput" class="form-control border-0"
                               placeholder="Lọc nhanh công cụ & hướng dẫn..."
                               onkeyup="filterWorkspaceContent(this.value)" />
                    </div>

                    @if (User.IsInRole("Admin") || User.IsInRole("ExecutiveBoard"))
                    {
                        <a asp-controller="FeaturePermissions" asp-action="Index"
                           class="btn btn-outline-light btn-sm rounded-pill px-3 fw-semibold"
                           title="Cấu hình ẩn/hiện các nút chức năng theo vai trò">
                            <i class="bi bi-sliders2-vertical me-1"></i> Phân quyền nút
                        </a>
                    }

                    @if (Model.IsAuthenticated || Context.Request.Cookies.ContainsKey("Parish_Staff_Device"))
                    {
                        <a asp-controller="Attendance" asp-action="ScanQr"
                           class="btn btn-warning text-dark btn-sm rounded-pill px-3 fw-bold shadow-sm">
                            <i class="bi bi-qr-code-scan me-1"></i> Quét QR Điểm Danh
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- FEAT-P5-01: CỔNG TRA CỨU THIẾU NHI NỘI BỘ DÀNH CHO GLV / BAN ĐIỀU HÀNH (Chỉ hiển thị tại Tab Chung) -->
    @if (User.Identity?.IsAuthenticated == true && (activeMaster?.MasterCode == "COMMON" || string.IsNullOrEmpty(Model.ActiveMasterCode)))
    {
        @await Html.PartialAsync("_StaffStudentLookupWidget", Model)
    }

    <!-- 2. BÀN LÀM VIỆC NHANH: CÁC TÁC VỤ THUỘC PHÂN KHU MASTER ĐANG CHỌN TRÊN TOPBAR -->
    @if (activeMaster != null && activeMaster.Features.Any())
    {
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-uppercase text-secondary mb-0" style="letter-spacing: 0.04em; font-size: 0.8rem;">
                    <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Công Cụ Tác Nghiệp Nhanh (@activeMaster.Features.Count chức năng)
                </h6>
                <small class="text-muted d-none d-sm-inline">Bấm vào thẻ bất kỳ để mở trực tiếp chức năng</small>
            </div>

            <div class="row g-3" id="workspaceFeatureGrid">
                @foreach (var feat in activeMaster.Features)
                {
                    <div class="col-12 col-md-6 col-xl-4 workspace-searchable-item">
                        <a href="@feat.TargetUrl" class="card feature-launch-card shadow-sm h-100 p-3">
                            <div class="d-flex align-items-start gap-3">
                                <div class="rounded-4 bg-@feat.BadgeColor bg-opacity-10 text-@feat.BadgeColor d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width: 50px; height: 50px; font-size: 1.4rem;">
                                    <i class="bi @feat.IconClass"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <h6 class="fw-bold text-dark mb-1">@feat.DisplayName</h6>
                                        <span class="launch-arrow flex-shrink-0">
                                            <i class="bi bi-arrow-right-short fs-5"></i>
                                        </span>
                                    </div>
                                    <p class="text-muted small mb-0">@feat.Description</p>
                                    @if (feat.SacramentClassesOnly)
                                    {
                                        <span class="badge bg-warning-subtle text-dark border mt-2" style="font-size: 0.68rem;">
                                            <i class="bi bi-stars me-1"></i>Lớp Bí tích (RL2, TS3, BĐ3, DB4)
                                        </span>
                                    }
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    }

    <!-- 3. WIDGET NHẬN DIỆN THIẾU NHI TRÊN THIẾT BỊ & THÔNG BÁO LỚP (FEAT-P4-07) -->
    @if (Model.ActiveMasterCode == "COMMON" && deviceCtx != null && deviceCtx.HasRememberedStudents)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-primary">
            <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom">
                <div>
                    <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-1 mb-1">
                        <i class="bi bi-phone-vibrate-fill me-1"></i>Thiết Bị Đã Ghi Nhớ Hồ Sơ Thiếu Nhi
                    </span>
                    <h5 class="fw-bold text-dark mb-0">Thông Báo & Dặn Dò Riêng Của Lớp Học</h5>
                </div>
                <form asp-controller="Home" asp-action="DetachRememberedStudent" method="post" class="m-0"
                      onsubmit="return confirm('Bạn muốn gỡ toàn bộ thiếu nhi đã ghi nhớ trên thiết bị này?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                        <i class="bi bi-link-45deg me-1"></i> Gỡ Ghi Nhớ Thiết Bị
                    </button>
                </form>
            </div>

            <div class="card-body p-3 p-md-4">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3 pb-3 border-bottom">
                    <span class="small fw-bold text-secondary me-1">Thiếu nhi đã lưu:</span>
                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 student-filter-chip active"
                            onclick="filterDeviceClassAnnouncements(0, this)">
                        Tất cả (@deviceCtx.RememberedStudents.Count em)
                    </button>

                    @foreach (var stu in deviceCtx.RememberedStudents)
                    {
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-primary rounded-start-pill px-3 student-filter-chip"
                                    onclick="filterDeviceClassAnnouncements(@stu.ClassRoomId, this)">
                                <i class="bi bi-person-badge me-1"></i>@stu.ChristianName @stu.FullName
                                <span class="badge bg-primary-subtle text-primary ms-1">@stu.ClassName</span>
                            </button>
                            <a asp-controller="Lookup" asp-action="QuickView" asp-route-studentCode="@stu.StudentCode"
                               class="btn btn-outline-success px-2" title="Xem nhanh Điểm danh & Bảng điểm (1-Chạm)">
                                <i class="bi bi-box-arrow-up-right"></i> Xem KQ
                            </a>
                            <form asp-controller="Home" asp-action="DetachRememberedStudent" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="studentCode" value="@stu.StudentCode" />
                                <button type="submit" class="btn btn-outline-danger rounded-end-pill px-2" title="Gỡ bé này khỏi thiết bị">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>

                @if (deviceCtx.ClassAnnouncements.Any())
                {
                    <div class="row g-3" id="deviceAnnouncementsGrid">
                        @foreach (var ann in deviceCtx.ClassAnnouncements)
                        {
                            <div class="col-md-6 device-ann-card" data-class-id="@(ann.TargetClassRoomId ?? 0)">
                                <div class="p-3 rounded-4 border h-100 @(ann.IsPinned ? "bg-warning-subtle border-warning" : "bg-light-subtle")">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center gap-1">
                                            @if (ann.IsPinned)
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-pin-angle-fill me-1"></i>Ghim</span>
                                            }
                                            <span class="badge bg-primary">@ann.TargetDisplayBadge</span>
                                        </div>
                                        <small class="text-muted">@ann.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-1">@ann.Title</h6>
                                    <p class="small text-secondary mb-2" style="white-space: pre-line;">@ann.Content</p>
                                    <div class="small text-muted border-top pt-1">
                                        <i class="bi bi-person-check me-1"></i>Đăng bởi: <strong>@ann.AuthorName</strong>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-3 text-muted small">
                        <i class="bi bi-check2-circle text-success me-1"></i>Hiện tại lớp của thiếu nhi chưa có thông báo hoặc dặn dò mới.
                    </div>
                }
            </div>
        </div>
    }

    <!-- 4. GIAO DIỆN CẨM NANG HƯỚNG DẪN CHI TIẾT THEO TỪNG PHÂN KHU MASTER -->
    <div id="workspaceGuideSection">
        @await Html.PartialAsync(guidePartialPath, Model)
    </div>
</div>

@section Scripts {
    <script>
        function filterDeviceClassAnnouncements(classId, btn) {
            document.querySelectorAll('.student-filter-chip').forEach(b => {
                b.classList.remove('btn-primary', 'active');
                b.classList.add('btn-outline-primary');
            });
            btn.classList.remove('btn-outline-primary');
            btn.classList.add('btn-primary', 'active');

            document.querySelectorAll('#deviceAnnouncementsGrid .device-ann-card').forEach(card => {
                const targetClassId = parseInt(card.getAttribute('data-class-id')) || 0;
                if (classId === 0 || targetClassId === 0 || targetClassId === classId) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function filterWorkspaceContent(keyword) {
            const kw = (keyword || '').trim().toLowerCase();
            document.querySelectorAll('.workspace-searchable-item').forEach(item => {
                const text = item.innerText.toLowerCase();
                item.style.display = (!kw || text.includes(kw)) ? '' : 'none';
            });
        }
    </script>
    <script src="~/js/staff-student-lookup.js" asp-append-version="true"></script>
}
