@{
    ViewData["Title"] = "Cổng Thông Tin Giáo Lý";
    var yearName = ViewBag.CurrentYearName as string ?? "2026-2027";
    var totalStudents = (int)(ViewBag.TotalStudents ?? 0);
    var totalClasses = (int)(ViewBag.TotalClasses ?? 0);
    var totalEnrolled = (int)(ViewBag.TotalEnrolled ?? 0);
    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
}

<div class="container-fluid px-0">
    <!-- 1. HERO BANNER CHÍNH -->
    <div class="card border-0 rounded-4 shadow-sm mb-4 text-white overflow-hidden"
         style="background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);">
        <div class="card-body p-4 p-lg-5">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <span class="badge bg-white bg-opacity-25 rounded-pill px-3 py-1 mb-2">
                        <i class="bi bi-calendar-event me-1"></i> Niên Khóa: @yearName
                    </span>
                    <h2 class="fw-bold mb-2">Gia Đình Giáo Lý Phú Trung</h2>
                    <p class="text-white-50 mb-4 fs-6">
                        Hệ thống thông tin và quản lý giáo lý xứ đoàn. Tra cứu nhanh kết quả học tập, chuyên cần Thánh Lễ và theo dõi sinh hoạt thiếu nhi.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Announcements" asp-action="Index" class="btn btn-outline-light rounded-pill px-4">
                            <i class="bi bi-megaphone-fill me-1"></i> Xem Bảng Tin & Thông Báo
                        </a>
                        @if (!isAuthenticated)
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-light text-primary fw-bold rounded-pill px-4 ms-lg-2">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập GLV
                            </a>
                        }
                        @if(isAuthenticated)
                        {
                            <a asp-controller="Attendance" asp-action="ScanQr" class="btn btn-light text-primary fw-bold rounded-pill px-4 ms-lg-2">
                                <i class="bi bi-card-checklist"></i> Quét QR Điểm Danh
                            </a>
                        }
                    </div>
                </div>
                <div class="col-lg-4 d-none d-lg-flex justify-content-end">
                    <i class="bi bi-mortarboard-fill display-1 text-white opacity-25"></i>
                </div>
            </div>
        </div>
    </div>

    @if (isAuthenticated)
    {
        <!-- ======================================================= -->
        <!-- GIAO DIỆN KHI ĐÃ ĐĂNG NHẬP (BẢNG ĐIỀU KHIỂN NỘI BỘ GLV)  -->
        <!-- ======================================================= -->
        <!-- Hàng Thẻ Thống Kê KPI Nội Bộ -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 rounded-4 shadow-sm h-100">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="bi bi-people-fill fs-4"></i>
                            </div>
                            <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1 small">Đang kích hoạt</span>
                        </div>
                        <div class="text-muted small fw-semibold">Tổng Hồ Sơ Thiếu Nhi</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@totalStudents</h3>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 rounded-4 shadow-sm h-100">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="rounded-3 bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="bi bi-person-check-fill fs-4"></i>
                            </div>
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-1 small">Niên khóa này</span>
                        </div>
                        <div class="text-muted small fw-semibold">Thiếu Nhi Đã Xếp Lớp</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@totalEnrolled</h3>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 rounded-4 shadow-sm h-100">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="rounded-3 bg-info bg-opacity-10 text-info d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="bi bi-building fs-4 text-info"></i>
                            </div>
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1 small">4 Cấp ngành</span>
                        </div>
                        <div class="text-muted small fw-semibold">Lớp Giáo Lý Hoạt Động</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@totalClasses</h3>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 rounded-4 shadow-sm h-100 bg-white" onclick="openLookupModal()" style="cursor: pointer;">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="rounded-3 bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="bi bi-search-heart fs-4 text-warning"></i>
                            </div>
                            <span class="badge bg-warning-subtle text-dark border rounded-pill px-2 py-1 small">Tra cứu nhanh</span>
                        </div>
                        <div class="text-muted small fw-semibold">Cổng Tra Cứu Thiếu Nhi</div>
                        <div class="d-flex align-items-center justify-content-between mt-2">
                            <span class="fw-bold text-primary fs-6">Xem Điểm & Chuyên Cần</span>
                            <i class="bi bi-arrow-right-circle text-primary fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thao Tác Thường Dùng Cho Giáo Lý Viên -->
        <div class="card border-0 rounded-4 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-lightning-charge-fill text-warning me-2"></i>Thao Tác Thường Dùng
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <a asp-controller="Classes" asp-action="Index" class="card border p-3 rounded-3 text-decoration-none h-100 hover-shadow transition">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary text-white p-3 rounded-3">
                                    <i class="bi bi-mortarboard fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">Quản Lý Lớp Học</h6>
                                    <small class="text-muted">Phân công GLV, xem danh sách lớp và xuất file in.</small>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-12 col-md-4">
                        <a asp-controller="Students" asp-action="Index" class="card border p-3 rounded-3 text-decoration-none h-100 hover-shadow transition">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-success text-white p-3 rounded-3">
                                    <i class="bi bi-people fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">Hồ Sơ Thiếu Nhi</h6>
                                    <small class="text-muted">Tra cứu lý lịch bí tích, nạp danh sách Excel hàng loạt.</small>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-12 col-md-4">
                        <a asp-controller="Attendance" asp-action="Statistics" class="card border p-3 rounded-3 text-decoration-none h-100 hover-shadow transition">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-info text-white p-3 rounded-3">
                                    <i class="bi bi-bar-chart-line fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">Báo Cáo Chuyên Cần</h6>
                                    <small class="text-muted">Xem tỷ lệ tham dự Thánh Lễ và Giờ học Giáo lý.</small>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ======================================================= -->
        <!-- GIAO DIỆN KHI CHƯA ĐĂNG NHẬP (DÀNH CHO PHỤ HUYNH / KHÁCH)-->
        <!-- ======================================================= -->
        <div class="row g-4">
            <!-- Khối 1: Hướng dẫn & Tra cứu nhanh -->
            <div class="col-12 col-lg-8">
                <div class="card border-0 rounded-4 shadow-sm p-4 h-100 bg-white">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3">
                            <i class="bi bi-qr-code-scan fs-3"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-1">Cổng Tra Cứu Sổ Điểm & Chuyên Cần Trực Tuyến</h5>
                            <p class="text-muted small mb-0">Dành cho Phụ huynh và Đoàn sinh Thiếu Nhi Thánh Thể</p>
                        </div>
                    </div>
                    <p class="text-secondary small">
                        Quý phụ huynh có thể tra cứu nhanh tình hình tham dự Thánh Lễ Chúa Nhật, chuyên cần giờ học giáo lý và điểm kiểm tra định kỳ của con em bằng <strong>Mã Định Danh Thiếu Nhi</strong> được in trên thẻ hoặc phiếu liên lạc.
                    </p>
                    <div class="bg-light p-3 rounded-3 border mb-3">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div class="small">
                                <i class="bi bi-info-circle text-primary me-1"></i> Ví dụ định dạng mã tra cứu: <code class="fw-bold">TN-2026-0001</code>
                            </div>
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Lookup" ? "active fw-bold text-warning" : "text-dark")"
                               asp-controller="Lookup" asp-action="Index">
                                <i class="bi bi-search text-warning"></i>
                                <span class="sidebar-text">Tra Cứu Nhanh</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Khối 2: Lịch sinh hoạt & Giờ lễ giáo xứ -->
            <div class="col-12 col-lg-4">
                <div class="card border-0 rounded-4 shadow-sm p-4 h-100 bg-white">
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-clock-history text-primary me-2"></i>Lịch Sinh Hoạt Chúa Nhật
                    </h6>
                    <ul class="list-unstyled small text-secondary mb-0 d-flex flex-column gap-3">
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-check-circle-fill text-success mt-1"></i>
                            <div>
                                <strong class="text-dark d-block">07:00 - 08:00</strong>
                                Thánh Lễ Thiếu Nhi tại Thánh Đường
                            </div>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-check-circle-fill text-primary mt-1"></i>
                            <div>
                                <strong class="text-dark d-block">09:00 - 10:45</strong>
                                Giờ học Giáo Lý theo phòng học phân bổ
                            </div>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-check-circle-fill text-warning mt-1"></i>
                            <div>
                                <strong class="text-dark d-block">15:00 - 16:45</strong>
                                Giờ học Giáo Lý theo phòng học phân bổ
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    }
</div>