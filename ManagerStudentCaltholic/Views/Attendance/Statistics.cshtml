@model ManagerStudentCaltholic.Models.ViewModels.AttendanceStatisticsViewModel
@{
    ViewData["Title"] = $"Thống Kê Chuyên Cần - Lớp {Model.ClassName}";
    var classes = ViewBag.Classes as List<ManagerStudentCaltholic.Models.Entities.ClassRoom> ?? new();
}

<div class="container-fluid py-4">
    <!-- Header & Bộ Lọc Lớp -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center justify-content-between">
                <div class="col-md-4">
                    <h4 class="fw-bold text-dark mb-1">
                        <i class="bi bi-pie-chart-fill text-primary me-2"></i>Báo Cáo Chuyên Cần & Điều Kiện Bí Tích
                    </h4>
                    <small class="text-muted">Niên khóa: <strong>@Model.AcademicYearName</strong> | Khối: <strong>@Model.GradeLevel</strong></small>
                </div>
                <div class="col-md-3">
                    <form method="get" asp-action="Statistics" class="d-flex gap-2">
                        <select name="classId" class="form-select fw-semibold" onchange="this.form.submit()">
                            @foreach (var c in classes)
                            {
                                <!option value="@c.Id" @(c.Id == Model.ClassId ? "selected" : "")>
                                @c.Name (@c.GradeLevel)
                                </!option>
                            }
                        </select>
                    </form>
                </div>
                <div class="col-md-2 text-end">
                    <a class="nav-link text-dark" asp-controller="Attendance" asp-action="MonthlySummary">
                        <i class="bi bi-calendar-month text-success me-1"></i> Tổng Hợp Tháng
                    </a>
                </div>
                <div class="col-md-3 text-end">
                    <a asp-action="ExportStatisticsExcel" asp-route-classId="@Model.ClassId" class="btn btn-success rounded-pill px-3 shadow-sm">
                        <i class="bi bi-file-earmark-excel-fill me-1"></i> Xuất Báo Cáo Excel
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng Dữ Liệu Thống Kê Tổng Hợp -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-0">
            <span class="fw-bold text-dark">
                Danh sách chi tiết chuyên cần lớp: <strong>@Model.ClassName</strong> (Tổng: @Model.StudentStats.Count em)
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-center">
                    <tr>
                        <th rowspan="2" class="align-middle ps-3">STT</th>
                        <th rowspan="2" class="align-middle">Mã QR</th>
                        <th rowspan="2" class="align-middle text-start">Tên Thánh, Họ và Tên</th>
                        <th colspan="5" class="bg-success-subtle text-success border-start border-end">CHUYÊN CẦN THÁNH LỄ CHÚA NHẬT (@Model.TotalMassSessions buổi)</th>
                        <th colspan="3" class="bg-success-subtle text-success border-start border-end">CHUYÊN CẦN THÁNH LỄ THỨ NĂM (@Model.TotalThuMassSessions buổi)</th>
                        <th colspan="4" class="bg-primary-subtle text-primary border-end">CHUYÊN CẦN HỌC GIÁO LÝ (@Model.TotalClassSessions buổi)</th>
                        <th rowspan="2" class="align-middle">Số buổi bù</th>
                        <th rowspan="2" class="align-middle text-center">Xét Bí Tích</th>
                    </tr>
                    <tr>
                        <th class="border-start">Xếp Hàng</th>
                        <th>Có mặt</th>
                        <th>Trễ</th>
                        <th>Vắng</th>
                        <th class="border-end text-success fw-bold">% Lễ</th>

                        <th class="border-start">Có mặt</th>
                        <th>Vắng</th>
                        <th class="border-end text-success fw-bold">% Lễ</th>

                        <th>Có mặt</th>
                        <th>Trễ</th>
                        <th>Vắng</th>
                        <th class="border-end text-primary fw-bold">% Học</th>
                    </tr>
                </thead>
                <tbody class="text-center">
                    @if (Model.StudentStats.Any())
                    {
                        var idx = 1;
                        foreach (var s in Model.StudentStats)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-muted">@(idx++)</td>
                                <td><span class="badge bg-light text-dark border font-monospace">@s.StudentCode</span></td>
                                <td class="text-start">
                                    <div class="fw-bold text-dark">@s.ChristianName @s.FullName</div>
                                </td>

                                <!-- Thống kê Lễ CN -->
                                <td class="border-start text-primary fw-bold">@s.MassLinedUpCount</td>
                                <td class="text-success fw-bold">@s.MassPresentCount</td>
                                <td class="text-warning fw-bold">@s.MassLateCount</td>
                                <td class="text-danger">@(s.MassAbsentPermitted + s.MassAbsentUnpermitted)</td>
                                <td class="border-end fw-bold">
                                    <span class="badge @(s.MassAttendanceRate >= 80 ? "bg-success" : "bg-danger")">@s.MassAttendanceRate%</span>
                                </td>

                                <!-- Thống kê Lễ T5 -->
                                <td class="border-start text-success fw-bold">@s.MassThuPresentCount</td>
                                <td class="text-danger">@(s.MassThuAbsentPermitted + s.MassThuAbsentUnpermitted)</td>
                                <td class="border-end fw-bold">
                                    <span class="badge @(s.MassThuAttendanceRate >= 80 ? "bg-success" : "bg-danger")">@s.MassThuAttendanceRate%</span>
                                </td>

                                <!-- Thống kê Học -->
                                <td class="text-primary fw-bold">@s.ClassPresentCount</td>
                                <td class="text-warning fw-bold">@s.ClassLateCount</td>
                                <td class="text-danger">@(s.ClassAbsentPermitted + s.ClassAbsentUnpermitted)</td>
                                <td class="border-end fw-bold">
                                    <span class="badge @(s.ClassAttendanceRate >= 80 ? "bg-primary" : "bg-danger")">@s.ClassAttendanceRate%</span>
                                </td>

                                <td><span class="badge bg-light text-dark border">@s.TotalMakeUpCount</span></td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1 rounded-pill">
                                        <i class="bi bi-dash-circle me-1"></i> Chưa xét
                                    </span>

                                    @* Mở comment này khi đã có thuộc tính IsEligibleForSacrament:
                                    @if (s.IsEligibleForSacrament)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
                                            <i class="bi bi-check-circle me-1"></i> Đủ ĐK
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill">
                                            <i class="bi bi-x-circle me-1"></i> Thiếu ĐK
                                        </span>
                                    }
                                    *@
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="17" class="py-5 text-muted">Lớp chưa có dữ liệu điểm danh.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>