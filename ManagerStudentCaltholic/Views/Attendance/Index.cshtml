        // Tự động lưu cache danh sách học sinh của lớp đang mở vào LocalStorage
        function cacheCurrentClassAttendance(classId, className, studentsData) {
            try {
                const cachePayload = {
                    classId: classId,
                    className: className,
                    cachedAt: new Date().toISOString(),
                    students: studentsData
                };
                localStorage.setItem(`offline_class_${classId}`, JSON.stringify(cachePayload));
            } catch (e) {
                console.warn("Không thể lưu LocalStorage:", e);
            }
        }

        function autoBalanceClassWeight() {
            let sun = parseInt(document.getElementById('ruleSundayMassWeight').value) || 0;
            let thu = parseInt(document.getElementById('ruleThursdayMassWeight').value) || 0;
            if (sun < 0) sun = 0;
            if (thu < 0) thu = 0;
            if (sun + thu > 100) {
                thu = Math.max(0, 100 - sun);
                document.getElementById('ruleThursdayMassWeight').value = thu;
            }
            document.getElementById('ruleSundayMassWeight').value = sun;
            document.getElementById('ruleClassWeight').value = 100 - (sun + thu);
        }

        async function openAttendanceRuleModal(classId) {
            document.getElementById('ruleClassId').value = classId;
            document.getElementById('ruleAlert').classList.add('d-none');

            try {
                const res = await fetch(`/Attendance/GetClassRule?classId=${classId}`);
                const data = await res.json();
                if (data.success) {
                    const r = data.data;
                    const titleEl = document.getElementById('ruleModalTitle');
                    titleEl.innerHTML = '<i class="bi bi-sliders me-2"></i>';
                    titleEl.appendChild(document.createTextNode(`Quy Ước Lớp: ${r.className}`));

                    document.getElementById('ruleSundayMassWeight').value = r.sundayMassWeightPercent ?? 40;
                    document.getElementById('ruleThursdayMassWeight').value = r.thursdayMassWeightPercent ?? 20;
                    document.getElementById('ruleClassWeight').value = r.classWeightPercent ?? 40;
                    document.getElementById('ruleLateMultiplier').value = Number(r.lateMultiplier ?? 0.8).toFixed(2);
                    document.getElementById('rulePermittedAbsentMultiplier').value = Number(r.permittedAbsentMultiplier ?? 0.5).toFixed(2);
                    document.getElementById('ruleMinSacrament').value = r.minAttendanceRateForSacrament ?? 80;

                    const btnSave = document.getElementById('btnSaveRule');
                    btnSave.disabled = !r.canEdit;
                    btnSave.innerText = r.canEdit ? "Lưu Quy Ước" : "Chỉ xem (Không có quyền sửa)";

                    bootstrap.Modal.getOrCreateInstance(document.getElementById('attendanceRuleModal')).show();
                }
            } catch (err) {
                alert("Lỗi tải quy ước: " + err);
            }
        }

        async function saveClassRule() {
            const classId = parseInt(document.getElementById('ruleClassId').value);
            const sundayMassWeight = parseInt(document.getElementById('ruleSundayMassWeight').value) || 0;
            const thursdayMassWeight = parseInt(document.getElementById('ruleThursdayMassWeight').value) || 0;
            const classWeight = parseInt(document.getElementById('ruleClassWeight').value) || 0;
            const lateMult = parseFloat(document.getElementById('ruleLateMultiplier').value);
            const permMult = parseFloat(document.getElementById('rulePermittedAbsentMultiplier').value);
            const minSacrament = parseFloat(document.getElementById('ruleMinSacrament').value);
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            const payload = {
                classId: classId,
                sundayMassWeightPercent: sundayMassWeight,
                thursdayMassWeightPercent: thursdayMassWeight,
                classWeightPercent: classWeight,
                lateMultiplier: lateMult,
                permittedAbsentMultiplier: permMult,
                minAttendanceRateForSacrament: minSacrament
            };

            try {
                const res = await fetch('/Attendance/SaveClassRule', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': token
                    },
                    body: JSON.stringify(payload)
                });

                const result = await res.json();
                if (result.success) {
                    alert(result.message);
                    bootstrap.Modal.getInstance(document.getElementById('attendanceRuleModal')).hide();
                    location.reload();
                } else {
                    const alertBox = document.getElementById('ruleAlert');
                    alertBox.innerText = result.message;
                    alertBox.classList.remove('d-none');
                }
            } catch (err) {
                alert("Lỗi lưu quy ước: " + err);
            }
        }

        let messageModalInstance = null;
        const currentClassId = @Model.ClassId; // Lấy ID lớp hiện tại từ Model

        // Mở Modal và nạp danh sách mẫu + học sinh của lớp
        async function openMessagePopup() {
            if (!messageModalInstance) {
                messageModalInstance = new bootstrap.Modal(document.getElementById('parentMessageModal'));
            }
            messageModalInstance.show();

            // 1. Nạp danh sách Template nếu chưa có
            const templateSelect = document.getElementById('modalTemplateSelect');
            if (templateSelect.options.length <= 1) {
                try {
                    const res = await fetch('/ParentMessages/GetTemplatesJson');
                    const data = await res.json();
                    if (data.success) {
                        templateSelect.innerHTML = '<option value="">-- Chọn mẫu tin nhắn chuẩn --</option>';
                        data.templates.forEach(t => {
                            const opt = document.createElement('option');
                            opt.value = t.id;
                            opt.text = `[${t.category}] ${t.title}`;
                            templateSelect.appendChild(opt);
                        });
                    }
                } catch (e) {
                    console.error("Lỗi tải mẫu tin nhắn:", e);
                }
            }

            // 2. Nạp danh sách học sinh của lớp vào dropdown trong modal
            const studentSelect = document.getElementById('modalStudentSelect');
            studentSelect.innerHTML = '<option value="">-- Chọn thiếu nhi trong lớp --</option>';

            document.querySelectorAll('#tableAttendance [data-enrollment-id]').forEach(row => {
                const enrollmentId = row.getAttribute('data-enrollment-id');
                const nameText = row.getAttribute('data-student-name') || row.querySelector('.student-fullname-text')?.innerText || 'Thiếu nhi';
                const codeText = row.getAttribute('data-student-code') || row.querySelector('.student-code-badge')?.innerText || '';

                const opt = document.createElement('option');
                opt.value = enrollmentId;
                opt.text = `${nameText} (${codeText})`;
                studentSelect.appendChild(opt);
            });
        }

        // Gọi API thay thế biến động và hiển thị nội dung vào Textarea
        async function loadCompiledMessage() {
            const templateId = document.getElementById('modalTemplateSelect').value;
            const enrollmentId = document.getElementById('modalStudentSelect').value;
            const txtArea = document.getElementById('modalCompiledContent');

            if (!templateId || !enrollmentId) {
                txtArea.value = '';
                return;
            }

            try {
                const res = await fetch(`/ParentMessages/RenderTemplateByEnrollment?templateId=${templateId}&enrollmentId=${enrollmentId}`);
                const data = await res.json();
                if (data.success) {
                    txtArea.value = data.compiledMessage;
                } else {
                    txtArea.value = 'Lỗi: ' + data.message;
                }
            } catch (err) {
                txtArea.value = 'Lỗi kết nối máy chủ.';
            }
        }

        // 1-Click Sao chép vào Clipboard
        function copyModalMessageToClipboard() {
            const txtArea = document.getElementById('modalCompiledContent');
            if (!txtArea.value.trim()) {
                alert('Chưa có nội dung tin nhắn để sao chép!');
                return;
            }

            txtArea.select();
            navigator.clipboard.writeText(txtArea.value).then(() => {
