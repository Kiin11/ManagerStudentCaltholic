        // SEC-NEW-09 FIX 3: Dùng createElement + textContent trong openAuditTimeline
        function openAuditTimeline(studentId, studentName) {
            document.getElementById('auditStudentName').textContent = studentName;
            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('auditTimelineModal'));
            modal.show();

            const loading = document.getElementById('timelineLoading');
            const list = document.getElementById('timelineList');
            loading.style.display = 'block';
            list.style.display = 'none';
            list.innerHTML = '';

            // P2-LOG-12 FIX: Đọc đúng ID '#inputDate' trên thanh chọn ngày điểm danh
            const selectedDate = document.getElementById('inputDate')?.value || getLocalTodayIsoDate();

            fetch(`/Attendance/GetAuditHistory?studentId=${studentId}&date=${encodeURIComponent(selectedDate)}`)
                .then(res => res.json())
                .then(response => {
                    loading.style.display = 'none';
                    list.style.display = 'block';

                    if (!response.success || response.data.length === 0) {
                        list.innerHTML = '<li class="text-muted small">Không tìm thấy thông tin kiểm toán.</li>';
                        return;
                    }

                    response.data.forEach(item => {
                        const li = document.createElement('li');
                        li.className = 'timeline-item';

                        const badge = document.createElement('span');
                        badge.className = 'timeline-badge';

                        const headerDiv = document.createElement('div');
                        headerDiv.className = 'd-flex flex-wrap align-items-center gap-2 mb-1';

                        const timeSpan = document.createElement('span');
                        timeSpan.className = 'fw-semibold text-primary small';
                        timeSpan.textContent = item.timeDisplay;

                        const actionBadge = document.createElement('span');
                        actionBadge.className = 'badge bg-light text-dark border';
                        actionBadge.style.fontSize = '0.7rem';
                        actionBadge.textContent = item.actionLabel || item.actionType || 'Thao tác';

                        headerDiv.appendChild(timeSpan);
                        headerDiv.appendChild(actionBadge);

                        const descDiv = document.createElement('div');
                        descDiv.className = 'text-dark small fw-medium';
                        descDiv.textContent = item.description;

                        li.appendChild(badge);
                        li.appendChild(headerDiv);
                        li.appendChild(descDiv);

                        if (item.oldValues || item.newValues) {
                            const diffBox = document.createElement('div');
                            diffBox.className = 'bg-light border rounded-2 px-2 py-1 mt-1 text-secondary';
                            diffBox.style.fontSize = '0.74rem';

                            if (item.oldValues) {
                                const oldLine = document.createElement('div');
                                const oldLabel = document.createElement('strong');
                                oldLabel.textContent = 'Trước: ';
                                oldLine.appendChild(oldLabel);
                                oldLine.appendChild(document.createTextNode(item.oldValues));
                                diffBox.appendChild(oldLine);
                            }

                            if (item.newValues) {
                                const newLine = document.createElement('div');
                                const newLabel = document.createElement('strong');
                                newLabel.textContent = 'Sau: ';
                                newLine.appendChild(newLabel);
                                newLine.appendChild(document.createTextNode(item.newValues));
                                diffBox.appendChild(newLine);
                            }

                            li.appendChild(diffBox);
                        }

                        const actorDiv = document.createElement('div');
                        actorDiv.className = 'text-muted fst-italic mt-1';
                        actorDiv.style.fontSize = '0.74rem';
                        actorDiv.textContent = item.ipAddress
                            ? `Thực hiện bởi: ${item.performedBy} (IP: ${item.ipAddress})`
                            : `Thực hiện bởi: ${item.performedBy}`;

                        li.appendChild(actorDiv);
                        list.appendChild(li);
                    });
                })
                .catch(() => {
                    loading.style.display = 'none';
                    list.style.display = 'block';
                    list.innerHTML = '<li class="text-danger small">Lỗi kết nối khi tải lịch sử.</li>';
                });
        }

        // TASK-P3-07.4: 1-Click Copy tin nhắn báo vắng / đi trễ ngay trên dòng Sổ Điểm Danh
        async function quickCopyAbsenceMessageFromRow(btn) {
            const row = btn.closest('[data-enrollment-id]');
            const enrollmentId = parseInt(btn.getAttribute('data-enrollment-id'));
            const date = document.getElementById('inputDate')?.value || getLocalTodayIsoDate();

            const chkMass = row.querySelector('.chk-mass');
            const selMass = row.querySelector('.select-mass-status');
            const attendedMass = chkMass ? chkMass.checked : false;
            const massStatus = selMass ? selMass.value : 'ABSENT_UNPERMITTED';

            const chkClass = row.querySelector('.chk-class');
            const selClass = row.querySelector('.select-class-status');
            const classAttended = chkClass ? chkClass.checked : false;
            const classStatus = selClass ? selClass.value : 'ABSENT_UNPERMITTED';

            const studentName = row.getAttribute('data-student-name') || row.querySelector('.student-fullname-text')?.textContent?.trim() || 'Thiếu nhi';
            const studentCode = row.getAttribute('data-student-code') || row.querySelector('.student-code-badge')?.textContent?.trim() || '';

            try {
                let compiledText = '';

                if (navigator.onLine) {
                    const url = `/ParentMessages/QuickAbsenceMessage?enrollmentId=${enrollmentId}&attendanceDate=${encodeURIComponent(date)}&attendedMass=${attendedMass}&massStatus=${encodeURIComponent(massStatus)}&classAttended=${classAttended}&classStatus=${encodeURIComponent(classStatus)}`;
                    const res = await fetch(url);
                    const data = await res.json();
                    if (data.success) {
                        compiledText = data.compiledMessage;
                    }
                }

                // Fallback tự sinh nội dung ngay tại Client nếu thiết bị đang ở chế độ Offline
                if (!compiledText) {
                    const currentClassName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ClassName ?? string.Empty));
                    compiledText = `Kính chào Quý Phụ huynh em ${studentName} (Mã TN: ${studentCode} - Lớp ${currentClassName}). Ngày ${date}, Ban Giáo Lý ghi nhận em vắng mặt trong buổi sinh hoạt Giáo lý. Kính mong Quý Phụ huynh phản hồi lý do cho GLV phụ trách. Xin cảm ơn Quý Phụ huynh!`;
                }

                await navigator.clipboard.writeText(compiledText);

                const origHtml = btn.innerHTML;
                btn.className = 'btn btn-success btn-sm rounded-pill px-2';
                btn.innerHTML = '<i class="bi bi-check2-all"></i> Đã Copy';
                showAlert(`Đã sao chép tin nhắn của em "${studentName}" vào Clipboard! Bạn có thể dán (Paste) gửi Zalo ngay.`, true);

                setTimeout(() => {
                    btn.className = 'btn btn-outline-primary btn-sm rounded-pill px-2';
                    btn.innerHTML = origHtml;
                }, 2200);
            } catch (err) {
                showAlert('Không thể tự động sao chép vào Clipboard: ' + err.message, false);
            }
        }
        async function triggerPreWarmRedis() {
            const date = document.getElementById('inputDate')?.value || '';
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const formData = new FormData();
            if (date) formData.append('date', date);

            try {
                const res = await fetch('/Attendance/PreWarmRedisCache', {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': token },
                    body: formData
                });
                const data = await res.json();
                showAlert(data.message, data.success);
            } catch (err) {
                showAlert('Lỗi khi nạp bộ đệm Redis: ' + err.message, false);
            }
        }

        async function triggerFlushRedisToDb() {
            const date = document.getElementById('inputDate')?.value || '';
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const formData = new FormData();
            if (date) formData.append('date', date);

            try {
                const res = await fetch('/Attendance/FlushRedisToDatabase', {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': token },
                    body: formData
                });
