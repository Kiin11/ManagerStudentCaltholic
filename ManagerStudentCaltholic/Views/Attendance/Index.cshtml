@section Scripts {
    <script>
        function getLocalTodayIsoDate() {
            const now = new Date();
            const y = now.getFullYear();
            const m = String(now.getMonth() + 1).padStart(2, '0');
            const d = String(now.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        function onFilterChange() {
            const classId = document.getElementById('selectClass').value;
            const date = document.getElementById('inputDate').value;
            window.location.href = `/Attendance/Index?classId=${classId}&date=${date}`;
        }

        const rowSaveSequenceMap = new Map();
        const rowBadgeHideTimers = new Map();

        function buildRowAttendanceItem(row) {
            const enrollmentId = parseInt(row.getAttribute('data-enrollment-id'));
            const code = row.getAttribute('data-student-code') || row.querySelector('.student-code-badge')?.textContent?.trim() || '';

            const chkClass = row.querySelector('.chk-class');
            const selClass = row.querySelector('.select-class-status');
            const classAttended = chkClass ? chkClass.checked : false;
            const classStatus = selClass ? selClass.value : 'ABSENT_UNPERMITTED';

            const chkMass = row.querySelector('.chk-mass');
            const selMass = row.querySelector('.select-mass-status');
            const attendedMass = chkMass ? chkMass.checked : false;
            const massStatus = selMass ? selMass.value : 'ABSENT_UNPERMITTED';

            const inputNote = row.querySelector('.input-note');
            const note = inputNote ? inputNote.value : '';

            return {
                enrollmentId: enrollmentId,
                studentCode: code,
                classAttended: classAttended,
                classStatus: classStatus,
                attendedMass: attendedMass,
                massStatus: massStatus,
                note: note
            };
        }

        function setRowSaveBadge(row, enrollmentId, state, text) {
            const existingTimer = rowBadgeHideTimers.get(enrollmentId);
            if (existingTimer) {
                clearTimeout(existingTimer);
                rowBadgeHideTimers.delete(enrollmentId);
            }

            const badge = row.querySelector('.quick-save-badge');
            if (!badge) return;

            if (state === 'saving') {
                badge.className = 'badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle quick-save-badge';
                badge.textContent = text || 'Đang lưu...';
            } else if (state === 'saved') {
                badge.className = 'badge rounded-pill bg-success-subtle text-success border border-success-subtle quick-save-badge';
                badge.textContent = text || '✔ Đã lưu';
                const timer = setTimeout(() => {
                    badge.classList.add('d-none');
                    rowBadgeHideTimers.delete(enrollmentId);
                }, 1800);
                rowBadgeHideTimers.set(enrollmentId, timer);
            } else if (state === 'offline') {
                badge.className = 'badge rounded-pill bg-info-subtle text-info-emphasis border border-info-subtle quick-save-badge';
                badge.textContent = text || '⚡ Đã lưu Offline';
                const timer = setTimeout(() => {
                    badge.classList.add('d-none');
                    rowBadgeHideTimers.delete(enrollmentId);
                }, 2200);
                rowBadgeHideTimers.set(enrollmentId, timer);
            } else {
                badge.className = 'badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle quick-save-badge';
                badge.textContent = text || 'Lỗi lưu!';
            }
        }

        async function quickSaveRowAttendance(row, updateTarget = 'ALL') {
            if (!row) return;
            const classId = parseInt(document.getElementById('selectClass').value);
            const date = document.getElementById('inputDate').value;
            const item = buildRowAttendanceItem(row);
            const enrollmentId = item.enrollmentId;
            const targetNorm = (updateTarget || 'ALL').toUpperCase();
            const seqKey = `${enrollmentId}_${targetNorm}`;

            const seq = (rowSaveSequenceMap.get(seqKey) || 0) + 1;
            rowSaveSequenceMap.set(seqKey, seq);

            setRowSaveBadge(row, enrollmentId, 'saving', 'Đang lưu...');

            if (!navigator.onLine && typeof ParishOfflineEngine !== 'undefined') {
                await ParishOfflineEngine.saveBatchAttendanceOffline(classId, date, [item]);
                if (rowSaveSequenceMap.get(seqKey) === seq) {
                    setRowSaveBadge(row, enrollmentId, 'offline', '⚡ Đã lưu Offline');
                }
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const res = await fetch('/Attendance/QuickUpdateSingle', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': token
                    },
                    body: JSON.stringify({
                        classId: classId,
                        attendanceDate: date,
                        enrollmentId: item.enrollmentId,
                        studentCode: item.studentCode,
                        attendedMass: item.attendedMass,
                        massStatus: item.massStatus,
                        classAttended: item.classAttended,
                        classStatus: item.classStatus,
                        updateTarget: targetNorm,
                        note: item.note
                    })
                });

                if (res.status === 403 || res.status === 400) {
                    let errMsg = res.status === 403
                        ? 'Bạn không có quyền thực hiện thao tác điểm danh này.'
                        : 'Dữ liệu điểm danh không hợp lệ.';
                    try {
                        const errJson = await res.json();
                        if (errJson && errJson.message) errMsg = errJson.message;
                    } catch {}
                    setRowSaveBadge(row, enrollmentId, 'error', 'Không được phép!');
                    showAlert(errMsg, false);
                    return;
                }

                if (!res.ok) throw new Error(`HTTP ${res.status}`);

                const data = await res.json();
                if (rowSaveSequenceMap.get(seqKey) !== seq) {
                    return;
                }

                if (data.success) {
                    if (data.data) {
                        if (targetNorm === 'CLASS' || targetNorm === 'ALL') {
                            const chkClass = row.querySelector('.chk-class');
                            const selClass = row.querySelector('.select-class-status');
                            if (chkClass) chkClass.checked = !!data.data.classAttended;
                            if (selClass && data.data.classStatus) selClass.value = data.data.classStatus;
                        }

                        if (targetNorm === 'MASS' || targetNorm === 'ALL') {
                            const chkMass = row.querySelector('.chk-mass');
                            const selMass = row.querySelector('.select-mass-status');
                            if (chkMass) chkMass.checked = !!data.data.attendedMass;
                            if (selMass && data.data.massStatus) selMass.value = data.data.massStatus;
                        }
                    }

                    setRowSaveBadge(row, enrollmentId, 'saved', '✔ Đã lưu');

                    const dirtyBadge = document.getElementById('badgeRedisDirtyState');
                    if (dirtyBadge) {
                        dirtyBadge.className = 'badge bg-success-subtle text-success border';
                        dirtyBadge.innerHTML = '<i class="bi bi-check2-all me-1"></i>Đã đồng bộ PostgreSQL';
                    }
                } else {
                    setRowSaveBadge(row, enrollmentId, 'error', 'Lỗi lưu!');
                    showAlert(data.message || 'Không thể lưu trạng thái điểm danh.', false);
                }
            } catch (err) {
                if (rowSaveSequenceMap.get(seqKey) !== seq) {
                    return;
                }

                if (typeof ParishOfflineEngine !== 'undefined') {
                    await ParishOfflineEngine.saveBatchAttendanceOffline(classId, date, [item]);
                    setRowSaveBadge(row, enrollmentId, 'offline', '⚡ Đã lưu Offline');
                } else {
                    setRowSaveBadge(row, enrollmentId, 'error', 'Lỗi kết nối!');
                }
            }
        }

        function onClassToggle(chk) {
            const row = chk.closest('[data-enrollment-id]');
            if (!row) return;
            const selectStatus = row.querySelector('.select-class-status');
            if (selectStatus) {
                if (chk.checked) {
                    if (selectStatus.value === 'ABSENT_UNPERMITTED' || selectStatus.value === 'ABSENT_PERMITTED') {
                        selectStatus.value = 'PRESENT';
                    }
                } else {
                    selectStatus.value = 'ABSENT_UNPERMITTED';
                }
            }
            quickSaveRowAttendance(row, 'CLASS');
        }

        function onClassStatusChange(selectEl) {
            const row = selectEl.closest('[data-enrollment-id]');
            if (!row) return;
            const chk = row.querySelector('.chk-class');
            if (chk) {
                chk.checked = selectEl.value === 'PRESENT' || selectEl.value === 'LATE';
            }
            quickSaveRowAttendance(row, 'CLASS');
        }

        function onMassToggle(chk) {
            const row = chk.closest('[data-enrollment-id]');
            if (!row) return;
            const selectStatus = row.querySelector('.select-mass-status');
            if (selectStatus) {
                if (chk.checked) {
                    if (selectStatus.value === 'ABSENT_UNPERMITTED' || selectStatus.value === 'ABSENT_PERMITTED') {
                        selectStatus.value = 'PRESENT';
                    }
                } else {
                    selectStatus.value = 'ABSENT_UNPERMITTED';
                }
            }
            quickSaveRowAttendance(row, 'MASS');
        }

        function onMassStatusChange(selectEl) {
            const row = selectEl.closest('[data-enrollment-id]');
            if (!row) return;
            const chk = row.querySelector('.chk-mass');
            if (chk) {
                chk.checked = selectEl.value === 'LINED_UP' || selectEl.value === 'PRESENT' || selectEl.value === 'LATE';
            }
            quickSaveRowAttendance(row, 'MASS');
        }

        function onNoteChange(inputEl) {
            const row = inputEl.closest('[data-enrollment-id]');
            if (!row) return;
            quickSaveRowAttendance(row, 'NOTE');
        }

        // SEC-NEW-09 FIX 1: Hiển thị thông báo an toàn bằng textContent thay vì cộng chuỗi innerHTML
        function showAlert(msg, isSuccess = true) {
            const box = document.getElementById('attendanceAlert');
            box.className = `alert alert-${isSuccess ? 'success' : 'danger'} alert-dismissible fade show shadow-sm border-0 mb-4`;
            box.innerHTML = '';

            const icon = document.createElement('i');
            icon.className = `bi bi-${isSuccess ? 'check-circle' : 'exclamation-triangle'}-fill me-2`;

            const textSpan = document.createElement('span');
            textSpan.textContent = msg;

            const closeBtn = document.createElement('button');
            closeBtn.type = 'button';
            closeBtn.className = 'btn-close';
            closeBtn.setAttribute('data-bs-dismiss', 'alert');

            box.appendChild(icon);
            box.appendChild(textSpan);
            box.appendChild(closeBtn);
            box.classList.remove('d-none');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Tự động lưu danh sách học sinh của lớp đang hiển thị vào IndexedDB ngay khi mở trang
        document.addEventListener('DOMContentLoaded', function () {
