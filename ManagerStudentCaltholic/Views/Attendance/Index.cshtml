                    }
                }
            } catch (err) {
                showAlert('Lỗi khi đồng bộ xuống CSDL: ' + err.message, false);
            }
        }

        async function openClassDisputesModal(classId) {
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modalClassDisputes')).show();
            const tbody = document.getElementById('classDisputesTableBody');
            tbody.innerHTML = '<tr><td colspan="5" class="text-center py-3">Đang tải danh sách báo sai sót...</td></tr>';

            try {
                const res = await fetch(`/Attendance/GetClassDisputes?classId=${classId}&status=PENDING`);
                const result = await res.json();
                if (!result.success || !result.data || result.data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">Không có yêu cầu báo sai sót nào đang chờ duyệt.</td></tr>';
                    return;
                }

                tbody.innerHTML = '';
                result.data.forEach(item => {
                    const tr = document.createElement('tr');
                    const disputeId = Number(item.id) || 0;

                    const tdStudent = document.createElement('td');
                    const codeDiv = document.createElement('div');
                    codeDiv.className = 'fw-bold text-primary font-monospace';
                    codeDiv.textContent = item.studentCode || '';
                    const nameDiv = document.createElement('div');
                    nameDiv.className = 'fw-semibold text-dark';
                    nameDiv.textContent = item.studentName || '';
                    tdStudent.appendChild(codeDiv);
                    tdStudent.appendChild(nameDiv);

                    const tdDateScope = document.createElement('td');
                    const dateDiv = document.createElement('div');
                    dateDiv.className = 'fw-bold';
                    dateDiv.textContent = item.attendanceDateDisplay || item.attendanceDate || '';
                    const scopeBadge = document.createElement('span');
                    scopeBadge.className = 'badge bg-info-subtle text-primary border';
                    scopeBadge.textContent = item.sessionScopeLabel || '';
                    tdDateScope.appendChild(dateDiv);
                    tdDateScope.appendChild(scopeBadge);

                    const tdStatus = document.createElement('td');
                    tdStatus.className = 'text-center';
                    const currBadge = document.createElement('span');
                    currBadge.className = 'badge bg-secondary';
                    currBadge.textContent = item.currentStatusLabel || '';
                    const arrowIcon = document.createElement('i');
                    arrowIcon.className = 'bi bi-arrow-right mx-1';
                    const reqBadge = document.createElement('span');
                    reqBadge.className = 'badge bg-success';
                    reqBadge.textContent = item.requestedStatusLabel || '';
                    tdStatus.appendChild(currBadge);
                    tdStatus.appendChild(arrowIcon);
                    tdStatus.appendChild(reqBadge);

                    const tdReason = document.createElement('td');
                    tdReason.className = 'text-break';
                    tdReason.textContent = item.reason || '';

                    const tdAction = document.createElement('td');
                    const noteInput = document.createElement('input');
                    noteInput.type = 'text';
                    noteInput.className = 'form-control form-control-sm mb-1';
                    noteInput.id = `disp-note-${disputeId}`;
                    noteInput.placeholder = 'Ghi chú phản hồi PH...';

                    const btnWrap = document.createElement('div');
                    btnWrap.className = 'd-flex gap-1';

                    const btnApprove = document.createElement('button');
                    btnApprove.type = 'button';
                    btnApprove.className = 'btn btn-success btn-sm w-50 fw-bold';
                    btnApprove.textContent = '✔ Duyệt';
                    btnApprove.addEventListener('click', () => reviewParentDispute(disputeId, 'APPROVED'));

                    const btnReject = document.createElement('button');
                    btnReject.type = 'button';
                    btnReject.className = 'btn btn-outline-danger btn-sm w-50 fw-bold';
                    btnReject.textContent = '✘ Từ chối';
                    btnReject.addEventListener('click', () => reviewParentDispute(disputeId, 'REJECTED'));

                    btnWrap.appendChild(btnApprove);
                    btnWrap.appendChild(btnReject);
                    tdAction.appendChild(noteInput);
                    tdAction.appendChild(btnWrap);

                    tr.appendChild(tdStudent);
                    tr.appendChild(tdDateScope);
                    tr.appendChild(tdStatus);
                    tr.appendChild(tdReason);
                    tr.appendChild(tdAction);
                    tbody.appendChild(tr);
                });
            } catch (err) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger py-3">Lỗi tải dữ liệu.</td></tr>';
            }
        }

        async function reviewParentDispute(disputeId, decision) {
            const note = document.getElementById(`disp-note-${disputeId}`)?.value || '';
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            const res = await fetch('/Attendance/ReviewDispute', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': token
                },
                body: JSON.stringify({
                    disputeId: disputeId,
                    decision: decision,
                    teacherResponseNote: note
                })
            });

            const data = await res.json();
            if (res.ok && data.success) {
                showAlert(data.message, true);
                setTimeout(() => location.reload(), 900);
            } else {
                alert(data.message || 'Không thể xử lý yêu cầu.');
            }
        }
    </script>
