                const fullName = r.getAttribute('data-student-name') || r.querySelector('.student-fullname-text')?.textContent?.trim() || '';
                const studentId = parseInt(r.getAttribute('data-student-id') || r.querySelector('button[data-student-id]')?.getAttribute('data-student-id') || '0');
                domStudents.push({
                    enrollmentId: enrollmentId,
                    studentId: studentId,
                    studentCode: code,
                    christianName: '',
                    fullName: fullName,
                    gender: 'Nam'
                });
