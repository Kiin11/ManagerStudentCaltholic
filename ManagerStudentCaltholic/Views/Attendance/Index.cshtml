@model ManagerStudentCaltholic.Models.ViewModels.ClassAttendanceSheetViewModel
@using ManagerStudentCaltholic.Extensions
@{
    ViewData["Title"] = $"Sổ Điểm Danh - {Model.ClassName}";
    var classes = ViewBag.Classes as List<ManagerStudentCaltholic.Models.Entities.ClassRoom> ?? new();
    var sessionCtx = ViewBag.SessionContext as ManagerStudentCaltholic.Models.DTOs.ClassSessionContextDto;
    bool canManageCache = User.IsInRole("Admin") || User.IsInRole("SpiritualDirector") || User.IsInRole("ExecutiveBoard") || User.IsInRole("BranchHead");
    int pendingDisputes = ViewBag.PendingDisputesCount != null ? (int)ViewBag.PendingDisputesCount : 0;
    bool isMobile = Context.Request.IsMobileDevice();
    bool hasClassColumn = Model.DayOfWeek != DayOfWeek.Thursday;
}

@section Styles {
    <style>
        /* Cho phép position: sticky bám theo viewport trên cả Desktop & Mobile */
        body,
        .mobile-main-wrapper {
            overflow-x: hidden !important;
            overflow-x: clip !important;
        }

        /* Desktop: Ghim cố định tiêu đề bảng khi cuộn trang */
        .attendance-table-wrap {
            width: 100%;
        }

        #tableAttendance thead th {
            position: sticky;
            top: var(--topbar-height, 64px);
            z-index: 1015;
            background-clip: padding-box;
            box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08);
        }

        #tableAttendance thead th:not(.bg-success-subtle):not(.bg-primary-subtle) {
            background-color: #f8fafc !important;
        }

        @@media (max-width: 991.98px) {
            .attendance-table-wrap {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }
        }
    </style>
}

@Html.AntiForgeryToken()
@if (sessionCtx != null)
{
    <!-- KHUNG THÔNG TIN GIỜ HỌC & TASK GIÁO LÝ VIÊN TỪ REDIS (FEAT-P3-12) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden border-start border-primary border-4">
        <div class="card-body p-3 p-md-4">
            <div class="row g-3 align-items-center">
                <!-- Cột trái: Thông tin Phòng học, Ca học & Bài giảng hôm nay -->
                <div class="col-lg-6 border-end-lg">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="badge bg-primary rounded-pill px-3 py-1">
                            <i class="bi bi-lightning-charge-fill me-1"></i>Redis High-Throughput Active
                        </span>
                        <span class="badge bg-info-subtle text-primary border px-2 py-1">
                            <i class="bi bi-geo-alt-fill me-1"></i>Phòng: @sessionCtx.RoomName (@sessionCtx.TimeSlotDisplay)
                        </span>
                        @if (sessionCtx.HasUnsyncedChanges)
                        {
                            <span class="badge bg-warning text-dark" id="badgeRedisDirtyState">
                                <i class="bi bi-clock-history me-1"></i>Đang chờ Sync-back về DB (2p/lần)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success-subtle text-success border" id="badgeRedisDirtyState">
                                <i class="bi bi-check2-all me-1"></i>Đã đồng bộ PostgreSQL
                            </span>
                        }
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        <i class="bi bi-book-half text-primary me-2"></i>Nội dung Giờ học: @sessionCtx.TopicTitle
                    </h6>

                    @if (!string.IsNullOrWhiteSpace(sessionCtx.LatestPinnedAnnouncementTitle))
                    {
                        <div class="small text-danger fw-semibold mt-1">
                            <i class="bi bi-pin-angle-fill me-1"></i>Thông báo ghim: @sessionCtx.LatestPinnedAnnouncementTitle
                        </div>
                    }

                    @if (canManageCache)
                    {
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 d-none" onclick="triggerPreWarmRedis()">
                                <i class="bi bi-fire me-1"></i> Nạp Đệm Redis (Pre-warm)
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 d-none" onclick="triggerFlushRedisToDb()">
                                <i class="bi bi-database-fill-up me-1"></i> Đồng Bộ Redis Xuống DB Ngay
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold shadow-sm"
                                    onclick="openClassDisputesModal(@Model.ClassId)">
                                <i class="bi bi-flag-fill me-1"></i> Duyệt Báo Sai Sót PH
                                @if (pendingDisputes > 0)
                                {
                                    <span class="badge bg-danger text-white rounded-pill ms-1">@pendingDisputes</span>
                                }
                            </button>
                        </div>
                    }
                </div>

                <!-- Cột phải: Checklist Nhiệm vụ của GLV trong giờ học -->
                <div class="col-lg-6">
                    <div class="small fw-bold text-secondary text-uppercase mb-2">
                        <i class="bi bi-list-check me-1 text-success"></i>Checklist Công Việc Trong Giờ Sinh Hoạt:
                    </div>
                    <div class="list-group list-group-flush small">
                        @foreach (var task in sessionCtx.Tasks)
                        {
                            <div class="list-group-item px-0 py-1 border-0 d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi @(task.IsCompleted ? "bi-check-circle-fill text-success" : "bi-circle text-secondary")"></i>
                                    @if (!string.IsNullOrWhiteSpace(task.ActionUrl))
                                    {
                                        <a href="@task.ActionUrl" class="text-decoration-none fw-semibold text-dark">@task.Title</a>
                                    }
                                    else
                                    {
                                        <span class="@(task.IsCompleted ? "text-decoration-line-through text-muted" : "fw-semibold text-dark")">@task.Title</span>
                                    }
                                </div>
                                <span class="badge @task.BadgeColor rounded-pill">@task.BadgeText</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}


<div class="container-fluid py-4">
    <!-- Header & Bộ Lọc Lớp / Ngày -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-door-open me-1"></i>Chọn Lớp Học:</label>
                    <select id="selectClass" class="form-select" onchange="onFilterChange()">
                        @foreach (var c in classes)
                        {
                            <!option value="@c.Id" @(c.Id == Model.ClassId ? "selected" : "")>
                            @c.Name (@c.GradeLevel)
                            </!option>
                        }
                    </select>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-calendar3 me-1"></i>Ngày Điểm Danh:</label>
                    <input type="date" id="inputDate" class="form-control" value="@ViewBag.SelectedDate" onchange="onFilterChange()" />
                </div>
                <div class="col-lg-6 col-md-12 d-flex flex-wrap justify-content-lg-end justify-content-start align-items-end gap-2 mt-3 mt-lg-0">
                    @if (!isMobile)
                    {
                        <div>
                            <a asp-controller="Students" asp-action="PrintBadges" asp-route-classId="@Model.ClassId" target="_blank" class="btn btn-outline-info">
                                <i class="bi bi-printer me-1"></i> In Thẻ QR Lớp
                            </a>
                        </div>
                    }
                    <!-- Nút mở Popup Gửi Tin Nhắn Nhanh -->
                    <button type="button" class="btn btn-primary px-3 shadow-sm" onclick="openMessagePopup()">
                        <i class="bi bi-chat-text-fill me-1"></i> Mẫu Tin Nhắn Phụ Huynh
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Box Thông Báo Toast/Inline -->
    <div id="attendanceAlert" class="alert d-none shadow-sm border-0" role="alert"></div>
    <!-- THANH TRẠNG THÁI OFFLINE-FIRST & ĐỒNG BỘ INDEXEDDB (FEAT-P3-06) -->
    <div id="offlineAttendanceStatusBar" class="alert alert-light border shadow-sm rounded-3 py-2 px-3 mb-3 d-flex flex-wrap justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2 small">
            <i class="bi bi-cloud-check-fill text-primary fs-5"></i>
            <div>
                <span class="fw-bold text-dark">Bộ nhớ Điểm danh Offline (IndexedDB):</span>
                <span class="badge bg-primary-subtle text-primary border ms-1" id="badgeOfflineCachedCount">0 thiếu nhi</span>
                <span class="ms-2 text-muted">Chờ đồng bộ:</span>
                <span class="badge bg-secondary rounded-pill" id="badgeOfflinePendingCount">0</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 mt-2 mt-sm-0">
            <button type="button" id="btnOfflineManualSync" class="btn btn-sm btn-warning fw-bold rounded-pill px-3 d-none"
                    onclick="ParishOfflineEngine.syncPendingAttendances(true)">
                <i class="bi bi-cloud-arrow-up-fill me-1"></i> Đồng Bộ Ngay
            </button>
            <a asp-controller="MassCampaigns" asp-action="Index" asp-route-classId="@Model.ClassId"
               id="btnMassCampaigns" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold shadow-sm">
                <i class="bi bi-calendar2-heart-fill me-1"></i> Chiến Dịch Đi Lễ 1 Tháng (Lớp Bí Tích)
            </a>
        </div>
    </div>

    <!-- Thanh tiến trình đồng bộ Background Sync -->
    <div id="offlineSyncProgressWrap" class="card border-0 shadow-sm rounded-3 mb-3 p-3 bg-primary-subtle d-none">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="small fw-bold text-primary" id="offlineSyncProgressText">Đang đồng bộ dữ liệu điểm danh...</span>
            <span class="spinner-border spinner-border-sm text-primary"></span>
        </div>
        <div class="progress" style="height: 8px;">
            <div id="offlineSyncProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" style="width: 25%"></div>
        </div>
    </div>

    <!-- Bảng Điểm Danh Chuyên Cần -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border-0 rounded-top-3">
            <div>
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-card-checklist me-2 text-primary"></i>Sổ Chuyên Cần: @Model.ClassName
                </h5>
                <small class="text-muted">
                    Khối: <strong>@Model.GradeLevel</strong> | Ngày: <strong>@Model.AttendanceDate.ToString("dd/MM/yyyy") (@Model.DayOfWeek)</strong> | Sĩ số: <strong>@Model.Students.Count</strong> em
                </small>
            </div>
            <a asp-action="ScanQr" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                <i class="bi bi-qr-code-scan me-1"></i> Chế độ Quét QR Cổng
            </a>
        </div>

        @if (isMobile)
        {
            @if (Model.Students.Any())
            {
                <div class="mobile-att-sticky-header @(hasClassColumn ? "" : "mobile-att-sticky-header-single")">
                    <div class="mobile-att-sticky-col mobile-att-sticky-col-mass">
                        <i class="bi bi-bell-fill"></i>
                        <span>@(Model.DayOfWeek == DayOfWeek.Thursday ? "Đi lễ Thứ 5 (17h45)" : "Đi lễ Chúa Nhật")</span>
                    </div>
                    @if (hasClassColumn)
                    {
                        <div class="mobile-att-sticky-col mobile-att-sticky-col-class">
                            <i class="bi bi-book-fill"></i>
                            <span>Đi học Giáo lý</span>
                        </div>
                    }
                </div>
            }
            <!-- GIAO DIỆN MOBILE: DẠNG THẺ HỌC SINH (CỘT TRÁI: ĐI LỄ | CỘT PHẢI: ĐI HỌC) -->
            <div id="tableAttendance" class="mobile-att-list">
                @if (Model.Students.Any())
                {
                    var stt = 1;
                    foreach (var s in Model.Students)
                    {
                        <div class="mobile-att-card"
                             data-enrollment-id="@s.EnrollmentId"
                             data-student-id="@s.StudentId"
                             data-student-code="@s.StudentCode"
                             data-student-name="@s.ChristianName @s.FullName">

                            <!-- HÀNG TRÊN: THÔNG TIN HỌC SINH -->
                            <div class="mobile-att-info">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill">#@(stt++)</span>
                                            <span class="badge bg-light text-dark border font-monospace student-code-badge">@s.StudentCode</span>
                                            <small class="text-muted">(@s.Gender)</small>
                                            <span class="badge rounded-pill d-none quick-save-badge"></span>
                                        </div>
                                        <div class="mobile-att-student-name student-fullname-text">@s.ChristianName @s.FullName</div>
                                    </div>
                                    <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-2 py-1"
                                                title="Copy tin nhắn báo vắng gửi Phụ huynh"
                                                data-enrollment-id="@s.EnrollmentId"
                                                onclick="quickCopyAbsenceMessageFromRow(this)">
                                            <i class="bi bi-chat-dots-fill"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-info btn-sm rounded-circle p-1 px-2"
                                                title="Xem lịch sử điểm danh"
                                                data-student-id="@s.StudentId"
                                                data-student-name="@s.FullName"
                                                onclick="openAuditTimelineFromBtn(this)">
                                            <i class="bi bi-clock-history"></i>
                                        </button>
                                    </div>
                                </div>
                                <input type="text" class="form-control form-control-sm input-note mt-1"
                                       placeholder="Ghi chú lý do vắng/trễ..." value="@s.Note" onchange="onNoteChange(this)" />
                            </div>

                            <!-- HÀNG DƯỚI: 2 CỘT (ĐI LỄ CHÚA NHẬT | ĐI HỌC GIÁO LÝ) HOẶC THỨ 5 (1 CỘT: ĐI LỄ THỨ 5) -->
                            @if (hasClassColumn)
                            {
                                <div class="mobile-att-split-row">
                                    <!-- CỘT TRÁI: ĐI LỄ CHÚA NHẬT -->
                                    <div class="mobile-att-col mobile-att-col-left">
                                        <div class="mobile-att-slot-label text-success">
                                            <span><i class="bi bi-bell-fill me-1"></i>Đi lễ CN</span>
                                            @if (s.MassCheckInTime.HasValue)
                                            {
                                                <small class="text-muted fw-normal">@s.MassCheckInTime.Value.ToString(@"hh\:mm")</small>
                                            }
                                        </div>
                                        <div class="mobile-att-controls">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input chk-mass" type="checkbox" role="switch"
                                                       @(s.AttendedMass ? "checked" : "") onchange="onMassToggle(this)" />
                                            </div>
                                            <select class="form-select form-select-sm select-mass-status" onchange="onMassStatusChange(this)">
                                                <!option value="LINED_UP" @(s.MassStatus == "LINED_UP" ? "selected" : "")>Xếp hàng</!option>
                                                <!option value="PRESENT" @(s.MassStatus == "PRESENT" ? "selected" : "")>Có mặt</!option>
                                                <!option value="LATE" @(s.MassStatus == "LATE" ? "selected" : "")>Đi trễ</!option>
                                                <!option value="ABSENT_PERMITTED" @(s.MassStatus == "ABSENT_PERMITTED" ? "selected" : "")>Vắng có phép</!option>
                                                <!option value="ABSENT_UNPERMITTED" @(s.MassStatus == "ABSENT_UNPERMITTED" ? "selected" : "")>Vắng k.phép</!option>
                                            </select>
                                        </div>
                                    </div>

                                    <!-- CỘT PHẢI: ĐI HỌC CN -->
                                    <div class="mobile-att-col mobile-att-col-right">
                                        <div class="mobile-att-slot-label text-primary">
                                            <span><i class="bi bi-book me-1"></i>Đi học CN</span>
                                            @if (s.ClassCheckInTime.HasValue)
                                            {
                                                <small class="text-muted fw-normal">@s.ClassCheckInTime.Value.ToString(@"hh\:mm")</small>
                                            }
                                        </div>
                                        <div class="mobile-att-controls">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input chk-class" type="checkbox" role="switch"
                                                       @(s.ClassAttended ? "checked" : "") onchange="onClassToggle(this)" />
                                            </div>
                                            <select class="form-select form-select-sm select-class-status" onchange="onClassStatusChange(this)">
                                                <!option value="PRESENT" @(s.ClassStatus == "PRESENT" ? "selected" : "")>Có mặt</!option>
                                                <!option value="LATE" @(s.ClassStatus == "LATE" ? "selected" : "")>Đi trễ</!option>
                                                <!option value="ABSENT_PERMITTED" @(s.ClassStatus == "ABSENT_PERMITTED" ? "selected" : "")>Vắng có phép</!option>
                                                <!option value="ABSENT_UNPERMITTED" @(s.ClassStatus == "ABSENT_UNPERMITTED" ? "selected" : "")>Vắng k.phép</!option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- TRƯỜNG HỢP 2: NGÀY THỨ 5 (CHỈ ĐI LỄ THỨ 5 - 1 CỘT TOÀN CHIỀU NGANG) -->
                                <div class="mobile-att-single-row">
                                    <div class="mobile-att-slot-label text-success">
                                        <span>
                                            <i class="bi bi-bell-fill me-1"></i>Đi lễ Thứ 5 (17h45)
                                        </span>
                                        @if (s.MassCheckInTime.HasValue)
                                        {
                                            <small class="text-muted fw-normal">Giờ quét: @s.MassCheckInTime.Value.ToString(@"hh\:mm")</small>
                                        }
                                    </div>
                                    <div class="mobile-att-controls">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input chk-mass" type="checkbox" role="switch"
                                                   @(s.AttendedMass ? "checked" : "") onchange="onMassToggle(this)" />
                                        </div>
                                        <select class="form-select form-select-sm select-mass-status" onchange="onMassStatusChange(this)">
                                            <!option value="LINED_UP" @(s.MassStatus == "LINED_UP" ? "selected" : "")>Xếp hàng</!option>
                                            <!option value="PRESENT" @(s.MassStatus == "PRESENT" ? "selected" : "")>Có mặt</!option>
                                            <!option value="LATE" @(s.MassStatus == "LATE" ? "selected" : "")>Đi trễ</!option>
                                            <!option value="ABSENT_PERMITTED" @(s.MassStatus == "ABSENT_PERMITTED" ? "selected" : "")>Vắng có phép</!option>
                                            <!option value="ABSENT_UNPERMITTED" @(s.MassStatus == "ABSENT_UNPERMITTED" ? "selected" : "")>Vắng k.phép</!option>
                                        </select>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted bg-white rounded-3 border">
                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                        Lớp chưa có thiếu nhi nào hoặc chưa được kích hoạt.
                    </div>
                }
            </div>
        }
        else
        {
            <!-- GIAO DIỆN DESKTOP (CỘT TRÁI: THÁNH LỄ | CỘT PHẢI: GIỜ HỌC GIÁO LÝ + STICKY HEADER) -->
            <div class="attendance-table-wrap">
                <table class="table table-hover align-middle mb-0" id="tableAttendance">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3 text-center" style="width: 45px;">STT</th>
                            <th>Mã QR</th>
                            <th>Họ Và Tên</th>
                            <th class="text-center bg-success-subtle text-success border-start border-end" style="width: 245px;">
                                <i class="bi bi-bell-fill me-1"></i>THÁNH LỄ (@(Model.DayOfWeek == DayOfWeek.Thursday ? "T5 17h45" : "CN 6h30"))
                            </th>
                            @if (hasClassColumn)
                            {
                                <th class="text-center bg-primary-subtle text-primary border-end" style="width: 245px;">
                                    <i class="bi bi-book me-1"></i>GIỜ HỌC GIÁO LÝ
                                </th>
                            }
                            <th>Ghi Chú</th>
                            <th class="text-center" style="width: 110px;">Tin Nhắn PH</th>
                            <th class="text-center" style="width: 100px;">Xem lịch sử</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Students.Any())
                        {
                            var stt = 1;
                            foreach (var s in Model.Students)
                            {
                                <tr data-enrollment-id="@s.EnrollmentId"
                                    data-student-id="@s.StudentId"
                                    data-student-code="@s.StudentCode"
                                    data-student-name="@s.ChristianName @s.FullName">
                                    <td class="ps-3 text-center fw-bold text-muted">@(stt++)</td>
                                    <td>
                                        <span class="badge bg-light text-dark border font-monospace student-code-badge">@s.StudentCode</span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark student-fullname-text">@s.ChristianName @s.FullName</div>
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <small class="text-muted">Giới tính: @s.Gender</small>
                                            <span class="badge rounded-pill d-none quick-save-badge"></span>
                                        </div>
                                    </td>

                                    <!-- CỘT 1: CHUYÊN CẦN THÁNH LỄ -->
                                    <td class="border-start border-end bg-light-subtle">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle flex-shrink-0">Lễ</span>
                                            <div class="form-check form-switch mb-0">
                                                <input class="form-check-input chk-mass" type="checkbox" role="switch"
                                                       @(s.AttendedMass ? "checked" : "") onchange="onMassToggle(this)" />
                                            </div>
                                            <select class="form-select form-select-sm select-mass-status" onchange="onMassStatusChange(this)">
                                                <!option value="LINED_UP" @(s.MassStatus == "LINED_UP" ? "selected" : "")>Xếp hàng</!option>
                                                <!option value="PRESENT" @(s.MassStatus == "PRESENT" ? "selected" : "")>Có mặt</!option>
                                                <!option value="LATE" @(s.MassStatus == "LATE" ? "selected" : "")>Đi trễ</!option>
                                                <!option value="ABSENT_PERMITTED" @(s.MassStatus == "ABSENT_PERMITTED" ? "selected" : "")>Vắng có phép</!option>
                                                <!option value="ABSENT_UNPERMITTED" @(s.MassStatus == "ABSENT_UNPERMITTED" ? "selected" : "")>Vắng k.phép</!option>
                                            </select>
                                        </div>
                                        @if (s.MassCheckInTime.HasValue)
                                        {
                                            <small class="text-muted d-block mt-1">Giờ quét: @s.MassCheckInTime.Value.ToString(@"hh\:mm")</small>
                                        }
                                    </td>

                                    <!-- CỘT 2: CHUYÊN CẦN HỌC GIÁO LÝ -->
                                    @if (hasClassColumn)
                                    {
                                        <td class="border-end bg-light-subtle">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle flex-shrink-0">Học</span>
                                                <div class="form-check form-switch mb-0">
                                                    <input class="form-check-input chk-class" type="checkbox" role="switch"
                                                           @(s.ClassAttended ? "checked" : "") onchange="onClassToggle(this)" />
                                                </div>
                                                <select class="form-select form-select-sm select-class-status" onchange="onClassStatusChange(this)">
                                                    <!option value="PRESENT" @(s.ClassStatus == "PRESENT" ? "selected" : "")>Có mặt</!option>
                                                    <!option value="LATE" @(s.ClassStatus == "LATE" ? "selected" : "")>Đi trễ</!option>
                                                    <!option value="ABSENT_PERMITTED" @(s.ClassStatus == "ABSENT_PERMITTED" ? "selected" : "")>Vắng có phép</!option>
                                                    <!option value="ABSENT_UNPERMITTED" @(s.ClassStatus == "ABSENT_UNPERMITTED" ? "selected" : "")>Vắng k.phép</!option>
                                                </select>
                                            </div>
                                            @if (s.ClassCheckInTime.HasValue)
                                            {
                                                <small class="text-muted d-block mt-1">Giờ vào: @s.ClassCheckInTime.Value.ToString(@"hh\:mm")</small>
                                            }
                                        </td>
                                    }

                                    <td>
                                        <input type="text" class="form-control form-control-sm input-note" placeholder="Lý do/ghi chú..." value="@s.Note" onchange="onNoteChange(this)" />
                                    </td>
                                    <td>
                                        <!-- NÚT 1-CLICK COPY TIN BÁO VẮNG GỬI ZALO/VIBER (TASK-P3-07.4) -->
                                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-2"
                                                title="1-Click Copy tin nhắn báo vắng / đi trễ gửi Phụ huynh"
                                                data-enrollment-id="@s.EnrollmentId"
                                                onclick="quickCopyAbsenceMessageFromRow(this)">
                                            <i class="bi bi-chat-dots-fill"></i> Copy Tin
                                        </button>
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-info rounded-circle ms-1 p-1"
                                                title="Xem lịch sử điểm danh"
                                                data-student-id="@s.StudentId"
                                                data-student-name="@s.FullName"
                                                onclick="openAuditTimelineFromBtn(this)">
                                            <i class="bi bi-clock-history"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(hasClassColumn ? 8 : 7)" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    Lớp chưa có thiếu nhi nào hoặc chưa được kích hoạt.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

