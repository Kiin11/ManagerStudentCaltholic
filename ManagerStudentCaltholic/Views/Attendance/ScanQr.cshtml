@using ManagerStudentCaltholic.Extensions
@{
    ViewData["Title"] = "Quét Mã QR Điểm Danh";
    bool isMobile = Context.Request.IsMobileDevice();
    string recommendedMode = ViewBag.RecommendedSessionMode as string ?? "SUNDAY_MASS";
}

@Html.AntiForgeryToken()

<div class="qr-scanner-page @(isMobile ? "mobile-view" : "desktop-view")">
    <!-- KHUNG ĐIỀU KHIỂN & CAMERA HUD TOÀN DIỆN -->
    <div class="scanner-viewport-container">
        <!-- VÙNG CAMERA CHÍNH (VIEWFINDER HUD) -->
        <div class="camera-hud-box" id="cameraHudBox">
            <!-- Html5Qrcode Reader Mount Point -->
            <div id="reader" class="camera-stream-reader"></div>

            <!-- LỚP PHỦ GIAO DIỆN HUD TRÊN CAMERA -->
            <div class="hud-interactive-overlay">
                <!-- 1. THANH TRẠNG THÁI & CHỌN NHANH BUỔI QUÉT TRÊN ĐẦU CAMERA -->
                <div class="hud-top-section">
                    <!-- Hàng 1: Trạng thái kết nối & Bộ nhớ Offline -->
                    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                        <div class="d-flex align-items-center gap-2">
                            <span id="hudNetworkBadge" class="badge rounded-pill bg-dark bg-opacity-75 border border-success text-success px-2 py-1 small">
                                <i class="bi bi-wifi me-1"></i><span id="hudNetworkText">Trực tuyến</span>
                            </span>
                            <span id="hudOfflinePendingBadge" class="badge rounded-pill bg-dark bg-opacity-75 border border-secondary text-light px-2 py-1 small" title="Lượt quét chờ đồng bộ trong IndexedDB">
                                <i class="bi bi-database me-1"></i><span id="hudPendingCount">0</span> chờ sync
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <button type="button" id="btnHudManualSync" class="btn btn-warning btn-sm rounded-pill py-0 px-2 fw-bold d-none shadow-sm" onclick="ParishOfflineEngine.syncPendingAttendances(true)">
                                <i class="bi bi-arrow-repeat me-1"></i>Sync ngay
                            </button>
                            <a asp-action="Index" class="btn btn-sm btn-dark bg-opacity-75 border border-white border-opacity-25 rounded-circle text-white p-2 shadow-sm" title="Trở về Sổ Lớp">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Hàng 2: TASK-P5-04.2: Thanh Chuyển đổi Nhanh Buổi Quét (Session Quick-Switcher) -->
                    <div class="session-quick-switcher" role="group" aria-label="Chọn buổi quét">
                        <button type="button" class="btn-session-mode @(recommendedMode == "SUNDAY_MASS" ? "active" : "")" data-mode="SUNDAY_MASS" onclick="setSessionMode('SUNDAY_MASS')">
                            <i class="bi bi-sun-fill me-1 text-warning"></i><span>Lễ Chúa Nhật</span>
                        </button>
                        <button type="button" class="btn-session-mode @(recommendedMode == "THURSDAY_MASS" ? "active" : "")" data-mode="THURSDAY_MASS" onclick="setSessionMode('THURSDAY_MASS')">
                            <i class="bi bi-fire me-1 text-danger"></i><span>Lễ Thứ Năm</span>
                        </button>
                        <button type="button" class="btn-session-mode @(recommendedMode == "CATECHISM_CLASS" ? "active" : "")" data-mode="CATECHISM_CLASS" onclick="setSessionMode('CATECHISM_CLASS')">
                            <i class="bi bi-book-half me-1 text-info"></i><span>Học Giáo Lý</span>
                        </button>
                        <button type="button" class="btn-session-mode @(recommendedMode == "CAMPAIGN_MONTH" ? "active" : "")" data-mode="CAMPAIGN_MONTH" onclick="setSessionMode('CAMPAIGN_MONTH')">
                            <i class="bi bi-trophy-fill me-1 text-warning"></i><span>Chiến Dịch 1T</span>
                        </button>
                    </div>
                </div>

                <!-- 2. TASK-P5-04.1: KHUNG NGẮM ĐỊNH TÂM TỰ ĐỔI MÀU (VIEWFINDER HUD) -->
                <div class="hud-center-section">
                    <div class="viewfinder-frame hud-idle" id="viewfinderFrame">
                        <!-- 4 góc ngắm quét QR hiện đại -->
                        <div class="hud-corner corner-tl"></div>
                        <div class="hud-corner corner-tr"></div>
                        <div class="hud-corner corner-bl"></div>
                        <div class="hud-corner corner-br"></div>

                        <!-- Tia Laser quét chuyển động -->
                        <div class="hud-laser" id="hudLaser"></div>

                        <!-- Gợi ý ngắm thẻ -->
                        <div class="viewfinder-hint" id="viewfinderHint">
                            <i class="bi bi-qr-code me-1"></i> Căn giữa mã QR thẻ thiếu nhi
                        </div>
                    </div>

                    <!-- Thanh điều khiển phần cứng nổi cạnh khung ngắm (Hardware Bar) -->
                    <div class="hud-hardware-toolbar">
                        <button type="button" id="btnToggleTorch" class="btn-hud-tool" onclick="toggleTorch()" title="Bật/Tắt đèn Flash" disabled>
                            <i class="bi bi-lightning-charge fs-5"></i>
                        </button>
                        <button type="button" id="btnFlipCamera" class="btn-hud-tool" onclick="switchCamera()" title="Đổi camera trước/sau">
                            <i class="bi bi-camera-reverse fs-5"></i>
                        </button>
                        <button type="button" id="btnToggleMute" class="btn-hud-tool" onclick="toggleMuteAudio()" title="Bật/Tắt âm báo">
                            <i class="bi bi-volume-up fs-5" id="iconMute"></i>
                        </button>
                        <button type="button" id="btnToggleFullscreen" class="btn-hud-tool" onclick="toggleFullscreenView()" title="Toàn màn hình">
                            <i class="bi bi-arrows-fullscreen fs-5"></i>
                        </button>
                    </div>

                    <!-- Thanh trượt Zoom phần cứng (nếu thiết bị hỗ trợ) -->
                    <div class="hud-zoom-container d-none" id="hudZoomContainer">
                        <i class="bi bi-zoom-out text-white small"></i>
                        <input type="range" class="form-range hud-zoom-slider" id="hudZoomSlider" min="1" max="3" step="0.1" value="1" oninput="handleZoomChange(this.value)">
                        <i class="bi bi-zoom-in text-white small"></i>
                        <span class="badge bg-dark bg-opacity-75 text-info py-0 px-1 font-monospace" id="hudZoomBadge">1.0x</span>
                    </div>
                </div>

                <!-- 3. TASK-P5-04.3: KHAY LỊCH SỬ VỪA QUÉT (RECENT SCANS DRAWER) & HOÀN TÁC 5 GIÂY -->
                <div class="hud-bottom-section">
                    <!-- Thẻ Kết quả vừa quét (Recent Result Card) -->
                    <div class="hud-result-card" id="hudResultCard">
                        <!-- Trạng thái chờ -->
                        <div id="resultCardEmpty" class="py-2 text-center text-white-50">
                            <i class="bi bi-upc-scan fs-4 text-primary opacity-75 d-block mb-1"></i>
                            <div class="fw-semibold text-white small">Đang quét camera liên tục...</div>
                            <span class="badge bg-dark bg-opacity-50 text-white-50 font-monospace small">Niên khóa: @ViewBag.AcademicYearName</span>
                        </div>

                        <!-- Trạng thái khi vừa quét xong -->
                        <div id="resultCardContent" class="d-none">
                            <!-- Banner cảnh báo Thẻ Mã Năm Cũ (TASK-P5-04.2) -->
                            <div id="resultCardOldCodeAlert" class="alert alert-warning py-1 px-2 mb-2 rounded-3 border-2 border-warning d-none small">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-exclamation-triangle-fill text-warning fs-5 me-2"></i>
                                    <div>
                                        <strong class="text-dark">THẺ MÃ NĂM CŨ!</strong> Cần in lại thẻ mới.<br/>
                                        Mã thẻ cũ: <code id="lblOldCode" class="fw-bold"></code> ➔ Mã mới: <code id="lblNewCode" class="fw-bold text-primary"></code>
                                    </div>
                                </div>
                            </div>

                            <!-- Thông tin học sinh & Trạng thái -->
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="text-start">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-primary px-2 py-1 rounded-pill small" id="lblActivityType">THÁNH LỄ</span>
                                        <span class="badge bg-success px-2 py-1 rounded-pill small fw-bold" id="lblScanStatus">CÓ MẶT</span>
                                        <span class="text-white-50 font-monospace small" id="lblCheckInTime">07:00:00</span>
                                    </div>
                                    <h5 class="fw-bold text-white mb-0" id="lblStudentName">...</h5>
                                    <div class="text-white-50 small">
                                        Lớp: <strong class="text-white" id="lblClassName">...</strong>
                                        <span class="mx-1">|</span> Mã: <span class="font-monospace text-info" id="lblStudentCode">...</span>
                                    </div>
                                </div>

                                <!-- TASK-P5-04.3: Nút Hoàn tác 5 Giây kèm thanh đếm lùi -->
                                <div class="d-flex flex-column align-items-end" id="undoWrapper">
                                    <button type="button" id="btnUndoScan" class="btn btn-warning btn-sm rounded-pill px-3 py-1 fw-bold shadow-sm d-flex align-items-center gap-1" onclick="triggerUndoLastScan()">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                        <span>Hoàn tác (<span id="undoSeconds">5</span>s)</span>
                                    </button>
                                    <div class="undo-progress-bar-wrap mt-1">
                                        <div class="undo-progress-bar" id="undoProgressBar"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Thanh tóm tắt Sĩ số ca quét & Nút bật Khay Lịch sử -->
                    <div class="hud-stats-bar">
                        <div class="stats-pills-wrap">
                            <span class="stat-item"><i class="bi bi-people-fill text-primary me-1"></i>Đã quét: <strong id="statTotalScanned">0</strong></span>
                            <span class="stat-item text-success"><i class="bi bi-check-circle-fill me-1"></i>Đúng giờ: <strong id="statOnTime">0</strong></span>
                            <span class="stat-item text-warning"><i class="bi bi-clock-history me-1"></i>Trễ: <strong id="statLate">0</strong></span>
                            <span class="stat-item text-danger"><i class="bi bi-qr-code text-warning me-1"></i>Mã cũ: <strong id="statOldCode">0</strong></span>
                        </div>
                        <button type="button" class="btn btn-sm btn-dark bg-opacity-75 text-white rounded-pill px-3 py-1 border border-white border-opacity-25" onclick="toggleRecentScansDrawer()">
                            <i class="bi bi-clock-history me-1"></i><span>Lịch sử</span>
                            <i class="bi bi-chevron-up ms-1" id="iconDrawerChevron"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- KHAY TRƯỢT LỊCH SỬ VỪA QUÉT (DRAWER SHEET) -->
        <div class="recent-scans-drawer collapsed" id="recentScansDrawer">
            <div class="drawer-header d-flex justify-content-between align-items-center p-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-primary fs-5"></i>
                    <h6 class="fw-bold mb-0 text-dark">Lịch Sử Quét Trong Buổi</h6>
                    <span class="badge bg-secondary rounded-pill" id="badgeDrawerCount">0 lượt</span>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-2 py-0" onclick="clearLocalHistory()">
                        Xóa lịch sử
                    </button>
                    <button type="button" class="btn btn-light btn-sm rounded-circle p-1" onclick="toggleRecentScansDrawer()">
                        <i class="bi bi-chevron-down fs-5"></i>
                    </button>
                </div>
            </div>

            <!-- Ô nhập tay súng quét mã USB cầm tay -->
            <div class="p-3 bg-light border-bottom">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-upc-scan text-primary"></i></span>
                    <input type="text" id="manualBarcodeInput" class="form-control font-monospace text-uppercase" placeholder="Dành cho súng quét USB hoặc gõ mã..." autocomplete="off">
                    <button class="btn btn-primary fw-bold px-3" type="button" onclick="submitManualBarcode()">Check-in</button>
                </div>
            </div>

            <!-- Bảng cuộn danh sách lịch sử -->
            <div class="drawer-body p-0 table-responsive" style="max-height: 280px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0" id="tableHistoryRecent">
                    <thead class="table-light small sticky-top">
                        <tr>
                            <th class="ps-3 py-2">Thời gian</th>
                            <th class="py-2">Thiếu Nhi</th>
                            <th class="py-2">Lớp</th>
                            <th class="py-2 text-center">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyHistoryRecent">
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted small">Chưa có lượt quét nào trong buổi này.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    /* CSS VIEWPORT & HUD CHO TOÀN BỘ MÀN HÌNH QUÉT QR (FEAT-P5-04) */
    .qr-scanner-page {
        position: relative;
        width: 100%;
        user-select: none;
    }

    .qr-scanner-page.mobile-view {
        height: calc(100dvh - 58px);
        overflow: hidden !important;
        margin: 0;
        padding: 0;
    }

    .qr-scanner-page.desktop-view {
        max-width: 960px;
        margin: 12px auto;
        padding: 0 12px;
    }

    .scanner-viewport-container {
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
        width: 100%;
    }

    /* Khung Camera HUD chính */
    .camera-hud-box {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 480px;
        background: #000;
        overflow: hidden;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    }

    .qr-scanner-page.mobile-view .camera-hud-box {
        border-radius: 0;
        min-height: calc(100dvh - 58px);
    }

    .camera-stream-reader {
        width: 100% !important;
        height: 100% !important;
        border: none !important;
        background: #000;
    }

    .camera-stream-reader video {
        object-fit: cover !important;
        width: 100% !important;
        height: 100% !important;
        background: #000;
    }

    /* Lớp phủ tương tác HUD */
    .hud-interactive-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        pointer-events: none;
        z-index: 20;
    }

    /* Phân khu trên HUD */
    .hud-top-section {
        padding: 10px 12px;
        background: linear-gradient(180deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.3) 70%, transparent 100%);
        pointer-events: auto;
    }

    /* Thanh chọn nhanh Buổi quét (TASK-P5-04.2) */
    .session-quick-switcher {
        display: flex;
        gap: 6px;
        overflow-x: auto;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 2px;
    }

    .session-quick-switcher::-webkit-scrollbar {
        display: none;
    }

    .btn-session-mode {
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        background: rgba(25, 25, 30, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.82rem;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 30px;
        backdrop-filter: blur(8px);
        transition: all 0.2s ease;
        touch-action: manipulation;
    }

    .btn-session-mode:hover {
        background: rgba(40, 40, 50, 0.85);
        color: #fff;
    }

    .btn-session-mode.active {
        background: #0d6efd;
        border-color: #0d6efd;
        color: #fff;
        box-shadow: 0 0 14px rgba(13, 110, 253, 0.7);
    }

    /* Phân khu giữa: Khung ngắm HUD (TASK-P5-04.1) */
    .hud-center-section {
        position: relative;
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .viewfinder-frame {
        position: relative;
        width: 250px;
        height: 250px;
        max-width: 70vw;
        max-height: 70vw;
        border-radius: 20px;
        transition: all 0.25s ease;
        box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.45);
    }

    /* 4 góc ngắm quét */
    .hud-corner {
        position: absolute;
        width: 26px;
        height: 26px;
        border-style: solid;
        border-width: 4px;
        transition: border-color 0.25s ease;
    }

    .corner-tl { top: -2px; left: -2px; border-right: none; border-bottom: none; border-top-left-radius: 16px; }
    .corner-tr { top: -2px; right: -2px; border-left: none; border-bottom: none; border-top-right-radius: 16px; }
    .corner-bl { bottom: -2px; left: -2px; border-right: none; border-top: none; border-bottom-left-radius: 16px; }
    .corner-br { bottom: -2px; right: -2px; border-left: none; border-top: none; border-bottom-right-radius: 16px; }

    /* Tia laser scan chuyển động */
    .hud-laser {
        position: absolute;
        left: 5%;
        right: 5%;
        height: 3px;
        background: linear-gradient(90deg, transparent, #0dcaf0, #fff, #0dcaf0, transparent);
        box-shadow: 0 0 10px #0dcaf0;
        animation: scanLaser 2.2s infinite ease-in-out;
    }

    @@keyframes scanLaser {
        0% { top: 8%; opacity: 0.8; }
        50% { top: 88%; opacity: 1; }
        100% { top: 8%; opacity: 0.8; }
    }

    .viewfinder-hint {
        position: absolute;
        bottom: -32px;
        left: 50%;
        transform: translateX(-50%);
        white-space: nowrap;
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.78rem;
        background: rgba(0, 0, 0, 0.6);
        padding: 2px 10px;
        border-radius: 12px;
        backdrop-filter: blur(4px);
    }

    /* Trạng thái đổi màu Khung ngắm (TASK-P5-04.1) */
    .viewfinder-frame.hud-idle .hud-corner { border-color: #0dcaf0; }
    .viewfinder-frame.hud-idle { box-shadow: 0 0 16px rgba(13, 202, 240, 0.3), 0 0 0 9999px rgba(0, 0, 0, 0.45); }

    .viewfinder-frame.hud-success .hud-corner { border-color: #198754; }
    .viewfinder-frame.hud-success .hud-laser { background: #198754; box-shadow: 0 0 12px #198754; }
    .viewfinder-frame.hud-success { box-shadow: 0 0 28px rgba(25, 135, 84, 0.8), 0 0 0 9999px rgba(0, 0, 0, 0.45); }

    .viewfinder-frame.hud-warning .hud-corner { border-color: #ffc107; }
    .viewfinder-frame.hud-warning .hud-laser { background: #ffc107; box-shadow: 0 0 12px #ffc107; }
    .viewfinder-frame.hud-warning { box-shadow: 0 0 28px rgba(255, 193, 7, 0.8), 0 0 0 9999px rgba(0, 0, 0, 0.45); }

    .viewfinder-frame.hud-error .hud-corner { border-color: #dc3545; }
    .viewfinder-frame.hud-error .hud-laser { background: #dc3545; box-shadow: 0 0 12px #dc3545; }
    .viewfinder-frame.hud-error { box-shadow: 0 0 28px rgba(220, 53, 69, 0.8), 0 0 0 9999px rgba(0, 0, 0, 0.45); }

    /* Thanh điều khiển phần cứng dọc (Hardware Toolbar) */
    .hud-hardware-toolbar {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        flex-direction: column;
        gap: 8px;
        pointer-events: auto;
    }

    .btn-hud-tool {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: rgba(20, 20, 25, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(6px);
        transition: all 0.2s ease;
        touch-action: manipulation;
    }

    .btn-hud-tool:hover:not(:disabled) {
        background: rgba(50, 50, 60, 0.9);
        color: #0dcaf0;
        transform: scale(1.06);
    }

    .btn-hud-tool.active {
        background: #ffc107;
        color: #000;
        border-color: #ffc107;
        box-shadow: 0 0 12px rgba(255, 193, 7, 0.8);
    }

    .btn-hud-tool:disabled {
        opacity: 0.35;
        cursor: not-allowed;
    }

    /* Thanh trượt Zoom phần cứng */
    .hud-zoom-container {
        position: absolute;
        bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(0, 0, 0, 0.65);
        padding: 4px 12px;
        border-radius: 20px;
        backdrop-filter: blur(6px);
        pointer-events: auto;
    }

    .hud-zoom-slider {
        width: 120px;
        accent-color: #0dcaf0;
    }

    /* Phân khu dưới: Kết quả quét & Sĩ số (TASK-P5-04.3) */
    .hud-bottom-section {
        padding: 10px 12px;
        background: linear-gradient(0deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 75%, transparent 100%);
        pointer-events: auto;
    }

    .hud-result-card {
        background: rgba(20, 25, 32, 0.88);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 16px;
        padding: 10px 14px;
        backdrop-filter: blur(10px);
        box-shadow: 0 6px 18px rgba(0,0,0,0.4);
        margin-bottom: 8px;
        transition: all 0.25s ease;
    }

    .hud-result-card.status-success {
        border-color: #198754;
        background: rgba(10, 35, 20, 0.9);
    }

    .hud-result-card.status-late {
        border-color: #ffc107;
        background: rgba(45, 35, 10, 0.9);
    }

    .hud-result-card.status-error {
        border-color: #dc3545;
        background: rgba(45, 15, 18, 0.9);
    }

    /* Thanh đếm lùi Hoàn tác 5 Giây */
    .undo-progress-bar-wrap {
        width: 90px;
        height: 3px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 2px;
        overflow: hidden;
    }

    .undo-progress-bar {
        height: 100%;
        width: 100%;
        background: #ffc107;
        transition: width 0.1s linear;
    }

    /* Thanh tóm tắt Sĩ số */
    .hud-stats-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.82rem;
    }

    .stats-pills-wrap {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .stat-item {
        background: rgba(255, 255, 255, 0.1);
        padding: 2px 8px;
        border-radius: 12px;
    }

    /* Khay lịch sử trượt (Recent Scans Drawer) */
    .recent-scans-drawer {
        background: #fff;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.25);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 30;
    }

    .recent-scans-drawer.collapsed {
        display: none;
    }
</style>

@section Scripts {
    <script src="~/lib/html5-qrcode/html5-qrcode.min.js"></script>
    <script>
        // TRẠNG THÁI CAMERA & HUD
        let html5QrCode = null;
        let isCameraRunning = false;
        let currentFacingMode = "environment";
        let isMuted = false;
        let currentSessionMode = "@recommendedMode";
        let mediaStreamTrack = null;
        let isTorchOn = false;

        // TASK-P5-04.4: BỘ ĐỆM CHỐNG QUÉT TRÙNG 3 GIÂY
        const recentScannedCodesMap = new Map();
        let isScanInFlight = false;

        // TASK-P5-04.3: QUẢN LÝ HOÀN TÁC (UNDO) 5 GIÂY
        let lastScanResult = null;
        let undoTimer = null;
        let undoProgressInterval = null;
        const UNDO_DURATION_MS = 5000;
        let undoStartTime = 0;

        // BỘ ĐẾM SĨ SỐ BUỔI QUÉT
        let sessionStats = {
            total: 0,
            onTime: 0,
            late: 0,
            oldCode: 0
        };

        document.addEventListener("DOMContentLoaded", function () {
            // Tải trước danh sách offline nếu có mạng
            if (navigator.onLine && typeof ParishOfflineEngine !== "undefined") {
                ParishOfflineEngine.prefetchStudentsCache();
            }

            // Khởi động Camera quét liên tục
            startCamera();

            // Lắng nghe mạng
            window.addEventListener('online', updateNetworkHudStatus);
            window.addEventListener('offline', updateNetworkHudStatus);
            updateNetworkHudStatus();

            // Gán phím Enter cho súng quét USB
            const barcodeInput = document.getElementById("manualBarcodeInput");
            if (barcodeInput) {
                barcodeInput.addEventListener("keydown", function (e) {
                    if (e.key === "Enter") {
                        e.preventDefault();
                        submitManualBarcode();
                    }
                });
            }
        });

        // 1. CẬP NHẬT TRẠNG THÁI MẠNG TRÊN HUD
        async function updateNetworkHudStatus() {
            const isOnline = navigator.onLine;
            const badge = document.getElementById("hudNetworkBadge");
            const text = document.getElementById("hudNetworkText");
            const syncBtn = document.getElementById("btnHudManualSync");
            const pendingBadge = document.getElementById("hudPendingCount");

            if (isOnline) {
                badge.className = "badge rounded-pill bg-dark bg-opacity-75 border border-success text-success px-2 py-1 small";
                text.textContent = "Trực tuyến";
            } else {
                badge.className = "badge rounded-pill bg-dark bg-opacity-75 border border-warning text-warning px-2 py-1 small";
                text.textContent = "Ngoại tuyến (Offline)";
            }

            if (typeof ParishOfflineEngine !== "undefined") {
                const stats = await ParishOfflineEngine.updateOfflineUiCounters();
                if (badgeOfflinePendingCount = document.getElementById('badgeOfflinePendingCount')) {
                    const count = parseInt(badgeOfflinePendingCount.textContent || "0");
                    if (pendingBadge) pendingBadge.textContent = count;
                    if (syncBtn) syncBtn.classList.toggle('d-none', count === 0 || !isOnline);
                }
            }
        }

        // 2. CHUYỂN ĐỔI NHANH BUỔI QUÉT (TASK-P5-04.2)
        function setSessionMode(mode) {
            currentSessionMode = mode;
            document.querySelectorAll(".btn-session-mode").forEach(btn => {
                btn.classList.toggle("active", btn.getAttribute("data-mode") === mode);
            });
            playBeep(true, false, 600, 0.08);
        }

        // 3. ÂM BÁO PHẢN HỒI (WEB AUDIO API SYNTHESIZER) & RUNG
        function playBeep(isSuccess = true, isWarning = false, customFreq = null, customDuration = null) {
            if (isMuted) return;
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);

                if (customFreq) {
                    osc.frequency.value = customFreq;
                    gain.gain.setValueAtTime(0.25, ctx.currentTime);
                    osc.start();
                    osc.stop(ctx.currentTime + (customDuration || 0.15));
                } else if (isWarning) {
                    // Âm cảnh báo (Hai nốt: 587Hz -> 440Hz)
                    osc.frequency.setValueAtTime(587.33, ctx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(440, ctx.currentTime + 0.22);
                    gain.gain.setValueAtTime(0.35, ctx.currentTime);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.25);
                } else if (isSuccess) {
                    // Âm thành công (Hài âm kép trong trẻo: 880Hz -> 1046Hz)
                    osc.frequency.setValueAtTime(880, ctx.currentTime);
                    osc.frequency.setValueAtTime(1046.5, ctx.currentTime + 0.08);
                    gain.gain.setValueAtTime(0.22, ctx.currentTime);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.18);
                } else {
                    // Âm lỗi (Sawtooth trầm 180Hz)
                    osc.type = "sawtooth";
                    osc.frequency.value = 180;
                    gain.gain.setValueAtTime(0.4, ctx.currentTime);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.35);
                }
            } catch (e) {
                console.log("Audio API blocked or not supported:", e);
            }
        }

        function triggerVibration(type = "SUCCESS") {
            if (!("vibrate" in navigator)) return;
            try {
                if (type === "SUCCESS") {
                    navigator.vibrate([70]);
                } else if (type === "WARNING") {
                    navigator.vibrate([110, 50, 110]);
                } else if (type === "ERROR") {
                    navigator.vibrate([220, 80, 220]);
                }
            } catch (e) {}
        }

        function toggleMuteAudio() {
            isMuted = !isMuted;
            const icon = document.getElementById("iconMute");
            if (icon) {
                icon.className = isMuted ? "bi bi-volume-mute fs-5 text-warning" : "bi bi-volume-up fs-5";
            }
        }

        // 4. KHỞI ĐỘNG CAMERA & PHẦN CỨNG (TASK-P5-04.1)
        async function startCamera(facingMode = currentFacingMode) {
            if (html5QrCode && isCameraRunning) {
                try {
                    await html5QrCode.stop();
                } catch (e) {}
            }

            html5QrCode = new Html5Qrcode("reader");

            const qrboxFunction = function(viewfinderWidth, viewfinderHeight) {
                const minEdge = Math.min(viewfinderWidth, viewfinderHeight);
                const size = Math.floor(minEdge * 0.72);
                return { width: size, height: size };
            };

            const config = {
                fps: 15,
                qrbox: qrboxFunction,
                experimentalFeatures: {
                    useBarCodeDetectorIfSupported: true
                }
            };

            try {
                await html5QrCode.start(
                    { facingMode: facingMode },
                    config,
                    (decodedText) => handleContinuousScan(decodedText),
                    (err) => {}
                );
                isCameraRunning = true;
                currentFacingMode = facingMode;
                detectCameraHardwareCapabilities();
            } catch (e) {
                console.warn("Thử lại camera với cấu hình mặc định:", e);
                try {
                    await html5QrCode.start(
                        facingMode,
                        config,
                        (decodedText) => handleContinuousScan(decodedText),
                        (err) => {}
                    );
                    isCameraRunning = true;
                    detectCameraHardwareCapabilities();
                } catch (err) {
                    console.error("Không thể kích hoạt Camera:", err);
                }
            }
        }

        // Nhận diện tính năng phần cứng: Đèn Flash (Torch) và Zoom quang học/số
        function detectCameraHardwareCapabilities() {
            setTimeout(() => {
                try {
                    const videoEl = document.querySelector("#reader video");
                    if (!videoEl || !videoEl.srcObject) return;

                    const tracks = videoEl.srcObject.getVideoTracks();
                    if (!tracks || tracks.length === 0) return;

                    mediaStreamTrack = tracks[0];
                    if (typeof mediaStreamTrack.getCapabilities === "function") {
                        const caps = mediaStreamTrack.getCapabilities();

                        // Kiểm tra Flash / Torch
                        const btnTorch = document.getElementById("btnToggleTorch");
                        if (btnTorch) {
                            if (caps.torch) {
                                btnTorch.removeAttribute("disabled");
                                btnTorch.title = "Bật/Tắt đèn Flash";
                            } else {
                                btnTorch.setAttribute("disabled", "true");
                                btnTorch.title = "Thiết bị không hỗ trợ Flash";
                            }
                        }

                        // Kiểm tra Zoom
                        const zoomContainer = document.getElementById("hudZoomContainer");
                        const zoomSlider = document.getElementById("hudZoomSlider");
                        if (caps.zoom && zoomContainer && zoomSlider) {
                            zoomContainer.classList.remove("d-none");
                            zoomSlider.min = caps.zoom.min || 1;
                            zoomSlider.max = Math.min(caps.zoom.max || 3, 4);
                            zoomSlider.step = caps.zoom.step || 0.1;
                        }
                    }
                } catch (e) {
                    console.log("Capabilities detection error:", e);
                }
            }, 600);
        }

        async function toggleTorch() {
            if (!mediaStreamTrack) return;
            try {
                isTorchOn = !isTorchOn;
                await mediaStreamTrack.applyConstraints({
                    advanced: [{ torch: isTorchOn }]
                });
                const btn = document.getElementById("btnToggleTorch");
                if (btn) btn.classList.toggle("active", isTorchOn);
            } catch (e) {
                console.warn("Không thể bật Flash:", e);
            }
        }

        async function handleZoomChange(val) {
            const badge = document.getElementById("hudZoomBadge");
            if (badge) badge.textContent = `${parseFloat(val).toFixed(1)}x`;
            if (!mediaStreamTrack) return;
            try {
                await mediaStreamTrack.applyConstraints({
                    advanced: [{ zoom: parseFloat(val) }]
                });
            } catch (e) {}
        }

        async function switchCamera() {
            currentFacingMode = (currentFacingMode === "environment") ? "user" : "environment";
            await startCamera(currentFacingMode);
        }

        function toggleFullscreenView() {
            const elem = document.getElementById("cameraHudBox");
            if (!document.fullscreenElement) {
                if (elem.requestFullscreen) elem.requestFullscreen();
                else if (elem.webkitRequestFullscreen) elem.webkitRequestFullscreen();
            } else {
                if (document.exitFullscreen) document.exitFullscreen();
            }
        }

        // 5. TASK-P5-04.4: XỬ LÝ QUÉT LIÊN TỤC & CHỐNG TRÙNG 3 GIÂY (CONTINUOUS SCAN)
        async function handleContinuousScan(decodedText) {
            const code = (decodedText || "").trim().toUpperCase();
            if (!code || isScanInFlight) return;

            // Kiểm tra chống quét trùng cùng 1 mã trong 3000ms mà không làm dừng Camera
            const now = Date.now();
            const lastScannedAt = recentScannedCodesMap.get(code) || 0;
            if (now - lastScannedAt < 3000) {
                return;
            }

            recentScannedCodesMap.set(code, now);
            isScanInFlight = true;

            try {
                let result = null;

                // TRƯỜNG HỢP 1: Thiết bị Ngoại tuyến (Offline IndexedDB)
                if (!navigator.onLine && typeof ParishOfflineEngine !== "undefined") {
                    result = await ParishOfflineEngine.processOfflineQrScan(code, currentSessionMode);
                } else {
                    // TRƯỜNG HỢP 2: Thiết bị Trực tuyến
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    const res = await fetch('/Attendance/ScanCheckIn', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'X-CSRF-TOKEN': token,
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({
                            studentCode: code,
                            sessionMode: currentSessionMode
                        })
                    });

                    if (res.ok) {
                        result = await res.json();
                    } else {
                        throw new Error(`HTTP ${res.status}`);
                    }
                }

                if (result) {
                    renderScanResult(result);
                }
            } catch (err) {
                console.warn("Mạng gặp sự cố khi quét, thử fallback IndexedDB:", err);
                if (typeof ParishOfflineEngine !== "undefined") {
                    const offlineRes = await ParishOfflineEngine.processOfflineQrScan(code, currentSessionMode);
                    renderScanResult(offlineRes);
                } else {
                    showHudFeedback("ERROR", "Lỗi kết nối máy chủ: " + err.message);
                }
            } finally {
                // Cho phép quét tiếp mã mới sau 350ms mà không đứng hình Camera
                setTimeout(() => { isScanInFlight = false; }, 350);
            }
        }

        // 6. PHẢN HỒI GIAO DIỆN KHUNG NGẮM & THẺ KẾT QUẢ
        function renderScanResult(data) {
            const frame = document.getElementById("viewfinderFrame");
            const resultCard = document.getElementById("hudResultCard");
            const emptyState = document.getElementById("resultCardEmpty");
            const contentState = document.getElementById("resultCardContent");

            emptyState.classList.add("d-none");
            contentState.classList.remove("d-none");

            if (!data.success) {
                showHudFeedback("ERROR", data.message || "Quét thất bại");
                playBeep(false);
                triggerVibration("ERROR");
                return;
            }

            const isLate = data.status === "LATE";
            const isOldCode = data.isHistoricalCode === true;
            const isDuplicate = data.isDuplicate === true;

            // Đổi màu Khung ngắm HUD (TASK-P5-04.1)
            if (isOldCode || isLate || isDuplicate) {
                showHudFeedback("WARNING");
                playBeep(true, true);
                triggerVibration("WARNING");
            } else {
                showHudFeedback("SUCCESS");
                playBeep(true, false);
                triggerVibration("SUCCESS");
            }

            // Cập nhật thẻ kết quả
            resultCard.className = "hud-result-card " + (isOldCode || isLate ? "status-late" : "status-success");

            // Hiển thị Cảnh báo Thẻ Mã Năm Cũ (TASK-P5-04.2)
            const oldCodeAlert = document.getElementById("resultCardOldCodeAlert");
            if (isOldCode) {
                oldCodeAlert.classList.remove("d-none");
                document.getElementById("lblOldCode").textContent = data.oldCode || "";
                document.getElementById("lblNewCode").textContent = data.currentCode || data.studentCode || "";
            } else {
                oldCodeAlert.classList.add("d-none");
            }

            // Điền thông tin học sinh
            document.getElementById("lblStudentName").textContent = `${data.christianName || ''} ${data.fullName || ''}`.trim();
            document.getElementById("lblClassName").textContent = data.className || "";
            document.getElementById("lblStudentCode").textContent = data.currentCode || data.studentCode || "";
            document.getElementById("lblActivityType").textContent = data.activityType || "THÁNH LỄ";
            document.getElementById("lblCheckInTime").textContent = data.checkInTimeStr || new Date().toLocaleTimeString('vi-VN');

            const statusBadge = document.getElementById("lblScanStatus");
            if (isDuplicate) {
                statusBadge.className = "badge bg-warning text-dark px-2 py-1 rounded-pill small fw-bold";
                statusBadge.textContent = "ĐÃ QUÉT TRƯỚC";
            } else if (isLate) {
                statusBadge.className = "badge bg-warning text-dark px-2 py-1 rounded-pill small fw-bold";
                statusBadge.textContent = "ĐI TRỄ";
            } else {
                statusBadge.className = "badge bg-success px-2 py-1 rounded-pill small fw-bold";
                statusBadge.textContent = "CÓ MẶT";
            }

            // Cập nhật Sĩ số ca quét
            if (!isDuplicate) {
                sessionStats.total++;
                if (isLate) sessionStats.late++;
                else sessionStats.onTime++;
                if (isOldCode) sessionStats.oldCode++;
                updateSessionStatsUi();
            }

            // Thêm vào danh sách lịch sử khay trượt
            addToHistoryList(data);

            // TASK-P5-04.3: KÍCH HOẠT ĐẾM LÙI HOÀN TÁC 5 GIÂY (UNDO)
            lastScanResult = data;
            startUndoCountdown();
        }

        function showHudFeedback(type, message = null) {
            const frame = document.getElementById("viewfinderFrame");
            frame.className = `viewfinder-frame hud-${type.toLowerCase()}`;
            const hint = document.getElementById("viewfinderHint");
            if (message && hint) {
                hint.textContent = message;
            }

            // Tự động trả về màu nhàn rỗi sau 1.4s để sẵn sàng quét em tiếp theo
            setTimeout(() => {
                if (frame) frame.className = "viewfinder-frame hud-idle";
                if (hint) hint.innerHTML = '<i class="bi bi-qr-code me-1"></i> Căn giữa mã QR thẻ thiếu nhi';
            }, 1400);
        }

        // 7. TASK-P5-04.3: QUẢN LÝ ĐẾM LÙI & HOÀN TÁC (UNDO) TRONG 5 GIÂY
        function startUndoCountdown() {
            clearTimeout(undoTimer);
            clearInterval(undoProgressInterval);

            const undoWrapper = document.getElementById("undoWrapper");
            const undoBar = document.getElementById("undoProgressBar");
            const undoSecLabel = document.getElementById("undoSeconds");

            if (!undoWrapper) return;
            undoWrapper.style.visibility = "visible";
            undoWrapper.style.opacity = "1";

            undoStartTime = Date.now();
            let remainingSec = 5;
            undoSecLabel.textContent = remainingSec;
            undoBar.style.width = "100%";

            undoProgressInterval = setInterval(() => {
                const elapsed = Date.now() - undoStartTime;
                const percent = Math.max(0, 100 - (elapsed / UNDO_DURATION_MS) * 100);
                undoBar.style.width = `${percent}%`;

                const curRemaining = Math.ceil((UNDO_DURATION_MS - elapsed) / 1000);
                if (curRemaining !== remainingSec && curRemaining >= 0) {
                    remainingSec = curRemaining;
                    undoSecLabel.textContent = remainingSec;
                }
            }, 100);

            undoTimer = setTimeout(() => {
                clearInterval(undoProgressInterval);
                undoWrapper.style.opacity = "0";
                setTimeout(() => { undoWrapper.style.visibility = "hidden"; }, 300);
                lastScanResult = null;
            }, UNDO_DURATION_MS);
        }

        async function triggerUndoLastScan() {
            if (!lastScanResult) return;

            clearTimeout(undoTimer);
            clearInterval(undoProgressInterval);

            const undoWrapper = document.getElementById("undoWrapper");
            if (undoWrapper) undoWrapper.style.visibility = "hidden";

            const dataToUndo = lastScanResult;
            lastScanResult = null;

            try {
                let success = false;
                let message = "";

                // Hoàn tác Ngoại tuyến nếu kết quả từ Offline
                if (dataToUndo.isOfflineSaved && typeof ParishOfflineEngine !== "undefined" && dataToUndo.clientRecordId) {
                    const offRes = await ParishOfflineEngine.undoOfflineQrScan(dataToUndo.clientRecordId);
                    success = offRes.success;
                    message = offRes.message;
                } else {
                    // Hoàn tác Trực tuyến qua Server
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    const res = await fetch('/Attendance/UndoScanCheckIn', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'X-CSRF-TOKEN': token,
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({
                            enrollmentId: dataToUndo.enrollmentId,
                            classId: dataToUndo.classId,
                            studentCode: dataToUndo.studentCode,
                            activityType: dataToUndo.activityType,
                            sessionMode: dataToUndo.sessionMode
                        })
                    });

                    if (res.ok) {
                        const json = await res.json();
                        success = json.success;
                        message = json.message;
                    }
                }

                if (success) {
                    playBeep(true, false, 440, 0.2); // Âm hoàn tác
                    triggerVibration("WARNING");

                    // Giảm sĩ số ca quét
                    sessionStats.total = Math.max(0, sessionStats.total - 1);
                    if (dataToUndo.status === "LATE") sessionStats.late = Math.max(0, sessionStats.late - 1);
                    else sessionStats.onTime = Math.max(0, sessionStats.onTime - 1);
                    if (dataToUndo.isHistoricalCode) sessionStats.oldCode = Math.max(0, sessionStats.oldCode - 1);
                    updateSessionStatsUi();

                    // Đánh dấu dòng trong lịch sử thành "Đã hoàn tác"
                    markHistoryRowUndone(dataToUndo.studentCode);

                    // Cập nhật lại thẻ kết quả
                    const statusBadge = document.getElementById("lblScanStatus");
                    if (statusBadge) {
                        statusBadge.className = "badge bg-secondary px-2 py-1 rounded-pill small fw-bold";
                        statusBadge.textContent = "ĐÃ HOÀN TÁC";
                    }

                    showHudFeedback("WARNING", `Đã hoàn tác cho: ${dataToUndo.fullName}`);
                }
            } catch (err) {
                console.error("Lỗi khi hoàn tác:", err);
            }
        }

        function updateSessionStatsUi() {
            document.getElementById("statTotalScanned").textContent = sessionStats.total;
            document.getElementById("statOnTime").textContent = sessionStats.onTime;
            document.getElementById("statLate").textContent = sessionStats.late;
            document.getElementById("statOldCode").textContent = sessionStats.oldCode;
            document.getElementById("badgeDrawerCount").textContent = `${sessionStats.total} lượt`;
        }

        // 8. BẢNG KHAY LỊCH SỬ QUÉT & SÚNG QUÉT MÃ USB
        function addToHistoryList(data) {
            const tbody = document.getElementById("tbodyHistoryRecent");
            if (tbody.querySelector("td[colspan]")) {
                tbody.innerHTML = "";
            }

            const tr = document.createElement("tr");
            tr.setAttribute("data-code", data.currentCode || data.studentCode);
            const isLate = data.status === "LATE";
            const isOldCode = data.isHistoricalCode === true;

            tr.innerHTML = `
                <td class="ps-3 small font-monospace text-muted py-2">${data.checkInTimeStr || '--:--:--'}</td>
                <td class="py-2">
                    <div class="fw-bold text-dark">${data.christianName || ''} ${data.fullName || ''}</div>
                    <small class="text-muted font-monospace">${data.currentCode || data.studentCode}</small>
                    ${isOldCode ? `<span class="badge bg-warning-subtle text-dark border border-warning ms-1 py-0 px-1" style="font-size:0.7rem;"><i class="bi bi-exclamation-triangle"></i> Mã cũ: ${data.oldCode}</span>` : ''}
                </td>
                <td class="py-2"><span class="badge bg-light text-dark border">${data.className || ''}</span></td>
                <td class="text-center py-2 status-cell">
                    <span class="badge ${isLate ? 'bg-warning text-dark' : 'bg-success'} rounded-pill">
                        ${isLate ? 'Trễ' : 'Có mặt'}
                    </span>
                </td>`;

            tbody.insertBefore(tr, tbody.firstChild);

            // Giới hạn 25 dòng lịch sử gần nhất
            if (tbody.children.length > 25) {
                tbody.removeChild(tbody.lastChild);
            }
        }

        function markHistoryRowUndone(code) {
            const row = document.querySelector(`#tbodyHistoryRecent tr[data-code="${code}"]`);
            if (row) {
                const cell = row.querySelector(".status-cell");
                if (cell) {
                    cell.innerHTML = '<span class="badge bg-secondary rounded-pill">Đã hoàn tác</span>';
                }
                row.classList.add("text-muted", "bg-light");
            }
        }

        function clearLocalHistory() {
            document.getElementById("tbodyHistoryRecent").innerHTML = `
                <tr><td colspan="4" class="text-center py-4 text-muted small">Chưa có lượt quét nào trong buổi này.</td></tr>`;
            sessionStats = { total: 0, onTime: 0, late: 0, oldCode: 0 };
            updateSessionStatsUi();
        }

        function toggleRecentScansDrawer() {
            const drawer = document.getElementById("recentScansDrawer");
            const icon = document.getElementById("iconDrawerChevron");
            const isCollapsed = drawer.classList.contains("collapsed");

            if (isCollapsed) {
                drawer.classList.remove("collapsed");
                icon.className = "bi bi-chevron-down ms-1";
            } else {
                drawer.classList.add("collapsed");
                icon.className = "bi bi-chevron-up ms-1";
            }
        }

        function submitManualBarcode() {
            const input = document.getElementById("manualBarcodeInput");
            const code = (input.value || "").trim();
            if (code) {
                handleContinuousScan(code);
                input.value = "";
                input.focus();
            }
        }

        // Tự động tắt camera khi chuyển trang
        window.addEventListener("beforeunload", () => {
            if (html5QrCode && isCameraRunning) {
                html5QrCode.stop().catch(() => {});
            }
        });
    </script>
}
