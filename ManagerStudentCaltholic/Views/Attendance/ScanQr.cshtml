@{
    ViewData["Title"] = "Quét Mã QR Điểm Danh";
}

@Html.AntiForgeryToken()

<div class="container py-4">
    <!-- Tiêu đề & Nút quay lại -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-0">
                <i class="bi bi-qr-code-scan text-primary me-2"></i>Cổng Quét Mã QR Điểm Danh Tức Thì
            </h4>
            <small class="text-muted">Niên khóa: <strong>@ViewBag.AcademicYearName</strong> | Ngày: <strong>@DateTime.Now.ToString("dd/MM/yyyy (dddd)")</strong></small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Trở về Sổ Lớp
        </a>
    </div>

    <div class="row g-4">
        <!-- CỘT BÊN TRÁI: KHUNG CAMERA QUÉT & Ô NHẬP TAY / SÚNG QUÉT BẰNG CỔNG USB -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-camera-fill me-2 text-warning"></i>Khung Quét Camera</span>
                    <button class="btn btn-sm btn-outline-light rounded-pill px-3" id="btnToggleCam" onclick="toggleCamera()">
                        <i class="bi bi-power me-1"></i> Bật / Tắt Camera
                    </button>
                </div>
                <div class="card-body p-3 text-center bg-black bg-opacity-10">
                    <div id="reader" style="width: 100%; min-height: 320px; border-radius: 12px; overflow: hidden; background: #000;"></div>
                    <div class="text-muted small mt-2">
                        <i class="bi bi-info-circle me-1"></i> Căn giữa mã QR của thẻ thiếu nhi vào ô quét camera.
                    </div>
                </div>
            </div>

            <!-- Hộp súng quét Barcode / Nhập tay -->
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <label class="form-label fw-bold text-muted small mb-1">
                    <i class="bi bi-upc-scan me-1 text-primary"></i>Dành cho Súng Quét Cầm Tay / Nhập Mã Thủ Công:
                </label>
                <div class="input-group">
                    <input type="text" id="manualCodeInput" class="form-control form-control-lg font-monospace text-uppercase"
                           placeholder="Quét hoặc nhập mã TN-2026-XXXX..." autofocus />
                    <button class="btn btn-primary px-4 fw-bold" onclick="submitManualCode()">
                        <i class="bi bi-send-fill me-1"></i> Check-in
                    </button>
                </div>
            </div>
        </div>

        <!-- CỘT BÊN PHẢI: KẾT QUẢ QUÉT TỨC THÌ & LỊCH SỬ QUÉT -->
        <div class="col-lg-6">
            <!-- Thẻ Kết Quả Quét Mới Nhất -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" id="scanResultCard">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-person-check-fill me-2"></i>Kết Quả Quét Gần Nhất</h5>
                </div>
                <div class="card-body p-4 text-center" id="scanResultBody">
                    <div class="py-5 text-muted">
                        <i class="bi bi-upc fs-1 d-block mb-3 opacity-50"></i>
                        Vui lòng hướng camera về phía mã QR hoặc quét bằng đầu đọc USB...
                    </div>
                </div>
            </div>

            <!-- Bảng Lịch Sử 10 Lần Quét Gần Nhất -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-dark"><i class="bi bi-clock-history me-2 text-secondary"></i>Lịch Sử Quét Gần Đây</span>
                    <button class="btn btn-link btn-sm text-decoration-none text-muted p-0" onclick="clearHistory()">Xóa lịch sử</button>
                </div>
                <div class="table-responsive" style="max-height: 280px;">
                    <table class="table table-hover align-middle mb-0" id="scanHistoryTable">
                        <thead class="table-light small">
                            <tr>
                                <th class="ps-3">Thời gian</th>
                                <th>Thiếu Nhi</th>
                                <th>Lớp</th>
                                <th class="text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody id="scanHistoryBody">
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted small">Chưa có lượt quét nào</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Âm thanh phản hồi (Audio Synthesizer bằng Web Audio API) -->
@section Scripts {
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <script>
        let html5QrCode = null;
        let isCameraRunning = false;
        let isProcessing = false;
        let lastScannedCode = "";
        let lastScannedTime = 0;

        // Phát âm thanh Beep qua Web Audio API (không phụ thuộc file mp3 ngoài)
        function playBeep(isSuccess = true, isWarning = false) {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);

                if (isWarning) {
                    osc.frequency.value = 440; // Âm A
                    gain.gain.setValueAtTime(0.3, ctx.currentTime);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.3);
                } else if (isSuccess) {
                    osc.frequency.value = 880; // Âm A cao
                    gain.gain.setValueAtTime(0.2, ctx.currentTime);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.15);
                } else {
                    osc.frequency.value = 220; // Âm trầm báo lỗi
                    gain.gain.setValueAtTime(0.4, ctx.currentTime);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.4);
                }
            } catch (e) {
                console.log("Audio not supported or blocked");
            }
        }

        // Khởi động Camera quét QR
        function startCamera() {
            html5QrCode = new Html5Qrcode("reader");
            const config = { fps: 10, qrbox: { width: 250, height: 250 } };

            html5QrCode.start(
                { facingMode: "environment" },
                config,
                (decodedText, decodedResult) => {
                    handleScannedCode(decodedText);
                },
                (errorMessage) => {
                    // Quét từng frame không có mã -> bỏ qua
                }
            ).then(() => {
                isCameraRunning = true;
                document.getElementById("btnToggleCam").innerHTML = '<i class="bi bi-stop-circle me-1"></i> Tắt Camera';
            }).catch(err => {
                console.error("Không thể mở Camera:", err);
                document.getElementById("reader").innerHTML = `
                    <div class="p-4 text-white text-center">
                        <i class="bi bi-camera-video-off fs-2 d-block mb-2 text-warning"></i>
                        Không thể kết nối Camera. Vui lòng cấp quyền truy cập thiết bị hoặc sử dụng ô quét bằng cổng USB/nhập tay.
                    </div>`;
            });
        }

        function stopCamera() {
            if (html5QrCode && isCameraRunning) {
                html5QrCode.stop().then(() => {
                    isCameraRunning = false;
                    document.getElementById("btnToggleCam").innerHTML = '<i class="bi bi-play-circle me-1"></i> Bật Camera';
                });
            }
        }

        function toggleCamera() {
            if (isCameraRunning) {
                stopCamera();
            } else {
                startCamera();
            }
        }

        // Xử lý gửi mã lên Backend
        async function handleScannedCode(code) {
            if (!code || isProcessing) return;

            const now = Date.now();
            // Debounce: Chống quét liên tục cùng 1 mã trong vòng 3 giây
            if (code === lastScannedCode && (now - lastScannedTime) < 3000) {
                return;
            }

            isProcessing = true;
            lastScannedCode = code;
            lastScannedTime = now;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const response = await fetch('/Attendance/ScanCheckIn', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ studentCode: code })
                });

                const data = await response.json();
                renderScanResult(data);
            } catch (err) {
                playBeep(false);
                renderErrorResult("Lỗi kết nối máy chủ: " + err);
            } finally {
                setTimeout(() => { isProcessing = false; }, 800);
            }
        }

        // Hiển thị kết quả lên giao diện
        function renderScanResult(data) {
            const resultBody = document.getElementById("scanResultBody");
            const resultCard = document.getElementById("scanResultCard");

            if (!data.success) {
                playBeep(false);
                resultCard.className = "card border-0 shadow rounded-4 mb-4 overflow-hidden border-danger border-start border-4";
                resultBody.innerHTML = `
                    <div class="py-3 text-danger">
                        <i class="bi bi-x-circle-fill fs-1 d-block mb-2"></i>
                        <h5 class="fw-bold mb-1">QUÉT THẤT BẠI</h5>
                        <p class="mb-0 text-muted">${data.message}</p>
                        <span class="badge bg-danger-subtle text-danger mt-2 font-monospace">${data.studentCode || ''}</span>
                    </div>`;
                return;
            }

            if (data.isDuplicate) {
                playBeep(true, true); // Âm thanh cảnh báo đã quét
                resultCard.className = "card border-0 shadow rounded-4 mb-4 overflow-hidden border-warning border-start border-4";
            } else {
                playBeep(true, false); // Âm thanh thành công
                resultCard.className = "card border-0 shadow rounded-4 mb-4 overflow-hidden border-success border-start border-4";
            }

            const isLate = data.status === "LATE";
            const badgeClass = isLate ? "bg-warning text-dark" : "bg-success";
            const statusText = isLate ? "ĐI TRỄ" : "CÓ MẶT";

            resultBody.innerHTML = `
                <div class="text-center py-2">
                    <span class="badge ${data.isDuplicate ? 'bg-warning text-dark' : 'bg-primary'} px-3 py-1 rounded-pill mb-2">
                        ${data.activityType} - ${data.checkInTimeStr}
                    </span>
                    <h3 class="fw-bold text-dark mb-1">${data.christianName} ${data.fullName}</h3>
                    <p class="text-muted mb-2">Lớp: <strong class="text-dark">${data.className}</strong> (${data.gradeLevel}) | Mã: <span class="font-monospace">${data.studentCode}</span></p>
                    <div>
                        <span class="badge ${badgeClass} fs-6 px-4 py-2 rounded-pill shadow-sm">
                            <i class="bi ${isLate ? 'bi-clock-history' : 'bi-check2-circle'} me-1"></i> ${statusText}
                        </span>
                    </div>
                    ${data.isDuplicate ? '<div class="alert alert-warning py-1 px-3 mt-3 mb-0 small"><i class="bi bi-exclamation-triangle me-1"></i> Thiếu nhi này đã quét điểm danh trước đó!</div>' : ''}
                </div>`;

            // Thêm vào lịch sử bảng bên dưới
            addToHistoryTable(data);
        }

        function renderErrorResult(msg) {
            const resultBody = document.getElementById("scanResultBody");
            resultBody.innerHTML = `
                <div class="py-3 text-danger">
                    <i class="bi bi-wifi-off fs-1 d-block mb-2"></i>
                    <h5 class="fw-bold mb-1">LỖI MẠNG HOẶC MÁY CHỦ</h5>
                    <p class="mb-0 text-muted">${msg}</p>
                </div>`;
        }

        function addToHistoryTable(data) {
            const tbody = document.getElementById("scanHistoryBody");
            if (tbody.querySelector("td[colspan]")) {
                tbody.innerHTML = "";
            }

            const tr = document.createElement("tr");
            const isLate = data.status === "LATE";
            tr.innerHTML = `
                <td class="ps-3 small font-monospace text-muted">${data.checkInTimeStr}</td>
                <td>
                    <div class="fw-bold text-dark">${data.christianName} ${data.fullName}</div>
                    <small class="text-muted font-monospace">${data.studentCode}</small>
                </td>
                <td><span class="badge bg-light text-dark border">${data.className}</span></td>
                <td class="text-center">
                    <span class="badge ${isLate ? 'bg-warning text-dark' : 'bg-success'} rounded-pill">
                        ${isLate ? 'Trễ' : 'Có mặt'}
                    </span>
                </td>`;
            tbody.insertBefore(tr, tbody.firstChild);

            // Giữ tối đa 15 dòng lịch sử gần nhất
            if (tbody.children.length > 15) {
                tbody.removeChild(tbody.lastChild);
            }
        }

        function clearHistory() {
            document.getElementById("scanHistoryBody").innerHTML = `
                <tr><td colspan="4" class="text-center py-4 text-muted small">Chưa có lượt quét nào</td></tr>`;
        }

        // Bắt sự kiện phím Enter từ Súng quét mã vạch USB / Ô nhập tay
        document.getElementById("manualCodeInput").addEventListener("keyup", function (e) {
            if (e.key === "Enter") {
                submitManualCode();
            }
        });

        function submitManualCode() {
            const input = document.getElementById("manualCodeInput");
            const code = input.value.trim();
            if (code) {
                handleScannedCode(code);
                input.value = "";
                input.focus();
            }
        }

        // Tự động bật camera khi mở trang
        window.addEventListener("DOMContentLoaded", () => {
            startCamera();
        });

        // Tắt camera khi rời trang
        window.addEventListener("beforeunload", () => {
            stopCamera();
        });
    </script>
}