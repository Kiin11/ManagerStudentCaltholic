@model ManagerStudentCaltholic.Models.ViewModels.MonthlyAttendanceReportViewModel
@{
    ViewData["Title"] = $"Tổng Hợp Điểm Danh Tháng {Model.SelectedMonth}/{Model.SelectedYear} - Lớp {Model.ClassName}";
    var classes = ViewBag.Classes as List<ManagerStudentCaltholic.Models.Entities.ClassRoom> ?? new();
}

<style>
    .table-matrix th, .table-matrix td {
        vertical-align: middle;
        text-align: center;
        padding: 6px 4px;
        font-size: 0.85rem;
    }

    .sticky-col-stt {
        position: sticky;
        left: 0;
        background: #fff !important;
        z-index: 2;
        width: 45px;
    }

    .sticky-col-name {
        position: sticky;
        left: 45px;
        background: #fff !important;
        z-index: 2;
        min-width: 170px;
        text-align: left !important;
        box-shadow: 2px 0 5px rgba(0,0,0,0.05);
    }

    .th-thursday {
        background-color: #fef3c7 !important;
        color: #92400e;
    }

    .th-sunday {
        background-color: #e0e7ff !important;
        color: #3730a3;
    }

    .badge-status {
        display: inline-block;
        width: 24px;
        height: 24px;
        line-height: 24px;
        border-radius: 4px;
        font-weight: 700;
        font-size: 0.75rem;
        cursor: default;
    }

    .status-present {
        background-color: #dcfce7;
        color: #15803d;
        border: 1px solid #86efac;
    }

    .status-inline {
        background-color: #f3e8ff; /* Tím nhạt */
        color: #7e22ce; /* Chữ tím đậm */
        border: 1px solid #d8b4fe; /* Viền tím vừa */
    }

    .status-late {
        background-color: #fef9c3;
        color: #a16207;
        border: 1px solid #fde047;
    }

    .status-absent-p {
        background-color: #e0f2fe;
        color: #0369a1;
        border: 1px solid #7dd3fc;
    }

    .status-absent-u {
        background-color: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fca5a5;
    }

    .status-makeup {
        background-color: #ffedd5;
        color: #c2410c;
        border: 1px dashed #fb923c;
    }
</style>

<div class="container-fluid py-4">
    <!-- Header & Bộ Lọc -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="MonthlySummary" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-door-open me-1"></i>Chọn Lớp Học:</label>
                    <select name="classId" class="form-select fw-semibold" onchange="this.form.submit()">
                        @foreach (var c in classes)
                        {
                            <!option value="@c.Id" @(c.Id == Model.ClassId ? "selected" : "")>
                            @c.Name (@c.GradeLevel)
                            </!option>
                        }
                    </select>
                </div>
                <div class="col-md-2 col-6">
                    <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-calendar-month me-1"></i>Tháng:</label>
                    <select name="month" class="form-select" onchange="this.form.submit()">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <!option value="@m" @(m == Model.SelectedMonth ? "selected" : "")>Tháng @m</!option>
                        }
                    </select>
                </div>
                <div class="col-md-2 col-6">
                    <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-calendar3 me-1"></i>Năm:</label>
                    <select name="year" class="form-select" onchange="this.form.submit()">
                        @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 1; y++)
                        {
                            <!option value="@y" @(y == Model.SelectedYear ? "selected" : "")>@y</!option>
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex justify-content-md-end gap-2">
                    <a href="/Attendance/Index?classId=@Model.ClassId" class="btn btn-outline-primary">
                        <i class="bi bi-pencil-square me-1"></i> Sổ Điểm Danh Ngày
                    </a>
                    <a asp-action="ExportMonthlySummaryExcel"
                       asp-route-classId="@Model.ClassId"
                       asp-route-month="@Model.SelectedMonth"
                       asp-route-year="@Model.SelectedYear"
                       class="btn btn-success shadow-sm">
                        <i class="bi bi-file-earmark-excel-fill me-1"></i> Xuất Excel Tháng
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Thanh Chú Thích Ký Hiệu Trạng Thái -->
    <div class="d-flex flex-wrap align-items-center gap-3 mb-3 px-2">
        <span class="small fw-bold text-muted">Chú thích:</span>
        <span class="small"><span class="badge-status status-inline me-1">XH</span> Xếp hàng</span>
        <span class="small"><span class="badge-status status-present me-1">✔</span> Có mặt</span>
        <span class="small"><span class="badge-status status-late me-1">T</span> Đi trễ</span>
        <span class="small"><span class="badge-status status-absent-p me-1">P</span> Vắng phép</span>
        <span class="small"><span class="badge-status status-absent-u me-1">K</span> Vắng không phép</span>
        <span class="small"><span class="badge-status status-makeup me-1">⟲</span> Điểm danh bù</span>
    </div>

    <!-- Bảng Ma Trận Điểm Danh Tháng -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-table me-2 text-primary"></i>Bảng Điểm Danh Chuyên Cần Tháng @Model.SelectedMonth/@Model.SelectedYear: @Model.ClassName
            </h5>
            <small class="text-muted">Sĩ số: <strong>@Model.Rows.Count</strong> em | Tổng số buổi: <strong>@Model.SessionDates.Count</strong> ngày</small>
        </div>
        <div class="table-responsive" style="max-height: 700px;">
            <table class="table table-bordered table-hover align-middle mb-0 table-matrix">
                <thead class="table-light sticky-top" style="z-index: 3;">
                    <!-- HÀNG HEADER 1: NGÀY & THỨ -->
                    <tr>
                        <th rowspan="2" class="sticky-col-stt">STT</th>
                        <th rowspan="2" class="sticky-col-name">Họ Và Tên</th>

                        @foreach (var sess in Model.SessionDates)
                        {
                            if (sess.IsSunday)
                            {
                                <th colspan="2" class="th-sunday border-start border-end">
                                    <div class="fw-bold">CN @sess.FormattedDate</div>
                                </th>
                            }
                            else
                            {
                                <th class="th-thursday border-start border-end">
                                    <div class="fw-bold">T5 @sess.FormattedDate</div>
                                </th>
                            }
                        }

                        <th colspan="2" class="bg-success-subtle text-success border-start">Tổng Lễ Thứ 5</th>
                        <th colspan="4" class="bg-success-subtle text-success border-start">Tổng Lễ Chúa Nhật</th>
                        <th colspan="3" class="bg-primary-subtle text-primary border-start">Tổng Học</th>
                    </tr>

                    <!-- HÀNG HEADER 2: PHÂN TÁCH LỄ & HỌC -->
                    <tr>
                        @foreach (var sess in Model.SessionDates)
                        {
                            if (sess.IsSunday)
                            {
                                <th class="th-sunday border-start" style="width: 32px;" title="Thánh Lễ Chúa Nhật">Lễ</th>
                                <th class="th-sunday border-end" style="width: 32px;" title="Giờ Học Giáo Lý">Học</th>
                            }
                            else
                            {
                                <th class="th-thursday border-start border-end" style="width: 38px;" title="Thánh Lễ Thứ Năm">Lễ</th>
                            }
                        }

                        <!-- Cột Thống Kê Tổng Lễ Thứ 5 -->
                        <th class="bg-light" style="width: 30px;" title="Có mặt Lễ">Đ</th>
                        <th class="bg-light border-end" style="width: 30px;" title="Vắng Lễ">V</th>

                        <!-- Cột Thống Kê Tổng Lễ Chúa Nhật -->
                        <th class="bg-light" style="width: 30px;" title="Xếp hàng">XH</th>
                        <th class="bg-light" style="width: 30px;" title="Có mặt Lễ">Đ</th>
                        <th class="bg-light" style="width: 30px;" title="Trễ Lễ">T</th>
                        <th class="bg-light border-end" style="width: 30px;" title="Vắng Lễ">V</th>

                        <!-- Cột Thống Kê Tổng Học -->
                        <th class="bg-light" style="width: 30px;" title="Có mặt Học">Đ</th>
                        <th class="bg-light" style="width: 30px;" title="Trễ Học">T</th>
                        <th class="bg-light" style="width: 30px;" title="Vắng Học">V</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rows.Any())
                    {
                        var stt = 1;
                        foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="sticky-col-stt fw-bold text-muted">@(stt++)</td>
                                <td class="sticky-col-name">
                                    <div class="fw-bold text-dark">@row.ChristianName @row.FullName</div>
                                    <small class="text-muted font-monospace">@row.StudentCode</small>
                                </td>

                                @foreach (var sess in Model.SessionDates)
                                {
                                    var dayStat = row.DailyStatuses.ContainsKey(sess.Date.Date)
                                    ? row.DailyStatuses[sess.Date.Date]
                                    : new ManagerStudentCaltholic.Models.ViewModels.StudentDailyStatusDto();

                                    if (sess.IsSunday)
                                    {
                                        <!-- CN: CỘT 1 - LỄ -->
                                        <td class="border-start">
                                            @RenderStatusBadge(dayStat.MassSunStatus, dayStat.MassSunCheckInTime, dayStat.IsMassSunMakeUp)
                                        </td>
                                        <!-- CN: CỘT 2 - HỌC -->
                                        <td class="border-end">
                                            @RenderStatusBadge(dayStat.ClassStatus, dayStat.ClassCheckInTime, dayStat.IsClassMakeUp)
                                        </td>
                                    }
                                    else
                                    {
                                        <!-- T5: CHỈ CÓ 1 CỘT LỄ -->
                                        <td class="border-start border-end">
                                            @RenderStatusBadge(dayStat.MassThuStatus, dayStat.MassThuCheckInTime, dayStat.IsMassThuMakeUp)
                                        </td>
                                    }
                                }

                                <!-- Cột Tổng Kết Lễ T5 -->
                                <td class="text-success fw-bold border-start">@row.TotalMassThuAttended</td>
                                <td class="text-danger fw-bold border-end">@row.TotalMassThuAbsent</td>

                                <!-- Cột Tổng Kết Lễ CN -->
                                <td class="text-success fw-bold border-start">@row.TotalMassSunInLine</td>
                                <td class="text-warning fw-bold">@row.TotalMassSunAttended</td>
                                <td class="text-warning fw-bold">@row.TotalMassSunLate</td>
                                <td class="text-danger fw-bold border-end">@row.TotalMassSunAbsent</td>

                                <!-- Cột Tổng Kết Học -->
                                <td class="text-primary fw-bold">@row.TotalClassAttended</td>
                                <td class="text-warning fw-bold">@row.TotalClassLate</td>
                                <td class="text-danger fw-bold">@row.TotalClassAbsent</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(Model.SessionDates.Count(d => d.IsSunday) * 2 + Model.SessionDates.Count(d => d.IsThursday) + 8)" class="py-5 text-center text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không có học sinh nào trong lớp hoặc chưa có dữ liệu điểm danh tháng này.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    public static Microsoft.AspNetCore.Html.IHtmlContent RenderStatusBadge(string status, TimeSpan? checkInTime, bool isMakeUp)
    {
        if (isMakeUp)
        {
            return new Microsoft.AspNetCore.Html.HtmlString("<span class='badge-status status-makeup' title='Điểm danh bù'>⟲</span>");
        }

        switch (status)
        {
            case "LINED_UP":
                var titleLU = checkInTime.HasValue ? $"Có xếp hàng ({checkInTime.Value:hh\\:mm})" : "Xếp hàng đầu lễ";
                return new Microsoft.AspNetCore.Html.HtmlString($"<span class='badge-status status-inline' title='{titleLU}'>XH</span>");

            case "PRESENT":
                var titleP = checkInTime.HasValue ? $"Có mặt ({checkInTime.Value:hh\\:mm})" : "Có mặt đúng giờ";
                return new Microsoft.AspNetCore.Html.HtmlString($"<span class='badge-status status-present' title='{titleP}'>✔</span>");

            case "LATE":
                var titleL = checkInTime.HasValue ? $"Đi trễ ({checkInTime.Value:hh\\:mm})" : "Đi trễ";
                return new Microsoft.AspNetCore.Html.HtmlString($"<span class='badge-status status-late' title='{titleL}'>T</span>");

            case "ABSENT_PERMITTED":
                return new Microsoft.AspNetCore.Html.HtmlString("<span class='badge-status status-absent-p' title='Vắng có phép'>P</span>");

            case "ABSENT_UNPERMITTED":
            default:
                return new Microsoft.AspNetCore.Html.HtmlString("<span class='badge-status status-absent-u' title='Vắng không phép'>K</span>");
        }
    }
}