@model ManagerStudentCaltholic.Models.ViewModels.StudentLookupResultViewModel
@{
    ViewData["Title"] = $"Kết Quả Tra Cứu - {Model.ChristianName} {Model.FullName}";
}
@Html.AntiForgeryToken()

<style>
    .stat-grid-box {
        border-radius: 12px;
        padding: 10px 8px;
        text-align: center;
        height: 100%;
    }

    .campaign-cal-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(76px, 1fr));
        gap: 8px;
    }

    .campaign-day-tile {
        border-radius: 10px;
        padding: 8px 6px;
        text-align: center;
        border: 1px solid #e2e8f0;
        position: relative;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

        .campaign-day-tile:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        }

    .tile-present {
        background-color: #dcfce7;
        border-color: #86efac;
        color: #166534;
    }

    .tile-late {
        background-color: #fef9c3;
        border-color: #fde047;
        color: #854d0e;
    }

    .tile-excused {
        background-color: #e0f2fe;
        border-color: #7dd3fc;
        color: #075985;
    }

    .tile-absent {
        background-color: #fee2e2;
        border-color: #fca5a5;
        color: #991b1b;
    }

    .tile-future {
        background-color: #f8fafc;
        border-color: #e2e8f0;
        color: #94a3b8;
    }
</style>

<div class="container py-4">
    <!-- Thanh điều hướng trên cùng -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <a asp-controller="Lookup" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Tra cứu thiếu nhi khác
        </a>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold"
                    onclick="openDisputeModal('@DateTime.Today.ToString("yyyy-MM-dd")', 'REGULAR_MASS_SUN', null, 'Báo sai sót điểm danh')">
                <i class="bi bi-flag-fill me-1"></i> Báo Sai Sót Điểm Danh
            </button>
            <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-sm"
                    data-bs-toggle="modal" data-bs-target="#absenceRequestModal">
                <i class="bi bi-envelope-paper-fill me-1"></i> Nộp Đơn Xin Nghỉ Phép
            </button>
        </div>
    </div>

    @if (ViewBag.CodeRolloverNotice != null)
    {
        <div class="alert alert-info border-0 shadow-sm rounded-4 mb-3 d-flex align-items-center">
            <i class="bi bi-info-circle-fill fs-5 me-2 text-primary"></i>
            <div>@ViewBag.CodeRolloverNotice</div>
        </div>
    }

    <!-- 1. THẺ THÔNG TIN HỒ SƠ & MÃ QR -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
        <div class="card-body p-4">
            <div class="row align-items-center g-3">
                <div class="col-md-9">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="badge bg-primary rounded-pill px-3 py-1 font-monospace fs-6">
                            <i class="bi bi-qr-code me-1"></i>@Model.StudentCode
                        </span>
                        <span class="badge bg-info-subtle text-primary border px-3 py-1 rounded-pill">
                            Lớp: @Model.ClassName (@Model.GradeLevel)
                        </span>
                        <span class="badge bg-light text-secondary border px-3 py-1 rounded-pill">
                            Niên khóa: @Model.AcademicYearName
                        </span>
                    </div>

                    <h3 class="fw-bold text-dark mb-1">@Model.ChristianName @Model.FullName</h3>
                    <div class="row g-2 small text-muted mt-2">
                        <div class="col-sm-4">
                            <i class="bi bi-calendar-event me-1"></i>Ngày sinh: <strong class="text-dark">@Model.DateOfBirth.ToString("dd/MM/yyyy")</strong> (@Model.Gender)
                        </div>
                        <div class="col-sm-4">
                            <i class="bi bi-geo-alt me-1"></i>Phòng học: <strong class="text-dark">@Model.RoomNumber</strong>
                        </div>
                        <div class="col-sm-4">
                            <i class="bi bi-telephone-shield me-1"></i>SĐT Phụ huynh: <strong class="text-dark">@Model.MaskedParentPhone</strong>
                        </div>
                        @if (Model.Teachers.Any())
                        {
                            <div class="col-12 mt-1">
                                <i class="bi bi-person-badge me-1"></i>GLV Phụ trách: <strong class="text-primary">@string.Join(", ", Model.Teachers)</strong>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-md-3 text-center border-start-md">
                    @if (!string.IsNullOrEmpty(Model.QrCodeBase64))
                    {
                        <img src="@Model.QrCodeBase64" alt="QR Code" class="img-fluid rounded-3 border p-1 shadow-sm" style="max-width: 115px;" />
                        <div class="small text-muted mt-1">Mã QR Điểm Danh</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 2. BA Ô TỔNG KẾT ĐI LỄ & ĐI HỌC (STAT-GRID TRỰC QUAN - KHÔNG DÙNG %) -->
    <div class="row g-3 mb-4">
        <!-- Ô 1: Thánh Lễ Chúa Nhật -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div class="fw-bold text-success">
                            <i class="bi bi-bell-fill me-1"></i>Thánh Lễ Chúa Nhật
                        </div>
                        <span class="badge bg-success-subtle text-success border rounded-pill px-3 py-1">
                            Tham dự: @Model.AttendedSunMassCount / @Model.TotalSunMassSessions buổi
                        </span>
                    </div>
                    <div class="row g-2">
                        <div class="col-3">
                            <div class="stat-grid-box bg-purple-subtle border" style="background:#f3e8ff; color:#7e22ce;">
                                <div class="fs-4 fw-bold">@Model.SunMassLinedUpCount</div>
                                <div style="font-size: 0.72rem;" class="fw-semibold">Xếp hàng</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="stat-grid-box bg-success-subtle text-success border border-success-subtle">
                                <div class="fs-4 fw-bold">@Model.SunMassPresentCount</div>
                                <div style="font-size: 0.72rem;" class="fw-semibold">Có mặt</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="stat-grid-box bg-warning-subtle text-dark border border-warning-subtle">
                                <div class="fs-4 fw-bold">@Model.SunMassLateCount</div>
                                <div style="font-size: 0.72rem;" class="fw-semibold">Đi trễ</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="stat-grid-box bg-danger-subtle text-danger border border-danger-subtle">
                                <div class="fs-4 fw-bold">@Model.SunMassAbsentCount</div>
                                <div style="font-size: 0.72rem;" class="fw-semibold">Vắng</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ô 2: Thánh Lễ Thứ Năm -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div class="fw-bold text-warning-emphasis">
                            <i class="bi bi-brightness-high-fill me-1 text-warning"></i>Thánh Lễ Thứ Năm
                        </div>
                        <span class="badge bg-warning-subtle text-dark border rounded-pill px-3 py-1">
                            Tham dự: @Model.AttendedThuMassCount / @Model.TotalThuMassSessions buổi
                        </span>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="stat-grid-box bg-success-subtle text-success border border-success-subtle">
                                <div class="fs-4 fw-bold">@Model.AttendedThuMassCount</div>
                                <div class="small fw-semibold">Có mặt</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-grid-box bg-danger-subtle text-danger border border-danger-subtle">
                                <div class="fs-4 fw-bold">@Model.ThuMassAbsentCount</div>
                                <div class="small fw-semibold">Vắng</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ô 3: Học Giáo Lý Chúa Nhật -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div class="fw-bold text-primary">
                            <i class="bi bi-book-half me-1"></i>Học Giáo Lý Chúa Nhật
                        </div>
                        <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-1">
                            Tham dự: @Model.AttendedClassCount / @Model.TotalClassSessions buổi
                        </span>
                    </div>
                    <div class="row g-2">
                        <div class="col-4">
                            <div class="stat-grid-box bg-primary-subtle text-primary border border-primary-subtle">
                                <div class="fs-4 fw-bold">@Model.ClassPresentCount</div>
                                <div class="small fw-semibold">Có mặt</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-grid-box bg-warning-subtle text-dark border border-warning-subtle">
                                <div class="fs-4 fw-bold">@Model.ClassLateCount</div>
                                <div class="small fw-semibold">Đi trễ</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-grid-box bg-danger-subtle text-danger border border-danger-subtle">
                                <div class="fs-4 fw-bold">@Model.ClassAbsentCount</div>
                                <div class="small fw-semibold">Vắng</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. LỊCH CHIẾN DỊCH ĐI LỄ 1 THÁNG (DÀNH CHO LỚP CHUẨN BỊ BÍ TÍCH - FEAT-P4-01 & FEAT-P4-05) -->
    @if (Model.ActiveCampaign != null)
    {
        var camp = Model.ActiveCampaign;
        <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-warning">
            <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom">
                <div>
                    <span class="badge bg-warning text-dark rounded-pill px-3 py-1 mb-1 fw-bold">
                        <i class="bi bi-calendar2-heart-fill me-1"></i>Chiến Dịch Đi Lễ 1 Tháng Chuẩn Bị Bí Tích
                    </span>
                    <h5 class="fw-bold text-dark mb-0">@camp.CampaignName</h5>
                    <small class="text-muted">
                        Thời gian: <strong>@camp.StartDate.ToString("dd/MM/yyyy") - @camp.EndDate.ToString("dd/MM/yyyy")</strong> |
                        Chỉ tiêu cần đạt: <strong>@camp.TargetDaysCount buổi</strong>
                    </small>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-success-subtle text-success border px-3 py-2 rounded-pill">
                        Đã đi: <strong>@camp.AttendedDays / @camp.TargetDaysCount</strong> buổi
                    </span>
                    <span class="badge bg-danger-subtle text-danger border px-3 py-2 rounded-pill">
                        <i class="bi bi-fire me-1"></i>Chuỗi liên tiếp: <strong>@camp.CurrentStreak ngày</strong> (Max: @camp.MaxStreak)
                    </span>
                    @if (camp.IsTargetMet)
                    {
                        <span class="badge bg-success px-3 py-2 rounded-pill">
                            <i class="bi bi-patch-check-fill me-1"></i>Đạt chỉ tiêu Chiến dịch
                        </span>
                    }
                </div>
            </div>
            <div class="card-body p-3">
                <div class="small text-muted mb-2">
                    <i class="bi bi-hand-index-thumb me-1"></i>Bấm vào ô ngày bất kỳ bên dưới nếu cần gửi yêu cầu <strong>Báo sai sót điểm danh chiến dịch</strong> cho Giáo lý viên chủ nhiệm:
                </div>
                <div class="campaign-cal-grid">
                    @foreach (var d in camp.CampaignDays)
                    {
                        var tileClass = d.MassStatus switch
                        {
                            "PRESENT" => "tile-present",
                            "LATE" => "tile-late",
                            "EXCUSED" => "tile-excused",
                            "FUTURE" => "tile-future",
                            _ => "tile-absent"
                        };
                        var statusIcon = d.MassStatus switch
                        {
                            "PRESENT" => "✔ Có mặt",
                            "LATE" => "⏰ Đi trễ",
                            "EXCUSED" => "P Có phép",
                            "FUTURE" => "—",
                            _ => "✘ Vắng"
                        };

                        <div class="campaign-day-tile @tileClass"
                             style="cursor: @(d.MassStatus == "FUTURE" ? "default" : "pointer");"
                             onclick="@(d.MassStatus == "FUTURE" ? "" : $"openDisputeModal('{d.Date:yyyy-MM-dd}', 'CAMPAIGN_MASS', {camp.CampaignId}, 'Lễ Chiến dịch ngày {d.Date:dd/MM/yyyy}')")">
                            <div class="small fw-bold">@d.Date.ToString("dd/MM") (@d.DayLabel)</div>
                            <div class="fw-bold my-1" style="font-size: 0.78rem;">@statusIcon</div>
                            @if (!string.IsNullOrEmpty(d.MassCorrectionStatus))
                            {
                                <span class="badge @(d.MassCorrectionStatus == "APPROVED" ? "bg-success" : (d.MassCorrectionStatus == "REJECTED" ? "bg-danger" : "bg-warning text-dark"))" style="font-size: 0.62rem;">
                                    @(d.MassCorrectionStatus == "PENDING" ? "Chờ duyệt" : (d.MassCorrectionStatus == "APPROVED" ? "Đã sửa" : "Từ chối"))
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- 4. NHẬT KÝ CHI TIẾT TỪNG NGÀY ĐI HỌC & ĐI LỄ + NÚT BÁO SAI SÓT (FEAT-P4-05) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
        <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom">
            <div>
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-calendar-check-fill text-primary me-2"></i>Nhật Ký Từng Ngày Đi Lễ &amp; Học Giáo Lý
                </h5>
                <small class="text-muted">Xem chi tiết em đi học, đi lễ ngày nào và bấm <strong>Báo sai sót</strong> nếu kết quả ghi nhận chưa đúng</small>
            </div>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-primary active" onclick="filterDayLogs('ALL', this)">
                    Tất cả (@Model.AttendanceHistoryLogs.Count ngày)
                </button>
                <button type="button" class="btn btn-outline-danger" onclick="filterDayLogs('ABSENT_OR_LATE', this)">
                    Các buổi Vắng / Đi trễ
                </button>
            </div>
        </div>

        <div class="table-responsive" style="max-height: 460px;">
            <table class="table table-hover align-middle mb-0 small" id="dayLogsTable">
                <thead class="table-light sticky-top">
                    <tr>
                        <th class="ps-3">Ngày Sinh Hoạt</th>
                        <th>Thánh Lễ</th>
                        <th>Giờ Học Giáo Lý</th>
                        <th>Ghi Chú / Phản Hồi Của GLV</th>
                        <th class="text-end pe-3">Báo Sai Sót</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AttendanceHistoryLogs.Any())
                    {
                        foreach (var log in Model.AttendanceHistoryLogs)
                        {
                            var massScope = log.IsSunday ? "REGULAR_MASS_SUN" : "REGULAR_MASS_THU";
                            <tr class="day-log-row" data-has-issue="@log.HasAnyAbsenceOrLate.ToString().ToLower()">
                                <td class="ps-3">
                                    <div class="fw-bold text-dark">@log.FormattedDate</div>
                                    <span class="badge @(log.IsSunday ? "bg-primary-subtle text-primary" : "bg-warning-subtle text-dark") border">
                                        @log.DayLabel
                                    </span>
                                </td>

                                <!-- Trạng thái Lễ -->
                                <td>
                                    @RenderLookupStatusBadge(log.MassStatus, log.MassCheckInTime, log.IsMakeUp)
                                    @if (!string.IsNullOrEmpty(log.MassCorrectionStatus))
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border ms-1">
                                            Khiếu nại: @log.MassCorrectionStatus
                                        </span>
                                    }
                                </td>

                                <!-- Trạng thái Học Giáo Lý -->
                                <td>
                                    @if (log.HasClassSession)
                                    {
                                        @RenderLookupStatusBadge(log.ClassStatus, log.ClassCheckInTime, log.IsMakeUp)
                                        @if (!string.IsNullOrEmpty(log.ClassCorrectionStatus))
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border ms-1">
                                                Khiếu nại: @log.ClassCorrectionStatus
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Không có tiết học</span>
                                    }
                                </td>

                                <!-- Ghi chú -->
                                <td>
                                    @if (!string.IsNullOrEmpty(log.Note))
                                    {
                                        <div class="text-dark">@log.Note</div>
                                    }
                                    @if (!string.IsNullOrEmpty(log.TeacherNote))
                                    {
                                        <div class="text-primary fw-semibold">
                                            <i class="bi bi-chat-left-quote-fill me-1"></i>Phản hồi GLV: @log.TeacherNote
                                        </div>
                                    }
                                </td>

                                <!-- Nút Báo sai sót -->
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-danger rounded-pill px-2 py-1"
                                                onclick="openDisputeModal('@log.Date.ToString("yyyy-MM-dd")', '@massScope', null, 'Thánh Lễ ngày @log.FormattedDate')">
                                            <i class="bi bi-flag"></i> Báo sai Lễ
                                        </button>
                                        @if (log.HasClassSession)
                                        {
                                            <button type="button" class="btn btn-outline-warning text-dark rounded-pill px-2 py-1 ms-1"
                                                    onclick="openDisputeModal('@log.Date.ToString("yyyy-MM-dd")', 'REGULAR_CLASS', null, 'Giờ Học Giáo Lý ngày @log.FormattedDate')">
                                                <i class="bi bi-flag"></i> Báo sai Học
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                Chưa có dữ liệu nhật ký điểm danh trong niên khóa hiện tại.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 5. DANH SÁCH YÊU CẦU BÁO SAI SÓT ĐÃ GỬI (NẾU CÓ) -->
    @if (Model.SubmittedDisputes.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-clock-history text-danger me-2"></i>Lịch Sử Yêu Cầu Đính Chính Điểm Danh Của Gia Đình
                </h6>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Ngày Báo</th>
                            <th>Buổi Cần Sửa</th>
                            <th>Đề Nghị</th>
                            <th>Lý Do Phụ Huynh Gửi</th>
                            <th>Trạng Thái</th>
                            <th class="pe-3">Phản Hồi Của GLV</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.SubmittedDisputes)
                        {
                            <tr>
                                <td class="ps-3">@d.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
                                <td><strong>@d.AttendanceDate.ToString("dd/MM/yyyy")</strong> - @d.SessionScopeLabel</td>
                                <td>
                                    <span class="badge bg-secondary">@d.CurrentRecordedStatus</span>
                                    <i class="bi bi-arrow-right mx-1"></i>
                                    <span class="badge bg-success">@d.RequestedStatus</span>
                                </td>
                                <td>@d.Reason</td>
                                <td>
                                    @if (d.Status == "APPROVED")
                                    {
                                        <span class="badge bg-success">Đã chấp nhận &amp; sửa</span>
                                    }
                                    else if (d.Status == "REJECTED")
                                    {
                                        <span class="badge bg-danger">Từ chối</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Đang chờ GLV duyệt</span>
                                    }
                                </td>
                                <td class="pe-3">@(d.TeacherResponseNote ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- 6. BẢNG ĐIỂM HỌC KỲ 1, HỌC KỲ 2 & TỔNG KẾT NĂM -->
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-primary mb-0"><i class="bi bi-journal-text me-2"></i>Bảng Điểm Học Kỳ 1</h6>
                    <span class="badge bg-primary rounded-pill px-3">
                        ĐTB HK1: @(Model.HK1.SemesterAverage?.ToString("0.00") ?? "--")
                    </span>
                </div>
                <div class="card-body p-3">
                    @if (Model.HK1.Items.Any())
                    {
                        <ul class="list-group list-group-flush small">
                            @foreach (var item in Model.HK1.Items)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <span>@item.DisplayName <small class="text-muted">(HS @item.WeightFactor)</small></span>
                                    <strong class="fs-6 text-dark">@(item.Score?.ToString("0.0") ?? "--")</strong>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-muted small text-center py-3">Chưa có cột điểm Học kỳ 1.</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-success mb-0"><i class="bi bi-journal-check me-2"></i>Bảng Điểm Học Kỳ 2 &amp; Cả Năm</h6>
                    <span class="badge bg-success rounded-pill px-3">
                        ĐTB HK2: @(Model.HK2.SemesterAverage?.ToString("0.00") ?? "--") |
                        Cả Năm: @(Model.YearAverage?.ToString("0.00") ?? "--") (@Model.OverallRank)
                    </span>
                </div>
                <div class="card-body p-3">
                    @if (Model.HK2.Items.Any())
                    {
                        <ul class="list-group list-group-flush small">
                            @foreach (var item in Model.HK2.Items)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <span>@item.DisplayName <small class="text-muted">(HS @item.WeightFactor)</small></span>
                                    <strong class="fs-6 text-dark">@(item.Score?.ToString("0.0") ?? "--")</strong>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-muted small text-center py-3">Chưa có cột điểm Học kỳ 2.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL BÁO SAI SÓT ĐIỂM DANH (FEAT-P4-05) -->
<div class="modal fade" id="disputeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-danger text-white">
                <h6 class="modal-title fw-bold">
                    <i class="bi bi-flag-fill me-2"></i>Gửi Yêu Cầu Đính Chính Điểm Danh
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-light border small mb-3" id="disputeTargetLabel"></div>
                <input type="hidden" id="dispCampaignId" value="" />

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Ngày điểm danh cần sửa <span class="text-danger">*</span></label>
                        <input type="date" id="dispDateIso" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Buổi sinh hoạt <span class="text-danger">*</span></label>
                        <select id="dispSessionScope" class="form-select form-select-sm">
                            <option value="REGULAR_MASS_SUN">Thánh Lễ Chúa Nhật</option>
                            <option value="REGULAR_CLASS">Giờ Học Giáo Lý CN</option>
                            <option value="REGULAR_MASS_THU">Thánh Lễ Thứ Năm</option>
                            <option value="CAMPAIGN_MASS">Lễ Chiến Dịch 1 Tháng</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Đề nghị cập nhật thành trạng thái <span class="text-danger">*</span></label>
                    <select id="dispRequestedStatus" class="form-select form-select-sm fw-semibold text-success">
                        <option value="PRESENT">✔ Có mặt đúng giờ</option>
                        <option value="LINED_UP">★ Có xếp hàng đầu giờ lễ</option>
                        <option value="LATE">⏰ Đi trễ (Có tham dự)</option>
                        <option value="ABSENT_PERMITTED">P Vắng có phép</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Lý do / Minh chứng gửi Giáo lý viên <span class="text-danger">*</span></label>
                    <textarea id="dispReason" class="form-control form-control-sm" rows="3"
                              placeholder="VD: Hôm đó bé có đi lễ và ngồi hàng ghế lớp nhưng quên mang thẻ QR..." required></textarea>
                </div>

                <div class="mb-2">
                    <label class="form-label small fw-bold">Nhập 4 số cuối SĐT Phụ huynh (@Model.MaskedParentPhone) để xác nhận <span class="text-danger">*</span></label>
                    <input type="password" inputmode="numeric" maxlength="4" id="dispPhoneLast4"
                           class="form-control form-control-sm text-center fw-bold" style="letter-spacing: 5px;" placeholder="••••" required />
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="btnSubmitDispute" class="btn btn-danger btn-sm rounded-pill px-4 fw-bold" onclick="submitParentDispute()">
                    <i class="bi bi-send-check me-1"></i> Gửi Yêu Cầu Cho GLV
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL NỘP ĐƠN XIN NGHỈ PHÉP TRỰC TUYẾN -->
<div class="modal fade" id="absenceRequestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-primary text-white">
                <h6 class="modal-title fw-bold"><i class="bi bi-envelope-paper me-2"></i>Nộp Đơn Xin Phép Nghỉ Học / Nghỉ Lễ</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label small fw-bold">Ngày xin nghỉ (*)</label>
                    <input type="date" id="absDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Buổi xin nghỉ (*)</label>
                    <select id="absSessionType" class="form-select">
                        <option value="ALL">Cả Thánh Lễ &amp; Giờ Học Giáo Lý</option>
                        <option value="MASS">Chỉ xin nghỉ Thánh Lễ</option>
                        <option value="CLASS">Chỉ xin nghỉ Giờ Học Giáo Lý</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Số điện thoại Phụ huynh xác nhận (*)</label>
                    <input type="tel" id="absPhone" class="form-control" placeholder="Nhập đầy đủ SĐT (@Model.MaskedParentPhone) để xác nhận..." required />
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-bold">Lý do xin phép nghỉ (*)</label>
                    <textarea id="absReason" class="form-control" rows="3" placeholder="Nhập lý do xin nghỉ..." required></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold" onclick="submitOnlineAbsence()">Gửi Đơn Xin Phép</button>
            </div>
        </div>
    </div>
</div>

@functions {
    public static Microsoft.AspNetCore.Html.IHtmlContent RenderLookupStatusBadge(string status, string? checkInTime, bool isMakeUp)
    {
        if (isMakeUp || status == "MAKE_UP")
        {
            return new Microsoft.AspNetCore.Html.HtmlString("<span class='badge bg-warning-subtle text-dark border border-warning'>⟲ Đã đi bù</span>");
        }

        var timeNote = !string.IsNullOrEmpty(checkInTime) ? $" ({checkInTime})" : "";
        return status switch
        {
            "LINED_UP" => new Microsoft.AspNetCore.Html.HtmlString($"<span class='badge' style='background:#f3e8ff;color:#7e22ce;border:1px solid #d8b4fe;'>★ Xếp hàng{timeNote}</span>"),
            "PRESENT" => new Microsoft.AspNetCore.Html.HtmlString($"<span class='badge bg-success-subtle text-success border border-success-subtle'>✔ Có mặt{timeNote}</span>"),
            "LATE" => new Microsoft.AspNetCore.Html.HtmlString($"<span class='badge bg-warning-subtle text-dark border border-warning-subtle'>⏰ Đi trễ{timeNote}</span>"),
            "ABSENT_PERMITTED" or "EXCUSED" => new Microsoft.AspNetCore.Html.HtmlString("<span class='badge bg-info-subtle text-info-emphasis border border-info-subtle'>P Vắng có phép</span>"),
            _ => new Microsoft.AspNetCore.Html.HtmlString("<span class='badge bg-danger-subtle text-danger border border-danger-subtle'>✘ Vắng không phép</span>")
        };
    }
}

@section Scripts {
    <script>
        function getCsrfToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        function filterDayLogs(mode, btn) {
            btn.parentElement.querySelectorAll('button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            document.querySelectorAll('#dayLogsTable tbody .day-log-row').forEach(row => {
                const hasIssue = row.getAttribute('data-has-issue') === 'true';
                if (mode === 'ALL' || (mode === 'ABSENT_OR_LATE' && hasIssue)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function openDisputeModal(dateIso, scope, campaignId, labelText) {
            document.getElementById('dispDateIso').value = dateIso;
            document.getElementById('dispSessionScope').value = scope;
            document.getElementById('dispCampaignId').value = campaignId || '';
            document.getElementById('dispReason').value = '';
            document.getElementById('dispPhoneLast4').value = '';
            document.getElementById('disputeTargetLabel').textContent =
                `Thiếu nhi: @Html.Raw(Model.ChristianName + " " + Model.FullName) (@Model.StudentCode) — Mục cần đính chính: ${labelText}`;

            bootstrap.Modal.getOrCreateInstance(document.getElementById('disputeModal')).show();
        }

        async function submitParentDispute() {
            const dateIso = document.getElementById('dispDateIso').value;
            const scope = document.getElementById('dispSessionScope').value;
            const campIdVal = document.getElementById('dispCampaignId').value;
            const reqStatus = document.getElementById('dispRequestedStatus').value;
            const reason = document.getElementById('dispReason').value.trim();
            const phoneLast4 = document.getElementById('dispPhoneLast4').value.trim();

            if (!dateIso || !reason || phoneLast4.length !== 4) {
                alert('Vui lòng nhập đầy đủ lý do báo sai sót và đúng 4 chữ số cuối SĐT Phụ huynh!');
                return;
            }

            const btn = document.getElementById('btnSubmitDispute');
            btn.disabled = true;

            try {
                const res = await fetch('/TraCuu/SubmitDispute', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': getCsrfToken()
                    },
                    body: JSON.stringify({
                        studentCode: '@Model.StudentCode',
                        dateOfBirth: '@Model.DateOfBirth.ToString("yyyy-MM-dd")',
                        phoneLast4Digits: phoneLast4,
                        attendanceDateIso: dateIso,
                        sessionScope: scope,
                        campaignId: campIdVal ? parseInt(campIdVal) : null,
                        requestedStatus: reqStatus,
                        reason: reason
                    })
                });

                const data = await res.json();
                alert(data.message || 'Đã xử lý yêu cầu.');
                if (res.ok && data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('disputeModal')).hide();
                }
            } catch (err) {
                alert('Lỗi kết nối máy chủ: ' + err.message);
            } finally {
                btn.disabled = false;
            }
        }

        async function submitOnlineAbsence() {
            const absDate = document.getElementById('absDate').value;
            const sessionType = document.getElementById('absSessionType').value;
            const parentPhone = document.getElementById('absPhone').value.trim();
            const reason = document.getElementById('absReason').value.trim();

            if (!absDate || !parentPhone || !reason) {
                alert('Vui lòng điền đầy đủ SĐT Phụ huynh và lý do xin nghỉ!');
                return;
            }

            const res = await fetch('/Absence/SubmitRequest', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': getCsrfToken()
                },
                body: JSON.stringify({
                    studentCode: '@Model.StudentCode',
                    dateOfBirth: '@Model.DateOfBirth.ToString("yyyy-MM-dd")',
                    absenceDate: absDate,
                    sessionType: sessionType,
                    parentPhone: parentPhone,
                    reason: reason
                })
            });

            const data = await res.json();
            alert(data.message);
            if (data.success) {
                bootstrap.Modal.getInstance(document.getElementById('absenceRequestModal')).hide();
            }
        }
    </script>
}