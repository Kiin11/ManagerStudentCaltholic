@model ManagerStudentCaltholic.Models.ViewModels.StudentLookupResultViewModel
@{
    ViewData["Title"] = $"Kết Quả Tra Cứu - {Model.FullName}";
}
@Html.AntiForgeryToken()

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <a href="/TraCuu" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Tra cứu thiếu nhi khác
        </a>
        <button type="button" class="btn btn-danger btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#absenceModal">
            <i class="bi bi-envelope-paper me-1"></i> Xin Phép Nghỉ Học / Nghỉ Lễ
        </button>
    </div>

    <!-- Thông tin Thiếu nhi & Thẻ QR -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="row align-items-center g-3">
                <div class="col-md-8">
                    <span class="badge bg-primary-subtle text-primary mb-2 px-3 py-1 rounded-pill">
                        Niên khóa: @Model.AcademicYearName
                    </span>
                    <h3 class="fw-bold text-dark mb-1">@Model.ChristianName @Model.FullName</h3>
                    <p class="text-muted mb-2">
                        Mã thiếu nhi: <strong class="font-monospace text-dark">@Model.StudentCode</strong> |
                        Ngày sinh: <strong>@Model.DateOfBirth.ToString("dd/MM/yyyy")</strong> |
                        Giới tính: <strong>@Model.Gender</strong>
                    </p>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <span class="badge bg-light text-dark border px-3 py-2">
                            <i class="bi bi-easel me-1 text-primary"></i> Lớp: <strong>@Model.ClassName</strong> (@Model.GradeLevel)
                        </span>
                        <span class="badge bg-light text-dark border px-3 py-2">
                            <i class="bi bi-geo-alt me-1 text-danger"></i> Phòng: <strong>@Model.RoomNumber</strong>
                        </span>
                        @if (Model.Teachers.Any())
                        {
                            <span class="badge bg-light text-dark border px-3 py-2">
                                <i class="bi bi-person-badge me-1 text-success"></i> GLV: <strong>@string.Join(", ", Model.Teachers)</strong>
                            </span>
                        }
                    </div>
                </div>
                <div class="col-md-4 text-md-end text-center">
                    @if (!string.IsNullOrEmpty(Model.QrCodeBase64))
                    {
                        <img src="@Model.QrCodeBase64" alt="QR Code" class="img-thumbnail rounded-3" style="width: 120px; height: 120px;" />
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 4 Thẻ Thống Kê: Lễ Chúa Nhật - Lễ Thứ Năm - Học Giáo Lý - ĐTB Cả Năm -->
    <div class="row g-3 mb-4">
        <!-- 1. THÁNH LỄ CHÚA NHẬT -->
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-top border-4 border-success">
                <div class="card-body text-center p-3">
                    <div class="text-success small fw-bold text-uppercase mb-1">
                        <i class="bi bi-bell-fill me-1"></i>Thánh Lễ Chúa Nhật
                    </div>
                    <h2 class="fw-bold text-success mb-1">@Model.SunMassAttendanceRate%</h2>
                    <div class="small text-muted mb-2">
                        Tham dự: <strong>@Model.AttendedSunMassCount / @Model.TotalSunMassSessions</strong> buổi
                    </div>
                    <div class="d-flex flex-wrap justify-content-center gap-1 pt-2 border-top">
                        <span class="badge bg-purple-subtle text-dark border" title="Xếp hàng đầu giờ">XH: @Model.SunMassLinedUpCount</span>
                        <span class="badge bg-success-subtle text-success border">Đúng giờ: @Model.SunMassPresentCount</span>
                        <span class="badge bg-warning-subtle text-dark border">Trễ: @Model.SunMassLateCount</span>
                        <span class="badge bg-danger-subtle text-danger border">Vắng: @Model.SunMassAbsentCount</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. THÁNH LỄ THỨ NĂM -->
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-top border-4 border-info">
                <div class="card-body text-center p-3">
                    <div class="text-info-emphasis small fw-bold text-uppercase mb-1">
                        <i class="bi bi-calendar2-heart-fill me-1"></i>Thánh Lễ Thứ Năm
                    </div>
                    <h2 class="fw-bold text-info-emphasis mb-1">@Model.ThuMassAttendanceRate%</h2>
                    <div class="small text-muted mb-2">
                        Tham dự: <strong>@Model.AttendedThuMassCount / @Model.TotalThuMassSessions</strong> buổi
                    </div>
                    <div class="d-flex flex-wrap justify-content-center gap-2 pt-2 border-top">
                        <span class="badge bg-success-subtle text-success border px-2">Có mặt: @Model.AttendedThuMassCount</span>
                        <span class="badge bg-danger-subtle text-danger border px-2">Vắng: @Model.ThuMassAbsentCount</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. GIỜ HỌC GIÁO LÝ (CHÚA NHẬT) -->
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-top border-4 border-primary">
                <div class="card-body text-center p-3">
                    <div class="text-primary small fw-bold text-uppercase mb-1">
                        <i class="bi bi-book-half me-1"></i>Học Giáo Lý Chúa Nhật
                    </div>
                    <h2 class="fw-bold text-primary mb-1">@Model.ClassAttendanceRate%</h2>
                    <div class="small text-muted mb-2">
                        Hiện diện: <strong>@Model.AttendedClassCount / @Model.TotalClassSessions</strong> buổi
                    </div>
                    <div class="d-flex flex-wrap justify-content-center gap-1 pt-2 border-top">
                        <span class="badge bg-primary-subtle text-primary border">Đúng giờ: @(Math.Max(0, Model.AttendedClassCount - Model.ClassLateCount))</span>
                        <span class="badge bg-warning-subtle text-dark border">Trễ: @Model.ClassLateCount</span>
                        <span class="badge bg-danger-subtle text-danger border">Vắng: @Model.ClassAbsentCount</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. ĐTB CẢ NĂM & XẾP LOẠI -->
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-warning-subtle border-top border-4 border-warning">
                <div class="card-body text-center p-3">
                    <div class="text-dark small fw-bold text-uppercase mb-1">
                        <i class="bi bi-award-fill me-1"></i>Tổng Kết Cả Năm
                    </div>
                    <h2 class="fw-bold text-dark mb-1">
                        @(Model.YearAverage.HasValue? Model.YearAverage.Value.ToString("0.00") : "--")
                    </h2>
                    <div class="mb-2">
                        <span class="badge bg-dark px-3 py-1 rounded-pill">@Model.OverallRank</span>
                    </div>
                    <div class="pt-2 border-top border-warning-subtle small">
                        <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2">
                            Xét Bí Tích: Chưa xét
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng điểm Học kỳ 1 & Học kỳ 2 -->
    <div class="row g-4">
        @foreach (var sem in new[] { Model.HK1, Model.HK2 })
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                        <h6 class="fw-bold mb-0 text-primary">
                            <i class="bi bi-journal-check me-1"></i>BẢNG ĐIỂM HỌC KỲ @sem.Semester
                        </h6>
                        <span class="badge bg-primary-subtle text-primary px-3 py-1">
                            ĐTB HK@(sem.Semester): @(sem.SemesterAverage.HasValue? sem.SemesterAverage.Value.ToString("0.00") : "--") (@sem.Rank)
                        </span>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th class="ps-3">Cột Điểm</th>
                                    <th class="text-center">Hệ Số</th>
                                    <th class="text-end pe-3">Điểm Số</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (sem.Items.Any())
                                {
                                    @foreach (var item in sem.Items)
                                    {
                                        <tr>
                                            <td class="ps-3">@item.DisplayName</td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border">x@(item.WeightFactor)</span>
                                            </td>
                                            <td class="text-end pe-3 fw-bold text-primary">
                                                @(item.Score.HasValue? item.Score.Value.ToString("0.0") : "--")
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-muted small">
                                            Chưa có cấu hình cột điểm cho Học kỳ @sem.Semester.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Xin Phép Nghỉ Trực Tuyến -->
<div class="modal fade" id="absenceModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-envelope-paper text-danger me-2"></i>Đơn Xin Phép Nghỉ Học / Nghỉ Lễ
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Ngày xin nghỉ (*)</label>
                    <input type="date" id="absDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Buổi xin nghỉ</label>
                    <select id="absSession" class="form-select">
                        <option value="ALL">Cả Thánh Lễ & Giờ Học Giáo Lý</option>
                        <option value="MASS">Chỉ xin nghỉ Thánh Lễ (Thứ 5 / Chúa Nhật)</option>
                        <option value="CLASS">Chỉ xin nghỉ Giờ Học Giáo Lý</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Số điện thoại Phụ huynh xác nhận (*)</label>
                    <input type="tel" id="absPhone" class="form-control"
                           placeholder="Nhập đầy đủ SĐT (@Model.MaskedParentPhone) để xác nhận..." required />
                </div>
                <div class="mb-2">
                    <label class="form-label fw-semibold">Lý do xin phép nghỉ (*)</label>
                    <textarea id="absReason" class="form-control" rows="3" placeholder="VD: Em bị sốt / Gia đình có việc bận..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold" onclick="submitAbsence()">Gửi Đơn Xin Phép</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function submitAbsence() {
            const reason = document.getElementById('absReason').value.trim();
            if (!reason) {
                alert('Vui lòng nhập lý do xin phép nghỉ!');
                return;
            }
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const payload = {
                studentCode: '@Model.StudentCode',
                dateOfBirth: '@Model.DateOfBirth.ToString("yyyy-MM-dd")',
                absenceDate: document.getElementById('absDate').value,
                sessionType: document.getElementById('absSession').value,
                parentPhone: document.getElementById('absPhone').value.trim(),
                reason: reason
            };

            const res = await fetch('/Absence/SubmitRequest', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': token
                },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            alert(data.message);
            if (data.success) {
                bootstrap.Modal.getInstance(document.getElementById('absenceModal')).hide();
            }
        }
    </script>
}