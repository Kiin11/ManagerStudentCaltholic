@model ManagerStudentCaltholic.Models.ViewModels.StudentLookupResultViewModel
@{
    ViewData["Title"] = $"Kết Quả Tra Cứu - {Model.FullName}";
    var classPresentOnTime = Math.Max(0, Model.AttendedClassCount - Model.ClassLateCount);
}
@Html.AntiForgeryToken()

<style>
    .att-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .att-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1.2rem rgba(0,0,0,.08) !important;
        }

    .stat-box {
        border-radius: 12px;
        padding: 10px 6px;
        text-align: center;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .stat-box .stat-num {
            font-size: 1.35rem;
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 3px;
        }

        .stat-box .stat-label {
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

    .box-linedup {
        background-color: #f3e8ff;
        color: #6b21a8;
        border: 1px solid #e9d5ff;
    }

    .box-present {
        background-color: #dcfce7;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .box-late {
        background-color: #fef3c7;
        color: #b45309;
        border: 1px solid #fde68a;
    }

    .box-absent {
        background-color: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }
</style>

<div class="container py-4">
    <!-- Thanh nút trên cùng -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <a href="/TraCuu" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Tra cứu thiếu nhi khác
        </a>
        <button type="button" class="btn btn-danger btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#absenceModal">
            <i class="bi bi-envelope-paper me-1"></i> Xin Phép Nghỉ Học / Nghỉ Lễ
        </button>
    </div>

    <!-- Thông tin Thiếu nhi & Thẻ QR -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="row align-items-center g-3">
                <div class="col-md-8">
                    <span class="badge bg-primary-subtle text-primary mb-2 px-3 py-1 rounded-pill">
                        Niên khóa: @Model.AcademicYearName
                    </span>
                    <h3 class="fw-bold text-dark mb-1">@Model.ChristianName @Model.FullName</h3>
                    <p class="text-muted mb-2">
                        Mã thiếu nhi: <strong class="font-monospace text-dark">@Model.StudentCode</strong> |
                        Ngày sinh: <strong>@Model.DateOfBirth.ToString("dd/MM/yyyy")</strong> |
                        Giới tính: <strong>@Model.Gender</strong>
                    </p>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <span class="badge bg-light text-dark border px-3 py-2">
                            <i class="bi bi-easel me-1 text-primary"></i> Lớp: <strong>@Model.ClassName</strong> (@Model.GradeLevel)
                        </span>
                        <span class="badge bg-light text-dark border px-3 py-2">
                            <i class="bi bi-geo-alt me-1 text-danger"></i> Phòng: <strong>@Model.RoomNumber</strong>
                        </span>
                        @if (Model.Teachers.Any())
                        {
                            <span class="badge bg-light text-dark border px-3 py-2">
                                <i class="bi bi-person-badge me-1 text-success"></i> GLV: <strong>@string.Join(", ", Model.Teachers)</strong>
                            </span>
                        }
                    </div>
                </div>
                <div class="col-md-4 text-md-end text-center">
                    @if (!string.IsNullOrEmpty(Model.QrCodeBase64))
                    {
                        <img src="@Model.QrCodeBase64" alt="QR Code" class="img-thumbnail rounded-3" style="width: 120px; height: 120px;" />
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- GIAO DIỆN MỚI: 3 Ô CHUYÊN CẦN (KHÔNG DÙNG %) + 1 Ô TỔNG KẾT -->
    <div class="row g-3 mb-4">
        <!-- Ô 1: THÁNH LỄ CHÚA NHẬT -->
        <div class="col-xl-3 col-md-6">
            <div class="card att-card border-0 shadow-sm rounded-4 h-100 border-top border-4 border-success">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <span class="bg-success-subtle text-success rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                <i class="bi bi-bell-fill"></i>
                            </span>
                            <div>
                                <div class="fw-bold text-dark small text-uppercase">Thánh Lễ Chúa Nhật</div>
                                <small class="text-muted" style="font-size: 0.75rem;">Tổng số: @Model.TotalSunMassSessions buổi</small>
                            </div>
                        </div>
                        <span class="badge bg-success text-white rounded-pill px-2 py-1">
                            Đi: @Model.AttendedSunMassCount/@Model.TotalSunMassSessions
                        </span>
                    </div>

                    <!-- 4 Ô chỉ số: Xếp hàng - Có mặt - Trễ - Vắng -->
                    <div class="row g-2">
                        <div class="col-3">
                            <div class="stat-box box-linedup" title="Đi lễ đúng giờ và có xếp hàng">
                                <div class="stat-num">@Model.SunMassLinedUpCount</div>
                                <div class="stat-label">Xếp hàng</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="stat-box box-present" title="Có mặt dự lễ">
                                <div class="stat-num">@Model.SunMassPresentCount</div>
                                <div class="stat-label">Có mặt</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="stat-box box-late" title="Đi lễ trễ">
                                <div class="stat-num">@Model.SunMassLateCount</div>
                                <div class="stat-label">Đi trễ</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="stat-box box-absent" title="Vắng lễ Chúa Nhật">
                                <div class="stat-num">@Model.SunMassAbsentCount</div>
                                <div class="stat-label">Vắng</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ô 2: THÁNH LỄ THỨ NĂM -->
        <div class="col-xl-3 col-md-6">
            <div class="card att-card border-0 shadow-sm rounded-4 h-100 border-top border-4 border-info">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <span class="bg-info-subtle text-info-emphasis rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                <i class="bi bi-calendar2-heart-fill"></i>
                            </span>
                            <div>
                                <div class="fw-bold text-dark small text-uppercase">Thánh Lễ Thứ Năm</div>
                                <small class="text-muted" style="font-size: 0.75rem;">Tổng số: @Model.TotalThuMassSessions buổi</small>
                            </div>
                        </div>
                        <span class="badge bg-info text-dark rounded-pill px-2 py-1 fw-bold">
                            Đi: @Model.AttendedThuMassCount/@Model.TotalThuMassSessions
                        </span>
                    </div>

                    <!-- 2 Ô chỉ số: Có mặt - Vắng -->
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="stat-box box-present">
                                <div class="stat-num">@Model.AttendedThuMassCount</div>
                                <div class="stat-label">Có mặt dự lễ</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-box box-absent">
                                <div class="stat-num">@Model.ThuMassAbsentCount</div>
                                <div class="stat-label">Vắng lễ</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ô 3: HỌC GIÁO LÝ CHÚA NHẬT -->
        <div class="col-xl-3 col-md-6">
            <div class="card att-card border-0 shadow-sm rounded-4 h-100 border-top border-4 border-primary">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <span class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                <i class="bi bi-book-half"></i>
                            </span>
                            <div>
                                <div class="fw-bold text-dark small text-uppercase">Học Giáo Lý CN</div>
                                <small class="text-muted" style="font-size: 0.75rem;">Tổng số: @Model.TotalClassSessions buổi</small>
                            </div>
                        </div>
                        <span class="badge bg-primary text-white rounded-pill px-2 py-1">
                            Học: @Model.AttendedClassCount/@Model.TotalClassSessions
                        </span>
                    </div>

                    <!-- 3 Ô chỉ số: Đúng giờ - Đi trễ - Vắng -->
                    <div class="row g-2">
                        <div class="col-4">
                            <div class="stat-box box-present">
                                <div class="stat-num">@classPresentOnTime</div>
                                <div class="stat-label">Đúng giờ</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-box box-late">
                                <div class="stat-num">@Model.ClassLateCount</div>
                                <div class="stat-label">Đi trễ</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-box box-absent">
                                <div class="stat-num">@Model.ClassAbsentCount</div>
                                <div class="stat-label">Vắng học</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ô 4: TỔNG KẾT CẢ NĂM -->
        <div class="col-xl-3 col-md-6">
            <div class="card att-card border-0 shadow-sm rounded-4 h-100 bg-warning-subtle border-top border-4 border-warning">
                <div class="card-body text-center p-3 d-flex flex-column justify-content-between">
                    <div class="text-dark small fw-bold text-uppercase">
                        <i class="bi bi-award-fill me-1 text-warning-emphasis"></i>Tổng Kết Cả Năm
                    </div>
                    <div class="my-1">
                        <div class="fw-bold text-dark" style="font-size: 2rem; line-height: 1.1;">
                            @(Model.YearAverage.HasValue? Model.YearAverage.Value.ToString("0.00") : "--")
                        </div>
                        <span class="badge bg-dark px-3 py-1 rounded-pill mt-1">@Model.OverallRank</span>
                    </div>
                    <div class="pt-2 border-top border-warning-subtle small">
                        <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2">
                            Xét Bí Tích: Chưa xét
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng điểm Học kỳ 1 & Học kỳ 2 -->
    <div class="row g-4">
        @foreach (var sem in new[] { Model.HK1, Model.HK2 })
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                        <h6 class="fw-bold mb-0 text-primary">
                            <i class="bi bi-journal-check me-1"></i>BẢNG ĐIỂM HỌC KỲ @sem.Semester
                        </h6>
                        <span class="badge bg-primary-subtle text-primary px-3 py-1">
                            ĐTB HK@(sem.Semester): @(sem.SemesterAverage.HasValue? sem.SemesterAverage.Value.ToString("0.00") : "--") (@sem.Rank)
                        </span>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th class="ps-3">Cột Điểm</th>
                                    <th class="text-center">Hệ Số</th>
                                    <th class="text-end pe-3">Điểm Số</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (sem.Items.Any())
                                {
                                    @foreach (var item in sem.Items)
                                    {
                                        <tr>
                                            <td class="ps-3">@item.DisplayName</td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border">x@(item.WeightFactor)</span>
                                            </td>
                                            <td class="text-end pe-3 fw-bold text-primary">
                                                @(item.Score.HasValue? item.Score.Value.ToString("0.0") : "--")
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-muted small">
                                            Chưa có cấu hình cột điểm cho Học kỳ @sem.Semester.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Xin Phép Nghỉ Trực Tuyến -->
<div class="modal fade" id="absenceModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-envelope-paper text-danger me-2"></i>Đơn Xin Phép Nghỉ Học / Nghỉ Lễ
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Ngày xin nghỉ (*)</label>
                    <input type="date" id="absDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Buổi xin nghỉ</label>
                    <select id="absSession" class="form-select">
                        <option value="ALL">Cả Thánh Lễ & Giờ Học Giáo Lý</option>
                        <option value="MASS">Chỉ xin nghỉ Thánh Lễ (Thứ 5 / Chúa Nhật)</option>
                        <option value="CLASS">Chỉ xin nghỉ Giờ Học Giáo Lý</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Số điện thoại Phụ huynh xác nhận (*)</label>
                    <!-- SEC-07 FIX: Không gán value="@Model.ParentPhone", chỉ hiển thị SĐT đã che ở placeholder -->
                    <input type="tel" id="absPhone" class="form-control"
                           placeholder="Nhập đầy đủ SĐT (@Model.MaskedParentPhone) để xác nhận..." required />
                    <small class="text-muted">Vui lòng nhập đầy đủ số điện thoại đã đăng ký với Giáo xứ để xác thực đơn xin phép.</small>
                </div>
                <div class="mb-2">
                    <label class="form-label fw-semibold">Lý do xin phép nghỉ (*)</label>
                    <textarea id="absReason" class="form-control" rows="3" placeholder="VD: Em bị sốt / Gia đình có việc bận..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold" onclick="submitAbsence()">Gửi Đơn Xin Phép</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function submitAbsence() {
            const phone = document.getElementById('absPhone').value.trim();
            const reason = document.getElementById('absReason').value.trim();
            if (!phone) {
                alert('Vui lòng nhập số điện thoại Phụ huynh đã đăng ký để xác thực!');
                return;
            }
            if (!reason) {
                alert('Vui lòng nhập lý do xin phép nghỉ!');
                return;
            }
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const payload = {
                studentCode: '@Model.StudentCode',
                dateOfBirth: '@Model.DateOfBirth.ToString("yyyy-MM-dd")',
                absenceDate: document.getElementById('absDate').value,
                sessionType: document.getElementById('absSession').value,
                parentPhone: document.getElementById('absPhone').value.trim(),
                reason: reason
            };

            const res = await fetch('/Absence/SubmitRequest', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': token
                },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            alert(data.message);
            if (data.success) {
                bootstrap.Modal.getInstance(document.getElementById('absenceModal')).hide();
            }
        }
    </script>
}