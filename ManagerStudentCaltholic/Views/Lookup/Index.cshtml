@model ManagerStudentCaltholic.Models.ViewModels.StudentLookupRequestDto
@{
    ViewData["Title"] = "Tra Cứu Học Tập & Chuyên Cần Thiếu Nhi";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white text-center py-4 border-0">
                    <i class="bi bi-mortarboard-fill display-5 d-block mb-2"></i>
                    <h4 class="fw-bold mb-1">CỔNG TRA CỨU PHỤ HUYNH</h4>
                    <small class="opacity-75">Xem điểm số, chuyên cần Thánh Lễ & Gửi đơn xin phép nghỉ</small>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Lookup" asp-action="Search" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3"></div>

                        <div class="mb-3">
                            <label asp-for="StudentCode" class="form-label fw-bold text-dark"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-qr-code"></i></span>
                                <input asp-for="StudentCode" class="form-control text-uppercase fw-semibold" placeholder="VD: TN20260001" required />
                            </div>
                            <span asp-validation-for="StudentCode" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DateOfBirth" class="form-label fw-bold text-dark"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span>
                                <input asp-for="DateOfBirth" type="date" class="form-control" required />
                            </div>
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PhoneLast4Digits" class="form-label fw-bold text-dark"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-telephone-check"></i></span>
                                <input asp-for="PhoneLast4Digits" type="password" inputmode="numeric" maxlength="4"
                                       class="form-control fw-bold text-center" style="letter-spacing: 6px;"
                                       placeholder="••••" required />
                            </div>
                            <small class="text-muted">Nhập 4 chữ số cuối của SĐT Phụ huynh đã đăng ký với Giáo xứ</small>
                            <span asp-validation-for="PhoneLast4Digits" class="text-danger small d-block"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow-sm">
                            <i class="bi bi-search me-1"></i> Tra Cứu Hồ Sơ
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>