@model ManagerStudentCaltholic.Models.ViewModels.SacramentRegistryIndexViewModel
@{
    ViewData["Title"] = "Sổ Bộ Bí Tích Điện Tử";
}
@Html.AntiForgeryToken()

<style>
    .sacrament-timeline {
        position: relative;
        padding-left: 28px;
    }

        .sacrament-timeline::before {
            content: '';
            position: absolute;
            top: 12px;
            bottom: 12px;
            left: 11px;
            width: 3px;
            background-color: #e2e8f0;
            border-radius: 3px;
        }

    .sacrament-step {
        position: relative;
        margin-bottom: 16px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        padding: 14px 16px;
        transition: all 0.2s ease;
    }

        .sacrament-step.completed {
            border-left: 4px solid #16a34a;
            background-color: #f8fafc;
        }

        .sacrament-step.pending {
            border-left: 4px solid #94a3b8;
        }

    .sacrament-dot {
        position: absolute;
        left: -27px;
        top: 18px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        color: #fff;
        border: 3px solid #fff;
        box-shadow: 0 0 0 2px #cbd5e1;
    }

        .sacrament-dot.done {
            background-color: #16a34a;
            box-shadow: 0 0 0 2px #86efac;
        }

        .sacrament-dot.todo {
            background-color: #94a3b8;
        }
</style>

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-journal-bookmark-fill me-2 text-success"></i>Sổ Bộ Bí Tích Điện Tử Giáo Xứ
            </h3>
            <p class="text-muted mb-0 small">
                Quản lý trọn vòng đời 4 Bí tích (Rửa Tội, Rước Lễ Lần Đầu, Thêm Sức, Bao Đồng), tra cứu số sổ bộ, Linh mục chủ sự và Người đỡ đầu.
            </p>
        </div>
        <a asp-controller="Students" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
            <i class="bi bi-people me-1"></i> Đi tới Hồ Sơ Thiếu Nhi
        </a>
    </div>

    <!-- 4 Thẻ Thống Kê Nhanh -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-primary border-4">
                <div class="text-muted small">1. Đã Rửa Tội</div>
                <div class="fs-3 fw-bold text-primary">@Model.TotalBaptized <small class="fs-6 text-muted fw-normal">/ @Model.TotalStudents</small></div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-info border-4">
                <div class="text-muted small">2. Xưng Tội & Rước Lễ LĐ</div>
                <div class="fs-3 fw-bold text-info">@Model.TotalFirstCommunion <small class="fs-6 text-muted fw-normal">/ @Model.TotalStudents</small></div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-danger border-4">
                <div class="text-muted small">3. Đã Thêm Sức</div>
                <div class="fs-3 fw-bold text-danger">@Model.TotalConfirmed <small class="fs-6 text-muted fw-normal">/ @Model.TotalStudents</small></div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-success border-4">
                <div class="text-muted small">4. Đã Bao Đồng</div>
                <div class="fs-3 fw-bold text-success">@Model.TotalProfessionOfFaith <small class="fs-6 text-muted fw-normal">/ @Model.TotalStudents</small></div>
            </div>
        </div>
    </div>

    <!-- Thanh Bộ Lọc -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary">Tìm kiếm (Tên, Mã QR, Số sổ bộ, Linh mục...)</label>
                    <input type="text" name="search" value="@Model.SearchKeyword" class="form-control form-control-sm" placeholder="Nhập từ khóa..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary">Khối ngành</label>
                    <select name="grade" class="form-select form-select-sm">
                        <option value="ALL" selected="@(Model.SelectedGrade == "ALL")">-- Tất cả khối --</option>
                        <option value="Khai Tâm" selected="@(Model.SelectedGrade == "Khai Tâm")">Khai Tâm</option>
                        <option value="Rước Lễ" selected="@(Model.SelectedGrade == "Rước Lễ")">Rước Lễ</option>
                        <option value="Thêm Sức" selected="@(Model.SelectedGrade == "Thêm Sức")">Thêm Sức</option>
                        <option value="Bao Đồng" selected="@(Model.SelectedGrade == "Bao Đồng")">Bao Đồng</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary">Lớp học</label>
                    <select name="classId" class="form-select form-select-sm">
                        <option value="">-- Tất cả lớp --</option>
                        @foreach (var c in Model.AvailableClasses)
                        {
                            <option value="@c.Id" selected="@(Model.SelectedClassId == c.Id)">[@c.GradeLevel] @c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary">Lọc theo Bí tích</label>
                    <select name="sacramentFilter" class="form-select form-select-sm">
                        <option value="">-- Tất cả --</option>
                        <option value="1" selected="@(Model.SacramentFilter == 1)">Đã Rửa Tội</option>
                        <option value="2" selected="@(Model.SacramentFilter == 2)">Đã Rước Lễ LĐ</option>
                        <option value="3" selected="@(Model.SacramentFilter == 3)">Đã Thêm Sức</option>
                        <option value="4" selected="@(Model.SacramentFilter == 4)">Đã Bao Đồng</option>
                        <option value="-1" selected="@(Model.SacramentFilter == -1)">Cảnh báo trễ tuổi Bí tích</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                        <i class="bi bi-funnel me-1"></i> Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-light btn-sm border" title="Đặt lại"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng Tổng hợp Sổ Bộ Bí Tích -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th class="ps-3">Mã QR</th>
                        <th>Tên Thánh & Họ Tên</th>
                        <th>Lớp / Tuổi</th>
                        <th class="text-center">1. Rửa Tội</th>
                        <th class="text-center">2. Rước Lễ LĐ</th>
                        <th class="text-center">3. Thêm Sức</th>
                        <th class="text-center">4. Bao Đồng</th>
                        <th class="text-end pe-3">Sổ Bộ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rows.Any())
                    {
                        foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="badge bg-light text-dark border font-monospace">@r.StudentCode</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">
                                        @r.ChristianName @r.FullName
                                        @if (r.HasAgeWarning)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill text-warning ms-1" title="Có Bí tích chưa cập nhật so với độ tuổi"></i>
                                        }
                                    </div>
                                    <small class="text-muted">NS: @r.DateOfBirth.ToString("dd/MM/yyyy")</small>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary">@r.ClassName</span>
                                    <small class="text-muted d-block">@r.Age tuổi</small>
                                </td>
                                <td class="text-center">
                                    @if (r.HasBaptism)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">@r.BaptismDateStr</span>
                                        @if (!string.IsNullOrEmpty(r.BaptismBookNo))
                                        {
                                            <small class="d-block text-muted font-monospace" style="font-size: 0.7rem;">Sổ: @r.BaptismBookNo</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Chưa ghi</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (r.HasFirstCommunion)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">@r.FirstCommunionDateStr</span>
                                        @if (!string.IsNullOrEmpty(r.FirstCommunionBookNo))
                                        {
                                            <small class="d-block text-muted font-monospace" style="font-size: 0.7rem;">Sổ: @r.FirstCommunionBookNo</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (r.HasConfirmation)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">@r.ConfirmationDateStr</span>
                                        @if (!string.IsNullOrEmpty(r.ConfirmationBookNo))
                                        {
                                            <small class="d-block text-muted font-monospace" style="font-size: 0.7rem;">Sổ: @r.ConfirmationBookNo</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (r.HasProfessionOfFaith)
                                    {
                                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle">@r.ProfessionDateStr</span>
                                        @if (!string.IsNullOrEmpty(r.ProfessionBookNo))
                                        {
                                            <small class="d-block text-muted font-monospace" style="font-size: 0.7rem;">Sổ: @r.ProfessionBookNo</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                            onclick="openSacramentModal(@r.StudentId)">
                                        <i class="bi bi-journal-bookmark-fill me-1"></i>Chi tiết
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                Không tìm thấy hồ sơ nào khớp với điều kiện lọc.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <span class="text-muted small">Trang @Model.CurrentPage / @Model.TotalPages (Tổng: @Model.TotalStudents em)</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@p"
                                   asp-route-search="@Model.SearchKeyword"
                                   asp-route-grade="@Model.SelectedGrade"
                                   asp-route-classId="@Model.SelectedClassId"
                                   asp-route-sacramentFilter="@Model.SacramentFilter">@p</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- MODAL TIẾN TRÌNH & SỔ BỘ BÍ TÍCH ĐIỆN TỬ -->
<div class="modal fade" id="sacramentRegistryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-primary text-white py-3">
                <div>
                    <h5 class="modal-title fw-bold mb-0">
                        <i class="bi bi-journal-bookmark-fill me-2"></i>Sổ Bộ & Tiến Trình Bí Tích:
                        <span id="sacStudentTitle" class="text-warning"></span>
                    </h5>
                    <small id="sacStudentSubTitle" class="text-white-50"></small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4">
                <div id="sacMissingAlertsBox" class="d-none mb-3"></div>
                <div id="sacActionAlert" class="alert d-none border-0 shadow-sm small py-2 mb-3"></div>

                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="bi bi-diagram-3-fill text-primary me-2"></i>Tiến Trình Lãnh Nhận Bí Tích (4 Chặng)
                            </h6>
                            <span class="badge bg-light text-secondary border">Bấm "Sửa/Ghi sổ bộ" trên từng mốc</span>
                        </div>

                        <div id="sacTimelineLoading" class="text-center py-5 d-none">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="small text-muted mt-2 mb-0">Đang tải dữ liệu Sổ bộ Bí tích...</p>
                        </div>

                        <div id="sacTimelineContainer" class="sacrament-timeline"></div>
                    </div>

                    <div class="col-lg-5">
                        <div class="card border-0 bg-light rounded-4 p-3 h-100" id="sacFormCard">
                            <h6 class="fw-bold text-primary mb-3">
                                <i class="bi bi-pencil-square me-1"></i>Cập Nhật Chi Tiết Sổ Bộ Bí Tích
                            </h6>

                            <input type="hidden" id="sacInputRecordId" value="0" />
                            <input type="hidden" id="sacInputStudentId" value="0" />

                            <div class="mb-3">
                                <label class="form-label small fw-bold">Loại Bí Tích <span class="text-danger">*</span></label>
                                <select id="sacInputType" class="form-select form-select-sm fw-semibold" onchange="onSacramentTypeSelectChange()">
                                    <option value="1">1. Bí tích Rửa Tội</option>
                                    <option value="2">2. Xưng Tội & Rước Lễ Lần Đầu</option>
                                    <option value="3">3. Bí tích Thêm Sức</option>
                                    <option value="4">4. Bao Đồng (Tuyên Hứa Sống Đạo)</option>
                                </select>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Ngày Lãnh Nhận <span class="text-danger">*</span></label>
                                    <input type="date" id="sacInputDate" class="form-control form-control-sm" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Số Vào Sổ Bộ Giáo Xứ</label>
                                    <input type="text" id="sacInputBookNo" class="form-control form-control-sm" placeholder="VD: Quyển 03, Trang 45, Số 123" maxlength="100" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold">Giáo Xứ Ban Bí Tích <span class="text-danger">*</span></label>
                                <input type="text" id="sacInputParish" class="form-control form-control-sm" value="Giáo xứ Phú Trung" maxlength="150" required />
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Linh Mục / Giám Mục Chủ Sự</label>
                                    <input type="text" id="sacInputPriest" class="form-control form-control-sm" placeholder="VD: Lm. Giuse Nguyễn Văn A" maxlength="120" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Người Đỡ Đầu (Cha/Mẹ TL)</label>
                                    <input type="text" id="sacInputGodparent" class="form-control form-control-sm" placeholder="Tên Thánh & Họ tên" maxlength="120" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold">Ghi Chú Thêm</label>
                                <textarea id="sacInputNotes" class="form-control form-control-sm" rows="2" maxlength="500"></textarea>
                            </div>

                            <div class="d-grid gap-2 mt-auto">
                                <button type="button" id="btnSaveSacrament" class="btn btn-primary btn-sm rounded-pill fw-bold py-2 shadow-sm" onclick="submitSaveSacramentRecord()">
                                    <i class="bi bi-floppy-fill me-1"></i> Lưu Vào Sổ Bộ Bí Tích
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4" data-bs-dismiss="modal" onclick="location.reload()">Đóng & Làm Mới</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentSacramentTimeline = [];
        let canEditCurrentSacrament = false;

        function getCsrfToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        async function openSacramentModal(studentId) {
            document.getElementById('sacInputStudentId').value = studentId;
            document.getElementById('sacActionAlert').classList.add('d-none');

            const modalEl = document.getElementById('sacramentRegistryModal');
            bootstrap.Modal.getOrCreateInstance(modalEl).show();

            await loadSacramentTimeline(studentId);
        }

        async function loadSacramentTimeline(studentId) {
            const loadingEl = document.getElementById('sacTimelineLoading');
            const containerEl = document.getElementById('sacTimelineContainer');
            const alertBox = document.getElementById('sacMissingAlertsBox');

            loadingEl.classList.remove('d-none');
            containerEl.innerHTML = '';
            alertBox.classList.add('d-none');
            alertBox.innerHTML = '';

            try {
                const res = await fetch(`/Sacraments/GetRecords/${studentId}`);
                const data = await res.json();
                loadingEl.classList.add('d-none');

                if (!data.success) {
                    containerEl.innerHTML = `<div class="alert alert-danger small">${data.message || 'Không thể tải dữ liệu Bí tích.'}</div>`;
                    return;
                }

                document.getElementById('sacStudentTitle').textContent = `${data.christianName} ${data.fullName}`;
                document.getElementById('sacStudentSubTitle').textContent = `Mã QR: ${data.studentCode} | Ngày sinh: ${data.dateOfBirthDisplay} (${data.currentAge} tuổi)`;

                currentSacramentTimeline = data.timeline || [];
                canEditCurrentSacrament = data.canEdit === true;

                document.getElementById('sacFormCard').style.opacity = canEditCurrentSacrament ? '1' : '0.6';
                document.getElementById('btnSaveSacrament').disabled = !canEditCurrentSacrament;

                if (data.missingAlerts && data.missingAlerts.length > 0) {
                    const ul = document.createElement('ul');
                    ul.className = 'mb-0 ps-3 small';
                    data.missingAlerts.forEach(a => {
                        const li = document.createElement('li');
                        li.textContent = a.warningMessage;
                        ul.appendChild(li);
                    });

                    alertBox.className = 'alert alert-warning border-0 shadow-sm mb-3 py-2';
                    alertBox.innerHTML = '<div class="fw-bold small mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i>Cảnh báo độ tuổi lãnh nhận Bí tích:</div>';
                    alertBox.appendChild(ul);
                    alertBox.classList.remove('d-none');
                }

                currentSacramentTimeline.forEach(item => {
                    const stepDiv = document.createElement('div');
                    stepDiv.className = `sacrament-step ${item.isCompleted ? 'completed' : 'pending'}`;

                    const dotSpan = document.createElement('span');
                    dotSpan.className = `sacrament-dot ${item.isCompleted ? 'done' : 'todo'}`;
                    dotSpan.innerHTML = item.isCompleted ? '<i class="bi bi-check-lg"></i>' : item.sacramentType;
                    stepDiv.appendChild(dotSpan);

                    const headerDiv = document.createElement('div');
                    headerDiv.className = 'd-flex justify-content-between align-items-center mb-1';

                    const titleStrong = document.createElement('strong');
                    titleStrong.className = item.isCompleted ? 'text-success' : 'text-secondary';
                    titleStrong.textContent = `${item.sacramentType}. ${item.sacramentName}`;
                    headerDiv.appendChild(titleStrong);

                    const actionGroup = document.createElement('div');
                    actionGroup.className = 'd-flex gap-1';

                    if (canEditCurrentSacrament) {
                        const editBtn = document.createElement('button');
                        editBtn.type = 'button';
                        editBtn.className = 'btn btn-outline-primary btn-sm py-0 px-2 rounded-pill';
                        editBtn.style.fontSize = '0.75rem';
                        editBtn.innerHTML = '<i class="bi bi-pencil-square me-1"></i>' + (item.isCompleted ? 'Sửa sổ bộ' : 'Ghi sổ bộ');
                        editBtn.onclick = () => selectSacramentStepForEdit(item.sacramentType);
                        actionGroup.appendChild(editBtn);

                        if (item.isCompleted && item.id > 0) {
                            const delBtn = document.createElement('button');
                            delBtn.type = 'button';
                            delBtn.className = 'btn btn-outline-danger btn-sm py-0 px-2 rounded-pill';
                            delBtn.style.fontSize = '0.75rem';
                            delBtn.innerHTML = '<i class="bi bi-trash"></i>';
                            delBtn.onclick = () => submitDeleteSacramentRecord(item.id, data.studentId);
                            actionGroup.appendChild(delBtn);
                        }
                    }

                    headerDiv.appendChild(actionGroup);
                    stepDiv.appendChild(headerDiv);

                    if (item.isCompleted) {
                        const detailDiv = document.createElement('div');
                        detailDiv.className = 'small text-dark mt-1';

                        const line1 = document.createElement('div');
                        line1.innerHTML = `<i class="bi bi-calendar-check text-success me-1"></i>Ngày nhận: <strong>${item.receivedDateDisplay || '--'}</strong> | Nơi nhận: <strong>${item.parishName || 'Giáo xứ Phú Trung'}</strong>`;
                        detailDiv.appendChild(line1);

                        const line2 = document.createElement('div');
                        line2.className = 'text-muted mt-1';
                        line2.textContent = `Số Sổ bộ: ${item.registryBookNumber || 'Chưa ghi'} | Linh mục: ${item.priestName || 'Chưa ghi'} | Người đỡ đầu: ${item.godparentName || 'Chưa ghi'}`;
                        detailDiv.appendChild(line2);

                        if (item.notes) {
                            const noteDiv = document.createElement('div');
                            noteDiv.className = 'fst-italic text-secondary mt-1';
                            noteDiv.textContent = `Ghi chú: ${item.notes}`;
                            detailDiv.appendChild(noteDiv);
                        }

                        stepDiv.appendChild(detailDiv);
                    } else {
                        const emptyDiv = document.createElement('div');
                        emptyDiv.className = 'small text-muted fst-italic';
                        emptyDiv.textContent = 'Chưa có dữ liệu lãnh nhận Bí tích này.';
                        stepDiv.appendChild(emptyDiv);
                    }

                    containerEl.appendChild(stepDiv);
                });

                selectSacramentStepForEdit(1);
            } catch (err) {
                loadingEl.classList.add('d-none');
                containerEl.innerHTML = `<div class="alert alert-danger small">Lỗi tải Sổ bộ Bí tích: ${err.message}</div>`;
            }
        }

        function onSacramentTypeSelectChange() {
            const selectedType = parseInt(document.getElementById('sacInputType').value);
            selectSacramentStepForEdit(selectedType);
        }

        function selectSacramentStepForEdit(sacramentType) {
            document.getElementById('sacInputType').value = sacramentType;
            const item = currentSacramentTimeline.find(x => x.sacramentType === sacramentType);

            if (item && item.isCompleted) {
                document.getElementById('sacInputRecordId').value = item.id || 0;
                document.getElementById('sacInputDate').value = item.receivedDate || '';
                document.getElementById('sacInputParish').value = (item.parishName && !item.parishName.includes('Kế thừa')) ? item.parishName : 'Giáo xứ Phú Trung';
                document.getElementById('sacInputPriest').value = item.priestName || '';
                document.getElementById('sacInputGodparent').value = item.godparentName || '';
                document.getElementById('sacInputBookNo').value = item.registryBookNumber || '';
                document.getElementById('sacInputNotes').value = (item.notes && !item.notes.includes('Chưa cập nhật Số sổ bộ')) ? item.notes : '';
            } else {
                document.getElementById('sacInputRecordId').value = 0;
                document.getElementById('sacInputDate').value = new Date().toISOString().split('T')[0];
                document.getElementById('sacInputParish').value = 'Giáo xứ Phú Trung';
                document.getElementById('sacInputPriest').value = '';
                document.getElementById('sacInputGodparent').value = '';
                document.getElementById('sacInputBookNo').value = '';
                document.getElementById('sacInputNotes').value = '';
            }
        }

        function showSacramentAlert(message, isSuccess) {
            const box = document.getElementById('sacActionAlert');
            box.className = `alert alert-${isSuccess ? 'success' : 'danger'} border-0 shadow-sm small py-2 mb-3`;
            box.textContent = message;
            box.classList.remove('d-none');
        }

        async function submitSaveSacramentRecord() {
            const studentId = parseInt(document.getElementById('sacInputStudentId').value);
            const recordId = parseInt(document.getElementById('sacInputRecordId').value);
            const sacType = parseInt(document.getElementById('sacInputType').value);
            const receivedDate = document.getElementById('sacInputDate').value;
            const parishName = document.getElementById('sacInputParish').value.trim();
            const priestName = document.getElementById('sacInputPriest').value.trim();
            const godparentName = document.getElementById('sacInputGodparent').value.trim();
            const bookNo = document.getElementById('sacInputBookNo').value.trim();
            const notes = document.getElementById('sacInputNotes').value.trim();

            if (!receivedDate || !parishName) {
                showSacramentAlert('Vui lòng nhập đầy đủ Ngày lãnh nhận và Tên Giáo xứ ban Bí tích!', false);
                return;
            }

            const res = await fetch('/Sacraments/SaveRecord', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': getCsrfToken()
                },
                body: JSON.stringify({
                    id: recordId > 0 ? recordId : null,
                    studentId: studentId,
                    sacramentType: sacType,
                    receivedDate: receivedDate,
                    parishName: parishName,
                    priestName: priestName,
                    godparentName: godparentName,
                    registryBookNumber: bookNo,
                    notes: notes
                })
            });

            const result = await res.json();
            if (result.success) {
                showSacramentAlert(result.message, true);
                await loadSacramentTimeline(studentId);
            } else {
                showSacramentAlert(result.message || 'Không thể lưu thông tin Bí tích.', false);
            }
        }

        async function submitDeleteSacramentRecord(recordId, studentId) {
            if (!confirm('Bạn có chắc chắn muốn xóa bản ghi Bí tích này khỏi Sổ bộ?')) return;

            const res = await fetch('/Sacraments/DeleteRecord', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': getCsrfToken()
                },
                body: JSON.stringify({
                    recordId: recordId,
                    studentId: studentId
                })
            });

            const result = await res.json();
            if (result.success) {
                showSacramentAlert(result.message, true);
                await loadSacramentTimeline(studentId);
            } else {
                showSacramentAlert(result.message || 'Không thể xóa bản ghi.', false);
            }
        }
    </script>
}