@model ManagerStudentCaltholic.Models.ViewModels.GradeManagementViewModel

<div class="container-fluid mt-3">
    <!-- Thanh điều hướng và Bộ lọc -->
    <div class="card shadow-sm mb-3">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
            <form method="get" class="d-flex align-items-center gap-2">
                <select name="academicYear" class="form-select form-select-sm">
                    <option value="2025-2026" selected>Niên khóa: 2025-2026</option>
                </select>
                <select name="semester" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="1" selected="@(Model.Semester == 1)">Học kỳ 1</option>
                    <option value="2" selected="@(Model.Semester == 2)">Học kỳ 2</option>
                    <option value="0" selected="@(Model.Semester == 0)">Cả năm</option>
                </select>
                <button type="submit" class="btn btn-sm btn-outline-primary">Lọc</button>
            </form>

            <div class="btn-group">
                <button class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#modalAddColumn">
                    <i class="bi bi-plus-circle"></i> Thêm Cột Điểm
                </button>
                <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#modalFormula">
                    <i class="bi bi-gear"></i> Cấu Hình Công Thức
                </button>
            </div>
        </div>
    </div>

    <!-- Bảng điểm chính -->
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle text-center mb-0" id="gradeTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">STT</th>
                        <th>Họ và Tên</th>
                        <th style="width: 120px;" class="bg-info-subtle">Học Kỳ</th>
                        @foreach (var col in Model.Columns)
                        {
                            <th>
                                @col.ColumnName <br />
                                <small class="text-muted">(@col.ColumnCode - HS @col.Coefficient)</small>
                            </th>
                        }
                        <th class="bg-light fw-bold">ĐTB</th>
                        <th class="bg-light">Xếp Loại</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Rows.Count; i++)
                    {
                        var row = Model.Rows[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td class="text-start">@row.HolyName @row.FullName</td>
                            <td class="bg-info-subtle fw-bold">
                                @(row.Semester == 0 ? "Cả năm" : $"Học kỳ {row.Semester}")
                            </td>
                            @foreach (var col in Model.Columns)
                            {
                                <td>
                                    <input type="number" step="0.1" min="0" max="10"
                                           class="form-control form-control-sm text-center score-input"
                                           data-student="@row.StudentId"
                                           data-column="@col.Id"
                                           data-semester="@Model.Semester"
                                           value="@(row.ScoresByCode.ContainsKey(col.ColumnCode) ? row.ScoresByCode[col.ColumnCode] : "")" />
                                </td>
                            }
                            <td class="fw-bold text-primary">@row.SemesterAverage</td>
                            <td><span class="badge bg-success">@row.Classification</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm Cột Điểm -->
<div class="modal fade" id="modalAddColumn" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tạo Thêm Cột Điểm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label">Tên hiển thị</label>
                    <input type="text" id="colName" class="form-control" placeholder="Ví dụ: Kiểm tra 15 phút" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Mã viết tắt (dùng cho công thức)</label>
                    <input type="text" id="colCode" class="form-control" placeholder="KT_15P" />
                </div>
                <div class="row">
                    <div class="col mb-2">
                        <label class="form-label">Học kỳ</label>
                        <select id="colSemester" class="form-select">
                            <option value="1">Học kỳ 1</option>
                            <option value="2">Học kỳ 2</option>
                            <option value="0">Cả năm</option>
                        </select>
                    </div>
                    <div class="col mb-2">
                        <label class="form-label">Hệ số</label>
                        <input type="number" step="0.5" id="colCoef" class="form-control" value="1.0" />
                    </div>
                </div>
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" id="colIsAtt" />
                    <label class="form-check-label" for="colIsAtt">Tự động tính từ điểm danh (Chuyên cần)</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="submitAddColumn()">Lưu cột</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Cấu hình Công thức & Chuyên cần -->
<div class="modal fade" id="modalFormula" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cấu Hình Công Thức Tính Điểm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label">Biểu thức tính điểm trung bình</label>
                <input type="text" id="formulaExpr" class="form-control font-monospace"
                       placeholder="(CC * 2 + KT_15P * 1 + THI * 3) / 6" />
                <div class="form-text">Nhập chính xác mã các cột viết tắt trong ngoặc hoặc phép nhân chia cộng trừ thông thường.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="submitFormula()">Lưu công thức</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Tự động lưu điểm inline khi rời ô nhập (onblur)
    document.querySelectorAll('.score-input').forEach(input => {
        input.addEventListener('change', async function() {
            const payload = {
                studentId: parseInt(this.dataset.student),
                gradeColumnId: parseInt(this.dataset.column),
                semester: parseInt(this.dataset.semester),
                score: this.value ? parseFloat(this.value) : null
            };

            await fetch('/Grades/SaveScoreInline', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
        });
    });

    async function submitAddColumn() {
        const payload = {
            academicYear: "2025-2026",
            columnName: document.getElementById('colName').value,
            columnCode: document.getElementById('colCode').value,
            semester: parseInt(document.getElementById('colSemester').value),
            coefficient: parseFloat(document.getElementById('colCoef').value),
            isAttendanceBased: document.getElementById('colIsAtt').checked
        };

        const res = await fetch('/Grades/AddColumn', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        if (res.ok) location.reload();
    }

    async function submitFormula() {
        const payload = {
            academicYear: "2025-2026",
            semester: @Model.Semester,
            formulaExpression: document.getElementById('formulaExpr').value,
            evaluationRules: JSON.stringify({ "Gioi": 8.0, "Kha": 6.5, "Dat": 5.0 })
        };

        const res = await fetch('/Grades/SaveFormula', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        if (res.ok) location.reload();
    }
</script>