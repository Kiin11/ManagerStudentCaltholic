@model ManagerStudentCaltholic.Models.ViewModels.ClassGradeMatrixViewModel
@{
    ViewData["Title"] = $"Sổ Điểm - {Model.ClassName}";
    var classes = ViewBag.Classes as List<ManagerStudentCaltholic.Models.Entities.ClassRoom> ?? new();
    var evalAction = Model.EvaluationAction;
}
@Html.AntiForgeryToken()

@if (ViewBag.NoAccessReason != null)
{
    <div class="container py-5">
        <div class="card border-0 shadow-sm rounded-4 text-center p-5">
            <div class="mb-3 text-warning">
                <i class="bi bi-shield-exclamation fs-1"></i>
            </div>
            <h4 class="fw-bold text-dark">Chưa Có Quyền Truy Cập Sổ Điểm</h4>
            <p class="text-muted">@ViewBag.NoAccessReason</p>
            <div>
                <a href="/Classes" class="btn btn-outline-primary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Quay về danh sách lớp
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid py-4">
        <!-- Header & Bộ Lọc -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-3">
                <div class="row g-3 align-items-center justify-content-between">
                    <div class="col-lg-5 col-md-12">
                        <h4 class="fw-bold text-dark mb-1">
                            <i class="bi bi-table text-primary me-2"></i>Sổ Điểm Giáo Lý: @Model.ClassName
                        </h4>
                        <small class="text-muted">
                            Niên khóa: <strong>@Model.AcademicYearName</strong> |
                            Khối: <strong>@Model.GradeLevel</strong> |
                            Sĩ số: <strong>@Model.Rows.Count</strong> em
                        </small>
                    </div>

                    <div class="col-lg-7 col-md-12 d-flex flex-wrap align-items-center justify-content-lg-end gap-2">
                        <!-- Dropdown chọn Lớp -->
                        <select id="selectClass" class="form-select form-select-sm w-auto fw-semibold" onchange="onFilterChange()">
                            @foreach (var c in classes)
                            {
                                <!option value="@c.Id" @(c.Id == Model.ClassId ? "selected" : "")>
                                @c.Name (@c.GradeLevel)
                                </!option>
                            }
                        </select>

                        <!-- Chọn Học kỳ -->
                        <div class="btn-group btn-group-sm" role="group">
                            <a href="/Grades/Index?classId=@Model.ClassId&semester=1"
                               class="btn @(Model.CurrentSemester == 1 ? "btn-primary" : "btn-outline-primary")">Học Kỳ 1</a>
                            <a href="/Grades/Index?classId=@Model.ClassId&semester=2"
                               class="btn @(Model.CurrentSemester == 2 ? "btn-primary" : "btn-outline-primary")">Học Kỳ 2</a>
                            <a href="/Grades/Index?classId=@Model.ClassId&semester=0"
                               class="btn @(Model.CurrentSemester == 0 ? "btn-success" : "btn-outline-success")">
                                <i class="bi bi-calendar2-check me-1"></i> Cả Năm
                            </a>
                        </div>

                        <!-- Menu In Ấn & Biểu Mẫu -->
                        <div class="btn-group">
                            <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle rounded-pill px-3" data-bs-toggle="dropdown">
                                <i class="bi bi-printer me-1"></i> In Ấn & Biểu Mẫu
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                <li>
                                    <a class="dropdown-item" asp-controller="PrintReports" asp-action="ReportCards" asp-route-classId="@Model.ClassId" target="_blank">
                                        <i class="bi bi-file-earmark-text text-primary me-2"></i> In Phiếu Liên Lạc Gia Đình (A5)
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="PrintReports" asp-action="CertificatesOfMerit" asp-route-classId="@Model.ClassId" target="_blank">
                                        <i class="bi bi-award text-warning me-2"></i> In Giấy Khen Cuối Năm (A4)
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="PrintReports" asp-action="SacramentCertificates" asp-route-classId="@Model.ClassId" target="_blank">
                                        <i class="bi bi-patch-check text-success me-2"></i> In Chứng Chỉ Bí Tích (A4)
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" asp-controller="Absence" asp-action="Manage" asp-route-classId="@Model.ClassId">
                                        <i class="bi bi-envelope-paper me-2"></i> Duyệt Đơn Nghỉ Phép Lớp
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <!-- Nút Thêm Cột Điểm & Khóa Sổ Điểm -->
                        @if (Model.CurrentSemester > 0 && !Model.IsLocked)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="openAddColumnModal()">
                                <i class="bi bi-plus-circle me-1"></i> Thêm Cột Điểm
                            </button>
                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("SpiritualDirector") || User.IsInRole("ExecutiveBoard"))
                        {
                            <button type="button" class="btn btn-sm @(Model.IsLocked ? "btn-danger" : "btn-outline-secondary")" onclick="toggleLockGradebook()">
                                <i class="bi @(Model.IsLocked ? "bi-lock-fill" : "bi-unlock") me-1"></i>
                                @(Model.IsLocked ? "Sổ Đang Khóa" : "Khóa Sổ Điểm")
                            </button>
                        }
                        <!-- FEAT-P4-02: Nút Xét Duyệt Động theo Loại Lớp (Lên lớp / Bí tích RL2-TS3 / Tuyên hứa BĐ3-DB4) -->
                        <button type="button"
                                class="btn @evalAction.ButtonCssClass btn-sm rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-2"
                                onclick="openClassEvaluationModal(@Model.ClassId)">
                            <i class="bi @evalAction.IconClass"></i>
                            <span>@evalAction.ButtonLabel</span>
                            @if (evalAction.SubmittedCount > 0)
                            {
                                <span class="badge bg-dark bg-opacity-25 rounded-pill">
                                    Đã xét @evalAction.SubmittedCount/@evalAction.TotalStudents
                                </span>
                            }
                        </button>
                        @if (evalAction.LinkedApprovalBatchId.HasValue)
                        {
                            <a asp-controller="Sacraments"
                               asp-action="Evaluation"
                               asp-route-batchId="@evalAction.LinkedApprovalBatchId"
                               class="btn btn-outline-dark btn-sm rounded-pill px-3"
                               title="Xem tờ trình Bí tích/Tuyên hứa đã đồng bộ">
                                <i class="bi bi-file-earmark-check me-1"></i> Tờ Trình (@evalAction.LinkedBatchStatus)
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (Model.IsLocked)
        {
            <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center mb-3">
                <i class="bi bi-exclamation-octagon-fill fs-5 me-2 text-warning"></i>
                <div><strong>Sổ điểm đã được khóa.</strong> Bạn chỉ có thể xem dữ liệu, không thể sửa điểm trực tiếp. Vui lòng liên hệ BĐH nếu cần cập nhật.</div>
            </div>
        }

        <!-- Bảng Ma Trận Điểm Grid View -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0 text-center" id="gridGradeTable">
                    <thead class="table-light small">
                        <tr>
                            <th rowspan="2" class="align-middle ps-3" style="width: 40px;">STT</th>
                            <th rowspan="2" class="align-middle" style="width: 85px;">Mã QR</th>
                            <th rowspan="2" class="align-middle text-start" style="min-width: 180px;">Tên Thánh & Họ Tên</th>

                            @if (Model.Columns.Any())
                            {
                                <th colspan="@Model.Columns.Count" class="bg-primary-subtle text-primary border-start border-end">
                                    @(Model.CurrentSemester == 0 ? "TẤT CẢ CỘT ĐIỂM CẢ NĂM" : $"CÁC CỘT ĐIỂM HỌC KỲ {Model.CurrentSemester}")
                                </th>
                            }

                            @if (Model.CurrentSemester == 0)
                            {
                                <th rowspan="2" class="align-middle bg-info-subtle text-dark" style="width: 80px;">ĐTB HK1</th>
                                <th rowspan="2" class="align-middle bg-info-subtle text-dark" style="width: 80px;">ĐTB HK2</th>
                                <th rowspan="2" class="align-middle bg-warning-subtle text-dark" style="width: 85px;">ĐTB Năm</th>
                            }
                            else
                            {
                                <th rowspan="2" class="align-middle bg-warning-subtle text-dark" style="width: 80px;">ĐTB HK</th>
                            }

                            <th rowspan="2" class="align-middle" style="width: 80px;">% Chuyên Cần</th>
                            <th rowspan="2" class="align-middle" style="width: 120px;">Xếp Loại</th>
                            <th rowspan="2" class="align-middle" style="width: 110px;">Xét Bí Tích</th>
                            <th class="text-center" style="min-width: 125px;">@Model.EvaluationAction.ButtonLabel</th>

                        </tr>
                        <tr>
                            @foreach (var col in Model.Columns)
                            {
                                <th class="small py-2 @(col.IsSacramentExam ? "bg-info-subtle text-dark" : "")" style="min-width: 95px;">
                                    <div class="d-flex align-items-center justify-content-center gap-1">
                                        <span>@col.DisplayName</span>
                                        @if (col.ClassRoomId.HasValue && !Model.IsLocked)
                                        {
                                            <button type="button" class="btn btn-link btn-sm text-danger p-0 ms-1"
                                                    title="Xóa cột điểm riêng" onclick="deleteCustomColumn(@col.Id)">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                    </div>
                                    <small class="text-muted">(HS: @col.WeightFactor@(Model.CurrentSemester == 0 ? $" - HK{col.Semester}" : ""))</small>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Any())
                        {
                            var stt = 1;
                            var rowIdx = 0;
                            foreach (var s in Model.Rows)
                            {
                                <tr data-enrollment-id="@s.EnrollmentId" data-row-index="@rowIdx">
                                    <td class="ps-3 fw-bold text-muted">@(stt++)</td>
                                    <td><span class="badge bg-light text-dark border font-monospace">@s.StudentCode</span></td>
                                    <td class="text-start">
                                        <div class="fw-bold text-dark">@s.ChristianName @s.FullName</div>
                                    </td>

                                    @{
                                        var colIdx = 0;
                                    }
                                    @foreach (var col in Model.Columns)
                                    {
                                        s.Scores.TryGetValue(col.Id, out var scoreVal);
                                        var cellValue = scoreVal.HasValue ? scoreVal.Value.ToString("0.0") : "";

                                        <td class="p-1">
                                            <input type="text"
                                                   class="form-control form-control-sm text-center fw-bold score-cell"
                                                   data-enrollment-id="@s.EnrollmentId"
                                                   data-config-id="@col.Id"
                                                   data-row="@rowIdx"
                                                   data-col="@colIdx"
                                                   value="@cellValue"
                                                   placeholder="--"
                                                   maxlength="4"
                                                   @(Model.IsLocked ? "readonly disabled" : "")
                                                   onfocus="this.select()"
                                                   onchange="onScoreChange(this)"
                                                   onkeydown="handleKeyNavigation(event, this)" />
                                        </td>
                                        <td class="text-center" id="eval-badge-@s.EnrollmentId">
                                            @switch (s.TeacherProposalStatus)
                                            {
                                                case "PROPOSED_PASS":
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Đạt chuẩn
                                                    </span>
                                                    break;
                                                case "PROPOSED_SPECIAL":
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1"
                                                          title="Lý do đặc cách: @s.TeacherProposalNote">
                                                        <i class="bi bi-star-fill me-1"></i>Đề xuất đặc cách
                                                    </span>
                                                    break;
                                                case "PROPOSED_RETAIN":
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1"
                                                          title="@s.TeacherProposalNote">
                                                        <i class="bi bi-x-circle-fill me-1"></i>Chưa đạt
                                                    </span>
                                                    break;
                                                default:
                                                    <span class="badge bg-light text-secondary border rounded-pill px-2 py-1">Chưa xét</span>
                                                    break;
                                            }
                                        </td>
                                        colIdx++;
                                    }

                                    @if (Model.CurrentSemester == 0)
                                    {
                                        <td class="fw-semibold text-secondary bg-light">
                                            @(s.Semester1Average.HasValue? s.Semester1Average.Value.ToString("0.00") : "--")
                                        </td>
                                        <td class="fw-semibold text-secondary bg-light">
                                            @(s.Semester2Average.HasValue? s.Semester2Average.Value.ToString("0.00") : "--")
                                        </td>
                                    }

                                    <td class="fw-bold text-primary bg-light avg-cell">
                                        @(s.SemesterAverage.HasValue? s.SemesterAverage.Value.ToString("0.00") : "--")
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@s.AttendanceRate%</span></td>
                                    <td>
                                        <span class="badge @(s.AcademicRank == "Xuất sắc" || s.AcademicRank == "Giỏi" ? "bg-success" : (s.AcademicRank == "Khá" ? "bg-primary" : "bg-secondary")) px-2 py-1">
                                            @s.AcademicRank
                                        </span>
                                    </td>
                                    <td>
                                        @if (s.IsEligibleForSacrament)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success px-2 py-1 rounded-pill">
                                                <i class="bi bi-check-circle me-1"></i>Đạt
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1 rounded-pill">
                                                <i class="bi bi-x-circle me-1"></i>Chưa đạt
                                            </span>
                                        }
                                    </td>
                                </tr>
                                rowIdx++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(8 + Model.Columns.Count)" class="py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i> Lớp chưa có học sinh hoặc chưa được phân công.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Thêm Cột Điểm Tùy Chỉnh -->
    <div class="modal fade" id="addColumnModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Thêm Cột Điểm Học Kỳ @Model.CurrentSemester</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên cột điểm hiển thị (*)</label>
                        <input type="text" id="newColName" class="form-control" placeholder="VD: Kiểm tra Miệng, 15 phút Lần 2..." />
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Loại điểm</label>
                            <select id="newColType" class="form-select">
                                <option value="15_MIN">Kiểm tra Miệng / 15 phút</option>
                                <option value="45_MIN">Kiểm tra 1 Tiết (45p)</option>
                                <option value="PRAYER">Khảo kinh / Thực hành</option>
                                <option value="SEMESTER_EXAM">Thi Học Kỳ</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Hệ số trọng số</label>
                            <select id="newColWeight" class="form-select">
                                <option value="1">Hệ số 1</option>
                                <option value="2">Hệ số 2</option>
                                <option value="3">Hệ số 3</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4" onclick="submitCreateColumn()">Lưu Cột Điểm</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function getCsrfToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        function onFilterChange() {
            const cId = document.getElementById('selectClass').value;
            window.location.href = `/Grades/Index?classId=${cId}&semester=@Model.CurrentSemester`;
        }

        function openAddColumnModal() {
            bootstrap.Modal.getOrCreateInstance(document.getElementById('addColumnModal')).show();
        }

        function handleKeyNavigation(e, input) {
            let row = parseInt(input.getAttribute('data-row'));
            let col = parseInt(input.getAttribute('data-col'));

            if (e.key === 'ArrowDown' || e.key === 'Enter') {
                e.preventDefault();
                focusCell(row + 1, col);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                focusCell(row - 1, col);
            } else if (e.key === 'ArrowRight' && input.selectionEnd === input.value.length) {
                focusCell(row, col + 1);
            } else if (e.key === 'ArrowLeft' && input.selectionStart === 0) {
                focusCell(row, col - 1);
            }
        }

        function focusCell(r, c) {
            const target = document.querySelector(`.score-cell[data-row="${r}"][data-col="${c}"]`);
            if (target) {
                target.focus();
                target.select();
            }
        }

        async function onScoreChange(input) {
            const valStr = input.value.trim().replace(',', '.');
            const enrollmentId = parseInt(input.getAttribute('data-enrollment-id'));
            const configId = parseInt(input.getAttribute('data-config-id'));

            if (valStr === '') {
                await saveCell(enrollmentId, configId, null, input);
                return;
            }

            const score = parseFloat(valStr);
            if (isNaN(score) || score < 0 || score > 10) {
                input.classList.add('is-invalid');
                alert('Điểm số phải là số hợp lệ từ 0.0 đến 10.0');
                input.focus();
                return;
            }

            input.classList.remove('is-invalid');
            input.value = score.toFixed(1);
            await saveCell(enrollmentId, configId, score, input);
        }

        async function saveCell(enrollmentId, configId, score, input) {
            input.classList.add('bg-warning-subtle');
            try {
                const res = await fetch('/Grades/SaveSingleCell', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': getCsrfToken()
                    },
                    body: JSON.stringify({
                        enrollmentId: enrollmentId,
                        gradeConfigurationId: configId,
                        score: score
                    })
                });

                const data = await res.json();
                if (data.success) {
                    input.classList.remove('bg-warning-subtle');
                    input.classList.add('bg-success-subtle');
                    setTimeout(() => input.classList.remove('bg-success-subtle'), 600);

                    // Cập nhật tức thì ô ĐTB trên cùng hàng
                    const tr = input.closest('tr');
                    const avgCell = tr?.querySelector('.avg-cell');
                    if (avgCell && data.semesterAverage) {
                        avgCell.textContent = data.semesterAverage;
                    }
                } else {
                    input.classList.remove('bg-warning-subtle');
                    input.classList.add('is-invalid');
                    alert(data.message);
                }
            } catch (err) {
                input.classList.remove('bg-warning-subtle');
                input.classList.add('is-invalid');
                alert('Lỗi khi lưu điểm: ' + err);
            }
        }

        async function toggleLockGradebook() {
            if (!confirm('Bạn có chắc chắn muốn thay đổi trạng thái khóa sổ điểm của lớp này?')) return;

            const res = await fetch(`/Grades/ToggleLock?classId=@Model.ClassId`, {
                method: 'POST',
                headers: { 'X-CSRF-TOKEN': getCsrfToken() }
            });
            const data = await res.json();
            if (data.success) {
                location.reload();
            } else {
                alert('Lỗi: ' + data.message);
            }
        }

        async function submitCreateColumn() {
            const name = document.getElementById('newColName').value.trim();
            const weight = parseInt(document.getElementById('newColWeight').value);
            const scoreType = document.getElementById('newColType').value;

            if (!name) {
                alert('Vui lòng nhập tên cột điểm!');
                return;
            }

            const res = await fetch('/Grades/AddCustomColumn', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': getCsrfToken()
                },
                body: JSON.stringify({
                    classId: @Model.ClassId,
                    semester: @Model.CurrentSemester,
                    displayName: name,
                    weightFactor: weight,
                    scoreType: scoreType
                })
            });
            const data = await res.json();
            if (data.success) {
                location.reload();
            } else {
                alert(data.message);
            }
        }

        async function deleteCustomColumn(columnId) {
            if (!confirm('Xóa cột điểm này sẽ xóa toàn bộ điểm đã nhập trong cột. Bạn có chắc chắn không?')) return;

            const res = await fetch(`/Grades/DeleteCustomColumn?columnId=${columnId}`, {
                method: 'POST',
                headers: { 'X-CSRF-TOKEN': getCsrfToken() }
            });
            const data = await res.json();
            if (data.success) {
                location.reload();
            } else {
                alert(data.message);
            }
        }

                <!-- FEAT-P4-02: Modal Xét Duyệt Cuối Năm Theo Loại Lớp -->
        <div class="modal fade" id="modalClassEvaluation" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content rounded-4 border-0 shadow-lg">
                    <div class="modal-header bg-primary text-white rounded-top-4">
                        <div>
                            <h5 class="modal-title fw-bold mb-0" id="evalModalTitle">
                                <i class="bi @Model.EvaluationAction.IconClass me-2"></i>@Model.EvaluationAction.ModalTitle
                            </h5>
                            <div class="small opacity-75" id="evalModalSubtitle">@Model.EvaluationAction.TargetDescription</div>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body p-3">
                        <!-- Thẻ KPI Tóm tắt -->
                        <div class="row g-2 mb-3">
                            <div class="col-md-3 col-6">
                                <div class="p-2 rounded-3 bg-light border text-center">
                                    <div class="text-muted small">Tổng sĩ số lớp</div>
                                    <div class="fs-5 fw-bold text-dark" id="evalKpiTotal">0</div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="p-2 rounded-3 bg-success-subtle border border-success-subtle text-center">
                                    <div class="text-success small">Đạt tự động</div>
                                    <div class="fs-5 fw-bold text-success" id="evalKpiAutoPass">0</div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="p-2 rounded-3 bg-warning-subtle border border-warning-subtle text-center">
                                    <div class="text-warning-emphasis small">Đề xuất đặc cách</div>
                                    <div class="fs-5 fw-bold text-warning-emphasis" id="evalKpiSpecial">0</div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="p-2 rounded-3 bg-danger-subtle border border-danger-subtle text-center">
                                    <div class="text-danger small">Chưa đạt / Ở lại</div>
                                    <div class="fs-5 fw-bold text-danger" id="evalKpiRetain">0</div>
                                </div>
                            </div>
                        </div>

                        <!-- Thông báo Chiến dịch đi lễ 1 tháng nếu là lớp RL2 / TS3 / BĐ3 / DB4 -->
                        <div id="evalCampaignBanner" class="alert alert-info py-2 px-3 small d-none mb-3"></div>

                        <!-- Bộ lọc nhanh trong Modal -->
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-secondary active" onclick="filterEvaluationRows('ALL', this)">Tất cả</button>
                                <button type="button" class="btn btn-outline-success" onclick="filterEvaluationRows('ELIGIBLE', this)">Đủ điều kiện</button>
                                <button type="button" class="btn btn-outline-danger" onclick="filterEvaluationRows('INELIGIBLE', this)">Thiếu điều kiện (Cần xem xét)</button>
                            </div>
                            <div class="small text-muted">
                                Ngưỡng chuẩn: ĐTB Năm ≥ <strong id="lblMinAvg">5.0</strong> | Chuyên cần ≥ <strong id="lblMinAtt">80%</strong>
                            </div>
                        </div>

                        <!-- Bảng danh sách xét duyệt từng thiếu nhi -->
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle small mb-0">
                                <thead class="table-light text-center">
                                    <tr>
                                        <th>Mã TN</th>
                                        <th class="text-start">Tên Thánh & Họ Tên</th>
                                        <th>ĐTB HK1</th>
                                        <th>ĐTB HK2</th>
                                        <th>ĐTB Năm</th>
                                        <th class="col-sacrament-only d-none">Khảo Hạch</th>
                                        <th>Chuyên Cần</th>
                                        <th class="col-campaign-only d-none">Chiến Dịch Lễ</th>
                                        <th>Đánh Giá Hệ Thống</th>
                                        <th style="min-width: 170px;">Đề Xuất Của GLV</th>
                                        <th class="col-sacrament-only d-none" style="min-width: 150px;">Người Đỡ Đầu</th>
                                        <th style="min-width: 190px;">Ghi Chú / Lý Do Đặc Cách</th>
                                    </tr>
                                </thead>
                                <tbody id="evalTableBody">
                                    <tr>
                                        <td colspan="12" class="text-center py-4 text-muted">Đang tải dữ liệu xét duyệt của lớp...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="modal-footer justify-content-between">
                        <div class="small text-muted">
                            <i class="bi bi-shield-check me-1"></i>Mọi đề xuất và ghi chú đặc cách đều được lưu vết kiểm toán (Audit Log).
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                            <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" id="btnSubmitClassEvaluation" onclick="submitClassEvaluation()">
                                <i class="bi bi-send-check-fill me-1"></i> Lưu & Trình Kết Quả Xét Duyệt
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            let currentEvaluationSheet = null;

            function getGradeCsrfToken() {
                return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            }

            async function openClassEvaluationModal(classId) {
                const modalEl = document.getElementById('modalClassEvaluation');
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();

                const tbody = document.getElementById('evalTableBody');
                tbody.innerHTML = '<tr><td colspan="12" class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Đang tổng hợp điểm số, chuyên cần và chiến dịch đi lễ...</td></tr>';

                try {
                    const res = await fetch(`/Grades/GetClassEvaluationSheet?classId=${classId}`);
                    if (!res.ok) {
                        tbody.innerHTML = '<tr><td colspan="12" class="text-center text-danger py-4">Không thể tải dữ liệu xét duyệt của lớp.</td></tr>';
                        return;
                    }

                    const result = await res.json();
                    currentEvaluationSheet = result.data;
                    renderClassEvaluationSheet(currentEvaluationSheet);
                } catch (err) {
                    console.error(err);
                    tbody.innerHTML = '<tr><td colspan="12" class="text-center text-danger py-4">Lỗi kết nối máy chủ.</td></tr>';
                }
            }

            function renderClassEvaluationSheet(sheet) {
                document.getElementById('lblMinAvg').textContent = sheet.minYearAverage.toFixed(1);
                document.getElementById('lblMinAtt').textContent = `${sheet.minAttendanceRate}%`;

                const isSacramentOrPromise = sheet.descriptor.sacramentType !== null;
                const showCampaign = sheet.descriptor.requireCampaignCheck && sheet.hasActiveMassCampaign;

                document.querySelectorAll('.col-sacrament-only').forEach(el => {
                    el.classList.toggle('d-none', !isSacramentOrPromise);
                });
                document.querySelectorAll('.col-campaign-only').forEach(el => {
                    el.classList.toggle('d-none', !showCampaign);
                });

                const banner = document.getElementById('evalCampaignBanner');
                if (sheet.descriptor.requireCampaignCheck) {
                    banner.classList.remove('d-none');
                    if (sheet.hasActiveMassCampaign) {
                        banner.innerHTML = `<i class="bi bi-calendar2-heart-fill me-2"></i><strong>Chiến dịch đi lễ 1 tháng đang liên kết:</strong> ${sheet.massCampaignTitle} (Chỉ tiêu tối thiểu: <strong>${sheet.massCampaignTargetDays} ngày</strong>).`;
                    } else {
                        banner.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-2"></i>Lớp chưa khởi tạo Chiến dịch đi lễ 1 tháng. <a href="/MassCampaigns/Index?classId=${sheet.classId}" class="fw-bold">Thiết lập tại đây</a>.`;
                    }
                } else {
                    banner.classList.add('d-none');
                }

                const tbody = document.getElementById('evalTableBody');
                tbody.innerHTML = '';

                sheet.students.forEach(st => {
                    const tr = document.createElement('tr');
                    tr.className = 'eval-student-row';
                    tr.setAttribute('data-enrollment-id', st.enrollmentId);
                    tr.setAttribute('data-eligible', st.isAutoEligible ? 'true' : 'false');

                    const autoBadge = st.isAutoEligible
                        ? `<span class="badge bg-success-subtle text-success border border-success-subtle">Đủ ĐK chuẩn</span>`
                        : `<span class="badge bg-danger-subtle text-danger border border-danger-subtle" title="${st.autoIneligibleReason}">${st.autoIneligibleReason}</span>`;

                    const campaignCellHtml = showCampaign
                        ? `<td class="text-center ${st.isCampaignTargetMet ? 'text-success fw-bold' : 'text-danger fw-bold'}">${st.campaignAttendedDays}/${st.campaignTargetDays}</td>`
                        : `<td class="d-none"></td>`;

                    const sacramentExamHtml = isSacramentOrPromise
                        ? `<td class="text-center fw-semibold">${st.sacramentExamScore !== null ? st.sacramentExamScore.toFixed(1) : '-'}</td>`
                        : `<td class="d-none"></td>`;

                    const godparentInputHtml = isSacramentOrPromise
                        ? `<td><input type="text" class="form-control form-control-sm inp-godparent" value="${st.godparentName || ''}" placeholder="Tên Thánh & Họ tên..." /></td>`
                        : `<td class="d-none"><input type="hidden" class="inp-godparent" value="" /></td>`;

                    tr.innerHTML = `
                        <td class="text-center fw-bold text-primary">${st.studentCode}</td>
                        <td><div class="fw-semibold">${st.christianName} ${st.fullName}</div></td>
                        <td class="text-center">${st.semester1Avg !== null ? st.semester1Avg.toFixed(1) : '-'}</td>
                        <td class="text-center">${st.semester2Avg !== null ? st.semester2Avg.toFixed(1) : '-'}</td>
                        <td class="text-center fw-bold ${st.yearAvg !== null && st.yearAvg >= sheet.minYearAverage ? 'text-primary' : 'text-danger'}">
                            ${st.yearAvg !== null ? st.yearAvg.toFixed(2) : '-'}
                        </td>
                        ${sacramentExamHtml}
                        <td class="text-center ${st.combinedAttendanceRate >= sheet.minAttendanceRate ? 'text-success' : 'text-danger'} fw-semibold">
                            ${st.combinedAttendanceRate}%
                        </td>
                        ${campaignCellHtml}
                        <td class="text-center">${autoBadge}</td>
                        <td>
                            <select class="form-select form-select-sm sel-proposal-status" onchange="recalculateEvalModalKpis()">
                                <option value="PROPOSED_PASS" ${st.proposalStatus === 'PROPOSED_PASS' ? 'selected' : ''}>✔ Đạt chuẩn</option>
                                <option value="PROPOSED_SPECIAL" ${st.proposalStatus === 'PROPOSED_SPECIAL' ? 'selected' : ''}>★ Đề xuất đặc cách</option>
                                <option value="PROPOSED_RETAIN" ${st.proposalStatus === 'PROPOSED_RETAIN' ? 'selected' : ''}>✘ Chưa đạt / Ở lại</option>
                            </select>
                        </td>
                        ${godparentInputHtml}
                        <td>
                            <input type="text" class="form-control form-control-sm inp-proposal-note"
                                   value="${st.proposalNote || ''}"
                                   placeholder="${st.isAutoEligible ? 'Nhận xét thêm...' : 'Nhập lý do xin đặc cách...'}" />
                        </td>
                    `;
                    tbody.appendChild(tr);
                });

                recalculateEvalModalKpis();
            }

            function recalculateEvalModalKpis() {
                const rows = document.querySelectorAll('#evalTableBody .eval-student-row');
                let total = rows.length;
                let pass = 0, special = 0, retain = 0;

                rows.forEach(r => {
                    const val = r.querySelector('.sel-proposal-status')?.value;
                    if (val === 'PROPOSED_PASS') pass++;
                    else if (val === 'PROPOSED_SPECIAL') special++;
                    else retain++;
                });

                document.getElementById('evalKpiTotal').textContent = total;
                document.getElementById('evalKpiAutoPass').textContent = pass;
                document.getElementById('evalKpiSpecial').textContent = special;
                document.getElementById('evalKpiRetain').textContent = retain;
            }

            function filterEvaluationRows(mode, btn) {
                btn.parentElement.querySelectorAll('button').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                document.querySelectorAll('#evalTableBody .eval-student-row').forEach(row => {
                    const isEligible = row.getAttribute('data-eligible') === 'true';
                    if (mode === 'ALL') row.classList.remove('d-none');
                    else if (mode === 'ELIGIBLE') row.classList.toggle('d-none', !isEligible);
                    else if (mode === 'INELIGIBLE') row.classList.toggle('d-none', isEligible);
                });
            }

            async function submitClassEvaluation() {
                if (!currentEvaluationSheet) return;

                const rows = document.querySelectorAll('#evalTableBody .eval-student-row');
                const items = [];

                for (const r of rows) {
                    const enrollmentId = parseInt(r.getAttribute('data-enrollment-id'));
                    const isEligible = r.getAttribute('data-eligible') === 'true';
                    const status = r.querySelector('.sel-proposal-status').value;
                    const note = r.querySelector('.inp-proposal-note').value.trim();
                    const godparent = r.querySelector('.inp-godparent')?.value.trim() || '';

                    if (status === 'PROPOSED_SPECIAL' && !note) {
                        alert('Vui lòng nhập lý do xin đặc cách (chuẩn chước) cho các em được đề xuất đặc cách.');
                        r.querySelector('.inp-proposal-note').focus();
                        return;
                    }

                    items.push({
                        enrollmentId: enrollmentId,
                        proposalStatus: (!isEligible && status === 'PROPOSED_PASS') ? 'PROPOSED_SPECIAL' : status,
                        proposalNote: note,
                        godparentName: godparent
                    });
                }

                const btn = document.getElementById('btnSubmitClassEvaluation');
                btn.disabled = true;

                try {
                    const res = await fetch('/Grades/SubmitClassEvaluation', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': getGradeCsrfToken(),
                            'RequestVerificationToken': getGradeCsrfToken()
                        },
                        body: JSON.stringify({
                            classId: currentEvaluationSheet.classId,
                            items: items
                        })
                    });

                    const result = await res.json();
                    if (res.ok && result.success) {
                        alert(result.message);
                        location.reload();
                    } else {
                        alert(result.message || 'Không thể lưu danh sách xét duyệt.');
                    }
                } catch (err) {
                    console.error(err);
                    alert('Lỗi kết nối máy chủ khi gửi kết quả xét duyệt.');
                } finally {
                    btn.disabled = false;
                }
            }
    </script>
    </script>
}