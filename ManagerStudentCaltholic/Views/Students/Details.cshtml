@model ManagerStudentCaltholic.Models.ViewModels.UserProfileViewModel
@using ManagerStudentCaltholic.Models.Entities
@{
    ViewData["Title"] = $"Hồ Sơ Chi Tiết: {Model.ChristianName} {Model.FirstName} {Model.LastName}".Trim();
    long? resolvedAvatarId = Model.StudentAvatarCloudFileId ?? Model.AvatarCloudFileId;
    string? studentAvatarUrl = resolvedAvatarId.HasValue ? $"/CloudMedia/File/{resolvedAvatarId.Value}" : null;
}
@Html.AntiForgeryToken()

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-person-vcard-fill me-2"></i>Hồ Sơ Chi Tiết &amp; Tiến Trình Lịch Sử Kép
            </h3>
            <p class="text-muted mb-0">
                Theo dõi xuyên suốt hành trình Đức tin, Tuyên hứa và lịch sử Học &amp; Dạy từ Khai Tâm ➔ Bao Đồng ➔ Dự Bị ➔ GLV
            </p>
        </div>
        <div class="d-flex gap-2">
            @if (Model.Id > 0)
            {
                <a asp-controller="Account" asp-action="Profile" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill px-3">
                    <i class="bi bi-person-badge me-1"></i> Xem Tài Khoản (@Model.Username)
                </a>
            }
            <a asp-controller="Students" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Danh Sách Thiếu Nhi
            </a>
        </div>
    </div>

    <!-- Thẻ Thông Tin Tổng Quan Thiếu Nhi & Tài Khoản Liên Kết -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center flex-shrink-0 overflow-hidden border border-primary-subtle shadow-sm"
                             style="width: 72px; height: 72px;">
                            @if (!string.IsNullOrWhiteSpace(studentAvatarUrl))
                            {
                                <img id="studentAvatarImg" src="@studentAvatarUrl" alt="Ảnh đại diện thiếu nhi"
                                     class="w-100 h-100 object-fit-cover rounded-circle"
                                     onerror="this.classList.add('d-none'); document.getElementById('studentAvatarFallbackIcon')?.classList.remove('d-none');" />
                                <i id="studentAvatarFallbackIcon" class="bi bi-person-fill fs-1 d-none"></i>
                            }
                            else
                            {
                                <img id="studentAvatarImg" src="" alt="Ảnh đại diện thiếu nhi"
                                     class="w-100 h-100 object-fit-cover rounded-circle d-none"
                                     onerror="this.classList.add('d-none'); document.getElementById('studentAvatarFallbackIcon')?.classList.remove('d-none');" />
                                <i id="studentAvatarFallbackIcon" class="bi bi-person-fill fs-1"></i>
                            }
                        </div>
                        <div>
                            <h4 class="fw-bold text-dark mb-1">
                                @(!string.IsNullOrEmpty(Model.ChristianName) ? $"{Model.ChristianName} " : "")@Model.FirstName @Model.LastName
                            </h4>
                            <div class="d-flex flex-wrap gap-2 small">
                                <span class="badge bg-light text-dark border font-monospace">
                                    <i class="bi bi-qr-code me-1"></i>@Model.LinkedStudentCode
                                </span>
                                @if (Model.StudentDateOfBirth.HasValue)
                                {
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-cake2 me-1"></i>@Model.StudentDateOfBirth.Value.ToString("dd/MM/yyyy")
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(Model.StudentGender))
                                {
                                    <span class="badge @(Model.StudentGender == "Nam" ? "bg-info-subtle text-primary" : "bg-danger-subtle text-danger") rounded-pill">
                                        @Model.StudentGender
                                    </span>
                                }
                            </div>
                            @if (Model.LinkedStudentId.HasValue)
                            {
                                <div class="mt-2 d-flex flex-wrap align-items-center gap-2">
                                    <input type="file" id="studentAvatarFileInput" class="d-none" accept=".jpg,.jpeg,.png,.webp,.gif,image/*" onchange="uploadStudentAvatar(this)" />
                                    <button type="button" id="btnUploadStudentAvatar"
                                            class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold touch-target-44 d-inline-flex align-items-center gap-1"
                                            onclick="document.getElementById('studentAvatarFileInput').click()">
                                        <i class="bi bi-camera-fill"></i> Đổi ảnh đại diện
                                    </button>
                                    <small id="studentAvatarStatus" class="text-muted">JPG, PNG, WebP (tối đa 5 MB)</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-6 text-md-end">
                    @if (Model.Id > 0)
                    {
                        <div class="mb-1">
                            <span class="badge @(Model.Role == UserRole.Teacher ? "bg-success" : Model.Role == UserRole.ProbationaryTeacher ? "text-white" : "bg-secondary") rounded-pill px-3 py-1"
                                  style="@(Model.Role == UserRole.ProbationaryTeacher ? "background-color: #6f42c1;" : "")">
                                Tài khoản liên kết: @@@Model.Username (@(Model.Role == UserRole.ProbationaryTeacher ? "Dự Bị" : Model.Role == UserRole.Teacher ? "GLV Chính Thức" : Model.Role))
                            </span>
                        </div>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1">
                            Chưa cấp tài khoản GLV / Dự Bị
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.ParentPhone))
                    {
                        <div class="small text-muted mt-1">
                            <i class="bi bi-telephone me-1"></i>SĐT liên hệ: <strong>@Model.ParentPhone</strong>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_ProfileDualTimelineAndMilestones", Model)
</div>

@section Scripts {
    <script>
        async function uploadStudentAvatar(inputEl) {
            const file = inputEl?.files?.[0];
            if (!file) return;

            const studentId = @(Model.LinkedStudentId ?? 0);
            if (!studentId || studentId <= 0) return;

            const statusEl = document.getElementById('studentAvatarStatus');
            const btnEl = document.getElementById('btnUploadStudentAvatar');
            const imgEl = document.getElementById('studentAvatarImg');
            const fallbackEl = document.getElementById('studentAvatarFallbackIcon');

            const setStatus = (msg, cls) => {
                if (!statusEl) return;
                statusEl.className = cls;
                statusEl.textContent = msg;
            };

            if (file.size > 5 * 1024 * 1024) {
                setStatus('Ảnh vượt quá giới hạn tối đa 5 MB.', 'text-danger small');
                inputEl.value = '';
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const formData = new FormData();
            formData.append('studentId', studentId.toString());
            formData.append('avatarFile', file);

            const prevBtnHtml = btnEl ? btnEl.innerHTML : '';
            if (btnEl) {
                btnEl.disabled = true;
                btnEl.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang tải...';
            }
            setStatus('Đang tối ưu và tải ảnh lên...', 'text-primary small');

            try {
                const res = await fetch('/Students/UploadAvatar', {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': token
                    },
                    body: formData
                });

                const rawText = await res.text();
                let result = null;
                try {
                    result = rawText ? JSON.parse(rawText) : null;
                } catch {
                    result = null;
                }

                if (res.ok && result && result.success && result.data?.proxyUrl) {
                    if (imgEl) {
                        imgEl.src = result.data.proxyUrl;
                        imgEl.classList.remove('d-none');
                    }
                    if (fallbackEl) {
                        fallbackEl.classList.add('d-none');
                    }
                    setStatus(result.message || 'Đã cập nhật ảnh đại diện!', 'text-success fw-semibold small');
                } else {
                    const errMsg = result?.message || `Không thể tải lên ảnh đại diện (HTTP ${res.status}).`;
                    setStatus(errMsg, 'text-danger small');
                }
            } catch (err) {
                setStatus('Lỗi kết nối khi tải ảnh: ' + err.message, 'text-danger small');
            } finally {
                if (btnEl) {
                    btnEl.disabled = false;
                    btnEl.innerHTML = prevBtnHtml;
                }
                inputEl.value = '';
            }
        }
    </script>
}
