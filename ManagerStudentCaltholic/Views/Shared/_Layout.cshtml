@using System.Security.Claims
@using ManagerStudentCaltholic.Models.Entities
@{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var activeMasterQuery = Context.Request.Query["master"].ToString().ToUpperInvariant();

    // Tự động xác định phân khu Master đang mở dựa theo ?master= hoặc theo Controller hiện tại
    string currentMaster = !string.IsNullOrEmpty(activeMasterQuery)
        ? activeMasterQuery
        : currentCtrl switch
        {
            "Attendance" or "MassCampaigns" or "Absence" => "ATTENDANCE",
            "Grades" or "Students" or "Classes" or "Enrollments" or "LessonPlans" or "Facilities" or "PrintReports" => "ACADEMIC",
            "Sacraments" or "Promotion" or "StudentRegistrations" => "SACRAMENT",
            "Dashboard" or "Users" or "Governance" or "FeaturePermissions" or "AcademicYears" or "Logs" => "GOVERNANCE",
            _ => "COMMON"
        };

    bool isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
    bool isLead = isAuthenticated && (User.IsInRole(UserRole.Admin) || User.IsInRole(UserRole.SpiritualDirector) || User.IsInRole(UserRole.ExecutiveBoard));
    bool isStaff = isLead || (isAuthenticated && (User.IsInRole(UserRole.BranchHead) || User.IsInRole(UserRole.Teacher)));
    bool canViewGovernance = isLead || (isAuthenticated && User.IsInRole(UserRole.BranchHead));

    // P2-LOG-18: Nhận diện thiết bị đang đăng nhập hoặc đã từng đăng nhập tài khoản GLV/Nhân sự
    bool isRecognizedStaffDevice = isAuthenticated || Context.Request.Cookies.ContainsKey("Parish_Staff_Device");

    // FEAT-P5-02 / TASK-P5-02.1: Nhận diện thiết bị Mobile để chuyển đổi giao diện Mobile-First
    bool isMobile = Context.Request.IsMobileDevice();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0@(isMobile ? ", viewport-fit=cover" : "")" />
    <!-- TASK-P5-02.4: Mở sớm kết nối tới CDN để rút ngắn thời gian tải CSS/JS -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <title>@ViewData["Title"] - Hệ Thống Quản Lý Giáo Lý</title>

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Google Fonts -->
    @* TASK-P5-02.4: Mobile dùng font hệ thống (bỏ tải Google Fonts) để giảm request chặn hiển thị *@
    @* fonts.gstatic / googleapis chỉ tải trên Desktop *@
    @if (!isMobile)
    {
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    }

    <!-- PWA & Mobile Meta Tags -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#1e40af" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="QL Giáo Lý" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-192x192.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192x192.png" />
    <link rel="stylesheet" href="~/css/mobile-layout.css" asp-append-version="true" />

    <style>
        html {
            scroll-behavior: smooth;
        }

        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        ::-webkit-scrollbar-thumb {
            background: #94a3b8;
            border-radius: 6px;
            border: 2px solid #f1f5f9;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #64748b;
            }

        .scroll-floating-controls {
            position: fixed;
            right: 22px;
            bottom: 25px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            z-index: 1050;
        }

        .btn-scroll-action {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: none;
            background: #1e40af;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(30, 64, 175, 0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            cursor: pointer;
            transition: all 0.25s ease;
            opacity: 0.85;
        }

            .btn-scroll-action:hover {
                opacity: 1;
                transform: translateY(-2px);
                background: #1d4ed8;
                box-shadow: 0 6px 16px rgba(30, 64, 175, 0.5);
                color: #ffffff;
            }

        #btnScrollToTop.hide-btn {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transform: scale(0.8);
        }

        :root {
            --sidebar-width: 260px;
            --sidebar-collapsed-width: 78px;
            --topbar-height: 64px;
            --primary-color: #1e40af;
            --primary-hover: #1d4ed8;
            --sidebar-bg: #0f172a;
            --sidebar-hover: #1e293b;
            --sidebar-active: #2563eb;
            --body-bg: #f8fafc;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--body-bg);
            color: #334155;
            overflow-x: hidden;
        }

        /* THANH TASKBAR TRÁI: CHỈ HIỂN THỊ TRÊN DESKTOP (>= 992px), ẨN HOÀN TOÀN TRÊN MOBILE */
        #app-sidebar {
            width: var(--sidebar-width);
            min-height: 100vh;
            background-color: var(--sidebar-bg);
            color: #94a3b8;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1040;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
        }

            #app-sidebar.collapsed {
                width: var(--sidebar-collapsed-width);
            }

                #app-sidebar.collapsed .sidebar-text,
                #app-sidebar.collapsed .sidebar-header-title,
                #app-sidebar.collapsed .sidebar-section-title {
                    display: none !important;
                }

                #app-sidebar.collapsed .nav-link {
                    justify-content: center;
                    padding: 0.75rem 0;
                }

                    #app-sidebar.collapsed .nav-link i {
                        margin-right: 0 !important;
                        font-size: 1.35rem;
                    }

        .sidebar-brand {
            height: var(--topbar-height);
            display: flex;
            align-items: center;
            padding: 0 1.25rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            text-decoration: none;
            color: #fff;
        }

        .sidebar-menu .nav-link {
            color: #94a3b8;
            font-weight: 500;
            font-size: 0.88rem;
            padding: 0.48rem 1rem;
            display: flex;
            align-items: center;
            border-radius: 0.4rem;
            margin: 0.12rem 0.65rem;
            transition: all 0.2s ease;
            cursor: pointer;
        }

            .sidebar-menu .nav-link i {
                font-size: 1.05rem;
                margin-right: 0.65rem;
                width: 20px;
                text-align: center;
            }

            .sidebar-menu .nav-link:hover {
                color: #f1f5f9;
                background-color: var(--sidebar-hover);
            }

            .sidebar-menu .nav-link.active {
                color: #ffffff;
                background-color: var(--sidebar-active);
                box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
            }

        /* MAIN WRAPPER */
        #main-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

            #main-wrapper.expanded {
                margin-left: var(--sidebar-collapsed-width);
            }

        /* TOPBAR NAVBAR */
        .topbar-navbar {
            height: var(--topbar-height);
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            position: sticky;
            top: 0;
            z-index: 1020;
        }

        /* MASTER TASKBAR PILLS */
        .master-taskbar-group {
            background-color: #f1f5f9;
            padding: 4px;
            border-radius: 999px;
            border: 1px solid #e2e8f0;
        }

        .master-taskbar-link {
            font-size: 0.84rem;
            font-weight: 600;
            color: #475569;
            padding: 6px 15px;
            border-radius: 999px;
            text-decoration: none;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

            .master-taskbar-link:hover {
                color: #1e40af;
                background-color: rgba(255, 255, 255, 0.75);
            }

            .master-taskbar-link.active {
                background-color: #1e40af;
                color: #ffffff;
                box-shadow: 0 2px 8px rgba(30, 64, 175, 0.3);
            }

        /* ẨN HOÀN TOÀN SIDEBAR BÊN TRÁI TRÊN MOBILE & TABLET (< 992px) */
        @@media (max-width: 991.98px) {
            #app-sidebar {
                display: none !important;
            }

            #main-wrapper, #main-wrapper.expanded {
                margin-left: 0 !important;
            }
        }

        .sidebar-section-title {
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #8b9bb4;
            font-weight: 700;
            padding: 1.15rem 1.25rem 0.45rem;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: color 0.2s ease;
        }

            .sidebar-section-title:hover {
                color: #ffffff;
            }

            .sidebar-section-title .bi-chevron-down {
                transition: transform 0.3s ease;
                font-size: 0.85rem;
            }

            .sidebar-section-title.collapsed .bi-chevron-down {
                transform: rotate(-90deg);
            }

        #app-sidebar.collapsed .sidebar-section-title .bi-chevron-down {
            display: none;
        }

        #app-sidebar.collapsed .sidebar-section-title {
            padding: 1rem 0;
            justify-content: center;
        }

        #app-sidebar.collapsed .collapse {
            display: block !important;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(isMobile ? "mobile-mode" : "")">
    <!-- CỤM NÚT KÉO LÊN & KÉO XUỐNG NHANH -->
    @if (!isMobile)
    {
    <div class="scroll-floating-controls" aria-label="Điều hướng cuộn trang">
        <button type="button" id="btnScrollToTop" class="btn-scroll-action hide-btn" onclick="scrollToTop()" title="Kéo lên đầu trang">
            <i class="bi bi-chevron-up"></i>
        </button>
        <button type="button" id="btnScrollToBottom" class="btn-scroll-action" onclick="scrollToBottom()" title="Kéo xuống chân trang">
            <i class="bi bi-chevron-down"></i>
        </button>
    </div>

    }

    @if (isMobile)
    {
        <!-- ============================================================== -->
        <!-- GIAO DIỆN MOBILE-FIRST (FEAT-P5-02 / TASK-P5-02.1)             -->
        <!-- ============================================================== -->
        <div id="mobile-app-root" class="d-flex flex-column min-vh-100">
            @await Html.PartialAsync("_LayoutMobileHeader")

            <!-- BANNER BÁO MẤT SÓNG / OFFLINE -->
            <div id="offlineNotice" class="alert alert-warning border-0 rounded-0 py-1 px-3 mb-0 text-center small fw-semibold shadow-sm d-none">
                <i class="bi bi-wifi-off me-1"></i> Thiết bị đang mất kết nối mạng. Ứng dụng đang hoạt động ở chế độ Offline (Dữ liệu lấy từ bộ nhớ đệm).
            </div>

            <main role="main" class="mobile-main-wrapper flex-grow-1 p-2 p-sm-3">
                @RenderBody()
            </main>

            @await Html.PartialAsync("_LayoutMobileBottomNav")
        </div>
    }
    else
    {
        <!-- ============================================================== -->
        <!-- GIAO DIỆN DESKTOP (GIỮ NGUYÊN 100% CẤU TRÚC GỐC)               -->
        <!-- ============================================================== -->
        <!-- THANH TASKBAR TRÁI: CHỈ HIỂN THỊ TRÊN DESKTOP (d-none d-lg-flex) -->
    <aside id="app-sidebar" class="d-none d-lg-flex">
        <!-- Logo & Brand Header -->
        <a asp-controller="Home" asp-action="Index" class="sidebar-brand text-decoration-none">
            <img src="~/image/logo.jpg"
                 asp-append-version="true"
                 alt="Logo Giáo Xứ"
                 class="rounded-3 me-2 shadow-sm"
                 style="width: 36px; height: 36px; object-fit: contain; background-color: #ffffff; padding: 2px;" />
            <div class="sidebar-header-title lh-sm">
                <span class="fw-bold fs-6 text-white d-block">GIA ĐÌNH GIÁO LÝ</span>
                <span class="text-white-50" style="font-size: 0.72rem;">Giáo Xứ Phú Trung</span>
            </div>
        </a>

        <!-- Menu Navigation Items -->
        <div class="sidebar-menu flex-grow-1 overflow-y-auto py-2" id="sidebarAccordion">

            <!-- PHẦN 1: CHUNG (4 MỤC: Tra Cứu Nhanh, Cổng Đăng Ký, Tải App, Executive Dashboard) -->
            <div class="sidebar-section-title" data-bs-toggle="collapse" data-bs-target="#collapseChung" aria-expanded="true">
                <span class="sidebar-text">Chung</span>
                <i class="bi bi-chevron-down"></i>
            </div>
            <div id="collapseChung" class="collapse show" data-bs-parent="#sidebarAccordion">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(currentCtrl == "Lookup" ? "active fw-bold text-warning" : "text-light")"
                           asp-controller="Lookup" asp-action="Index">
                            <i class="bi bi-search text-warning"></i>
                            <span class="sidebar-text">Tra Cứu Học Sinh</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentCtrl == "PublicRegistration" ? "active" : "")"
                           asp-controller="PublicRegistration" asp-action="Index" target="_blank">
                            <i class="bi bi-globe text-info"></i>
                            <span class="sidebar-text">Cổng Đăng Ký Tuyển Sinh</span>
                        </a>
                    </li>
                    <li class="nav-item" id="navItemInstallPwa">
                        <a class="nav-link text-info fw-semibold" onclick="triggerPwaInstall()">
                            <i class="bi bi-phone-fill text-info"></i>
                            <span class="sidebar-text">Tải App</span>
                        </a>
                    </li>
                    @if (canViewGovernance)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentCtrl == "Dashboard" ? "active" : "")"
                               asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2 text-warning"></i>
                                <span class="sidebar-text">Executive Dashboard</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <!-- PHẦN 2: ĐIỂM DANH (2 MỤC: Báo Cáo Tổng Hợp -> MonthlySummary, Duyệt Đơn) -->
            @if (isAuthenticated)
            {
                <div class="sidebar-section-title" data-bs-toggle="collapse" data-bs-target="#collapseDiemDanh" aria-expanded="true">
                    <span class="sidebar-text">Điểm Danh</span>
                    <i class="bi bi-chevron-down"></i>
                </div>
                <div id="collapseDiemDanh" class="collapse show" data-bs-parent="#sidebarAccordion">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(currentCtrl == "Attendance" && currentAct == "MonthlySummary" ? "active" : "")"
                               asp-controller="Attendance" asp-action="MonthlySummary">
                                <i class="bi bi-calendar-month-fill text-success"></i>
                                <span class="sidebar-text">Báo Cáo Tổng Hợp</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentCtrl == "Absence" ? "active" : "")"
                               asp-controller="Absence" asp-action="Manage">
                                <i class="bi bi-envelope-paper-fill text-info"></i>
                                <span class="sidebar-text">Duyệt Đơn Xin Nghỉ Phép</span>
                            </a>
                        </li>
                    </ul>
                </div>
            }

            <!-- PHẦN 3: HỌC VỤ & ĐÀO TẠO (3 MỤC: Hồ Sơ Thiếu Nhi, Sổ Điểm, CSVC) -->
            @if (isStaff)
            {
                <div class="sidebar-section-title" data-bs-toggle="collapse" data-bs-target="#collapseHocVu" aria-expanded="true">
                    <span class="sidebar-text">Học Vụ & Đào Tạo</span>
                    <i class="bi bi-chevron-down"></i>
                </div>
                <div id="collapseHocVu" class="collapse show" data-bs-parent="#sidebarAccordion">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(currentCtrl == "Students" ? "active" : "")"
                               asp-controller="Students" asp-action="Index">
                                <i class="bi bi-people-fill text-success"></i>
                                <span class="sidebar-text">Hồ Sơ Thiếu Nhi</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentCtrl == "Grades" ? "active" : "")"
                               asp-controller="Grades" asp-action="Index">
                                <i class="bi bi-journal-check text-warning"></i>
                                <span class="sidebar-text">Sổ Điểm</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentCtrl == "Facilities" ? "active" : "")"
                               asp-controller="Facilities" asp-action="Index">
                                <i class="bi bi-building-gear text-info"></i>
                                <span class="sidebar-text">Sơ Đồ Phòng Học</span>
                            </a>
                        </li>
                    </ul>
                </div>
            }

            <!-- PHẦN 4: HỆ THỐNG (GIỮ NGUYÊN 100%) -->
            @if (isLead)
            {
                <div class="sidebar-section-title" data-bs-toggle="collapse" data-bs-target="#collapseHeThong" aria-expanded="true">
                    <span class="sidebar-text">Hệ Thống</span>
                    <i class="bi bi-chevron-down"></i>
                </div>
                <div id="collapseHeThong" class="collapse show" data-bs-parent="#sidebarAccordion">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(currentCtrl == "AcademicYears" ? "active" : "")"
                               asp-controller="AcademicYears" asp-action="Index">
                                <i class="bi bi-calendar3"></i>
                                <span class="sidebar-text">Niên Khóa</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentCtrl == "StudentRegistrations" ? "active" : "")"
                               asp-controller="StudentRegistrations" asp-action="Index">
                                <i class="bi bi-person-vcard-fill text-info"></i>
                                <span class="sidebar-text">Duyệt Đơn Tuyển Sinh</span>
                            </a>
                        </li>
                        @if (User.IsInRole(UserRole.Admin) || User.IsInRole(UserRole.ExecutiveBoard))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentCtrl == "Users" ? "active" : "")"
                                   asp-controller="Users" asp-action="Index">
                                    <i class="bi bi-person-gear"></i>
                                    <span class="sidebar-text">Tài Khoản & Quyền</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentCtrl == "FeaturePermissions" ? "active" : "")"
                                   asp-controller="FeaturePermissions" asp-action="Index">
                                    <i class="bi bi-sliders2-vertical text-warning"></i>
                                    <span class="sidebar-text">Phân Quyền Nút (UI)</span>
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link @(currentCtrl == "Promotion" ? "active" : "")"
                               asp-controller="Promotion" asp-action="Index">
                                <i class="bi bi-arrow-up-right-circle me-1"></i>
                                <span class="sidebar-text">Kết Chuyển Niên Khóa</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning @(currentCtrl == "Governance" ? "active" : "")"
                               asp-controller="Governance" asp-action="Index">
                                <i class="bi bi-person-badge-fill"></i>
                                <span class="sidebar-text">Bàn Giao & Nhiệm Kỳ</span>
                            </a>
                        </li>
                    </ul>
                </div>
            }
        </div>

        <!-- Sidebar Bottom Footer -->
        <div class="py-2 px-3 border-top border-secondary border-opacity-25 small text-center text-muted" style="font-size: 0.7rem;">
            <span class="sidebar-text">© 2026 GLGX Phú Trung</span>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <div id="main-wrapper">
        <nav class="topbar-navbar d-flex align-items-center justify-content-between px-3 px-lg-4 shadow-sm">
            <!-- Nút thu gọn Sidebar (Chỉ hiện trên Desktop) & Logo/Tiêu đề -->
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-light btn-sm d-none d-lg-inline-flex align-items-center text-secondary border"
                        onclick="toggleSidebarDesktop()" title="Thu gọn / Mở rộng Taskbar">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <a asp-controller="Home" asp-action="Index" class="d-lg-none text-decoration-none d-flex align-items-center gap-2">
                    <img src="~/image/logo.jpg" asp-append-version="true" alt="Logo" class="rounded-2 border" style="width: 32px; height: 32px; object-fit: contain;" />
                    <span class="fw-bold text-primary small">GLGX Phú Trung</span>
                </a>
                <span class="fw-semibold text-dark fs-6 d-none d-md-inline text-truncate" style="max-width: 240px;">
                    @ViewData["Title"]
                </span>
            </div>

            <!-- THANH MASTER 5 PHÂN KHU TRÊN TOPBAR (DESKTOP) -->
            <div class="d-none d-xl-flex align-items-center master-taskbar-group">
                <a class="master-taskbar-link @(currentMaster == "COMMON" ? "active" : "")"
                   asp-controller="Home" asp-action="Index" asp-route-master="COMMON">
                    <i class="bi bi-house-heart-fill"></i>
                    <span>Chung</span>
                </a>
                @if (isAuthenticated)
                {
                    <a class="master-taskbar-link @(currentMaster == "ATTENDANCE" ? "active" : "")"
                       asp-controller="Home" asp-action="Index" asp-route-master="ATTENDANCE">
                        <i class="bi bi-qr-code-scan"></i>
                        <span>Điểm Danh</span>
                    </a>
                    <a class="master-taskbar-link @(currentMaster == "ACADEMIC" ? "active" : "")"
                       asp-controller="Home" asp-action="Index" asp-route-master="ACADEMIC">
                        <i class="bi bi-mortarboard-fill"></i>
                        <span>Học Vụ</span>
                    </a>
                    <a class="master-taskbar-link @(currentMaster == "SACRAMENT" ? "active" : "")"
                       asp-controller="Home" asp-action="Index" asp-route-master="SACRAMENT">
                        <i class="bi bi-award-fill"></i>
                        <span>Bí Tích</span>
                    </a>
                    @if (canViewGovernance)
                    {
                        <a class="master-taskbar-link @(currentMaster == "GOVERNANCE" ? "active" : "")"
                           asp-controller="Home" asp-action="Index" asp-route-master="GOVERNANCE">
                            <i class="bi bi-shield-lock-fill"></i>
                            <span>Quản Trị</span>
                        </a>
                    }
                }
            </div>

            <!-- Cụm Nút Lối Tắt Nhanh + Profile -->
            <div class="d-flex align-items-center gap-2">
                @if (isRecognizedStaffDevice)
                {
                    <!-- P2-LOG-18: Máy đã đăng nhập GLV/BĐH hiển thị nút Quét QR Điểm Danh ngay kế nút Đăng nhập/Profile -->
                    <a class="btn btn-primary btn-sm rounded-pill px-3 d-inline-flex align-items-center fw-bold shadow-sm"
                       asp-controller="Attendance" asp-action="ScanQr">
                        <i class="bi bi-qr-code-scan me-1"></i>
                        <span>Quét QR Điểm Danh</span>
                    </a>
                }
                else
                {
                    <!-- Máy của Phụ huynh / Khách chưa từng đăng nhập tài khoản GLV thì hiện nút Tra Cứu Học Sinh -->
                    <a class="btn btn-outline-warning text-dark btn-sm rounded-pill px-3 d-inline-flex align-items-center fw-semibold"
                       asp-controller="Lookup" asp-action="Index">
                        <i class="bi bi-search me-1"></i>
                        <span>Tra Cứu Học Sinh</span>
                    </a>
                }

                <button type="button" id="btnInstallPwaTopbar"
                        class="btn btn-primary btn-sm rounded-pill px-3 d-none align-items-center fw-semibold shadow-sm"
                        onclick="triggerPwaInstall()">
                    <i class="bi bi-download me-1"></i>
                    <span>Tải App</span>
                </button>

                @if (isAuthenticated)
                {
                    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
                    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name;

                    <div class="dropdown">
                        <button class="btn btn-light bg-transparent border-0 d-flex align-items-center gap-2 text-dark p-1"
                                type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary fw-bold d-flex align-items-center justify-content-center"
                                 style="width: 36px; height: 36px;">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <div class="text-start d-none d-md-block lh-1">
                                <div class="fw-bold small">@fullName</div>
                                <span class="badge @(role == UserRole.Admin ? "bg-danger" :
                                                                                           role == UserRole.SpiritualDirector ? "bg-info text-dark" :
                                                                                           role == UserRole.ExecutiveBoard ? "bg-primary" : "bg-secondary") rounded-pill px-2 py-0 mt-1" style="font-size: 0.65rem;">
                                    @(role == UserRole.Admin ? "Quản trị viên" :
                                                                    role == UserRole.SpiritualDirector ? "Cha Tuyên Úy" :
                                                                    role == UserRole.ExecutiveBoard ? "Ban Điều Hành" :
                                                                    role == UserRole.BranchHead ? "Trưởng khối" : "Giáo lý viên / Dự bị")
                            </span>
                        </div>
                        <i class="bi bi-chevron-down text-muted small ms-1"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 py-2">
                        <li class="px-3 py-1">
                            <div class="small text-muted">Đăng nhập với:</div>
                            <div class="fw-bold text-dark">@User.Identity?.Name</div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                <i class="bi bi-person-badge text-primary me-2"></i> Hồ Sơ Cá Nhân
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2" asp-controller="Sacraments" asp-action="Index">
                                <i class="bi bi-journal-bookmark-fill text-success me-2"></i> Sổ Bộ Bí Tích Điện Tử
                            </a>
                        </li>

                        @if (User.IsInRole(UserRole.Admin) || User.IsInRole(UserRole.ExecutiveBoard))
                            {
                                <li>
                                    <a class="dropdown-item py-2 text-primary fw-semibold" asp-controller="FeaturePermissions" asp-action="Index">
                                        <i class="bi bi-sliders2-vertical me-2"></i> Phân Quyền Nút Chức Năng (UI)
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole(UserRole.Admin))
                            {
                                <li>
                                    <a class="dropdown-item py-2 text-danger" href="/Admin/Logs">
                                        <i class="bi bi-terminal me-2"></i> Nhật Ký Hệ Thống
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 text-primary fw-semibold" href="/Admin/Hangfire" target="_blank">
                                        <i class="bi bi-cpu-fill me-2"></i> Quản Lý Hàng Đợi (Hangfire)
