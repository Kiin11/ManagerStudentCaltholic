@using System.Security.Claims
@using ManagerStudentCaltholic.Models.Entities
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ Thống Quản Lý Giáo Lý</title>

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

    <!-- PWA & Mobile Meta Tags (FEAT-P3-05) -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#1e40af" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="QL Giáo Lý" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-192x192.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192x192.png" />


    <style>
        /* 1. TÙY CHỈNH THANH CUỘN TRÌNH DUYỆT (SCROLLBAR) */
        html {
            scroll-behavior: smooth;
        }

        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        ::-webkit-scrollbar-thumb {
            background: #94a3b8;
            border-radius: 6px;
            border: 2px solid #f1f5f9;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #64748b;
            }

        /* 2. CỤM NÚT TRƯỢT KÉO LÊN / KÉO XUỐNG GÓC PHẢI MÀN HÌNH */
        .scroll-floating-controls {
            position: fixed;
            right: 22px;
            bottom: 25px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            z-index: 1050;
        }

        .btn-scroll-action {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: none;
            background: #1e40af;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(30, 64, 175, 0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            cursor: pointer;
            transition: all 0.25s ease;
            opacity: 0.85;
        }

            .btn-scroll-action:hover {
                opacity: 1;
                transform: translateY(-2px);
                background: #1d4ed8;
                box-shadow: 0 6px 16px rgba(30, 64, 175, 0.5);
                color: #ffffff;
            }

        #btnScrollToTop.hide-btn {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transform: scale(0.8);
        }

        :root {
            --sidebar-width: 260px;
            --sidebar-collapsed-width: 78px;
            --topbar-height: 64px;
            --primary-color: #1e40af;
            --primary-hover: #1d4ed8;
            --sidebar-bg: #0f172a;
            --sidebar-hover: #1e293b;
            --sidebar-active: #2563eb;
            --body-bg: #f8fafc;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--body-bg);
            color: #334155;
            overflow-x: hidden;
        }

        /* SIDEBAR STYLING */
        #app-sidebar {
            width: var(--sidebar-width);
            min-height: 100vh;
            background-color: var(--sidebar-bg);
            color: #94a3b8;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1040;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
        }

            #app-sidebar.collapsed {
                width: var(--sidebar-collapsed-width);
            }

                #app-sidebar.collapsed .sidebar-text,
                #app-sidebar.collapsed .sidebar-header-title,
                #app-sidebar.collapsed .sidebar-section-title {
                    display: none !important;
                }

                #app-sidebar.collapsed .nav-link {
                    justify-content: center;
                    padding: 0.75rem 0;
                }

                    #app-sidebar.collapsed .nav-link i {
                        margin-right: 0 !important;
                        font-size: 1.35rem;
                    }

        .sidebar-brand {
            height: var(--topbar-height);
            display: flex;
            align-items: center;
            padding: 0 1.25rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            text-decoration: none;
            color: #fff;
        }

        .sidebar-menu .nav-link {
            color: #94a3b8;
            font-weight: 500;
            font-size: 0.88rem;
            padding: 0.45rem 1rem;
            display: flex;
            align-items: center;
            border-radius: 0.4rem;
            margin: 0.1rem 0.65rem;
            transition: all 0.2s ease;
            cursor: pointer;
        }

            .sidebar-menu .nav-link i {
                font-size: 1.05rem;
                margin-right: 0.65rem;
                width: 20px;
                text-align: center;
            }

            .sidebar-menu .nav-link:hover {
                color: #f1f5f9;
                background-color: var(--sidebar-hover);
            }

            .sidebar-menu .nav-link.active {
                color: #ffffff;
                background-color: var(--sidebar-active);
                box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
            }

        /* MAIN WRAPPER */
        #main-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

            #main-wrapper.expanded {
                margin-left: var(--sidebar-collapsed-width);
            }

        /* TOPBAR NAVBAR */
        .topbar-navbar {
            height: var(--topbar-height);
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            position: sticky;
            top: 0;
            z-index: 1020;
        }

        /* RESPONSIVE ON MOBILE */
        @@media (max-width: 991.98px) {
            #app-sidebar {
                margin-left: calc(-1 * var(--sidebar-width));
            }

                #app-sidebar.show-mobile {
                    margin-left: 0;
                }

            #main-wrapper, #main-wrapper.expanded {
                margin-left: 0 !important;
            }

            .sidebar-backdrop {
                display: none;
                position: fixed;
                inset: 0;
                background-color: rgba(15, 23, 42, 0.6);
                z-index: 1035;
            }

                .sidebar-backdrop.show {
                    display: block;
                }
        }

        .sidebar-section-title {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #8b9bb4;
            font-weight: 700;
            padding: 1.25rem 1.25rem 0.5rem;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: color 0.2s ease;
        }

            .sidebar-section-title:hover {
                color: #ffffff;
            }

            .sidebar-section-title .bi-chevron-down {
                transition: transform 0.3s ease;
                font-size: 0.9rem;
            }

            .sidebar-section-title.collapsed .bi-chevron-down {
                transform: rotate(-90deg);
            }

        #app-sidebar.collapsed .sidebar-section-title .bi-chevron-down {
            display: none;
        }

        #app-sidebar.collapsed .sidebar-section-title {
            padding: 1rem 0;
            justify-content: center;
        }

        #app-sidebar.collapsed .collapse {
            display: block !important;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- CỤM NÚT KÉO LÊN & KÉO XUỐNG NHANH -->
    <div class="scroll-floating-controls" aria-label="Điều hướng cuộn trang">
        <button type="button" id="btnScrollToTop" class="btn-scroll-action hide-btn" onclick="scrollToTop()" title="Kéo lên đầu trang">
            <i class="bi bi-chevron-up"></i>
        </button>
        <button type="button" id="btnScrollToBottom" class="btn-scroll-action" onclick="scrollToBottom()" title="Kéo xuống chân trang">
            <i class="bi bi-chevron-down"></i>
        </button>
    </div>
    <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebarMobile()"></div>

    <!-- SIDEBAR BÊN TRÁI -->
    <aside id="app-sidebar">
        <!-- Logo & Brand Header -->
        <a asp-controller="Home" asp-action="Index" class="sidebar-brand text-decoration-none">
            <img src="~/image/logo.jpg"
                 asp-append-version="true"
                 alt="Logo Giáo Xứ"
                 class="rounded-3 me-2 shadow-sm"
                 style="width: 36px; height: 36px; object-fit: contain; background-color: #ffffff; padding: 2px;" />
            <div class="sidebar-header-title lh-sm">
                <span class="fw-bold fs-6 text-white d-block">GIA ĐÌNH GIÁO LÝ</span>
                <span class="text-white-50" style="font-size: 0.72rem;">Giáo Xứ Phú Trung</span>
            </div>
        </a>

        <!-- Menu Navigation Items -->
        <div class="sidebar-menu flex-grow-1 overflow-y-auto py-2" id="sidebarAccordion">

            <!-- NHÓM 1: TỔNG QUAN & TRA CỨU -->
            <div class="sidebar-section-title" data-bs-toggle="collapse" data-bs-target="#collapseChung" aria-expanded="true">
                <span class="sidebar-text">Chung</span>
                <i class="bi bi-chevron-down"></i>
            </div>
            <div id="collapseChung" class="collapse show" data-bs-parent="#sidebarAccordion">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Announcements" ? "active" : "")"
                           asp-controller="Announcements" asp-action="Index">
                            <i class="bi bi-megaphone-fill"></i>
                            <span class="sidebar-text">Bảng Tin & Thông Báo</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Lookup" ? "active fw-bold text-warning" : "text-light")"
                           asp-controller="Lookup" asp-action="Index">
                            <i class="bi bi-search text-warning"></i>
                            <span class="sidebar-text">Tra Cứu Nhanh</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PublicRegistration" ? "active" : "")"
                           asp-controller="PublicRegistration" asp-action="Index" target="_blank">
                            <i class="bi bi-globe text-info"></i>
                            <span class="sidebar-text">Cổng Đăng Ký Online</span>
                        </a>
                    </li>
                    <li class="nav-item d-none" id="navItemInstallPwa">
                        <a class="nav-link text-info fw-semibold" onclick="triggerPwaInstall()">
                            <i class="bi bi-phone-fill text-info"></i>
                            <span class="sidebar-text">Cài Đặt Ứng Dụng</span>
                        </a>
                    </li>
                    @if (User.IsInRole(UserRole.Admin) || User.IsInRole(UserRole.SpiritualDirector) || User.IsInRole(UserRole.ExecutiveBoard) || User.IsInRole(UserRole.BranchHead))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                               asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2 text-info"></i>
                                <span class="sidebar-text">Executive Dashboard</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <!-- NHÓM 2: CHUYÊN CẦN & CHECK-IN -->
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="sidebar-section-title" data-bs-toggle="collapse" data-bs-target="#collapseDiemDanh" aria-expanded="true">
                    <span class="sidebar-text">Điểm Danh</span>
                    <i class="bi bi-chevron-down"></i>
                </div>
                <div id="collapseDiemDanh" class="collapse show" data-bs-parent="#sidebarAccordion">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Attendance" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                               asp-controller="Attendance" asp-action="Index">
                                <i class="bi bi-card-checklist"></i>
                                <span class="sidebar-text">Sổ Điểm Danh</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning-emphasis @(ViewContext.RouteData.Values["action"]?.ToString() == "ScanQr" ? "active" : "")"
                               asp-controller="Attendance" asp-action="ScanQr">
                                <i class="bi bi-qr-code-scan text-warning"></i>
                                <span class="sidebar-text">Quét QR Check-in</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Statistics" ? "active" : "")"
                               asp-controller="Attendance" asp-action="Statistics">
                                <i class="bi bi-pie-chart-fill"></i>
                                <span class="sidebar-text">Báo Cáo Chuyên Cần</span>
                            </a>
                        </li>
                    </ul>
                </div>
            }

            <!-- NHÓM 3: HỌC VỤ & LỚP HỌC -->
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                var isLead = User.IsInRole(UserRole.Admin) || User.IsInRole(UserRole.SpiritualDirector) || User.IsInRole(UserRole.ExecutiveBoard);
                var isStaff = isLead || User.IsInRole(UserRole.BranchHead) || User.IsInRole(UserRole.Teacher);

                if (isStaff)
                {
                    <div class="sidebar-section-title" data-bs-toggle="collapse" data-bs-target="#collapseHocVu" aria-expanded="true">
                        <span class="sidebar-text">Học Vụ & Đào Tạo</span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                    <div id="collapseHocVu" class="collapse show" data-bs-parent="#sidebarAccordion">
                        <ul class="nav flex-column">
                            @if (isLead)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AcademicYears" ? "active" : "")"
                                       asp-controller="AcademicYears" asp-action="Index">
                                        <i class="bi bi-calendar3"></i>
                                        <span class="sidebar-text">Niên Khóa</span>
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Classes" ? "active" : "")"
                                   asp-controller="Classes" asp-action="Index">
                                    <i class="bi bi-mortarboard-fill"></i>
                                    <span class="sidebar-text">Danh Sách Lớp</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Students" ? "active" : "")"
                                   asp-controller="Students" asp-action="Index">
                                    <i class="bi bi-people-fill"></i>
                                    <span class="sidebar-text">Hồ Sơ Thiếu Nhi</span>
                                </a>
                            </li>
                            <!-- NÚT MỚI: SỔ BỘ BÍ TÍCH ĐIỆN TỬ (FEAT-P3-03) -->
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sacraments" ? "active" : "")"
                                   asp-controller="Sacraments" asp-action="Index">
                                    <i class="bi bi-journal-bookmark-fill text-success"></i>
                                    <span class="sidebar-text">Sổ Bộ Bí Tích</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Grades" ? "active" : "")"
                                   asp-controller="Grades" asp-action="Index">
                                    <i class="bi bi-journal-check text-warning"></i>
                                    <span class="sidebar-text">Sổ Điểm Giáo Lý</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "LessonPlans" ? "active" : "")"
                                   asp-controller="LessonPlans" asp-action="Index">
                                    <i class="bi bi-calendar3-week-fill text-info"></i>
                                    <span class="sidebar-text">Kế Hoạch Bài Giảng</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Facilities" ? "active" : "")"
                                   asp-controller="Facilities" asp-action="Index">
                                    <i class="bi bi-building-gear"></i>
                                    <span class="sidebar-text">Cơ Sở Vật Chất</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ParentMessages" ? "active" : "")"
                                   asp-controller="ParentMessages" asp-action="Index">
                                    <i class="bi bi-chat-quote-fill text-warning"></i>
                                    <span class="sidebar-text">Mẫu Tin Nhắn Phụ Huynh</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                }

                <!-- NHÓM 4: QUẢN TRỊ HỆ THỐNG -->
                if (isLead)
                {
                    <div class="sidebar-section-title" data-bs-toggle="collapse" data-bs-target="#collapseHeThong" aria-expanded="true">
                        <span class="sidebar-text">Hệ Thống</span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                    <div id="collapseHeThong" class="collapse show" data-bs-parent="#sidebarAccordion">
                        <ul class="nav flex-column">
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "StudentRegistrations" ? "active" : "")"
                                   asp-controller="StudentRegistrations" asp-action="Index">
                                    <i class="bi bi-person-vcard-fill text-info"></i>
                                    <span class="sidebar-text">Duyệt Đơn Tuyển Sinh</span>
                                </a>
                            </li>
                            @if (User.IsInRole(UserRole.Admin) || User.IsInRole(UserRole.ExecutiveBoard))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")"
                                       asp-controller="Users" asp-action="Index">
                                        <i class="bi bi-person-gear"></i>
                                        <span class="sidebar-text">Tài Khoản & Quyền</span>
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Promotion" ? "active" : "")"
                                   asp-controller="Promotion" asp-action="Index">
                                    <i class="bi bi-arrow-up-right-circle me-1"></i>
                                    <span class="sidebar-text">Kết Chuyển Niên Khóa</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-warning @(ViewContext.RouteData.Values["controller"]?.ToString() == "Governance" ? "active" : "")"
                                   asp-controller="Governance" asp-action="Index">
                                    <i class="bi bi-person-badge-fill"></i>
                                    <span class="sidebar-text">Bàn Giao & Nhiệm Kỳ</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                }
            }
        </div>

        <!-- Sidebar Bottom Footer -->
        <div class="py-2 px-3 border-top border-secondary border-opacity-25 small text-center text-muted" style="font-size: 0.7rem;">
            <span class="sidebar-text">© 2026 GLGX Phú Trung</span>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <div id="main-wrapper">
        <nav class="topbar-navbar d-flex align-items-center justify-content-between px-3 px-lg-4 shadow-sm">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn btn-light btn-sm d-none d-lg-inline-flex align-items-center text-secondary border"
                        onclick="toggleSidebarDesktop()" title="Thu gọn / Mở rộng Sidebar">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <button type="button" class="btn btn-light btn-sm d-lg-none d-inline-flex align-items-center text-secondary border"
                        onclick="toggleSidebarMobile()">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <span class="fw-semibold text-dark fs-6 d-none d-sm-inline">
                    @ViewData["Title"]
                </span>
            </div>

            <!-- BANNER BÁO MẤT SÓNG / OFFLINE -->
            <div id="offlineNotice" class="alert alert-warning border-0 rounded-0 py-1 px-3 mb-0 text-center small fw-semibold shadow-sm d-none">
                <i class="bi bi-wifi-off me-1"></i> Thiết bị đang mất kết nối mạng. Ứng dụng đang hoạt động ở chế độ Offline (Dữ liệu lấy từ bộ nhớ đệm).
            </div>

            <!-- Cụm Nút Lối Tắt Nhanh trên Topbar + Profile -->
            <div class="d-flex align-items-center gap-2">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <!-- Button Sổ Bộ Bí Tích trên Topbar -->
                    <a class="btn btn-outline-success btn-sm rounded-pill px-3 d-none d-md-inline-flex align-items-center fw-semibold"
                       asp-controller="Sacraments" asp-action="Index">
                        <i class="bi bi-journal-bookmark-fill me-1"></i> Sổ Bộ Bí Tích
                    </a>
                }

                <a class="btn btn-outline-warning text-dark btn-sm rounded-pill px-3 d-inline-flex align-items-center fw-semibold"
                   asp-controller="Lookup" asp-action="Index">
                    <i class="bi bi-search me-1"></i>
                    <span>Tra Cứu Nhanh</span>
                </a>
                <!-- Nút Cài Đặt PWA (Tự động hiện khi trình duyệt hỗ trợ cài đặt) -->
                <button type="button" id="btnInstallPwaTopbar"
                        class="btn btn-primary btn-sm rounded-pill px-3 d-none align-items-center fw-semibold shadow-sm"
                        onclick="triggerPwaInstall()">
                    <i class="bi bi-download me-1"></i>
                    <span>Cài Đặt App</span>
                </button>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
                    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;

                    <div class="dropdown">
                        <button class="btn btn-light bg-transparent border-0 d-flex align-items-center gap-2 text-dark p-1"
                                type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary fw-bold d-flex align-items-center justify-content-center"
                                 style="width: 36px; height: 36px;">
                                <i class="bi bi-person-fill"></i>
                            </div>
