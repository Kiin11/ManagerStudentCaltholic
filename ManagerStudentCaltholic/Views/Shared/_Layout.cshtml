                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item py-2 text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i> Đăng Xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
                    </a>
                }
            </div>
        </nav>

        <!-- BANNER BÁO MẤT SÓNG / OFFLINE -->
        <div id="offlineNotice" class="alert alert-warning border-0 rounded-0 py-1 px-3 mb-0 text-center small fw-semibold shadow-sm d-none">
            <i class="bi bi-wifi-off me-1"></i> Thiết bị đang mất kết nối mạng. Ứng dụng đang hoạt động ở chế độ Offline (Dữ liệu lấy từ bộ nhớ đệm).
        </div>

        <!-- THANH MASTER CHO MÀN HÌNH NHỎ (< XL) ĐỂ THAO TÁC TRÊN MOBILE/TABLET KHI ẨN SIDEBAR -->
        <div class="d-xl-none bg-white border-bottom px-3 py-2 overflow-x-auto">
            <div class="d-inline-flex align-items-center gap-1">
                <a class="master-taskbar-link @(currentMaster == "COMMON" ? "active" : "")"
                   asp-controller="Home" asp-action="Index" asp-route-master="COMMON">
                    <i class="bi bi-house-heart-fill"></i><span>Chung</span>
                </a>
                @if (isAuthenticated)
                {
                    <a class="master-taskbar-link @(currentMaster == "ATTENDANCE" ? "active" : "")"
                       asp-controller="Home" asp-action="Index" asp-route-master="ATTENDANCE">
                        <i class="bi bi-qr-code-scan"></i><span>Điểm Danh</span>
                    </a>
                    <a class="master-taskbar-link @(currentMaster == "ACADEMIC" ? "active" : "")"
                       asp-controller="Home" asp-action="Index" asp-route-master="ACADEMIC">
                        <i class="bi bi-mortarboard-fill"></i><span>Học Vụ</span>
                    </a>
                    <a class="master-taskbar-link @(currentMaster == "SACRAMENT" ? "active" : "")"
                       asp-controller="Home" asp-action="Index" asp-route-master="SACRAMENT">
                        <i class="bi bi-award-fill"></i><span>Bí Tích</span>
                    </a>
                    @if (canViewGovernance)
                    {
                        <a class="master-taskbar-link @(currentMaster == "GOVERNANCE" ? "active" : "")"
                           asp-controller="Home" asp-action="Index" asp-route-master="GOVERNANCE">
                            <i class="bi bi-shield-lock-fill"></i><span>Quản Trị</span>
                        </a>
                    }
                }
            </div>
        </div>

        <main role="main" class="flex-grow-1 p-3 p-md-4">
            @RenderBody()
        </main>
    </div>

    }

    <!-- BANNER MỜI CÀI ĐẶT ỨNG DỤNG TRÊN ĐIỆN THOẠI -->
    <div id="pwaInstallBanner" class="position-fixed bottom-0 start-0 end-0 p-3 d-none" style="z-index: 1055;">
        <div class="card border-0 shadow-lg rounded-4 bg-dark text-white mx-auto" style="max-width: 520px;">
            <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <img src="~/image/logo.jpg" alt="Logo" class="rounded-3 bg-white p-1" style="width: 44px; height: 44px; object-fit: contain;" />
                    <div class="lh-sm">
                        <div class="fw-bold small text-white">Cài đặt Ứng dụng QL Giáo Lý</div>
                        <small class="text-white-50" style="font-size: 0.75rem;">Mở nhanh ngoài màn hình chính & quét QR mượt hơn</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold text-nowrap" onclick="triggerPwaInstall()">
                        Cài đặt
                    </button>
                    <button type="button" class="btn-close btn-close-white" aria-label="Đóng" onclick="dismissPwaBanner()"></button>
                </div>
            </div>
        </div>
    </div>

    <!-- TOAST THÔNG BÁO CÓ BẢN CẬP NHẬT PWA MỚI -->
    <div id="pwaUpdateToast" class="position-fixed bottom-0 start-50 translate-middle-x p-3 d-none" style="z-index: 1060;">
        <div class="alert alert-primary border-0 shadow-lg rounded-pill px-4 py-2 d-flex align-items-center gap-3 mb-0">
            <span class="small fw-semibold"><i class="bi bi-arrow-repeat me-1"></i>Đã có phiên bản nâng cấp mới!</span>
            <button type="button" id="btnApplyPwaUpdate" class="btn btn-sm btn-light rounded-pill fw-bold px-3">
                Cập nhật ngay
            </button>
        </div>
    </div>

    <!-- MODAL HƯỚNG DẪN CÀI ĐẶT TRÊN IPHONE / IPAD (SAFARI) -->
    <div class="modal fade" id="iosPwaInstallModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
                <div class="modal-header bg-primary text-white py-3">
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="bi bi-apple me-2"></i>Hướng Dẫn Cài Đặt Ứng Dụng Trên iPhone / iPad
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="small text-muted mb-3">
                        Để cài đặt <strong>Ứng dụng Quản Lý Giáo Lý</strong> lên màn hình chính thiết bị iOS, bạn hãy thực hiện 2 bước đơn giản trên trình duyệt <strong>Safari</strong>:
                    </p>
                    <div class="d-flex align-items-start gap-3 mb-3 p-3 rounded-3 bg-light">
                        <span class="badge bg-primary rounded-circle p-2 fs-6">1</span>
                        <div class="small">
                            Nhấn vào biểu tượng <strong>Chia sẻ (Share)</strong> <i class="bi bi-box-arrow-up text-primary fs-5 mx-1"></i> ở thanh công cụ phía dưới trình duyệt Safari.
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3 p-3 rounded-3 bg-light">
                        <span class="badge bg-primary rounded-circle p-2 fs-6">2</span>
                        <div class="small">
                            Cuộn xuống và chọn mục <strong>Thêm vào MH chính (Add to Home Screen)</strong> <i class="bi bi-plus-square text-dark fs-5 mx-1"></i>, sau đó nhấn <strong>Thêm (Add)</strong> ở góc phải trên cùng.
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4" data-bs-dismiss="modal">Đã hiểu</button>
                </div>
            </div>
        </div>
    </div>

    <!-- WIDGET THÔNG BÁO TIẾN TRÌNH TÁC VỤ NỀN HANGFIRE -->
    <div id="bgJobToastContainer" class="position-fixed bottom-0 start-0 p-3 d-none" style="z-index: 1065; max-width: 380px;">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header bg-primary text-white py-2 px-3 d-flex justify-content-between align-items-center">
                <span class="small fw-bold"><i class="bi bi-gear-wide-connected me-1"></i>Tác Vụ Xuất Báo Cáo Ngầm</span>
                <button type="button" class="btn-close btn-close-white btn-sm" onclick="closeBgJobToast()"></button>
            </div>
            <div class="card-body p-3 bg-white">
                <div id="bgJobProcessingState" class="d-flex align-items-center gap-3">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <div class="small text-dark" id="bgJobStatusText">Đang khởi tạo báo cáo Excel trong nền...</div>
                </div>
                <div id="bgJobCompletedState" class="d-none">
                    <div class="small text-success fw-bold mb-2">
                        <i class="bi bi-check-circle-fill me-1"></i>Báo cáo Excel của bạn đã sẵn sàng!
                    </div>
                    <a id="bgJobDownloadLink" href="#" class="btn btn-success btn-sm w-100 rounded-pill fw-bold shadow-sm">
                        <i class="bi bi-download me-1"></i> Tải Xuống Tại Đây
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebarDesktop() {
            const sidebar = document.getElementById('app-sidebar');
            const wrapper = document.getElementById('main-wrapper');
            if (!sidebar || !wrapper) return;

            sidebar.classList.toggle('collapsed');
            wrapper.classList.toggle('expanded');

            if (sidebar.classList.contains('collapsed')) {
                const collapses = document.querySelectorAll('#app-sidebar .collapse');
                collapses.forEach(c => c.classList.add('show'));
            }

            localStorage.setItem('sidebar_collapsed', sidebar.classList.contains('collapsed'));
        }

        (function restoreSidebarState() {
            if (localStorage.getItem('sidebar_collapsed') === 'true' && window.innerWidth >= 992) {
                document.getElementById('app-sidebar')?.classList.add('collapsed');
                document.getElementById('main-wrapper')?.classList.add('expanded');
            }
        })();

        function scrollToTop() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function scrollToBottom() {
            window.scrollTo({ top: document.documentElement.scrollHeight || document.body.scrollHeight, behavior: 'smooth' });
        }

        // TASK-P5-02.4: Listener cuộn chỉ chạy khi có nút cuộn (Desktop), dùng passive + requestAnimationFrame
        // để không ép trình duyệt tính lại layout ở mỗi sự kiện scroll (gây giật trên điện thoại).
        (function initScrollButtons() {
            const btnTop = document.getElementById('btnScrollToTop');
            const btnBottom = document.getElementById('btnScrollToBottom');
            if (!btnTop && !btnBottom) return;

            let ticking = false;
            function updateScrollButtons() {
                ticking = false;
                const scrollPosition = window.scrollY || document.documentElement.scrollTop;
                const totalHeight = document.documentElement.scrollHeight - window.innerHeight;

                if (btnTop) {
                    btnTop.classList.toggle('hide-btn', scrollPosition <= 150);
                }
                if (btnBottom) {
                    btnBottom.style.opacity = (totalHeight - scrollPosition <= 50) ? '0.35' : '0.85';
                }
            }

            window.addEventListener('scroll', function () {
                if (!ticking) {
                    ticking = true;
                    window.requestAnimationFrame(updateScrollButtons);
                }
            }, { passive: true });
        })();

        // Service Worker chỉ được đăng ký 1 lần duy nhất trong ~/js/pwa-installer.js (tránh đăng ký trùng lặp)

        function updateNetworkStatus() {
            const notice = document.getElementById('offlineNotice');
            if (notice) {
                if (navigator.onLine) {
                    notice.classList.add('d-none');
                } else {
                    notice.classList.remove('d-none');
                }
            }
        }

        let bgJobPollTimer = null;

        function closeBgJobToast() {
            document.getElementById('bgJobToastContainer')?.classList.add('d-none');
            if (bgJobPollTimer) clearInterval(bgJobPollTimer);
        }

        async function enqueueBackgroundParishExport(academicYearId, gradeLevel) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const formData = new FormData();
            formData.append('academicYearId', academicYearId);
            formData.append('gradeLevel', gradeLevel || 'ALL');

            try {
                const res = await fetch('/BackgroundJobs/EnqueueParishReport', {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': token },
                    body: formData
                });
                const data = await res.json();
                if (data.success && data.jobId) {
                    startPollingBackgroundJob(data.jobId, data.message);
                } else {
                    alert(data.message || 'Không thể đặt lịch xuất báo cáo.');
                }
            } catch (err) {
                alert('Lỗi kết nối máy chủ: ' + err.message);
            }
        }

        function startPollingBackgroundJob(jobId, initialMessage) {
            const container = document.getElementById('bgJobToastContainer');
            const procState = document.getElementById('bgJobProcessingState');
            const doneState = document.getElementById('bgJobCompletedState');
            const statusText = document.getElementById('bgJobStatusText');
            const downloadLink = document.getElementById('bgJobDownloadLink');

            if (!container) return;
            container.classList.remove('d-none');
            procState.classList.remove('d-none');
            doneState.classList.add('d-none');
            statusText.textContent = initialMessage || 'Đang xử lý báo cáo trong nền...';

            if (bgJobPollTimer) clearInterval(bgJobPollTimer);

            bgJobPollTimer = setInterval(async () => {
                try {
                    const res = await fetch(`/BackgroundJobs/GetJobStatus?jobId=${encodeURIComponent(jobId)}`);
                    if (!res.ok) return;
                    const data = await res.json();

                    if (data.status === 'COMPLETED' && data.downloadUrl) {
                        clearInterval(bgJobPollTimer);
                        procState.classList.add('d-none');
                        doneState.classList.remove('d-none');
                        downloadLink.href = data.downloadUrl;
                    } else if (data.status === 'FAILED') {
                        clearInterval(bgJobPollTimer);
                        statusText.textContent = data.errorMessage || 'Tác vụ xuất báo cáo thất bại.';
                    }
                } catch (e) { }
            }, 2000);
        }

        window.addEventListener('online', updateNetworkStatus);
        window.addEventListener('offline', updateNetworkStatus);
        updateNetworkStatus();
    </script>

    <script src="~/js/pwa-installer.js" asp-append-version="true"></script>
    <script src="~/js/offline-attendance.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
