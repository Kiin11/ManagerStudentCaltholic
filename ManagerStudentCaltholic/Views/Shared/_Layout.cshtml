@using System.Security.Claims
@using ManagerStudentCaltholic.Models.Entities

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Giáo Lý</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half me-1"></i> GIÁO LÝ GIÁO XỨ PHÚ TRUNG
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- 1. Niên khóa & Lớp học: Ban Điều Hành, Cha Tuyên Úy, Admin -->
                            @if (User.IsInRole(UserRole.Admin) || User.IsInRole(UserRole.SpiritualDirector) || User.IsInRole(UserRole.ExecutiveBoard))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="AcademicYears" asp-action="Index">
                                        <i class="bi bi-calendar-check me-1"></i> Niên Khóa
                                    </a>
                                </li>
                            }

                            <!-- 2. Lớp học: Cả GLV và Ban Quản trị đều có thể xem -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Classes" asp-action="Index">
                                    <i class="bi bi-mortarboard me-1"></i> Lớp Học
                                </a>
                            </li>

                            <!-- 3. Hồ sơ Thiếu Nhi: GLV, Trưởng ngành, BĐH -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Students" asp-action="Index">
                                    <i class="bi bi-people me-1"></i> Thiếu Nhi
                                </a>
                            </li>

                            <!-- 4. Điểm Danh & Sổ Lớp -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Attendance" asp-action="Index">
                                    <i class="bi bi-card-checklist me-1"></i> Sổ Điểm Danh
                                </a>
                            </li>

                            <!-- 5. Cổng Quét QR Cổng Nhà Thờ -->
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-semibold" asp-controller="Attendance" asp-action="ScanQr">
                                    <i class="bi bi-qr-code-scan me-1"></i> Quét QR Check-in
                                </a>
                            </li>

                            <!-- 6. Quản trị Tài khoản: Dành riêng cho Admin và Ban Điều Hành -->
                            @if (User.IsInRole(UserRole.Admin) || User.IsInRole(UserRole.ExecutiveBoard))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Users" asp-action="Index">
                                        <i class="bi bi-person-gear me-1"></i> Quản Trị Tài Khoản
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- Khu vực Đăng nhập / Profile User góc phải -->
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
                            var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown">
                                    <span class="badge bg-light text-primary rounded-pill px-2 py-1">
                                        @(role == UserRole.Admin ? "Admin" :
                                                                            role == UserRole.SpiritualDirector ? "Cha Tuyên Úy" :
                                                                            role == UserRole.ExecutiveBoard ? "Ban Điều Hành" :
                                                                            role == UserRole.BranchHead ? "Trưởng Khối" : "Giáo Lý Viên")
                                </span>
                                <strong>@fullName</strong>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                <li>
                                    <div class="dropdown-item-text small text-muted">
                                        Đăng nhập với: <strong>@User.Identity.Name</strong>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i> Đăng Xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                                                }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer mt-auto py-3 bg-white border-top text-center text-muted small">
        <div class="container">
            &copy; 2026 - Quản Lý Giáo Lý Phú Trung.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>