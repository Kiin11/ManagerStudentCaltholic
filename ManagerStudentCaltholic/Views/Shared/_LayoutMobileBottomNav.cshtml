@using System.Security.Claims
@using ManagerStudentCaltholic.Models.Entities
@{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var activeMasterQuery = Context.Request.Query["master"].ToString().ToUpperInvariant();

    string currentMaster = !string.IsNullOrEmpty(activeMasterQuery)
        ? activeMasterQuery
        : currentCtrl switch
        {
            "Attendance" or "MassCampaigns" or "Absence" => "ATTENDANCE",
            "Grades" or "Students" or "Classes" or "Enrollments" or "LessonPlans" or "Facilities" or "PrintReports" => "ACADEMIC",
            "Sacraments" or "Promotion" or "StudentRegistrations" => "SACRAMENT",
            "Dashboard" or "Users" or "Governance" or "FeaturePermissions" or "AcademicYears" or "Logs" => "GOVERNANCE",
            _ => "COMMON"
        };

    bool isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
    bool isLead = isAuthenticated && (User.IsInRole(UserRole.Admin) || User.IsInRole(UserRole.SpiritualDirector) || User.IsInRole(UserRole.ExecutiveBoard));
    bool isStaff = isLead || (isAuthenticated && (User.IsInRole(UserRole.BranchHead) || User.IsInRole(UserRole.Teacher)));
    bool canViewGovernance = isLead || (isAuthenticated && User.IsInRole(UserRole.BranchHead));

    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "";
    string avatarInitial = !string.IsNullOrWhiteSpace(fullName)
        ? fullName.Trim().Substring(0, 1).ToUpperInvariant()
        : "U";

    bool isHomeActive = currentMaster == "COMMON" && currentCtrl != "Account" && currentCtrl != "Lookup";
}

<!-- FEAT-P5-02: THANH ĐIỀU HƯỚNG NỔI DẠNG VIÊN THUỐC (YOUTUBE FLOATING PILL DOCK) -->
<nav class="mobile-bottom-nav yt-floating-nav" aria-label="Thanh điều hướng nhanh phía dưới">
    <ul class="mobile-nav-items">
        <!-- 1. TRANG CHỦ / PHÂN KHU CHUNG (Biểu tượng Ngôi nhà kèm Pill xám khi Active) -->
        <li class="mobile-nav-item">
            <a class="mobile-nav-link touch-target-44 @(isHomeActive ? "active" : "")"
               asp-controller="Home" asp-action="Index" asp-route-master="COMMON"
               title="Phân khu Chung" aria-label="Phân khu Chung">
                <span class="yt-nav-pill">
                    <i class="bi @(isHomeActive ? "bi-house-door-fill" : "bi-house-door")"></i>
                </span>
            </a>
        </li>

        <!-- 2. PHÂN KHU HỌC VỤ -->
        <li class="mobile-nav-item">
            <a class="mobile-nav-link touch-target-44 @(currentMaster == "ACADEMIC" ? "active" : "")"
               asp-controller="Home" asp-action="Index" asp-route-master="ACADEMIC"
               title="Phân khu Học Vụ" aria-label="Phân khu Học Vụ">
                <span class="yt-nav-pill">
                    <i class="bi @(currentMaster == "ACADEMIC" ? "bi-mortarboard-fill" : "bi-mortarboard")"></i>
                </span>
            </a>
        </li>

        <!-- 3. NÚT TRUNG TÂM VÒNG TRÒN KIỂU YOUTUBE (+ / QUÉT QR ĐIỂM DANH) -->
        <li class="mobile-nav-item">
            @if (isStaff)
            {
                <a class="mobile-nav-link yt-center-action touch-target-44 @(currentMaster == "ATTENDANCE" ? "active" : "")"
                   asp-controller="Attendance" asp-action="ScanQr"
                   title="Quét QR Điểm Danh" aria-label="Quét QR Điểm Danh">
                    <span class="yt-nav-pill">
                        <span class="yt-center-circle">
                            <i class="bi bi-qr-code-scan"></i>
                        </span>
                    </span>
                </a>
            }
            else
            {
                <a class="mobile-nav-link yt-center-action touch-target-44 @(currentMaster == "ATTENDANCE" ? "active" : "")"
                   asp-controller="Home" asp-action="Index" asp-route-master="ATTENDANCE"
                   title="Phân khu Điểm Danh" aria-label="Phân khu Điểm Danh">
                    <span class="yt-nav-pill">
                        <span class="yt-center-circle">
                            <i class="bi bi-plus-lg"></i>
                        </span>
                    </span>
                </a>
            }
        </li>

        <!-- 4. PHÂN KHU BÍ TÍCH -->
        <li class="mobile-nav-item">
            <a class="mobile-nav-link touch-target-44 @(currentMaster == "SACRAMENT" ? "active" : "")"
               asp-controller="Home" asp-action="Index" asp-route-master="SACRAMENT"
               title="Phân khu Bí Tích" aria-label="Phân khu Bí Tích">
                <span class="yt-nav-pill">
                    <i class="bi @(currentMaster == "SACRAMENT" ? "bi-award-fill" : "bi-award")"></i>
                </span>
            </a>
        </li>

        <!-- 5. CÁ NHÂN / QUẢN TRỊ (AVATAR TRÒN KIỂU YOUTUBE 'K') -->
        <li class="mobile-nav-item">
            @if (canViewGovernance)
            {
                <a class="mobile-nav-link touch-target-44 @(currentMaster == "GOVERNANCE" ? "active" : "")"
                   asp-controller="Home" asp-action="Index" asp-route-master="GOVERNANCE"
                   title="Phân khu Quản Trị" aria-label="Phân khu Quản Trị">
                    <span class="yt-nav-pill">
                        <span class="yt-avatar-badge">@avatarInitial</span>
                    </span>
                </a>
            }
            else if (isAuthenticated)
            {
                <a class="mobile-nav-link touch-target-44 @(currentCtrl == "Account" ? "active" : "")"
                   asp-controller="Account" asp-action="Profile"
                   title="Hồ Sơ Cá Nhân" aria-label="Hồ Sơ Cá Nhân">
                    <span class="yt-nav-pill">
                        <span class="yt-avatar-badge">@avatarInitial</span>
                    </span>
                </a>
            }
            else
            {
                <a class="mobile-nav-link touch-target-44 @(currentCtrl == "Lookup" ? "active" : "")"
                   asp-controller="Lookup" asp-action="Index"
                   title="Tra Cứu Học Sinh" aria-label="Tra Cứu Học Sinh">
                    <span class="yt-nav-pill">
                        <span class="yt-avatar-badge yt-avatar-guest">
                            <i class="bi bi-person-fill"></i>
                        </span>
                    </span>
                </a>
            }
        </li>
    </ul>
</nav>
