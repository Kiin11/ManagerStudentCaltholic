@model ManagerStudentCaltholic.Models.ViewModels.SystemLogsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "System Health & Nhật Ký Hệ Thống (Admin)";
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var hourlyJson = JsonSerializer.Serialize(Model.HourlyStats, jsonOptions);
    var modulesJson = JsonSerializer.Serialize(Model.ModuleBreakdown, jsonOptions);
}

<style>
    .log-table th, .log-table td {
        vertical-align: middle;
        font-size: 0.84rem;
    }

    .log-row-err {
        background-color: #fff5f5 !important;
    }

    .log-row-wrn {
        background-color: #fffbeb !important;
    }

    .stacktrace-pre {
        background: #0f172a;
        color: #f8fafc;
        border-radius: 10px;
        padding: 14px;
        font-size: 0.8rem;
        max-height: 360px;
        overflow: auto;
        white-space: pre-wrap;
        word-break: break-word;
    }
</style>

<div class="container-fluid py-3">
    <!-- HEADER & NÚT TIỆN ÍCH CHO ADMIN -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="bi bi-terminal-plus text-danger me-2"></i>System Health Dashboard &amp; Nhật Ký Hệ Thống
            </h4>
            <p class="text-muted small mb-0">
                Giám sát trạng thái PostgreSQL, Redis Cache, lưu lượng truy cập và điều tra lỗi Structured Logging (Serilog).
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/Admin/Hangfire" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-cpu me-1"></i> Hangfire Jobs Dashboard
            </a>
            @if (!string.IsNullOrEmpty(Model.SelectedFile))
            {
                <a asp-action="Download" asp-route-fileName="@Model.SelectedFile"
                   class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-semibold">
                    <i class="bi bi-download me-1"></i> Tải File Log Gốc (@Model.SelectedFile)
                </a>
            }
            <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-sm" onclick="window.location.reload()">
                <i class="bi bi-arrow-clockwise me-1"></i> Làm Mới Ngay
            </button>
        </div>
    </div>

    <!-- HÀNG 1: 4 WIDGET GIÁM SÁT SỨC KHỎE HỆ THỐNG (TASK-P3-11.4) -->
    <div class="row g-3 mb-4">
        <!-- 1. Trạng thái PostgreSQL & Redis -->
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start @(Model.Health.IsDatabaseUp ? "border-success" : "border-danger") border-4 h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small fw-bold text-uppercase">Kết Nối CSDL &amp; Cache</span>
                    <i class="bi bi-hdd-network-fill fs-5 @(Model.Health.IsDatabaseUp ? "text-success" : "text-danger")"></i>
                </div>
                <div class="mb-1">
                    <span class="badge @(Model.Health.IsDatabaseUp ? "bg-success" : "bg-danger") rounded-pill me-1">
                        PostgreSQL: @(Model.Health.IsDatabaseUp ? "UP" : "DOWN")
                    </span>
                    <small class="text-muted font-monospace">@(Model.Health.DatabaseLatencyMs >= 0 ? $"{Model.Health.DatabaseLatencyMs} ms" : "Lỗi")</small>
                </div>
                <div>
                    <span class="badge @(Model.Health.IsRedisUp ? "bg-info text-dark" : "bg-secondary") rounded-pill me-1">
                        Redis: @(Model.Health.IsRedisUp ? "UP" : "FALLBACK")
                    </span>
                    <small class="text-muted font-monospace">@(Model.Health.RedisLatencyMs >= 0 ? $"{Model.Health.RedisLatencyMs} ms" : "Memory")</small>
                </div>
            </div>
        </div>

        <!-- 2. Lưu lượng Request & Độ trễ phản hồi -->
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-primary border-4 h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Lưu Lượng Truy Cập</div>
                        <div class="fs-3 fw-bold text-primary my-1">
                            @Model.Health.RequestsPerMinute <small class="fs-6 text-muted fw-normal">req/phút</small>
                        </div>
                        <small class="text-secondary">
                            Phản hồi TB: <strong>@Model.Health.AverageResponseMs ms</strong> | Tổng: <strong>@Model.Health.TotalRequestsSinceStart</strong>
                        </small>
                    </div>
                    <i class="bi bi-activity fs-4 text-primary"></i>
                </div>
            </div>
        </div>

        <!-- 3. Tổng hợp Lỗi & Cảnh báo trong ngày -->
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-danger border-4 h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Sự Cố Trong Tệp Đang Xem</div>
                        <div class="fs-3 fw-bold text-danger my-1">
                            @(Model.ErrorCount + Model.FatalCount) <small class="fs-6 text-muted fw-normal">lỗi (ERR/FTL)</small>
                        </div>
                        <small class="text-secondary">
                            Cảnh báo (WRN): <strong class="text-warning-emphasis">@Model.WarningCount</strong> |
                            Audit: <strong class="text-success">@Model.AuditCount</strong>
                        </small>
                    </div>
                    <i class="bi bi-bug-fill fs-4 text-danger"></i>
                </div>
            </div>
        </div>

        <!-- 4. Tài nguyên RAM & Dung lượng Logs -->
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-info border-4 h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Tài Nguyên &amp; Lưu Trữ Log</div>
                        <div class="fs-3 fw-bold text-dark my-1">
                            @Model.Health.MemoryUsageMb <small class="fs-6 text-muted fw-normal">MB RAM</small>
                        </div>
                        <small class="text-secondary d-block text-truncate" title="Uptime: @Model.Health.UptimeDisplay">
                            Logs: <strong>@Model.Health.TotalLogFilesCount tệp (@Model.Health.TotalLogsSizeMb MB)</strong>
                        </small>
                    </div>
                    <i class="bi bi-cpu-fill fs-4 text-info"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- HÀNG 2: BIỂU ĐỒ MẬT ĐỘ LOG THEO 24 GIỜ & PHÂN BỔ THEO PHÂN HỆ -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-bar-chart-steps text-primary me-2"></i>Biểu Đồ Mật Độ Hoạt Động &amp; Lỗi Phát Sinh Theo Giờ (00:00 – 23:00)
                        </h6>
                        <small class="text-muted">Phân tích lưu lượng Information, Warning và Error qua từng khung giờ của tệp <code>@Model.SelectedFile</code></small>
                    </div>
                </div>
                <div class="card-body pt-0">
                    <div style="height: 230px;">
                        <canvas id="hourlyLogsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-0">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-pie-chart-fill text-warning me-2"></i>Phân Bổ Log Theo Phân Hệ
                    </h6>
                    <small class="text-muted">Tỷ trọng hoạt động giữa Điểm danh, Quét QR, Bí tích, Học vụ &amp; Bảo mật</small>
                </div>
                <div class="card-body pt-0">
                    <div style="height: 230px;">
                        <canvas id="moduleBreakdownChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- HÀNG 3: BỘ LỌC TRUY VẤN LOG ĐA TIÊU CHÍ (TASK-P3-11.2) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" action="/Admin/Logs" class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">Tệp Nhật Ký Ngày:</label>
                    <select name="fileName" class="form-select form-select-sm fw-semibold" onchange="this.form.submit()">
                        @foreach (var f in Model.AvailableLogFiles)
                        {
                            <option value="@f" selected="@(f == Model.SelectedFile)">@f</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">Cấp Độ Log (Level):</label>
                    <select name="level" class="form-select form-select-sm fw-semibold" onchange="this.form.submit()">
                        <option value="ALL" selected="@(Model.LevelFilter == "ALL")">-- Tất cả (@Model.TotalLines) --</option>
                        <option value="ERR_FTL" selected="@(Model.LevelFilter == "ERR_FTL")">🔥 Chỉ Lỗi (ERR + FTL: @(Model.ErrorCount + Model.FatalCount))</option>
                        <option value="WRN" selected="@(Model.LevelFilter == "WRN")">⚠️ Cảnh báo (WRN: @Model.WarningCount)</option>
                        <option value="INF" selected="@(Model.LevelFilter == "INF")">ℹ️ Thông tin (INF: @Model.InfoCount)</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">Phân Hệ Nghiệp Vụ:</label>
                    <select name="module" class="form-select form-select-sm fw-semibold" onchange="this.form.submit()">
                        <option value="ALL" selected="@(Model.ModuleFilter == "ALL")">-- Tất cả phân hệ --</option>
                        <option value="KIỂM TOÁN (AUDIT)" selected="@(Model.ModuleFilter == "KIỂM TOÁN (AUDIT)")">Kiểm toán (AUDIT)</option>
                        <option value="QUÉT QR" selected="@(Model.ModuleFilter == "QUÉT QR")">Quét QR Điểm danh</option>
                        <option value="ĐIỂM DANH" selected="@(Model.ModuleFilter == "ĐIỂM DANH")">Sổ Điểm danh &amp; Nghỉ phép</option>
                        <option value="TUYỂN SINH" selected="@(Model.ModuleFilter == "TUYỂN SINH")">Tuyển sinh trực tuyến</option>
                        <option value="BÍ TÍCH" selected="@(Model.ModuleFilter == "BÍ TÍCH")">Sổ bộ &amp; Xét duyệt Bí tích</option>
                        <option value="HỌC VỤ & ĐIỂM" selected="@(Model.ModuleFilter == "HỌC VỤ & ĐIỂM")">Sổ điểm &amp; Lên lớp</option>
                        <option value="BẢO MẬT & AUTH" selected="@(Model.ModuleFilter == "BẢO MẬT & AUTH")">Bảo mật &amp; Đăng nhập</option>
                        <option value="HỆ THỐNG" selected="@(Model.ModuleFilter == "HỆ THỐNG")">Hệ thống chung</option>
                    </select>
                </div>

                <div class="col-6 col-md-1">
                    <label class="form-label small fw-bold text-secondary mb-1">Từ giờ:</label>
                    <input type="time" name="fromTime" class="form-control form-control-sm" value="@(Model.FromTime?.ToString(@"hh\:mm"))" />
                </div>

                <div class="col-6 col-md-1">
                    <label class="form-label small fw-bold text-secondary mb-1">Đến giờ:</label>
                    <input type="time" name="toTime" class="form-control form-control-sm" value="@(Model.ToTime?.ToString(@"hh\:mm"))" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">Từ khóa / User / IP / URL:</label>
                    <input type="text" name="search" class="form-control form-control-sm"
                           placeholder="Tìm lỗi, username, IP..." value="@Model.SearchKeyword" />
                </div>

                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                        <i class="bi bi-funnel-fill me-1"></i> Lọc Log
                    </button>
                    <a href="/Admin/Logs?fileName=@Model.SelectedFile" class="btn btn-light btn-sm border" title="Xóa bộ lọc">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- HÀNG 4: BẢNG DỮ LIỆU LOG CÓ PHÂN TRANG & NÚT MỞ MODAL CHI TIẾT (TASK-P3-11.3) -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h6 class="fw-bold text-dark mb-0">
                    Danh Sách Nhật Ký Chi Tiết (Tìm thấy <strong>@Model.FilteredCount</strong> / @Model.TotalLines bản ghi)
                </h6>
            </div>
            <span class="small text-muted">Nhấn vào nút <strong>Chi tiết</strong> ở từng dòng để xem Stack Trace &amp; Request Context</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover log-table mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-3" style="width: 155px;">Thời Gian</th>
                        <th class="text-center" style="width: 75px;">Level</th>
                        <th style="width: 145px;">Phân Hệ</th>
                        <th style="width: 135px;">User / IP</th>
                        <th>Nội Dung Sự Kiện &amp; Đường Dẫn</th>
                        <th class="text-end pe-3" style="width: 110px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Entries.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không có dòng nhật ký nào khớp với bộ lọc hiện tại.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Entries)
                        {
                            var rowClass = (item.Level == "ERR" || item.Level == "FTL")
                            ? "log-row-err"
                            : (item.Level == "WRN" ? "log-row-wrn" : "");

                            var badgeClass = item.Level switch
                            {
                                "ERR" or "FTL" => "bg-danger text-white",
                                "WRN" => "bg-warning text-dark",
                                _ => "bg-success-subtle text-success border border-success-subtle"
                            };

                            <tr class="@rowClass">
                                <td class="ps-3 font-monospace text-muted small">@item.TimestampDisplay</td>
                                <td class="text-center">
                                    <span class="badge @badgeClass rounded-pill px-2">@item.Level</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.Module</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.PerformedBy))
                                    {
                                        <div class="fw-semibold text-dark small"><i class="bi bi-person me-1"></i>@item.PerformedBy</div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.IpAddress))
                                    {
                                        <small class="text-muted font-monospace">@item.IpAddress</small>
                                    }
                                    @if (string.IsNullOrEmpty(item.PerformedBy) && string.IsNullOrEmpty(item.IpAddress))
                                    {
                                        <span class="text-muted small">System</span>
                                    }
                                </td>
                                <td>
                                    @if (item.StatusCode.HasValue)
                                    {
                                        var stColor = item.StatusCode >= 500 ? "bg-danger" : (item.StatusCode >= 400 ? "bg-warning text-dark" : "bg-primary-subtle text-primary");
                                        <span class="badge @stColor me-1 font-monospace">@item.HttpMethod @item.StatusCode</span>
                                        @if (item.ElapsedMs.HasValue)
                                        {
                                            <span class="badge bg-light text-secondary border font-monospace me-1">@item.ElapsedMs ms</span>
                                        }
                                    }
                                    <span class="text-dark fw-medium text-break">@item.Message</span>
                                    @if (item.HasException)
                                    {
                                        <div class="mt-1">
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                <i class="bi bi-exclamation-octagon-fill me-1"></i>Có đính kèm Stack Trace ngoại lệ
                                            </span>
                                        </div>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <button type="button"
                                            class="btn btn-sm @(item.HasException ? "btn-danger" : "btn-outline-secondary") rounded-pill px-3"
                                            data-ts="@item.TimestampDisplay"
                                            data-level="@item.Level"
                                            data-module="@item.Module"
                                            data-user="@(item.PerformedBy ?? "System")"
                                            data-ip="@(item.IpAddress ?? "--")"
                                            data-path="@(item.RequestPath ?? "--")"
                                            data-status="@(item.StatusCode?.ToString() ?? "--")"
                                            data-elapsed="@(item.ElapsedMs.HasValue ? $"{item.ElapsedMs} ms" : "--")"
                                            data-msg="@item.Message"
                                            data-ex="@(item.Exception ?? "")"
                                            onclick="openLogDetailModal(this)">
                                        <i class="bi bi-code-square me-1"></i>Chi tiết
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Thanh Phân Trang -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="small text-muted">
                    Trang <strong>@Model.CurrentPage</strong> / <strong>@Model.TotalPages</strong> (Tổng @Model.FilteredCount bản ghi)
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @{
                            int startPage = Math.Max(1, Model.CurrentPage - 3);
                            int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 3);
                        }
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-fileName="@Model.SelectedFile"
                               asp-route-level="@Model.LevelFilter"
                               asp-route-module="@Model.ModuleFilter"
                               asp-route-search="@Model.SearchKeyword"
                               asp-route-fromTime="@Model.FromTime"
                               asp-route-toTime="@Model.ToTime"
                               asp-route-page="@(Model.CurrentPage - 1)">« Trước</a>
                        </li>
                        @for (int p = startPage; p <= endPage; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-fileName="@Model.SelectedFile"
                                   asp-route-level="@Model.LevelFilter"
                                   asp-route-module="@Model.ModuleFilter"
                                   asp-route-search="@Model.SearchKeyword"
                                   asp-route-fromTime="@Model.FromTime"
                                   asp-route-toTime="@Model.ToTime"
                                   asp-route-page="@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-fileName="@Model.SelectedFile"
                               asp-route-level="@Model.LevelFilter"
                               asp-route-module="@Model.ModuleFilter"
                               asp-route-search="@Model.SearchKeyword"
                               asp-route-fromTime="@Model.FromTime"
                               asp-route-toTime="@Model.ToTime"
                               asp-route-page="@(Model.CurrentPage + 1)">Sau »</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- MODAL XEM CHI TIẾT DÒNG LOG & STACK TRACE NGOẠI LỆ (TASK-P3-11.3) -->
<div class="modal fade" id="logDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white py-3">
                <h6 class="modal-title fw-bold mb-0">
                    <i class="bi bi-bug me-2 text-warning"></i>Chi Tiết Bản Ghi Nhật Ký &amp; Ngữ Cảnh Thực Thi
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-2 mb-3 small">
                    <div class="col-md-4">
                        <div class="p-2 rounded bg-light border">
                            <span class="text-muted d-block">Thời điểm ghi nhận:</span>
                            <strong class="font-monospace" id="mdlLogTime"></strong>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-2 rounded bg-light border">
                            <span class="text-muted d-block">Cấp độ &amp; Phân hệ:</span>
                            <strong id="mdlLogLevelModule"></strong>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-2 rounded bg-light border">
                            <span class="text-muted d-block">Tài khoản &amp; IP:</span>
                            <strong class="font-monospace" id="mdlLogUserIp"></strong>
                        </div>
                    </div>
                </div>

                <div class="row g-2 mb-3 small">
                    <div class="col-md-6">
                        <div class="p-2 rounded bg-light border">
                            <span class="text-muted d-block">Đường dẫn Request Path:</span>
                            <strong class="font-monospace text-primary" id="mdlLogPath"></strong>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-2 rounded bg-light border">
                            <span class="text-muted d-block">HTTP Status &amp; Độ trễ:</span>
                            <strong class="font-monospace" id="mdlLogStatusElapsed"></strong>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">Thông điệp sự kiện (Log Message):</label>
                    <div class="p-3 rounded-3 bg-light border font-monospace small text-break" id="mdlLogMessage"></div>
                </div>

                <div id="mdlExceptionSection" class="d-none">
                    <label class="form-label small fw-bold text-danger">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Chi Tiết Ngoại Lệ &amp; Stack Trace:
                    </label>
                    <pre class="stacktrace-pre mb-0" id="mdlLogException"></pre>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold" onclick="copyCurrentLogModal()">
                    <i class="bi bi-clipboard-check me-1"></i> Copy Toàn Bộ Thông Tin Lỗi
                </button>
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        const hourlyStats = @Html.Raw(hourlyJson);
        const moduleBreakdown = @Html.Raw(modulesJson);

        document.addEventListener('DOMContentLoaded', function () {
            renderHourlyChart();
            renderModuleChart();
        });

        function renderHourlyChart() {
            const ctx = document.getElementById('hourlyLogsChart');
            if (!ctx) return;

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: hourlyStats.map(x => x.label),
                    datasets: [
                        {
                            label: 'Lỗi (ERR/FTL)',
                            data: hourlyStats.map(x => x.errorCount),
                            backgroundColor: '#dc2626',
                            borderRadius: 4
                        },
                        {
                            label: 'Cảnh báo (WRN)',
                            data: hourlyStats.map(x => x.warningCount),
                            backgroundColor: '#f59e0b',
                            borderRadius: 4
                        },
                        {
                            label: 'Thông tin (INF)',
                            data: hourlyStats.map(x => x.infoCount),
                            backgroundColor: '#3b82f6',
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { stacked: true },
                        y: { stacked: true, beginAtZero: true }
                    },
                    plugins: {
                        legend: { position: 'top' }
                    }
                }
            });
        }

        function renderModuleChart() {
            const ctx = document.getElementById('moduleBreakdownChart');
            if (!ctx) return;

            const labels = Object.keys(moduleBreakdown);
            const values = Object.values(moduleBreakdown);

            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: values,
                        backgroundColor: ['#2563eb', '#16a34a', '#eab308', '#dc2626', '#7c3aed', '#0891b2', '#64748b']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 11 } }
                    }
                }
            });
        }

        function openLogDetailModal(btn) {
            document.getElementById('mdlLogTime').textContent = btn.getAttribute('data-ts');
            document.getElementById('mdlLogLevelModule').textContent = `[${btn.getAttribute('data-level')}] ${btn.getAttribute('data-module')}`;
            document.getElementById('mdlLogUserIp').textContent = `${btn.getAttribute('data-user')} (${btn.getAttribute('data-ip')})`;
            document.getElementById('mdlLogPath').textContent = btn.getAttribute('data-path');
            document.getElementById('mdlLogStatusElapsed').textContent = `HTTP ${btn.getAttribute('data-status')} | ${btn.getAttribute('data-elapsed')}`;
            document.getElementById('mdlLogMessage').textContent = btn.getAttribute('data-msg');

            const exText = btn.getAttribute('data-ex') || '';
            const exSection = document.getElementById('mdlExceptionSection');
            const exPre = document.getElementById('mdlLogException');

            if (exText.trim().length > 0) {
                exPre.textContent = exText;
                exSection.classList.remove('d-none');
            } else {
                exPre.textContent = '';
                exSection.classList.add('d-none');
            }

            bootstrap.Modal.getOrCreateInstance(document.getElementById('logDetailModal')).show();
        }

        function copyCurrentLogModal() {
            const ts = document.getElementById('mdlLogTime').textContent;
            const lvl = document.getElementById('mdlLogLevelModule').textContent;
            const userIp = document.getElementById('mdlLogUserIp').textContent;
            const path = document.getElementById('mdlLogPath').textContent;
            const msg = document.getElementById('mdlLogMessage').textContent;
            const ex = document.getElementById('mdlLogException').textContent;

            const compiled = `=== LOG REPORT ===\nTime: ${ts}\nScope: ${lvl}\nActor: ${userIp}\nPath: ${path}\nMessage: ${msg}\n${ex ? ('Stack Trace:\n' + ex) : ''}`;
            navigator.clipboard.writeText(compiled).then(() => {
                alert('Đã sao chép toàn bộ thông tin chi tiết bản ghi Log vào Clipboard!');
            });
        }
    </script>
}