@model ManagerStudentCaltholic.Models.ViewModels.ParentMessageCenterViewModel
@{
    ViewData["Title"] = "Trung Tâm Tương Tác Phụ Huynh (1-Click Copy)";
}
@Html.AntiForgeryToken()

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold text-primary mb-1">
                <i class="bi bi-chat-quote-fill text-warning me-2"></i>Trung Tâm Tương Tác Phụ Huynh &amp; Mẫu Tin Nhắn 1-Click Copy
            </h4>
            <p class="text-muted small mb-0">
                Tự động tổng hợp Điểm trung bình, Số buổi vắng và Cảnh báo Bí tích để Giáo lý viên <strong>1-Click Sao Chép</strong> gửi Zalo/Viber miễn phí 100%.
            </p>
        </div>
        @if (Model.CanManageTemplates)
        {
            <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#createTemplateModal">
                <i class="bi bi-plus-circle me-1"></i> Tạo Mẫu Tin Nhắn Mới
            </button>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- BỐ CỤC 2 CỘT: CỘT TRÁI (DANH SÁCH THIẾU NHI CẦN LƯU Ý) - CỘT PHẢI (TRÌNH SOẠN & 1-CLICK COPY) -->
    <div class="row g-4">
        <!-- CỘT TRÁI: CHỌN LỚP & DANH SÁCH HỌC SINH TRONG LỚP -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <form method="get" asp-action="Index" class="row g-2 align-items-center">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary mb-1">Lớp phụ trách:</label>
                            <select name="classId" class="form-select form-select-sm fw-semibold" onchange="this.form.submit()">
                                @foreach (var c in Model.AuthorizedClasses)
                                {
                                    <option value="@c.Id" selected="@(c.Id == Model.SelectedClassId)">
                                        [@c.GradeLevel] @c.Name
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 d-flex align-items-end justify-content-between pt-3">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" name="attentionOnly" value="true" id="chkAttentionOnly"
                                       @(Model.FilterAttentionOnly ? "checked" : "") onchange="this.form.submit()" />
                                <label class="form-check-label small fw-semibold text-danger" for="chkAttentionOnly">
                                    Chỉ hiện em cần lưu ý (@Model.AttentionStudentsCount)
                                </label>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="card-body p-0">
                    <div class="p-2 bg-light border-bottom d-flex justify-content-between align-items-center">
                        <input type="text" id="searchStudentBox" class="form-control form-control-sm"
                               placeholder="Tìm nhanh tên hoặc mã thiếu nhi..." onkeyup="filterStudentList(this.value)" />
                    </div>

                    <div class="list-group list-group-flush overflow-y-auto" style="max-height: 460px;" id="studentInteractionList">
                        @if (Model.Students.Any())
                        {
                            foreach (var s in Model.Students)
                            {
                                <button type="button"
                                        class="list-group-item list-group-item-action p-3 student-item-btn @(s.NeedsAttention ? "border-start border-4 border-danger" : "")"
                                        data-enrollment-id="@s.EnrollmentId"
                                        data-student-name="@($"{s.ChristianName} {s.FullName}")"
                                        data-phone="@(s.ParentPhone ?? "")"
                                        onclick="selectStudentForMessage(this)">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <div class="fw-bold text-dark">
                                                @s.ChristianName @s.FullName
                                                <span class="badge bg-light text-secondary border font-monospace ms-1">@s.StudentCode</span>
                                            </div>
                                            <div class="small text-muted mt-1">
                                                ĐTB Năm: <strong class="@(s.YearAverage < 5.0m ? "text-danger" : "text-primary")">@(s.YearAverage?.ToString("0.00") ?? "--")</strong> |
                                                Chuyên cần: <strong class="@(s.CombinedAttendanceRate < 80 ? "text-danger" : "text-success")">@s.CombinedAttendanceRate.ToString("0.0")%</strong> |
                                                Vắng: <strong>@s.TotalAbsentDays</strong> buổi
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            @if (s.NeedsAttention)
                                            {
                                                foreach (var b in s.AttentionBadges)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle d-block mb-1">@b</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success">Ổn định</span>
                                            }
                                        </div>
                                    </div>
                                </button>
                            }
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted small">
                                Không có thiếu nhi nào trong danh sách lọc hiện tại.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: KHUNG CHỌN MẪU TIN NHẮN & 1-CLICK COPY GỬI ZALO/VIBER -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">
                        <i class="bi bi-send-check-fill me-2"></i>Soạn &amp; Sao Chép Nhanh Tin Nhắn Phụ Huynh
                    </h6>
                    <span id="selectedStudentBadge" class="badge bg-warning text-dark">Chưa chọn thiếu nhi</span>
                </div>
                <div class="card-body p-4">
                    <input type="hidden" id="activeEnrollmentId" value="0" />
                    <input type="hidden" id="activeParentPhone" value="" />

                    <div class="row g-2 mb-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-bold text-secondary">Chọn Mẫu Tin Nhắn Chuẩn:</label>
                            <select id="selectMessageTemplate" class="form-select form-select-sm fw-semibold" onchange="refreshCompiledPreview()">
                                @foreach (var t in Model.Templates)
                                {
                                    <option value="@t.Id">[@t.Category] @t.Title</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-secondary">Ngày ghi nhận:</label>
                            <input type="date" id="customMessageDate" class="form-control form-control-sm"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="refreshCompiledPreview()" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary d-flex justify-content-between">
                            <span>Nội dung tin nhắn hoàn chỉnh (Có thể chỉnh sửa thêm trước khi Copy):</span>
                            <span id="copyStatusBadge" class="badge bg-success d-none">Đã sao chép vào bộ nhớ tạm!</span>
                        </label>
                        <textarea id="compiledMessageTextarea" class="form-control font-monospace small" rows="6"
                                  placeholder="Hãy bấm chọn 1 thiếu nhi ở cột bên trái để hệ thống tự động điền thông tin điểm số, chuyên cần và cảnh báo Bí tích..."></textarea>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-success rounded-pill px-4 fw-bold flex-grow-1 shadow-sm"
                                onclick="copyCenterMessageToClipboard()">
                            <i class="bi bi-clipboard-check-fill me-1"></i> 1-Click Sao Chép Tin Nhắn (Copy)
                        </button>
                        <a id="btnOpenZaloDirect" href="#" target="_blank"
                           class="btn btn-outline-primary rounded-pill px-3 fw-bold disabled"
                           title="Mở nhanh cửa sổ chat Zalo theo SĐT Phụ huynh">
                            <i class="bi bi-chat-dots-fill me-1"></i> Mở Zalo Phụ Huynh (<span id="spanParentPhone">Chưa có SĐT</span>)
                        </a>
                    </div>
                </div>
            </div>

            <!-- Danh sách Kho Mẫu Tin Nhắn hiện có -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-collection me-2 text-primary"></i>Kho Mẫu Câu Chuẩn (@Model.Templates.Count mẫu)
                    </h6>
                </div>
                <div class="list-group list-group-flush" style="max-height: 240px; overflow-y: auto;">
                    @foreach (var tpl in Model.Templates)
                    {
                        <div class="list-group-item p-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div>
                                    <span class="badge bg-primary-subtle text-primary border me-1">@tpl.Category</span>
                                    <strong class="small text-dark">@tpl.Title</strong>
                                </div>
                                @if (User.IsInRole("Admin") || User.IsInRole("ExecutiveBoard"))
                                {
                                    <form asp-action="Delete" asp-route-id="@tpl.Id" asp-route-classId="@Model.SelectedClassId" method="post"
                                          onsubmit="return confirm('Xóa mẫu tin nhắn này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm border-0 py-0 px-2">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                            <div class="text-muted small font-monospace" style="font-size: 0.75rem;">@tpl.ContentTemplate</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Tạo Mẫu Tin Nhắn Mới -->
@if (Model.CanManageTemplates)
{
    <div class="modal fade" id="createTemplateModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <form asp-action="Create" method="post" class="modal-content border-0 shadow rounded-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="classId" value="@Model.SelectedClassId" />
                <div class="modal-header bg-primary text-white">
                    <h6 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i>Thêm Mẫu Tin Nhắn Phụ Huynh Mới</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-2 mb-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Tiêu đề mẫu tin <span class="text-danger">*</span></label>
                            <input type="text" name="title" class="form-control" placeholder="VD: Thông báo học bù Lễ Chúa Nhật..." required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Phân loại</label>
                            <select name="category" class="form-select">
                                <option value="CHUYÊN CẦN">CHUYÊN CẦN</option>
                                <option value="HỌC TẬP">HỌC TẬP</option>
                                <option value="CẢNH BÁO BÍ TÍCH">CẢNH BÁO BÍ TÍCH</option>
                                <option value="SINH HOẠT">SINH HOẠT</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold"> Bấm vào các biến dưới đây để chèn nhanh vào mẫu câu:</label>
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            @foreach (var tag in new[] { "{TenThieuNhi}", "{MaThieuNhi}", "{TenLop}", "{Khoi}", "{NgayVang}", "{TongSoNgayVang}", "{TiLeChuyenCan}", "{DiemTB_Ky1}", "{DiemTB_Ky2}", "{DiemTB_Nam}", "{XepLoai}", "{CanhBaoBiTich}", "{SDTLienHe}" })
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 font-monospace"
                                        style="font-size: 0.75rem;" onclick="insertVariableTag('@tag')">
                                    @tag
                                </button>
                            }
                        </div>
                        <textarea name="contentTemplate" id="newTemplateTextarea" class="form-control font-monospace small" rows="4"
                              placeholder="Kính gửi Quý Phụ huynh em {TenThieuNhi} (Lớp {TenLop})..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold">Lưu Mẫu Câu</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        function filterStudentList(keyword) {
            const kw = (keyword || '').toLowerCase();
            document.querySelectorAll('.student-item-btn').forEach(btn => {
                const text = btn.innerText.toLowerCase();
                btn.style.display = text.includes(kw) ? '' : 'none';
            });
        }

        function insertVariableTag(tag) {
            const txt = document.getElementById('newTemplateTextarea');
            if (!txt) return;
            const start = txt.selectionStart || txt.value.length;
            const end = txt.selectionEnd || txt.value.length;
            txt.value = txt.value.substring(0, start) + tag + txt.value.substring(end);
            txt.focus();
        }

        async function selectStudentForMessage(btn) {
            document.querySelectorAll('.student-item-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const enrollmentId = btn.getAttribute('data-enrollment-id');
            const studentName = btn.getAttribute('data-student-name');
            const phone = btn.getAttribute('data-phone') || '';

            document.getElementById('activeEnrollmentId').value = enrollmentId;
            document.getElementById('activeParentPhone').value = phone;
            document.getElementById('selectedStudentBadge').textContent = studentName;

            const zaloBtn = document.getElementById('btnOpenZaloDirect');
            const phoneSpan = document.getElementById('spanParentPhone');
            if (phone.trim().length >= 9) {
                const digits = phone.replace(/\D/g, '');
                zaloBtn.href = `https://zalo.me/${digits}`;
                zaloBtn.classList.remove('disabled');
                phoneSpan.textContent = phone;
            } else {
                zaloBtn.href = '#';
                zaloBtn.classList.add('disabled');
                phoneSpan.textContent = 'Chưa có SĐT';
            }

            await refreshCompiledPreview();
        }

        async function refreshCompiledPreview() {
            const enrollmentId = parseInt(document.getElementById('activeEnrollmentId').value) || 0;
            const templateId = document.getElementById('selectMessageTemplate').value;
            const customDate = document.getElementById('customMessageDate').value;
            const txtArea = document.getElementById('compiledMessageTextarea');

            if (!enrollmentId || !templateId) return;

            txtArea.value = 'Đang tổng hợp dữ liệu điểm & chuyên cần...';
            try {
                const res = await fetch(`/ParentMessages/RenderTemplateByEnrollment?templateId=${templateId}&enrollmentId=${enrollmentId}&customDate=${encodeURIComponent(customDate)}`);
                const data = await res.json();
                if (data.success) {
                    txtArea.value = data.compiledMessage;
                } else {
                    txtArea.value = 'Lỗi: ' + (data.message || 'Không thể tạo nội dung.');
                }
            } catch (err) {
                txtArea.value = 'Lỗi kết nối máy chủ: ' + err.message;
            }
        }

        function copyCenterMessageToClipboard() {
            const txtArea = document.getElementById('compiledMessageTextarea');
            if (!txtArea.value.trim()) {
                alert('Vui lòng chọn một thiếu nhi ở danh sách bên trái trước khi sao chép!');
                return;
            }

            navigator.clipboard.writeText(txtArea.value).then(() => {
                const badge = document.getElementById('copyStatusBadge');
                badge.classList.remove('d-none');
                setTimeout(() => badge.classList.add('d-none'), 2500);
            });
        }

        // Tự động chọn học sinh đầu tiên khi mở trang
        document.addEventListener('DOMContentLoaded', function () {
            const firstStudent = document.querySelector('.student-item-btn');
            if (firstStudent) {
                selectStudentForMessage(firstStudent);
            }
        });
    </script>
}