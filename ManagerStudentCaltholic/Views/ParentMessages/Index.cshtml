@model IEnumerable<ManagerStudentCaltholic.Models.Entities.ParentMessageTemplate>
@using ManagerStudentCaltholic.Models.Entities
@{
    ViewData["Title"] = "Mẫu Tin Nhắn Phụ Huynh (1-Click Copy)";
    var selectedCategory = (string)(ViewBag.SelectedCategory ?? "ALL");
    bool canCreate = User.IsInRole(UserRole.Admin) || User.IsInRole(UserRole.ExecutiveBoard) || User.IsInRole(UserRole.BranchHead);
    bool canDelete = User.IsInRole(UserRole.Admin) || User.IsInRole(UserRole.ExecutiveBoard);
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-chat-quote-fill text-warning me-2"></i>Thư Viện Mẫu Tin Nhắn Phụ Huynh (1-Click Copy)
            </h3>
            <p class="text-muted small mb-0">
                Soạn sẵn các mẫu thông báo chuyên cần & học tập. Giáo lý viên chỉ cần bấm <strong>Sao chép</strong> để gửi qua Zalo/Viber hoàn toàn miễn phí.
            </p>
        </div>
        @if (canCreate)
        {
            <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#createTemplateModal">
                <i class="bi bi-plus-circle me-1"></i> Thêm Mẫu Tin Nhắn
            </button>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Thanh công cụ điền thử nhanh & Bộ lọc -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary">Lọc theo nhóm mẫu</label>
                    <select class="form-select form-select-sm" onchange="window.location.href='/ParentMessages?category=' + encodeURIComponent(this.value)">
                        <option value="ALL" selected="@(selectedCategory == "ALL")">-- Tất cả phân loại --</option>
                        <option value="CHUYÊN CẦN" selected="@(selectedCategory == "CHUYÊN CẦN")">Chuyên cần (Vắng / Đi trễ)</option>
                        <option value="HỌC TẬP" selected="@(selectedCategory == "HỌC TẬP")">Học tập & Kiểm tra</option>
                        <option value="SINH HOẠT" selected="@(selectedCategory == "SINH HOẠT")">Thông báo Sinh hoạt / Phụng vụ</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary">Tên thiếu nhi (Điền nhanh khi Copy)</label>
                    <input type="text" id="previewStudentName" class="form-control form-control-sm" placeholder="VD: Giuse Nguyễn Văn An" oninput="updateAllPreviews()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary">Tên lớp</label>
                    <input type="text" id="previewClassName" class="form-control form-control-sm" placeholder="VD: Thêm Sức 2A" oninput="updateAllPreviews()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary">Ngày áp dụng</label>
                    <input type="text" id="previewDate" class="form-control form-control-sm" value="@DateTime.Now.ToString("dd/MM/yyyy")" oninput="updateAllPreviews()" />
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách các thẻ Mẫu tin nhắn -->
    <div class="row g-3">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge bg-primary-subtle text-primary border px-2 py-1 rounded-pill">
                                        @item.Category
                                    </span>
                                    <small class="text-muted">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small>
                                </div>
                                <h5 class="fw-bold text-dark mb-2">@item.Title</h5>
                                <div class="p-3 bg-light rounded-3 border font-monospace small text-dark mb-3 template-preview-box"
                                     id="preview-box-@item.Id"
                                     data-raw-template="@item.ContentTemplate"
                                     style="white-space: pre-line;">
                                    @item.ContentTemplate
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <button type="button" class="btn btn-success btn-sm rounded-pill px-3 fw-bold shadow-sm"
                                        onclick="copyTemplateContent(@item.Id, this)">
                                    <i class="bi bi-clipboard-check me-1"></i> Sao Chép Tin Nhắn
                                </button>

                                @if (canDelete)
                                {
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="m-0"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa mẫu tin nhắn này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                            <i class="bi bi-trash3 me-1"></i> Xóa
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-chat-square-dots fs-1 d-block mb-2"></i>
                Chưa có mẫu tin nhắn nào trong phân loại này.
            </div>
        }
    </div>
</div>

<!-- Modal Tạo Mẫu Tin Nhắn Mới -->
@if (canCreate)
{
    <div class="modal fade" id="createTemplateModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <form asp-action="Create" method="post" class="modal-content border-0 shadow rounded-4 overflow-hidden">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-plus-circle me-2"></i>Tạo Mẫu Tin Nhắn Phụ Huynh Mới
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Tiêu đề mẫu tin nhắn <span class="text-danger">*</span></label>
                            <input type="text" name="title" class="form-control" placeholder="VD: Thông báo vắng học Giáo lý Chúa Nhật..." required maxlength="150" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Phân loại</label>
                            <select name="category" class="form-select">
                                <option value="CHUYÊN CẦN">CHUYÊN CẦN</option>
                                <option value="HỌC TẬP">HỌC TẬP</option>
                                <option value="SINH HOẠT">SINH HOẠT</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold">Nội dung mẫu (Hỗ trợ biến tự động) <span class="text-danger">*</span></label>
                        <textarea name="contentTemplate" id="newTemplateContent" class="form-control font-monospace small" rows="5" required
                              placeholder="Kính gửi Quý Phụ huynh em {TenThieuNhi} (Lớp {TenLop})..."></textarea>
                    </div>
                    <div class="small text-muted">
                        Bấm để chèn nhanh biến tự động:
                        <button type="button" class="btn btn-light btn-sm border py-0 px-2 font-monospace" onclick="insertVar('{TenThieuNhi}')">{TenThieuNhi}</button>
                        <button type="button" class="btn btn-light btn-sm border py-0 px-2 font-monospace" onclick="insertVar('{TenLop}')">{TenLop}</button>
                        <button type="button" class="btn btn-light btn-sm border py-0 px-2 font-monospace" onclick="insertVar('{NgayVang}')">{NgayVang}</button>
                        <button type="button" class="btn btn-light btn-sm border py-0 px-2 font-monospace" onclick="insertVar('{SDTLienHe}')">{SDTLienHe}</button>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Lưu Mẫu Tin Nhắn</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        function updateAllPreviews() {
            const name = document.getElementById('previewStudentName').value.trim() || '{TenThieuNhi}';
            const cls = document.getElementById('previewClassName').value.trim() || '{TenLop}';
            const dt = document.getElementById('previewDate').value.trim() || '{NgayVang}';

            document.querySelectorAll('.template-preview-box').forEach(box => {
                const raw = box.getAttribute('data-raw-template') || '';
                box.textContent = raw
                    .replaceAll('{TenThieuNhi}', name)
                    .replaceAll('{TenLop}', cls)
                    .replaceAll('{NgayVang}', dt)
                    .replaceAll('{SDTLienHe}', 'Ban Giáo Lý Giáo Xứ');
            });
        }

        function copyTemplateContent(id, btn) {
            const box = document.getElementById(`preview-box-${id}`);
            if (!box) return;

            navigator.clipboard.writeText(box.textContent).then(() => {
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check2-all me-1"></i> Đã Sao Chép!';
                btn.classList.replace('btn-success', 'btn-dark');
                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                    btn.classList.replace('btn-dark', 'btn-success');
                }, 1800);
            });
        }

        function insertVar(varText) {
            const txt = document.getElementById('newTemplateContent');
            if (!txt) return;
            const start = txt.selectionStart;
            const end = txt.selectionEnd;
            txt.value = txt.value.substring(0, start) + varText + txt.value.substring(end);
            txt.focus();
            txt.selectionStart = txt.selectionEnd = start + varText.length;
        }
    </script>
}