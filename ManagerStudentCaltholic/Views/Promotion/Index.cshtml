@model ManagerStudentCaltholic.Models.ViewModels.PromotionPreviewViewModel
@using ManagerStudentCaltholic.Models.Entities
@{
    ViewData["Title"] = "Xét Duyệt Lên Lớp & Kết Chuyển Niên Khóa";
    var allYears = ViewBag.AllYears as List<AcademicYear> ?? new();
    var sourceClasses = ViewBag.SourceClasses as List<ClassRoom> ?? new();
}
@Html.AntiForgeryToken()

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="bi bi-arrow-up-right-circle-fill text-primary me-2"></i>Hội Đồng Xét Lên Lớp & Kết Chuyển Niên Khóa
            </h4>
            <small class="text-muted">
                Tự động tổng hợp kết quả cuối năm, xét duyệt lên lớp / đặc cách và chuyển danh sách học sinh sang niên khóa mới.
            </small>
        </div>
        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="cloneClassesToNewYear()">
            <i class="bi bi-files me-1"></i> Sao Chép Khung Lớp Sang Niên Khóa Đích (@Model.TargetYearName)
        </button>
    </div>

    <!-- Bộ lọc Niên khóa Nguồn - Lớp Nguồn - Tiêu chí xét duyệt -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary">1. Niên Khóa Nguồn (Năm Cũ)</label>
                    <select name="sourceYearId" id="sourceYearId" class="form-select form-select-sm" onchange="this.form.submit()">
                        @foreach (var y in allYears)
                        {
                            <option value="@y.Id" selected="@(y.Id == Model.SourceYearId)">
                                @y.Name @(y.IsCurrent ? "(Đang kích hoạt)" : "")
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary">2. Chọn Lớp Xét Duyệt</label>
                    <select name="sourceClassId" class="form-select form-select-sm fw-semibold" onchange="this.form.submit()">
                        @foreach (var c in sourceClasses)
                        {
                            <option value="@c.Id" selected="@(c.Id == Model.SourceClassId)">
                                @c.Name (@c.GradeLevel)
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary">3. Niên Khóa Đích (Năm Mới)</label>
                    <select name="targetYearId" id="targetYearId" class="form-select form-select-sm" onchange="this.form.submit()">
                        @foreach (var y in allYears)
                        {
                            <option value="@y.Id" selected="@(y.Id == Model.TargetYearId)">@y.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary">ĐTB Tối Thiểu</label>
                    <input type="number" step="0.5" min="0" max="10" name="minAvg" value="@Model.MinYearAverage" class="form-control form-control-sm text-center" />
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <div class="w-100">
                        <label class="form-label small fw-bold text-secondary">% Chuyên Cần</label>
                        <input type="number" step="5" min="0" max="100" name="minAtt" value="@Model.MinAttendanceRate" class="form-control form-control-sm text-center" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm align-self-end px-3" title="Áp dụng tiêu chí">
                        <i class="bi bi-funnel-fill"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Khu vực Cấu hình Lớp Đích & Nút Thực thi Kết chuyển -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary-subtle">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-dark mb-1">
                        <i class="bi bi-check2-circle text-success me-1"></i>Chuyển Học Sinh ĐƯỢC LÊN LỚP (@Model.PassedCount em) vào lớp:
                    </label>
                    <select id="promoteToClassId" class="form-select form-select-sm fw-bold border-success">
                        <option value="">-- Chọn lớp lên ở niên khóa @Model.TargetYearName --</option>
                        @foreach (var tc in Model.TargetYearClasses)
                        {
                            <option value="@tc.Id">@tc.Name (@tc.GradeLevel)</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label small fw-bold text-dark mb-1">
                        <i class="bi bi-arrow-repeat text-danger me-1"></i>Giữ Học Sinh Ở LẠI LỚP (@Model.RetainedCount em) vào lớp:
                    </label>
                    <select id="retainInClassId" class="form-select form-select-sm fw-bold border-danger">
                        <option value="">-- Chọn lớp học lại ở niên khóa @Model.TargetYearName --</option>
                        @foreach (var tc in Model.TargetYearClasses)
                        {
                            <option value="@tc.Id" selected="@(tc.Id == Model.SuggestedRetainClassId)">@tc.Name (@tc.GradeLevel)</option>
                        }
                    </select>
                </div>

                <div class="col-md-4 text-md-end">
                    <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm mt-3 mt-md-0" onclick="executeRollover()">
                        <i class="bi bi-cloud-upload-fill me-1"></i> Xác Nhận Kết Chuyển Sang @Model.TargetYearName
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng Danh sách Học sinh Xét duyệt -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0 text-center">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 45px;">STT</th>
                        <th style="width: 95px;">Mã QR</th>
                        <th class="text-start">Tên Thánh & Họ Tên</th>
                        <th>ĐTB HK1</th>
                        <th>ĐTB HK2</th>
                        <th class="bg-warning-subtle">ĐTB Cả Năm</th>
                        <th>% Chuyên Cần</th>
                        <th>Xếp Loại</th>
                        <th>Xét Bí Tích</th>
                        <th style="width: 170px;">Quyết Định Lên Lớp</th>
                        <th>Trạng Thái Năm Mới</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Students.Any())
                    {
                        var stt = 1;
                        foreach (var s in Model.Students)
                        {
                            <tr class="student-rollover-row" data-student-id="@s.StudentId">
                                <td class="fw-bold text-muted">@(stt++)</td>
                                <td><span class="badge bg-light text-dark border font-monospace">@s.StudentCode</span></td>
                                <td class="text-start fw-bold text-dark">@s.ChristianName @s.FullName</td>
                                <td>@(s.HK1Average.HasValue? s.HK1Average.Value.ToString("0.00") : "--")</td>
                                <td>@(s.HK2Average.HasValue? s.HK2Average.Value.ToString("0.00") : "--")</td>
                                <td class="fw-bold text-primary bg-light">@(s.YearAverage.HasValue? s.YearAverage.Value.ToString("0.00") : "--")</td>
                                <td><span class="badge bg-light text-dark border">@s.AttendanceRate%</span></td>
                                <td><span class="badge bg-secondary">@s.AcademicRank</span></td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2">
                                        Tạm khóa (Chờ quy tắc)
                                    </span>
                                </td>
                                <td>
                                    <select class="form-select form-select-sm fw-bold decision-select @(s.IsPromoted ? "text-success border-success" : "text-danger border-danger")"
                                            @(s.AlreadyEnrolledInTargetYear ? "disabled" : "")
                                            onchange="updateSelectStyle(this)">
                                        <option value="PROMOTE" selected="@s.IsPromoted">✔ Lên lớp</option>
                                        <option value="RETAIN" selected="@(!s.IsPromoted)">✘ Ở lại lớp</option>
                                        <option value="SKIP">Bỏ qua (Nghỉ/Chuyển xứ)</option>
                                    </select>
                                    <small class="text-muted d-block mt-1" style="font-size: 0.72rem;">@s.PromotionNote</small>
                                </td>
                                <td>
                                    @if (s.AlreadyEnrolledInTargetYear)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                            Đã vào lớp: @s.ExistingTargetClassName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-dark border px-2 py-1">Chưa kết chuyển</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="py-5 text-muted">Lớp hiện tại chưa có dữ liệu thiếu nhi.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getCsrfToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        function updateSelectStyle(sel) {
            sel.classList.remove('text-success', 'border-success', 'text-danger', 'border-danger', 'text-secondary');
            if (sel.value === 'PROMOTE') {
                sel.classList.add('text-success', 'border-success');
            } else if (sel.value === 'RETAIN') {
                sel.classList.add('text-danger', 'border-danger');
            } else {
                sel.classList.add('text-secondary');
            }
        }

        async function cloneClassesToNewYear() {
            const sourceYearId = document.getElementById('sourceYearId').value;
            const targetYearId = document.getElementById('targetYearId').value;
            if (sourceYearId === targetYearId) {
                alert('Vui lòng chọn Niên khóa Đích (Năm mới) khác với Niên khóa Nguồn trước khi sao chép khung lớp!');
                return;
            }
            if (!confirm('Hệ thống sẽ tự động tạo các lớp học tương ứng sang niên khóa mới. Tiếp tục?')) return;

            const formData = new FormData();
            formData.append('sourceYearId', sourceYearId);
            formData.append('targetYearId', targetYearId);

            const res = await fetch('/Promotion/CloneClassesToNewYear', {
                method: 'POST',
                headers: { 'X-CSRF-TOKEN': getCsrfToken() },
                body: formData
            });
            const data = await res.json();
            alert(data.message);
            if (data.success) location.reload();
        }

        async function executeRollover() {
            const targetYearId = parseInt(document.getElementById('targetYearId').value);
            const promoteToClassId = document.getElementById('promoteToClassId').value;
            const retainInClassId = document.getElementById('retainInClassId').value;

            const decisions = [];
            document.querySelectorAll('.student-rollover-row').forEach(row => {
                const sel = row.querySelector('.decision-select');
                if (sel && !sel.disabled) {
                    decisions.push({
                        studentId: parseInt(row.getAttribute('data-student-id')),
                        isPromoted: sel.value === 'PROMOTE',
                        skip: sel.value === 'SKIP'
                    });
                }
            });

            const hasPromote = decisions.some(d => !d.skip && d.isPromoted);
            const hasRetain = decisions.some(d => !d.skip && !d.isPromoted);

            if (hasPromote && !promoteToClassId) {
                alert('Vui lòng chọn Lớp Đích cho nhóm học sinh ĐƯỢC LÊN LỚP!');
                return;
            }
            if (hasRetain && !retainInClassId) {
                alert('Vui lòng chọn Lớp Đích cho nhóm học sinh Ở LẠI LỚP!');
                return;
            }

            if (!confirm('Xác nhận thực thi kết chuyển danh sách thiếu nhi sang niên khóa mới?')) return;

            const payload = {
                sourceClassId: @Model.SourceClassId,
                targetYearId: targetYearId,
                promoteToClassId: promoteToClassId ? parseInt(promoteToClassId) : null,
                retainInClassId: retainInClassId ? parseInt(retainInClassId) : null,
                decisions: decisions
            };

            const res = await fetch('/Promotion/ExecuteRollover', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': getCsrfToken()
                },
                body: JSON.stringify(payload)
            });

            const data = await res.json();
            alert(data.message);
            if (data.success) location.reload();
        }
    </script>
}