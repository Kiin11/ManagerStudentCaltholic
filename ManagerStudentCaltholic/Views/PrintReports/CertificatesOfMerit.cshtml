@model ManagerStudentCaltholic.Models.ViewModels.BatchPrintViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Giấy Khen - @Model.ClassName</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        @@media print {
            body {
                background: transparent;
            }

            .no-print {
                display: none !important;
            }

            .page-break {
                page-break-after: always;
            }
        }

        .cert-card {
            width: 297mm;
            height: 210mm;
            padding: 20mm;
            margin: auto;
            border: 6px double #b8860b;
            background: #fff;
            position: relative;
            text-align: center;
        }
    </style>
</head>
<body class="bg-light py-4">
    <div class="text-center mb-4 no-print">
        <button onclick="window.print()" class="btn btn-warning px-4 fw-bold shadow">
            🖨️ In Hàng Loạt (@Model.Students.Count Giấy Khen)
        </button>
    </div>

    @foreach (var s in Model.Students)
    {
        <div class="cert-card page-break mb-4">
            <h5 class="text-muted text-uppercase">BAN GIÁO LÝ XỨ ĐOÀN TRUNG BẮC</h5>
            <h1 class="fw-bold text-danger my-3" style="font-family: serif; letter-spacing: 2px;">GIẤY KHEN</h1>
            <p class="lead mb-2">Tuyên dương em:</p>
            <h2 class="fw-bold text-primary mb-2">@s.ChristianName @s.FullName</h2>
            <p class="fs-5 text-muted mb-3">Học sinh Lớp: <strong>@Model.ClassName</strong> - Niên Khóa: <strong>@Model.AcademicYearName</strong></p>
            <p class="fs-4 fst-italic text-dark">
                Đã đạt thành tích: <strong>HỌC SINH @s.AcademicRank.ToUpper()</strong> VÀ CHĂM NGOAN
            </p>

            <div class="row text-center mt-5 pt-4">
                <div class="col-6">
                    <h6 class="fw-bold">TRƯỞNG BAN ĐIỀU HÀNH</h6>
                    <div style="height: 70px;"></div>
                    <div class="text-muted">(Ký tên)</div>
                </div>
                <div class="col-6">
                    <h6 class="fw-bold">CHA TUYÊN ÚY</h6>
                    <div style="height: 70px;"></div>
                    <div class="text-muted">(Ký tên & Đóng dấu)</div>
                </div>
            </div>
        </div>
    }
</body>
</html>