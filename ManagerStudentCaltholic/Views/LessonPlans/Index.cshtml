@model ManagerStudentCaltholic.Models.ViewModels.LessonPlanWorkspaceViewModel
@{
    ViewData["Title"] = "Kế Hoạch Lớp & Phân Phối Chương Trình";
    var classes = Model.Classes;
    var selectedClassId = Model.SelectedClassId;
    var currentYear = Model.CurrentYear;
    var selectedClassName = Model.SelectedClassName;
    var selectedGrade = Model.SelectedGrade;
    var doc = Model.CurriculumDocument;
    var versions = Model.Versions;
    var items = doc?.Items ?? new List<ManagerStudentCaltholic.Models.DTOs.CurriculumItemDto>();
    var canManage = Model.CanManage;
}

@Html.AntiForgeryToken()

<div class="container-fluid py-4">
    <!-- 1. Header & Tiêu đề -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-calendar3-week-fill me-2"></i>Kế Hoạch Lớp & Phân Phối Chương Trình
            </h3>
            <p class="text-muted mb-0">
                Niên khóa: <strong class="text-dark">@(currentYear?.Name ?? "2026-2027")</strong> |
                Lớp: <strong class="text-primary">@selectedClassName</strong> (@selectedGrade)
                @if (doc != null && doc.Id > 0)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle ms-2 px-2 py-1">
                        <i class="bi bi-bookmark-check-fill me-1"></i>Phiên bản hiện hành: <strong>@doc.CurrentVersion</strong>
                    </span>
                    <span class="text-muted small ms-2">
                        <i class="bi bi-person me-1"></i>Sửa bởi <strong>@doc.UpdatedBy</strong> lúc @doc.UpdatedAt.ToString("dd/MM/yyyy HH:mm")
                    </span>
                }
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-2 mt-md-0">
            <a href="/Classes" class="btn btn-outline-secondary">
                <i class="bi bi-mortarboard me-1"></i> Danh Sách Lớp
            </a>
            @if (doc != null && doc.Id > 0)
            {
                <a href="/LessonPlans/ExportCurrentCurriculumExcel?documentId=@doc.Id" class="btn btn-outline-success">
                    <i class="bi bi-file-earmark-excel-fill me-1"></i> Xuất Excel (@doc.CurrentVersion)
                </a>
            }
            @if (canManage)
            {
                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#parserModal">
                    <i class="bi bi-file-earmark-arrow-up-fill me-1"></i> Nạp Từ File (.xlsx, .docx, .csv, .md)
                </button>
                <button type="button" class="btn btn-primary shadow-sm" onclick="openSaveModal()">
                    <i class="bi bi-save2-fill me-1"></i> Lưu Phiên Bản Mới
                </button>
            }
        </div>
    </div>

    <!-- 2. Thanh chọn Lớp & Thống kê nhanh -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-5">
                    <label class="form-label small fw-bold text-secondary mb-1">
                        <i class="bi bi-building me-1"></i>Chọn Lớp Cần Xem Kế Hoạch:
                    </label>
                    <select class="form-select fw-semibold" onchange="window.location.href='/LessonPlans?classRoomId=' + this.value">
                        @foreach (var c in classes)
                        {
                            <!option value="@c.Id" @(c.Id == selectedClassId ? "selected" : "")>
                            @c.Name (@c.GradeLevel) - Phòng: @(string.IsNullOrEmpty(c.RoomName) ? "Chưa xếp" : c.RoomName)
                            </!option>
                        }
                    </select>
                </div>
                <div class="col-md-7 d-flex flex-wrap justify-content-md-end gap-3 pt-md-3">
                    <div class="text-center px-3 py-1 bg-light rounded-3 border">
                        <small class="text-muted d-block">Tổng số tuần</small>
                        <strong class="text-primary fs-6" id="statTotalWeeks">@items.Count</strong>
                    </div>
                    <div class="text-center px-3 py-1 bg-light rounded-3 border">
                        <small class="text-muted d-block">Kiểm tra / Thi</small>
                        <strong class="text-danger fs-6" id="statExamDays">@items.Count(i => i.IsExamDay)</strong>
                    </div>
                    <div class="text-center px-3 py-1 bg-light rounded-3 border">
                        <small class="text-muted d-block">Nghỉ lễ / Sự kiện</small>
                        <strong class="text-warning fs-6" id="statOffDays">@items.Count(i => i.IsDayOff)</strong>
                    </div>
                    <div class="text-center px-3 py-1 bg-light rounded-3 border">
                        <small class="text-muted d-block">Số lần sửa (Versions)</small>
                        <strong class="text-success fs-6">@versions.Count</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Navigation Tabs -->
    <ul class="nav nav-pills nav-fill bg-white p-2 rounded-4 shadow-sm mb-4 border" id="planTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold py-2" id="editor-tab" data-bs-toggle="tab" data-bs-target="#editorPane" type="button" role="tab">
                <i class="bi bi-pencil-square me-2"></i>Chương Trình & Biên Tập Trực Tuyến
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold py-2" id="versions-tab" data-bs-toggle="tab" data-bs-target="#versionsPane" type="button" role="tab">
                <i class="bi bi-clock-history me-2"></i>Lịch Sử Phiên Bản & File Ngày Sửa (@versions.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold py-2" id="legacy-tab" data-bs-toggle="tab" data-bs-target="#legacyPane" type="button" role="tab">
                <i class="bi bi-folder2-open me-2"></i>Tài Liệu Đính Kèm Khác (@Model.LegacyDocuments.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="planTabContent">
        <!-- TAB 1: TRÌNH BIÊN TẬP & HIỂN THỊ CHƯƠNG TRÌNH TRỰC TUYẾN (TASK-P5-07.3) -->
        <div class="tab-pane fade show active" id="editorPane" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-table me-2 text-primary"></i>Phân Phối Bài Học & Kế Hoạch Từng Tuần
                        </h5>
                        <small class="text-muted">
                            Chỉnh sửa trực tiếp trên trình duyệt. Khi bấm <strong>"Lưu Phiên Bản Mới"</strong>, hệ thống tự động xuất file Excel đính kèm và đồng bộ lịch học.
                        </small>
                    </div>
                    @if (canManage)
                    {
                        <div class="d-flex gap-2 mt-2 mt-md-0">
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="autoFillConsecutiveSundays()" title="Tự động tính ngày Chúa Nhật tiếp theo cho tất cả các tuần">
                                <i class="bi bi-magic me-1"></i> Điền Ngày CN Tiếp Theo
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addNewRow()">
                                <i class="bi bi-plus-circle-fill me-1"></i> Thêm Tuần Mới
                            </button>
                        </div>
                    }
                </div>

                <div class="table-responsive" style="max-height: 68vh;">
                    <table class="table table-hover align-middle mb-0" id="curriculumTable">
                        <thead class="table-light sticky-top small text-uppercase" style="z-index: 10;">
                            <tr>
                                <th class="text-center" style="width: 70px;">Tuần</th>
                                <th style="width: 140px;">Ngày Học (CN)</th>
                                <th style="width: 160px;">Chúa Nhật / Phụng Vụ</th>
                                <th style="width: 110px;">Số / Mã Bài</th>
                                <th>Tên Chủ Đề / Bài Giảng <span class="text-danger">*</span></th>
                                <th style="width: 200px;">Trọng Tâm Giáo Lý</th>
                                <th style="width: 140px;">GLV Phụ Trách</th>
                                <th class="text-center" style="width: 130px;">Phân Loại</th>
                                <th style="width: 150px;">Ghi Chú</th>
                                @if (canManage)
                                {
                                    <th class="text-center" style="width: 70px;">Xóa</th>
                                }
                            </tr>
                        </thead>
                        <tbody id="curriculumTableBody">
                            @if (items.Any())
                            {
                                int idx = 0;
                                foreach (var item in items)
                                {
                                    var rowClass = item.IsExamDay ? "table-danger-subtle" : (item.IsDayOff ? "table-warning-subtle" : "");
                                    var dateVal = item.LessonDate?.ToString("yyyy-MM-dd") ?? "";
                                    <tr class="curriculum-row @rowClass" data-index="@idx">
                                        <td class="text-center">
                                            <input type="number" class="form-control form-control-sm text-center fw-bold row-week" value="@item.WeekNumber" min="1" max="60" @(!canManage ? "readonly" : "") />
                                        </td>
                                        <td>
                                            <input type="date" class="form-control form-control-sm row-date" value="@dateVal" @(!canManage ? "readonly" : "") />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm row-liturgical" value="@item.LiturgicalDay" placeholder="CN 24 TN..." @(!canManage ? "readonly" : "") />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm row-code fw-semibold text-primary" value="@item.LessonCode" placeholder="Bài 1..." @(!canManage ? "readonly" : "") />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm fw-bold row-topic" value="@item.TopicTitle" placeholder="Tiêu đề bài học..." required @(!canManage ? "readonly" : "") />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm row-key" value="@item.KeyPoints" placeholder="Ý chính..." @(!canManage ? "readonly" : "") />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm row-teacher" value="@item.AssignedTeacherName" placeholder="GLV..." @(!canManage ? "readonly" : "") />
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-1">
                                                <input type="checkbox" class="btn-check row-exam-check" id="exam_check_@idx" autocomplete="off" @(item.IsExamDay ? "checked" : "") onchange="onTypeToggle(this)" @(!canManage ? "disabled" : "") />
                                                <label class="btn btn-sm btn-outline-danger p-1" for="exam_check_@idx" title="Đánh dấu ngày Kiểm tra / Thi">
                                                    <i class="bi bi-pencil-fill"></i> Thi
                                                </label>

                                                <input type="checkbox" class="btn-check row-off-check" id="off_check_@idx" autocomplete="off" @(item.IsDayOff ? "checked" : "") onchange="onTypeToggle(this)" @(!canManage ? "disabled" : "") />
                                                <label class="btn btn-sm btn-outline-warning p-1" for="off_check_@idx" title="Đánh dấu ngày Nghỉ lễ / Sự kiện">
                                                    <i class="bi bi-cup-hot-fill"></i> Nghỉ
                                                </label>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm row-notes" value="@item.EventNotes" placeholder="Ghi chú..." @(!canManage ? "readonly" : "") />
                                        </td>
                                        @if (canManage)
                                        {
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="deleteRow(this)" title="Xóa tuần này">
                                                    <i class="bi bi-trash3-fill fs-6"></i>
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                    idx++;
                                }
                            }
                            else
                            {
                                <tr id="emptyCurriculumRow">
                                    <td colspan="@(canManage ? 10 : 9)" class="text-center py-5 text-muted">
                                        <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary"></i>
                                        Lớp này chưa có kế hoạch phân phối chương trình nào.<br />
                                        Bạn có thể bấm nút <strong>"Thêm Tuần Mới"</strong> hoặc <strong>"Nạp Từ File (.xlsx, .docx, .csv, .md)"</strong> để thiết lập nhanh.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (canManage)
                {
                    <div class="card-footer bg-light py-3 d-flex flex-wrap justify-content-between align-items-center">
                        <button type="button" class="btn btn-outline-primary" onclick="addNewRow()">
                            <i class="bi bi-plus-lg me-1"></i> Thêm Tuần Tiếp Theo
                        </button>
                        <div class="d-flex gap-2 mt-2 mt-md-0">
                            <button type="button" class="btn btn-success shadow-sm px-4 fw-bold" onclick="openSaveModal()">
                                <i class="bi bi-cloud-arrow-up-fill me-1"></i> Lưu Kế Hoạch (Phiên Bản Mới)
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- TAB 2: LỊCH SỬ PHIÊN BẢN & FILE ĐÍNH KÈM THEO NGÀY SỬA (TASK-P5-07.4) -->
        <div class="tab-pane fade" id="versionsPane" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-clock-history me-2 text-primary"></i>Lịch Sử Phiên Bản & File Đính Kèm Tự Động Sinh
                    </h5>
                    <small class="text-muted">
                        Mỗi lần lưu chỉnh sửa, hệ thống tự động kết xuất thành file Excel gắn phiên bản và ngày sửa (VD: <code>KeHoach_TS3A_v2_20261105.xlsx</code>). Bạn có thể xem lại bản cũ, tải file hoặc Khôi phục (Rollback).
                    </small>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase">
                            <tr>
                                <th class="ps-3" style="width: 100px;">Phiên Bản</th>
                                <th style="width: 170px;">Ngày Giờ Sửa</th>
                                <th style="width: 160px;">Người Thực Hiện</th>
                                <th>Ghi Chú Thay Đổi</th>
                                <th style="width: 100px;">Số Tuần</th>
                                <th>File Đính Kèm Tự Động</th>
                                <th class="text-end pe-3" style="width: 220px;">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (versions.Any())
                            {
                                foreach (var v in versions)
                                {
                                    var isCurrent = doc != null && doc.VersionNumber == v.VersionNumber;
                                    var fileSizeKb = (v.FileSize / 1024.0).ToString("0.##") + " KB";
                                    <tr class="@(isCurrent ? "table-success-subtle" : "")">
                                        <td class="ps-3">
                                            <span class="badge @(isCurrent ? "bg-success" : "bg-secondary") fs-6 px-2 py-1">
                                                @v.VersionTag
                                            </span>
                                            @if (isCurrent)
                                            {
                                                <small class="d-block text-success fw-bold" style="font-size: 0.75rem;">Hiện hành</small>
                                            }
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark">@v.CreatedAt.ToString("dd/MM/yyyy")</div>
                                            <small class="text-muted">@v.CreatedAt.ToString("HH:mm:ss")</small>
                                        </td>
                                        <td>
                                            <i class="bi bi-person-fill text-secondary me-1"></i>@v.CreatedBy
                                        </td>
                                        <td>
                                            <span class="fw-semibold text-dark">@v.ChangeSummary</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@v.TotalWeeks tuần</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-file-earmark-excel-fill text-success fs-4 me-2"></i>
                                                <div>
                                                    <a href="/LessonPlans/DownloadCurriculumVersion/@v.Id" class="fw-bold text-decoration-none text-dark" download>
                                                        @v.FileName
                                                    </a>
                                                    <small class="d-block text-muted">@fileSizeKb</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-end pe-3">
                                            <div class="btn-group">
                                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="viewVersionDetail(@v.Id, '@v.VersionTag', '@v.FileName')">
                                                    <i class="bi bi-eye-fill me-1"></i> Xem
                                                </button>
                                                <a href="/LessonPlans/DownloadCurriculumVersion/@v.Id" class="btn btn-sm btn-outline-success" download title="Tải file của ngày sửa này">
                                                    <i class="bi bi-download"></i>
                                                </a>
                                                @if (canManage && !isCurrent)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-warning text-dark" onclick="rollbackVersion(@doc?.Id, @v.Id, '@v.VersionTag')" title="Khôi phục về bản này">
                                                        <i class="bi bi-arrow-counterclockwise"></i> Khôi phục
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="bi bi-clock-history fs-1 d-block mb-2 text-secondary"></i>
                                        Chưa có phiên bản nào được lưu vết.<br />
                                        Khi bạn bấm <strong>"Lưu Kế Hoạch"</strong>, phiên bản đầu tiên sẽ được ghi nhận tại đây cùng file đính kèm!
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 3: TÀI LIỆU ĐÍNH KÈM KHÁC (ClassLessonDocuments) -->
        <div class="tab-pane fade" id="legacyPane" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-folder2-open me-2 text-primary"></i>Tài Liệu Giáo Án & Hồ Sơ Bài Giảng Khác
                        </h5>
                        <small class="text-muted">Các tài liệu đính kèm bên ngoài (PDF giáo án, giáo trình giảng dạy)</small>
                    </div>
                    @if (canManage)
                    {
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#uploadLegacyModal">
                            <i class="bi bi-cloud-arrow-up-fill me-1"></i> Tải Lên File Khác
                        </button>
                    }
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase">
                            <tr>
                                <th class="ps-3" style="width: 50px;">Định Dạng</th>
                                <th>Tên File & Mô Tả</th>
                                <th style="width: 140px;">Dung Lượng</th>
                                <th style="width: 160px;">Người Đăng</th>
                                <th style="width: 160px;">Ngày Đăng</th>
                                <th class="text-end pe-3" style="width: 180px;">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.LegacyDocuments.Any())
                            {
                                foreach (var d in Model.LegacyDocuments)
                                {
                                    var ext = System.IO.Path.GetExtension(d.FileName).ToLowerInvariant();
                                    var icon = ext switch
                                    {
                                        ".pdf" => "bi-file-earmark-pdf-fill text-danger",
                                        ".xlsx" or ".xls" => "bi-file-earmark-excel-fill text-success",
                                        ".docx" or ".doc" => "bi-file-earmark-word-fill text-primary",
                                        _ => "bi-file-earmark-text-fill text-secondary"
                                    };
                                    var sizeKb = (d.FileSize / 1024.0).ToString("0.##") + " KB";
                                    <tr>
                                        <td class="ps-3 text-center"><i class="bi @icon fs-3"></i></td>
                                        <td>
                                            <div class="fw-bold text-dark">@d.FileName</div>
                                            <small class="text-muted">@d.Description</small>
                                        </td>
                                        <td><span class="badge bg-light text-secondary border">@sizeKb</span></td>
                                        <td>@d.UploadedBy</td>
                                        <td>@d.UploadedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end pe-3">
                                            <div class="btn-group">
                                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="viewDocumentOnline('@d.FilePath', '@d.FileName', '@ext')">
                                                    <i class="bi bi-eye-fill"></i>
                                                </button>
                                                <a href="@d.FilePath" download="@d.FileName" class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-download"></i>
                                                </a>
                                                @if (canManage)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteLegacyDocument(@d.Id, '@d.FileName')">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-folder-x fs-1 d-block mb-2 text-secondary"></i>
                                        Chưa có file tài liệu bổ trợ nào khác cho lớp này.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 1: BỘ ĐỌC NẠP FILE KẾ HOẠCH LÊN TRÌNH BIÊN TẬP (TASK-P5-07.2) -->
<!-- ========================================================================= -->
<div class="modal fade" id="parserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-file-earmark-arrow-up-fill me-2"></i>Nạp Nội Dung File Kế Hoạch Lên Giao Diện Web
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info border-0 shadow-sm rounded-3 small mb-3">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    Bộ đọc hỗ trợ tự động nhận diện và bóc tách nội dung từ các định dạng:
                    <strong>.xlsx</strong> (Excel), <strong>.docx</strong> (Word Table), <strong>.csv</strong>, <strong>.md</strong> (Markdown Table) và <strong>.pdf</strong>.
                    Sau khi nạp, bạn có thể chỉnh sửa trực tiếp các tuần trên web trước khi bấm lưu.
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Chọn file kế hoạch / phân phối chương trình:</label>
                    <input type="file" id="inputCurriculumParserFile" class="form-control form-control-lg" accept=".xlsx,.xls,.docx,.csv,.md,.pdf" />
                </div>

                <div id="parseProgressAlert" class="alert alert-warning border-0 d-none">
                    <div class="d-flex align-items-center">
                        <div class="spinner-border spinner-border-sm me-2 text-warning" role="status"></div>
                        <span>Đang phân tích cấu trúc tệp và bóc tách các tuần học...</span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-primary px-4 fw-bold" onclick="submitParseFile()">
                        <i class="bi bi-box-arrow-in-down me-1"></i> Đọc & Nạp Vào Bảng Biên Tập
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 2: XÁC NHẬN LƯU PHIÊN BẢN MỚI & TỰ ĐỘNG XUẤT FILE (TASK-P5-07.3) -->
<!-- ========================================================================= -->
<div class="modal fade" id="saveVersionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-cloud-arrow-up-fill me-2"></i>Lưu Kế Hoạch Lớp (Phiên Bản Mới)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small mb-3">
                    Khi lưu, hệ thống sẽ tự động:
                    <br />1. Tăng số thứ tự phiên bản (VD: <code>v@( (doc?.VersionNumber ?? 0) + 1 )</code>).
                    <br />2. Tự động kết xuất thành file Excel đính kèm: <code>KeHoach_@(selectedClassName)_v@( (doc?.VersionNumber ?? 0) + 1 )_@(DateTime.UtcNow.ToString("yyyyMMdd")).xlsx</code>.
                    <br />3. Đồng bộ danh sách bài học tuần vào hệ thống điểm danh và bài giảng.
                </p>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Tiêu đề kế hoạch</label>
                    <input type="text" id="inputSaveTitle" class="form-control" value="@(doc?.Title ?? $"Kế hoạch năm học Lớp {selectedClassName}")" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Ghi chú thay đổi của phiên bản này (Tùy chọn)</label>
                    <input type="text" id="inputChangeSummary" class="form-control" placeholder="Ví dụ: Cập nhật lịch thi HK1, phân công thêm GLV..." />
                </div>

                <div id="saveProgressAlert" class="alert alert-warning border-0 d-none">
                    <div class="d-flex align-items-center">
                        <div class="spinner-border spinner-border-sm me-2 text-success" role="status"></div>
                        <span>Đang lưu dữ liệu và kết xuất file Excel đính kèm...</span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-success px-4 fw-bold shadow-sm" onclick="submitSaveCurriculum()">
                        <i class="bi bi-check-circle-fill me-1"></i> Xác Nhận Lưu
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 3: XEM CHI TIẾT BẢN CHỤP PHIÊN BẢN CŨ (TASK-P5-07.4) -->
<!-- ========================================================================= -->
<div class="modal fade" id="versionDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="versionDetailTitle">
                    <i class="bi bi-journal-text me-2"></i>Chi Tiết Phiên Bản
                </h5>
                <div class="d-flex gap-2">
                    <a id="versionDetailDownloadBtn" href="#" class="btn btn-sm btn-outline-light" download>
                        <i class="bi bi-download me-1"></i> Tải File Bản Này
                    </a>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase sticky-top">
                            <tr>
                                <th class="text-center" style="width: 60px;">Tuần</th>
                                <th style="width: 120px;">Ngày Học</th>
                                <th style="width: 150px;">Phụng Vụ</th>
                                <th style="width: 100px;">Mã Bài</th>
                                <th>Chủ Đề Bài Giảng</th>
                                <th>Trọng Tâm</th>
                                <th style="width: 140px;">GLV Phụ Trách</th>
                                <th class="text-center" style="width: 110px;">Phân Loại</th>
                                <th>Ghi Chú</th>
                            </tr>
                        </thead>
                        <tbody id="versionDetailTableBody">
                            <!-- Injected via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
