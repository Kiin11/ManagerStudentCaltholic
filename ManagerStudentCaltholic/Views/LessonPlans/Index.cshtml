</div>

<!-- ========================================================================= -->
<!-- MODAL 5: XEM FILE PDF TRỰC TIẾP -->
<!-- ========================================================================= -->
<div class="modal fade" id="viewerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" style="height: 90vh;">
        <div class="modal-content h-100 border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white py-2">
                <h6 class="modal-title fw-bold" id="viewerModalTitle">
                    <i class="bi bi-file-earmark-text me-2"></i>Xem Tài Liệu
                </h6>
                <div class="d-flex gap-2">
                    <a id="viewerDownloadBtn" href="#" download class="btn btn-sm btn-outline-light">
                        <i class="bi bi-download me-1"></i> Tải Về
                    </a>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
            </div>
            <div class="modal-body p-0 bg-secondary-subtle d-flex justify-content-center align-items-center" style="height: calc(100% - 50px);">
                <iframe id="pdfViewerFrame" class="w-100 h-100 d-none border-0" src=""></iframe>
                <div id="officeNotice" class="text-center p-4 d-none bg-white rounded-4 shadow-sm" style="max-width: 500px;">
                    <i class="bi bi-file-earmark-spreadsheet display-3 text-success d-block mb-3"></i>
                    <h5 class="fw-bold mb-2" id="officeFileName">Tài Liệu Văn Bản</h5>
                    <p class="text-muted small mb-4">File này là định dạng Word/Excel. Bạn có thể tải về máy để xem với đầy đủ định dạng gốc.</p>
                    <div class="d-flex justify-content-center gap-2">
                        <a id="officeDownloadLink" href="#" download class="btn btn-success rounded-pill px-4">
                            <i class="bi bi-download me-1"></i> Tải Về Máy
                        </a>
                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const selectedClassId = @selectedClassId;
        const currentYearId = @(currentYear?.Id ?? 0);

        function getCsrfToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        // =========================================================================
        // 1. CHỈNH SỬA & BIÊN TẬP TRỰC TUYẾN TRÊN TRÌNH DUYỆT (TASK-P5-07.3)
        // =========================================================================

        function updateStats() {
            const rows = document.querySelectorAll('#curriculumTableBody tr.curriculum-row');
            let examCount = 0;
            let offCount = 0;

            rows.forEach(r => {
                const examCheck = r.querySelector('.row-exam-check');
                const offCheck = r.querySelector('.row-off-check');
                if (examCheck && examCheck.checked) examCount++;
                if (offCheck && offCheck.checked) offCount++;
            });

            document.getElementById('statTotalWeeks').innerText = rows.length;
            document.getElementById('statExamDays').innerText = examCount;
            document.getElementById('statOffDays').innerText = offCount;
        }

        function onTypeToggle(checkbox) {
            const row = checkbox.closest('tr');
            const examCheck = row.querySelector('.row-exam-check');
            const offCheck = row.querySelector('.row-off-check');

            row.classList.remove('table-danger-subtle', 'table-warning-subtle');
            if (checkbox === examCheck && examCheck.checked) {
                offCheck.checked = false;
                row.classList.add('table-danger-subtle');
            } else if (checkbox === offCheck && offCheck.checked) {
                examCheck.checked = false;
                row.classList.add('table-warning-subtle');
            }
            updateStats();
        }

        function addNewRow(item = null) {
            const tbody = document.getElementById('curriculumTableBody');
            const emptyRow = document.getElementById('emptyCurriculumRow');
            if (emptyRow) emptyRow.remove();

            const rows = tbody.querySelectorAll('tr.curriculum-row');
            const nextIdx = rows.length;
            const nextWeek = nextIdx + 1;

            let prevDateStr = '';
            if (rows.length > 0) {
                const lastRowDate = rows[rows.length - 1].querySelector('.row-date').value;
                if (lastRowDate) {
                    const d = new Date(lastRowDate);
                    d.setDate(d.getDate() + 7);
                    prevDateStr = d.toISOString().split('T')[0];
                }
            }

            const week = item?.weekNumber || nextWeek;
            const dateVal = item?.lessonDate ? item.lessonDate.substring(0, 10) : (item?.lessonDateStr ? parseDateToIso(item.lessonDateStr) : prevDateStr);
            const liturgical = item?.liturgicalDay || 'Chúa Nhật';
            const code = item?.lessonCode || `Bài ${week}`;
            const topic = item?.topicTitle || '';
            const keyPoints = item?.keyPoints || '';
            const teacher = item?.assignedTeacherName || '';
            const isExam = item?.isExamDay || false;
            const isOff = item?.isDayOff || false;
            const notes = item?.eventNotes || '';

            const rowClass = isExam ? 'table-danger-subtle' : (isOff ? 'table-warning-subtle' : '');

            const tr = document.createElement('tr');
            tr.className = `curriculum-row ${rowClass}`;
            tr.setAttribute('data-index', nextIdx);
            tr.innerHTML = `
                <td class="text-center">
                    <input type="number" class="form-control form-control-sm text-center fw-bold row-week" value="${week}" min="1" max="60" />
                </td>
                <td>
                    <input type="date" class="form-control form-control-sm row-date" value="${dateVal}" />
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm row-liturgical" value="${escapeHtml(liturgical)}" placeholder="CN 24 TN..." />
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm row-code fw-semibold text-primary" value="${escapeHtml(code)}" placeholder="Bài 1..." />
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm fw-bold row-topic" value="${escapeHtml(topic)}" placeholder="Tiêu đề bài học..." required />
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm row-key" value="${escapeHtml(keyPoints)}" placeholder="Ý chính..." />
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm row-teacher" value="${escapeHtml(teacher)}" placeholder="GLV..." />
                </td>
                <td class="text-center">
                    <div class="d-flex justify-content-center gap-1">
                        <input type="checkbox" class="btn-check row-exam-check" id="exam_check_dyn_${nextIdx}" autocomplete="off" ${isExam ? 'checked' : ''} onchange="onTypeToggle(this)" />
                        <label class="btn btn-sm btn-outline-danger p-1" for="exam_check_dyn_${nextIdx}" title="Kiểm tra / Thi">
                            <i class="bi bi-pencil-fill"></i> Thi
                        </label>

                        <input type="checkbox" class="btn-check row-off-check" id="off_check_dyn_${nextIdx}" autocomplete="off" ${isOff ? 'checked' : ''} onchange="onTypeToggle(this)" />
                        <label class="btn btn-sm btn-outline-warning p-1" for="off_check_dyn_${nextIdx}" title="Nghỉ lễ">
                            <i class="bi bi-cup-hot-fill"></i> Nghỉ
                        </label>
                    </div>
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm row-notes" value="${escapeHtml(notes)}" placeholder="Ghi chú..." />
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="deleteRow(this)" title="Xóa tuần này">
                        <i class="bi bi-trash3-fill fs-6"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(tr);
            updateStats();
        }

        function deleteRow(btn) {
            const tr = btn.closest('tr');
            tr.remove();
            renumberWeeks();
            updateStats();
        }

        function renumberWeeks() {
            const rows = document.querySelectorAll('#curriculumTableBody tr.curriculum-row');
            rows.forEach((r, idx) => {
                const weekInput = r.querySelector('.row-week');
                if (weekInput) weekInput.value = idx + 1;
            });
        }

        function autoFillConsecutiveSundays() {
            const rows = document.querySelectorAll('#curriculumTableBody tr.curriculum-row');
            if (rows.length === 0) {
                alert('Chưa có dòng nào trong bảng kế hoạch.');
                return;
            }

            const firstDateInput = rows[0].querySelector('.row-date');
            if (!firstDateInput.value) {
                alert('Vui lòng chọn ngày học cho Tuần 1 trước khi tự động điền.');
                firstDateInput.focus();
                return;
            }

            let cur = new Date(firstDateInput.value);
            for (let i = 1; i < rows.length; i++) {
                cur.setDate(cur.getDate() + 7);
                const iso = cur.toISOString().split('T')[0];
                rows[i].querySelector('.row-date').value = iso;
            }
            alert(`Đã tự động tính chuỗi Chúa Nhật cho ${rows.length} tuần học!`);
        }

        function parseDateToIso(str) {
            if (!str) return '';
            const parts = str.split('/');
            if (parts.length === 3) {
                const day = parts[0].padStart(2, '0');
                const month = parts[1].padStart(2, '0');
                const year = parts[2];
                return `${year}-${month}-${day}`;
            }
            return '';
        }

        function escapeHtml(text) {
            if (!text) return '';
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
        }

        // =========================================================================
        // 2. BỘ ĐỌC NẠP TỆP (.xlsx, .docx, .csv, .md, .pdf) (TASK-P5-07.2)
        // =========================================================================

        async function submitParseFile() {
            const fileInput = document.getElementById('inputCurriculumParserFile');
            if (!fileInput.files || fileInput.files.length === 0) {
                alert('Vui lòng chọn 1 tệp kế hoạch để nạp!');
                return;
            }

            const formData = new FormData();
            formData.append('file', fileInput.files[0]);

            const progress = document.getElementById('parseProgressAlert');
            progress.classList.remove('d-none');

            try {
                const res = await fetch('/LessonPlans/ParseCurriculumFile', {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': getCsrfToken() },
                    body: formData
                });
                const result = await res.json();
                progress.classList.add('d-none');

                if (result.success && result.items && result.items.length > 0) {
                    if (confirm(`Đã bóc tách thành công ${result.items.length} tuần học từ file!\nBạn có muốn nạp dữ liệu này vào bảng biên tập trên web không? (Dữ liệu cũ trên bảng sẽ được cập nhật lại)`)) {
                        const tbody = document.getElementById('curriculumTableBody');
                        tbody.innerHTML = '';
                        result.items.forEach(it => addNewRow(it));
                        bootstrap.Modal.getInstance(document.getElementById('parserModal')).hide();
                        alert(`Đã nạp thành công ${result.items.length} tuần học! Hãy kiểm tra và bấm "Lưu Phiên Bản Mới".`);
                    }
                } else {
                    alert('Không thể nạp file: ' + (result.message || 'Cấu trúc file chưa đúng định dạng.'));
                }
            } catch (err) {
                progress.classList.add('d-none');
                alert('Lỗi kết nối khi nạp file: ' + err.message);
            }
        }

        // =========================================================================
        // 3. LƯU PHIÊN BẢN MỚI & TỰ ĐỘNG XUẤT FILE ĐÍNH KÈM (TASK-P5-07.3)
        // =========================================================================

        function openSaveModal() {
            const rows = document.querySelectorAll('#curriculumTableBody tr.curriculum-row');
            if (rows.length === 0) {
                alert('Vui lòng thêm ít nhất 1 tuần học vào kế hoạch trước khi lưu!');
                return;
            }
            bootstrap.Modal.getOrCreateInstance(document.getElementById('saveVersionModal')).show();
        }

        async function submitSaveCurriculum() {
            const rows = document.querySelectorAll('#curriculumTableBody tr.curriculum-row');
            const items = [];

            let hasError = false;
            rows.forEach((r, idx) => {
                const week = parseInt(r.querySelector('.row-week').value) || (idx + 1);
                const dateVal = r.querySelector('.row-date').value;
                const liturgical = r.querySelector('.row-liturgical').value.trim();
                const code = r.querySelector('.row-code').value.trim();
                const topic = r.querySelector('.row-topic').value.trim();
                const keyPoints = r.querySelector('.row-key').value.trim();
                const teacher = r.querySelector('.row-teacher').value.trim();
                const isExam = r.querySelector('.row-exam-check').checked;
                const isOff = r.querySelector('.row-off-check').checked;
                const notes = r.querySelector('.row-notes').value.trim();

                if (!topic) {
                    r.querySelector('.row-topic').classList.add('is-invalid');
                    hasError = true;
                } else {
                    r.querySelector('.row-topic').classList.remove('is-invalid');
                }

                items.push({
                    weekNumber: week,
                    lessonDate: dateVal ? dateVal + 'T00:00:00Z' : null,
                    liturgicalDay: liturgical,
                    lessonCode: code,
                    topicTitle: topic,
                    keyPoints: keyPoints,
                    assignedTeacherName: teacher,
                    isExamDay: isExam,
                    isDayOff: isOff,
                    eventNotes: notes
                });
            });

            if (hasError) {
                alert('Vui lòng nhập tên chủ đề bài giảng cho tất cả các tuần!');
                return;
            }

            const title = document.getElementById('inputSaveTitle').value.trim();
            const changeSummary = document.getElementById('inputChangeSummary').value.trim();
            const progress = document.getElementById('saveProgressAlert');
            progress.classList.remove('d-none');

            const payload = {
                classRoomId: selectedClassId,
                academicYearId: currentYearId,
                title: title,
                changeSummary: changeSummary,
                items: items
            };

            try {
                const res = await fetch('/LessonPlans/SaveCurriculum', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': getCsrfToken()
                    },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                progress.classList.add('d-none');

                if (result.success) {
                    alert(result.message);
                    location.reload();
                } else {
                    alert('Lỗi lưu kế hoạch: ' + result.message);
                }
            } catch (err) {
                progress.classList.add('d-none');
                alert('Lỗi kết nối máy chủ: ' + err.message);
            }
        }

        // =========================================================================
        // 4. LỊCH SỬ PHIÊN BẢN & KHÔI PHỤC (ROLLBACK) (TASK-P5-07.4)
        // =========================================================================

        async function viewVersionDetail(versionId, versionTag, fileName) {
            document.getElementById('versionDetailTitle').innerHTML = `
                <i class="bi bi-clock-history me-2"></i>Bản Chụp Phiên Bản: <span class="badge bg-primary ms-1">${versionTag}</span> (${fileName})
            `;
            document.getElementById('versionDetailDownloadBtn').href = `/LessonPlans/DownloadCurriculumVersion/${versionId}`;

            const tbody = document.getElementById('versionDetailTableBody');
            tbody.innerHTML = `<tr><td colspan="9" class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></td></tr>`;

            bootstrap.Modal.getOrCreateInstance(document.getElementById('versionDetailModal')).show();

            try {
                const res = await fetch(`/LessonPlans/GetVersionDetail/${versionId}`);
                const data = await res.json();
                if (data.success && data.data && data.data.items) {
                    tbody.innerHTML = '';
                    data.data.items.forEach(it => {
                        const tr = document.createElement('tr');
                        if (it.isExamDay) tr.className = 'table-danger-subtle';
                        else if (it.isDayOff) tr.className = 'table-warning-subtle';

                        tr.innerHTML = `
                            <td class="text-center fw-bold">${it.weekNumber}</td>
                            <td>${it.lessonDateStr || (it.lessonDate ? it.lessonDate.substring(0, 10) : '')}</td>
                            <td>${it.liturgicalDay || 'Chúa Nhật'}</td>
                            <td class="fw-semibold text-primary">${it.lessonCode || ''}</td>
                            <td class="fw-bold">${it.topicTitle || ''}</td>
                            <td class="small text-muted">${it.keyPoints || ''}</td>
                            <td>${it.assignedTeacherName || ''}</td>
                            <td class="text-center">
                                ${it.isExamDay ? '<span class="badge bg-danger">Kiểm Tra</span>' : (it.isDayOff ? '<span class="badge bg-warning text-dark">Nghỉ Lễ</span>' : '<span class="badge bg-light text-secondary border">Học</span>')}
                            </td>
                            <td class="small">${it.eventNotes || ''}</td>
                        `;
                        tbody.appendChild(tr);
                    });
                } else {
                    tbody.innerHTML = `<tr><td colspan="9" class="text-center py-4 text-danger">Không thể tải nội dung phiên bản này.</td></tr>`;
                }
            } catch (err) {
                tbody.innerHTML = `<tr><td colspan="9" class="text-center py-4 text-danger">Lỗi kết nối: ${err.message}</td></tr>`;
            }
        }

        async function rollbackVersion(documentId, versionId, versionTag) {
            if (!confirm(`Bạn có chắc chắn muốn KHÔI PHỤC kế hoạch lớp về phiên bản "${versionTag}"?\n\nHệ thống sẽ khôi phục toàn bộ bài học của phiên bản này và tạo ra một phiên bản mới để ghi nhận lịch sử.`)) {
                return;
            }

            const formData = new FormData();
            formData.append('documentId', documentId);
            formData.append('versionId', versionId);

            try {
                const res = await fetch('/LessonPlans/RollbackCurriculum', {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': getCsrfToken() },
                    body: formData
                });
                const result = await res.json();
                if (result.success) {
                    alert(result.message);
                    location.reload();
                } else {
                    alert('Lỗi khôi phục: ' + result.message);
                }
            } catch (err) {
                alert('Lỗi kết nối: ' + err.message);
            }
        }

        // =========================================================================
        // 5. LEGACY DOCUMENT VIEWER & UPLOADER
        // =========================================================================

        async function submitUploadLegacyDocument() {
            const fileInput = document.getElementById('inputLegacyFile');
            const desc = document.getElementById('inputLegacyDesc').value.trim();

            if (!fileInput.files || fileInput.files.length === 0) {
                alert('Vui lòng chọn 1 file để tải lên!');
                return;
            }

            const formData = new FormData();
            formData.append('file', fileInput.files[0]);
            formData.append('classRoomId', selectedClassId);
            formData.append('description', desc);

            try {
                const res = await fetch('/LessonPlans/UploadDocument', {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': getCsrfToken() },
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            } catch (err) {
                alert('Lỗi kết nối: ' + err.message);
            }
        }

        function viewDocumentOnline(filePath, fileName, ext) {
            document.getElementById('viewerModalTitle').innerText = fileName;
            document.getElementById('viewerDownloadBtn').href = filePath;
            document.getElementById('viewerDownloadBtn').download = fileName;

            const pdfFrame = document.getElementById('pdfViewerFrame');
            const officeNotice = document.getElementById('officeNotice');

            if (ext === '.pdf') {
                officeNotice.classList.add('d-none');
                pdfFrame.classList.remove('d-none');
                pdfFrame.src = filePath + "#toolbar=1&navpanes=0";
            } else {
                pdfFrame.classList.add('d-none');
                pdfFrame.src = "";
                officeNotice.classList.remove('d-none');
                document.getElementById('officeFileName').innerText = fileName;
                document.getElementById('officeDownloadLink').href = filePath;
                document.getElementById('officeDownloadLink').download = fileName;
            }

            bootstrap.Modal.getOrCreateInstance(document.getElementById('viewerModal')).show();
        }

        async function deleteLegacyDocument(docId, fileName) {
            if (!confirm(`Bạn có chắc chắn muốn xóa file "${fileName}"?`)) return;

            const formData = new FormData();
            formData.append('documentId', docId);

            try {
                const res = await fetch('/LessonPlans/DeleteDocument', {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': getCsrfToken() },
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            } catch (err) {
                alert('Lỗi kết nối: ' + err.message);
            }
        }
    </script>
}
