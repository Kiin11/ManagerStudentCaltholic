@model IEnumerable<ManagerStudentCaltholic.Models.Entities.ClassLessonPlan>
@{
    ViewData["Title"] = "Kế Hoạch Giảng Dạy Năm Học";
    var classes = ViewBag.Classes as List<ManagerStudentCaltholic.Models.Entities.ClassRoom> ?? new();
    var selectedClassId = (int)ViewBag.SelectedClassId;
    var currentYear = ViewBag.CurrentYear as ManagerStudentCaltholic.Models.Entities.AcademicYear;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-calendar3 me-2"></i>Kế Hoạch & Bài Giảng Theo Tuần
            </h3>
            <p class="text-muted mb-0">Niên khóa: <strong>@(currentYear?.Name ?? "Hiện hành")</strong> | Theo dõi lộ trình bài giảng và phân công giáo lý viên</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/Facilities" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Quay lại Sơ Đồ Phòng
            </a>
        </div>
    </div>

    <!-- Bộ lọc Lớp -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="LessonPlans" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <label class="form-label small fw-bold text-secondary mb-1">Chọn Lớp Giáo Lý:</label>
                    <select name="classRoomId" class="form-select fw-semibold" onchange="this.form.submit()">
                        @foreach (var c in classes)
                        {
                            <!option value="@c.Id" @(c.Id == selectedClassId ? "selected" : "")>
                            @c.Name (@c.GradeLevel)
                            </!option>
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng Kế Hoạch Năm Học -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th class="ps-3" style="width: 140px;">Ngày Học</th>
                        <th style="width: 120px;">Bài Học</th>
                        <th>Chủ Đề & Đoạn Kinh Thánh</th>
                        <th>Ý Chính Bài Học</th>
                        <th style="width: 150px;">GLV Phụ Trách</th>
                        <th>Ghi Chú Mục Vụ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="@(item.IsExamDay ? "table-warning" : item.IsDayOff ? "table-secondary text-muted" : "")">
                                <td class="ps-3 fw-bold">
                                    @item.LessonDate.ToString("dd/MM/yyyy")
                                    <div class="small text-muted font-normal">@item.LiturgicalDay</div>
                                </td>
                                <td>
                                    <span class="badge @(item.IsExamDay ? "bg-danger" : "bg-primary-subtle text-primary") rounded-pill px-2 py-1">
                                        @(string.IsNullOrEmpty(item.LessonCode) ? "Sinh hoạt" : item.LessonCode)
                                    </span>
                                </td>
                                <td class="fw-semibold">@item.TopicTitle</td>
                                <td class="small text-secondary" style="max-width: 320px;">@(item.KeyPoints ?? "-")</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-person me-1"></i>@(item.AssignedTeacherName ?? "Cả khối")
                                    </span>
                                </td>
                                <td class="small text-danger">@(item.EventNotes ?? "")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>
                                Chưa có dữ liệu kế hoạch giảng dạy cho lớp này trong niên khóa.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>