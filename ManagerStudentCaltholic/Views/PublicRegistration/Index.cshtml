@using ManagerStudentCaltholic.Extensions
@{
    ViewData["Title"] = "Đăng Ký Nhập Học Giáo Lý Trực Tuyến";
    bool isMobile = Context.Request.IsMobileDevice();
}

@Html.AntiForgeryToken()

<style>
    .upload-dropzone {
        transition: all 0.2s ease;
        border-color: #cbd5e1 !important;
    }
    .upload-dropzone:hover, .upload-dropzone:active {
        border-color: var(--bs-primary) !important;
        background-color: #f1f5f9 !important;
    }
    .form-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        padding-bottom: 8px;
        margin-bottom: 16px;
        border-bottom: 1px solid #e2e8f0;
    }
    .form-section-badge {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
        background: #1e40af;
        color: #ffffff;
        flex-shrink: 0;
    }
    @@media (max-width: 768px) {
        form input, form select, form textarea {
            font-size: 16px !important;
        }
        .mobile-reg-form-card {
            border: 1px solid #e2e8f0;
        }
    }
</style>

<div class="@(isMobile ? "container-fluid px-2 py-2" : "container py-4")">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            @if (isMobile)
            {
                <!-- THANH ĐIỀU HƯỚNG & TIÊU ĐỀ TRÊN MOBILE -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-1 small fw-semibold">
                            <i class="bi bi-mortarboard-fill me-1"></i>Tuyển Sinh Giáo Lý
                        </span>
                        <a asp-action="CheckStatus" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1 fw-semibold">
                            <i class="bi bi-search me-1"></i> Tra cứu hồ sơ
                        </a>
                    </div>
                    <div class="card border-0 shadow-sm rounded-4 bg-primary text-white p-3 mb-3">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi bi-journal-plus fs-4"></i>
                            <h5 class="fw-bold mb-0">Đăng Ký Học Giáo Lý (@ViewBag.CurrentYearName)</h5>
                        </div>
                        <p class="small text-white-50 mb-0">
                            Phụ huynh điền đầy đủ thông tin bên dưới và chụp ảnh Giấy Rửa Tội (Sổ Gia Đình Công Giáo).
                        </p>
                    </div>
                </div>
            }
            else
            {
                <!-- TIÊU ĐỀ TRÊN DESKTOP -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h4 class="fw-bold text-primary mb-1">
                            <i class="bi bi-journal-plus me-2"></i>Cổng Tuyển Sinh Giáo Lý Đầu Năm (@ViewBag.CurrentYearName)
                        </h4>
                        <p class="text-muted small mb-0">Phụ huynh điền đầy đủ thông tin và đính kèm ảnh chụp Giấy Chứng Nhận Rửa Tội.</p>
                    </div>
                    <a asp-action="CheckStatus" class="btn btn-outline-primary rounded-pill px-3 fw-semibold">
                        <i class="bi bi-search me-1"></i> Tra cứu kết quả hồ sơ
                    </a>
                </div>
            }

            <div class="card border-0 shadow-sm rounded-4 @(isMobile ? "mobile-reg-form-card" : "")">
                <div class="card-body @(isMobile ? "p-3" : "p-4")">
                    <form id="publicRegForm" enctype="multipart/form-data">
                        <!-- Honeypot chống Bot tự động -->
                        <div class="d-none" aria-hidden="true">
                            <input type="text" name="WebsiteUrlHoneypot" tabindex="-1" autocomplete="off" />
                        </div>

                        <!-- 1. THÔNG TIN THIẾU NHI -->
                        <div class="form-section-title">
                            <span class="form-section-badge">1</span>
                            <h6 class="fw-bold text-uppercase text-dark mb-0" style="letter-spacing: 0.03em;">
                                Thông tin Thiếu Nhi
                            </h6>
                        </div>

                        <div class="row g-2 g-md-3 mb-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold small">Tên Thánh <span class="text-danger">*</span></label>
                                <input type="text" name="ChristianName" class="form-control" placeholder="VD: Giuse, Maria..." required />
                            </div>
                            <div class="col-12 col-md-5">
                                <label class="form-label fw-semibold small">Họ và tên đệm <span class="text-danger">*</span></label>
                                <input type="text" name="FirstName" class="form-control" placeholder="VD: Nguyễn Văn" required />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label fw-semibold small">Tên gọi <span class="text-danger">*</span></label>
                                <input type="text" name="LastName" class="form-control" placeholder="VD: An" required />
                            </div>
                        </div>

                        <div class="row g-2 g-md-3 mb-3">
                            <div class="col-6 col-md-3">
                                <label class="form-label fw-semibold small">Giới tính <span class="text-danger">*</span></label>
                                <select name="Gender" class="form-select">
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label fw-semibold small">Ngày sinh <span class="text-danger">*</span></label>
                                <input type="date" name="DateOfBirth" id="inputDob" class="form-control" onchange="suggestGradeByAge()" required />
                            </div>
                            <div class="col-12 col-md-5">
                                <label class="form-label fw-semibold small">Khối đăng ký dự kiến <span class="text-danger">*</span></label>
                                <select name="TargetGradeLevel" id="selectTargetGrade" class="form-select">
                                    <option value="Khai Tâm">Khối Khai Tâm (6 - 8 tuổi)</option>
                                    <option value="Rước Lễ">Khối Rước Lễ (9 - 11 tuổi)</option>
                                    <option value="Thêm Sức">Khối Thêm Sức (12 - 14 tuổi)</option>
                                    <option value="Bao Đồng">Khối Bao Đồng (15 - 17 tuổi)</option>
                                </select>
                                <div id="ageHint" class="small text-primary fw-semibold mt-1"></div>
                            </div>
                        </div>

                        <div class="row g-2 g-md-3 mb-4">
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold small">Phân loại hồ sơ</label>
                                <select name="RegistrationType" class="form-select">
                                    <option value="NEW">Học mới đầu cấp</option>
                                    <option value="TRANSFER">Chuyển xứ đến</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold small">Ngày Rửa Tội</label>
                                <input type="date" name="BaptismDate" class="form-control" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold small">Tại Giáo xứ</label>
                                <input type="text" name="BaptismParish" class="form-control" placeholder="VD: GX Phú Trung" />
                            </div>
                        </div>

                        <!-- 2. THÔNG TIN PHỤ HUYNH & ĐỊA CHỈ -->
                        <div class="form-section-title">
                            <span class="form-section-badge">2</span>
                            <h6 class="fw-bold text-uppercase text-dark mb-0" style="letter-spacing: 0.03em;">
                                Thông tin Phụ huynh &amp; Địa chỉ cư ngụ
                            </h6>
                        </div>

                        <div class="row g-2 g-md-3 mb-3">
                            <div class="col-12 col-md-5">
                                <label class="form-label fw-semibold small">Họ tên Cha/Mẹ (Người giám hộ) <span class="text-danger">*</span></label>
                                <input type="text" name="ParentFullName" class="form-control" placeholder="Họ tên phụ huynh" required />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold small">SĐT Liên hệ (Zalo) <span class="text-danger">*</span></label>
                                <input type="tel" name="ParentPhone" inputmode="tel" class="form-control" placeholder="09xxxxxxxx" required />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label fw-semibold small">Giáo khu</label>
                                <input type="text" name="ParishSubDivision" class="form-control" placeholder="VD: Giáo khu Phero" />
                            </div>
                        </div>

                        <div class="row g-2 g-md-3 mb-4">
                            <div class="col-12 col-md-8">
                                <label class="form-label fw-semibold small">Địa chỉ hiện tại</label>
                                <input type="text" name="Address" class="form-control" placeholder="Số nhà, đường, phường/xã..." />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold small">Email Phụ huynh (Tùy chọn)</label>
                                <input type="email" name="ParentEmail" class="form-control" placeholder="email@example.com" />
                            </div>
                        </div>

                        <!-- 3. ĐÍNH KÈM CHỨNG NHẬN RỬA TỘI -->
                        <div class="form-section-title">
                            <span class="form-section-badge">3</span>
                            <h6 class="fw-bold text-uppercase text-dark mb-0" style="letter-spacing: 0.03em;">
                                Đính kèm Giấy Chứng Nhận Rửa Tội
                            </h6>
                        </div>

                        <div class="mb-4">
                            <!-- Khung Chọn / Chụp Ảnh Chạm Nhanh -->
                            <label for="inputCertFile" class="upload-dropzone p-3 text-center rounded-4 border border-2 border-dashed bg-light d-block cursor-pointer" style="cursor: pointer;">
                                <div class="py-2">
                                    <i class="bi bi-camera-fill fs-2 text-primary d-block mb-1"></i>
                                    <span class="fw-bold text-dark d-block">Chụp ảnh hoặc Chọn file Giấy Rửa Tội</span>
                                    <span class="small text-muted">Hỗ trợ ảnh chụp JPG, PNG hoặc file PDF (Tối đa 5MB, tự động tối ưu dung lượng)</span>
                                </div>
                            </label>
                            <input type="file" id="inputCertFile" accept=".jpg,.jpeg,.png,.pdf" class="form-control d-none" onchange="handleCertFileChange(this)" />

                            <!-- Khung Preview Ảnh hoặc PDF -->
                            <div id="certPreviewContainer" class="mt-3 d-none p-3 bg-light rounded-4 border text-center">
                                <div class="small fw-semibold text-secondary mb-2" id="certFileInfo"></div>
                                <img id="certImagePreview" src="#" alt="Xem trước Giấy Rửa Tội" class="img-fluid rounded-3 shadow-sm mb-2" style="max-height: 260px;" />
                                <div>
                                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="document.getElementById('inputCertFile').click()">
                                        <i class="bi bi-arrow-repeat me-1"></i> Chọn / Chụp ảnh khác
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" id="btnSubmitReg" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm touch-target-44">
                                <i class="bi bi-send-check-fill me-2"></i>Gửi Hồ Sơ Đăng Ký
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let processedUploadBlob = null;
        let processedFileName = '';

        // Tự động tính tuổi và gợi ý Khối Giáo lý phù hợp (TASK-P3-02.2)
        function suggestGradeByAge() {
            const dobVal = document.getElementById('inputDob').value;
            if (!dobVal) return;

            const birthYear = new Date(dobVal).getFullYear();
            const currentYear = new Date().getFullYear();
            const age = currentYear - birthYear;

            const gradeSelect = document.getElementById('selectTargetGrade');
            const hint = document.getElementById('ageHint');

            if (age >= 4 && age <= 20) {
                let suggested = 'Khai Tâm';
                if (age >= 9 && age <= 11) suggested = 'Rước Lễ';
                else if (age >= 12 && age <= 14) suggested = 'Thêm Sức';
                else if (age >= 15) suggested = 'Bao Đồng';

                gradeSelect.value = suggested;
                hint.innerHTML = `<span class="badge bg-primary-subtle text-primary border"><i class="bi bi-magic me-1"></i>~${age} tuổi &rarr; Gợi ý: Khối ${suggested}</span>`;
            } else {
                hint.innerHTML = '';
            }
        }

        // Xem trước ảnh & Nén ảnh phía Client bằng Canvas nếu ảnh chụp > 1.2MB (TASK-P3-02.2)
        async function handleCertFileChange(input) {
            const container = document.getElementById('certPreviewContainer');
            const imgPreview = document.getElementById('certImagePreview');
            const infoText = document.getElementById('certFileInfo');
            processedUploadBlob = null;

            if (!input.files || input.files.length === 0) {
                container.classList.add('d-none');
                return;
            }

            const file = input.files[0];
            processedFileName = file.name;

            if (file.type === 'application/pdf') {
                container.classList.remove('d-none');
                imgPreview.classList.add('d-none');
                infoText.textContent = `Đã chọn tệp PDF: ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`;
                return;
            }

            if (file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    imgPreview.src = e.target.result;
                    imgPreview.classList.remove('d-none');
                    container.classList.remove('d-none');
                };
                reader.readAsDataURL(file);

                // Nén ảnh nếu > 1.2 MB
                if (file.size > 1.2 * 1024 * 1024) {
                    infoText.textContent = 'Đang tối ưu dung lượng ảnh...';
                    processedUploadBlob = await compressImageClientSide(file, 1600, 0.82);
                    processedFileName = file.name.replace(/\.[^/.]+$/, ".jpg");
                    infoText.textContent = `Ảnh đã tối ưu: ${(processedUploadBlob.size / 1024).toFixed(0)} KB (Gốc: ${(file.size / 1024 / 1024).toFixed(2)} MB)`;
                } else {
                    infoText.textContent = `Đã chọn ảnh: ${file.name} (${(file.size / 1024).toFixed(0)} KB)`;
                }
            }
        }

        function compressImageClientSide(file, maxWidth, quality) {
            return new Promise((resolve) => {
                const img = new Image();
                img.onload = () => {
                    let width = img.width;
                    let height = img.height;
                    if (width > maxWidth) {
                        height = Math.round((height * maxWidth) / width);
                        width = maxWidth;
                    }
                    const canvas = document.createElement('canvas');
                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);
                    canvas.toBlob((blob) => resolve(blob || file), 'image/jpeg', quality);
                };
                img.src = URL.createObjectURL(file);
            });
        }

        document.getElementById('publicRegForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitReg');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang gửi hồ sơ...';

            const formData = new FormData(this);
            const fileInput = document.getElementById('inputCertFile');

            if (processedUploadBlob) {
                formData.set('CertificateFile', processedUploadBlob, processedFileName);
            } else if (fileInput.files.length > 0) {
                formData.set('CertificateFile', fileInput.files[0]);
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const response = await fetch('/PublicRegistration/Submit', {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': token
                    },
                    body: formData
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    window.location.href = result.redirectUrl || '/PublicRegistration/Success';
                } else {
                    alert(result.message || 'Không thể gửi đơn đăng ký. Vui lòng kiểm tra lại.');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-send-check-fill me-2"></i>Gửi Hồ Sơ Đăng Ký';
                }
            } catch (err) {
                alert('Lỗi kết nối máy chủ: ' + err.message);
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send-check-fill me-2"></i>Gửi Hồ Sơ Đăng Ký';
            }
        });
    </script>
}
