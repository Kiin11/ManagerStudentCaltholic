@model ManagerStudentCaltholic.Models.ViewModels.PublicRegistrationResubmitDto
@using ManagerStudentCaltholic.Extensions
@{
    ViewData["Title"] = $"Bổ Sung Hồ Sơ #{Model.Id} - {Model.ChristianName} {Model.FirstName} {Model.LastName}";
    bool isMobile = Context.Request.IsMobileDevice();
    bool hasExistingCert = !string.IsNullOrWhiteSpace(Model.ExistingCertificatePath);
    bool isExistingPdf = hasExistingCert && Model.ExistingCertificatePath!.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
    string existingCertUrl = Url.Action("ViewOwnCertificate", "PublicRegistration", new
    {
        id = Model.Id,
        phone = Model.OriginalParentPhone,
        dob = Model.OriginalDateOfBirth.ToString("yyyy-MM-dd")
    }) ?? "#";
}

@Html.AntiForgeryToken()

<style>
    .upload-dropzone {
        transition: all 0.2s ease;
        border-color: #cbd5e1 !important;
    }
    .upload-dropzone:hover, .upload-dropzone:active {
        border-color: var(--bs-primary) !important;
        background-color: #f1f5f9 !important;
    }
    .form-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        padding-bottom: 8px;
        margin-bottom: 16px;
        border-bottom: 1px solid #e2e8f0;
    }
    .form-section-badge {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        background: #1e40af;
        color: #ffffff;
        flex-shrink: 0;
    }
    @@media (max-width: 768px) {
        form input, form select, form textarea {
            font-size: 16px !important;
        }
        .mobile-resubmit-card {
            border: 1px solid #e2e8f0;
        }
    }
</style>

<div class="@(isMobile ? "container-fluid px-2 py-2" : "container py-4")">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            @if (isMobile)
            {
                <!-- ============================================================== -->
                <!-- HEADER & KHUNG YÊU CẦU BỔ SUNG TRÊN MOBILE WEB APP             -->
                <!-- ============================================================== -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <a asp-action="CheckStatus"
                           asp-route-phone="@Model.OriginalParentPhone"
                           asp-route-dob="@Model.OriginalDateOfBirth.ToString("yyyy-MM-dd")"
                           class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1 fw-semibold">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại tra cứu
                        </a>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 small fw-semibold">
                            <i class="bi bi-pencil-square me-1"></i>Hồ sơ #@Model.Id
                        </span>
                    </div>

                    <div class="card border-0 shadow-sm rounded-4 bg-danger bg-opacity-10 border border-danger border-opacity-25 p-3 mb-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-4"></i>
                            <div>
                                <h6 class="fw-bold text-danger mb-0">Bổ Sung &amp; Nộp Lại Hồ Sơ</h6>
                                <small class="text-dark fw-semibold">@Model.ChristianName @Model.FirstName @Model.LastName</small>
                            </div>
                        </div>
                        <div class="bg-white p-2 px-3 rounded-3 border border-danger border-opacity-25 small text-dark shadow-sm">
                            <div class="text-secondary fw-semibold mb-1" style="font-size: 0.72rem;">
                                YÊU CẦU TỪ BAN ĐIỀU HÀNH:
                            </div>
                            <div class="fw-semibold text-danger">
                                @(Model.RejectionReason ?? "Hồ sơ chưa đầy đủ thông tin hoặc ảnh chụp Giấy Rửa Tội chưa rõ nét.")
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- ============================================================== -->
                <!-- HEADER & KHUNG YÊU CẦU BỔ SUNG TRÊN DESKTOP WEB APP            -->
                <!-- ============================================================== -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h4 class="fw-bold text-dark mb-1">
                            <i class="bi bi-pencil-square text-danger me-2"></i>Bổ Sung &amp; Nộp Lại Hồ Sơ Tuyển Sinh (#@Model.Id)
                        </h4>
                        <p class="text-muted small mb-0">
                            Cập nhật thông tin theo yêu cầu của Ban Điều Hành và gửi lại xét duyệt (@ViewBag.CurrentYearName).
                        </p>
                    </div>
                    <a asp-action="CheckStatus"
                       asp-route-phone="@Model.OriginalParentPhone"
                       asp-route-dob="@Model.OriginalDateOfBirth.ToString("yyyy-MM-dd")"
                       class="btn btn-outline-secondary rounded-pill px-3 fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại kết quả tra cứu
                    </a>
                </div>

                <div class="card border-0 shadow-sm rounded-4 bg-danger bg-opacity-10 border border-danger border-opacity-25 p-4 mb-4">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-8">
                            <div class="fw-bold text-danger fs-6 mb-2">
                                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>Yêu cầu bổ sung thông tin từ Ban Điều Hành:
                            </div>
                            <div class="bg-white p-3 rounded-3 border border-danger border-opacity-25 shadow-sm text-dark fw-semibold">
                                @(Model.RejectionReason ?? "Hồ sơ chưa hợp lệ hoặc hình ảnh giấy chứng nhận Rửa Tội bị mờ/không rõ.")
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="bg-white p-3 rounded-3 border shadow-sm h-100 small">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Mã hồ sơ:</span>
                                    <strong class="font-monospace text-dark">#@Model.Id</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Ngày nộp đầu:</span>
                                    <strong class="text-dark">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
                                </div>
                                <hr class="my-2" />
                                <div class="text-muted" style="font-size: 0.78rem;">
                                    <i class="bi bi-check2-circle text-success me-1"></i>Sau khi nhấn <strong>Lưu bổ sung</strong>, hồ sơ sẽ tự động chuyển về trạng thái <strong>Chờ BĐH duyệt</strong>.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- ============================================================== -->
            <!-- BIỂU MẪU CẬP NHẬT & NỘP LẠI HỒ SƠ                              -->
            <!-- ============================================================== -->
            <div class="card border-0 shadow-sm rounded-4 @(isMobile ? "mobile-resubmit-card" : "")">
                <div class="card-body @(isMobile ? "p-3" : "p-4")">
                    <form id="resubmitRegForm" enctype="multipart/form-data">
                        <input type="hidden" name="Id" value="@Model.Id" />
                        <input type="hidden" name="OriginalParentPhone" value="@Model.OriginalParentPhone" />
                        <input type="hidden" name="OriginalDateOfBirth" value="@Model.OriginalDateOfBirth.ToString("yyyy-MM-dd")" />

                        <!-- Honeypot chống Bot tự động -->
                        <div class="d-none" aria-hidden="true">
                            <input type="text" name="WebsiteUrlHoneypot" tabindex="-1" autocomplete="off" />
                        </div>

                        <!-- 1. THÔNG TIN THIẾU NHI -->
                        <div class="form-section-title">
                            <span class="form-section-badge">1</span>
                            <h6 class="fw-bold text-uppercase text-dark mb-0" style="letter-spacing: 0.03em;">
                                Thông tin Thiếu Nhi
                            </h6>
                        </div>

                        <div class="row g-2 g-md-3 mb-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold small">Tên Thánh <span class="text-danger">*</span></label>
                                <input type="text" name="ChristianName" class="form-control" value="@Model.ChristianName" placeholder="VD: Giuse, Maria..." required />
                            </div>
                            <div class="col-12 col-md-5">
                                <label class="form-label fw-semibold small">Họ và tên đệm <span class="text-danger">*</span></label>
                                <input type="text" name="FirstName" class="form-control" value="@Model.FirstName" placeholder="VD: Nguyễn Văn" required />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label fw-semibold small">Tên gọi <span class="text-danger">*</span></label>
                                <input type="text" name="LastName" class="form-control" value="@Model.LastName" placeholder="VD: An" required />
                            </div>
                        </div>

                        <div class="row g-2 g-md-3 mb-3">
                            <div class="col-6 col-md-3">
                                <label class="form-label fw-semibold small">Giới tính <span class="text-danger">*</span></label>
                                <select name="Gender" class="form-select">
                                    <option value="Nam" selected="@(Model.Gender != "Nữ")">Nam</option>
                                    <option value="Nữ" selected="@(Model.Gender == "Nữ")">Nữ</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label fw-semibold small">Ngày sinh <span class="text-danger">*</span></label>
                                <input type="date" name="DateOfBirth" id="inputDob" class="form-control" value="@Model.DateOfBirth.ToString("yyyy-MM-dd")" onchange="suggestGradeByAge()" required />
                            </div>
                            <div class="col-12 col-md-5">
                                <label class="form-label fw-semibold small">Khối đăng ký dự kiến <span class="text-danger">*</span></label>
                                <select name="TargetGradeLevel" id="selectTargetGrade" class="form-select">
                                    <option value="Khai Tâm" selected="@(Model.TargetGradeLevel == "Khai Tâm")">Khối Khai Tâm (6 - 8 tuổi)</option>
                                    <option value="Rước Lễ" selected="@(Model.TargetGradeLevel == "Rước Lễ")">Khối Rước Lễ (9 - 11 tuổi)</option>
                                    <option value="Thêm Sức" selected="@(Model.TargetGradeLevel == "Thêm Sức")">Khối Thêm Sức (12 - 14 tuổi)</option>
                                    <option value="Bao Đồng" selected="@(Model.TargetGradeLevel == "Bao Đồng")">Khối Bao Đồng (15 - 17 tuổi)</option>
                                </select>
                                <div id="ageHint" class="small text-primary fw-semibold mt-1"></div>
                            </div>
                        </div>

                        <div class="row g-2 g-md-3 mb-4">
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold small">Phân loại hồ sơ</label>
                                <select name="RegistrationType" class="form-select">
                                    <option value="NEW" selected="@(Model.RegistrationType != "TRANSFER")">Học mới đầu cấp</option>
                                    <option value="TRANSFER" selected="@(Model.RegistrationType == "TRANSFER")">Chuyển xứ đến</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold small">Ngày Rửa Tội</label>
                                <input type="date" name="BaptismDate" class="form-control" value="@(Model.BaptismDate?.ToString("yyyy-MM-dd"))" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold small">Tại Giáo xứ</label>
                                <input type="text" name="BaptismParish" class="form-control" value="@Model.BaptismParish" placeholder="VD: GX Phú Trung" />
                            </div>
                        </div>

                        <!-- 2. THÔNG TIN PHỤ HUYNH & ĐỊA CHỈ -->
                        <div class="form-section-title">
                            <span class="form-section-badge">2</span>
                            <h6 class="fw-bold text-uppercase text-dark mb-0" style="letter-spacing: 0.03em;">
                                Thông tin Phụ huynh &amp; Địa chỉ cư ngụ
                            </h6>
                        </div>

                        <div class="row g-2 g-md-3 mb-3">
                            <div class="col-12 col-md-5">
                                <label class="form-label fw-semibold small">Họ tên Cha/Mẹ (Người giám hộ) <span class="text-danger">*</span></label>
                                <input type="text" name="ParentFullName" class="form-control" value="@Model.ParentFullName" placeholder="Họ tên phụ huynh" required />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold small">SĐT Liên hệ (Zalo) <span class="text-danger">*</span></label>
                                <input type="tel" name="ParentPhone" inputmode="tel" class="form-control" value="@Model.ParentPhone" placeholder="09xxxxxxxx" required />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label fw-semibold small">Giáo khu</label>
                                <input type="text" name="ParishSubDivision" class="form-control" value="@Model.ParishSubDivision" placeholder="VD: Giáo khu Phero" />
                            </div>
                        </div>

                        <div class="row g-2 g-md-3 mb-4">
                            <div class="col-12 col-md-8">
                                <label class="form-label fw-semibold small">Địa chỉ hiện tại</label>
                                <input type="text" name="Address" class="form-control" value="@Model.Address" placeholder="Số nhà, đường, phường/xã..." />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold small">Email Phụ huynh (Tùy chọn)</label>
                                <input type="email" name="ParentEmail" class="form-control" value="@Model.ParentEmail" placeholder="email@example.com" />
                            </div>
                        </div>

                        <!-- 3. ĐÍNH KÈM / CẬP NHẬT CHỨNG NHẬN RỬA TỘI -->
                        <div class="form-section-title">
                            <span class="form-section-badge">3</span>
                            <h6 class="fw-bold text-uppercase text-dark mb-0" style="letter-spacing: 0.03em;">
                                Giấy Chứng Nhận Rửa Tội (Sổ Gia Đình Công Giáo)
                            </h6>
                        </div>

                        <div class="mb-4">
                            @if (hasExistingCert)
                            {
                                <div class="p-3 rounded-4 bg-info bg-opacity-10 border border-info border-opacity-25 mb-3">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-paperclip me-1"></i>Đã có chứng từ đính kèm trước đó
                                        </span>
                                        <a href="@existingCertUrl" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1">
                                            <i class="bi bi-eye me-1"></i> Xem chứng từ đã nộp
                                        </a>
                                    </div>
                                    @if (!isExistingPdf)
                                    {
                                        <div class="text-center my-2">
                                            <img src="@existingCertUrl" alt="Giấy Rửa Tội đã nộp" class="img-fluid rounded-3 border shadow-sm bg-white p-1" style="max-height: 180px;" />
                                        </div>
                                    }
                                    <div class="small text-muted">
                                        <i class="bi bi-info-circle me-1"></i>Nếu ảnh trên bị mờ hoặc Ban Điều Hành yêu cầu chụp lại, phụ huynh hãy bấm vào khung bên dưới để <strong>chụp hoặc tải lên ảnh mới thay thế</strong>. Nếu không chọn tệp mới, hệ thống sẽ giữ nguyên tệp cũ.
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning border-0 rounded-4 small py-2 px-3 mb-3">
                                    <i class="bi bi-exclamation-circle-fill me-1"></i>Hồ sơ hiện chưa có ảnh chụp Giấy Chứng Nhận Rửa Tội. Vui lòng chụp hoặc chọn tệp đính kèm bên dưới.
                                </div>
                            }

                            <!-- Khung Chọn / Chụp Ảnh Mới -->
                            <label for="inputCertFile" class="upload-dropzone p-3 text-center rounded-4 border border-2 border-dashed bg-light d-block cursor-pointer" style="cursor: pointer;">
                                <div class="py-2">
                                    <i class="bi bi-camera-fill fs-2 text-primary d-block mb-1"></i>
                                    <span class="fw-bold text-dark d-block">
                                        @(hasExistingCert ? "Chụp ảnh mới hoặc Chọn tệp thay thế Giấy Rửa Tội" : "Chụp ảnh hoặc Chọn tệp Giấy Rửa Tội")
                                    </span>
                                    <span class="small text-muted">Hỗ trợ ảnh chụp JPG, PNG hoặc file PDF (Tối đa 5MB, tự động tối ưu dung lượng)</span>
                                </div>
                            </label>
                            <input type="file" id="inputCertFile" accept=".jpg,.jpeg,.png,.pdf" class="form-control d-none" onchange="handleCertFileChange(this)" />

                            <!-- Khung Preview Ảnh hoặc PDF Mới Chọn -->
                            <div id="certPreviewContainer" class="mt-3 d-none p-3 bg-success bg-opacity-10 rounded-4 border border-success border-opacity-25 text-center">
                                <span class="badge bg-success mb-2">Tệp mới sẽ dùng để thay thế</span>
                                <div class="small fw-semibold text-dark mb-2" id="certFileInfo"></div>
                                <img id="certImagePreview" src="#" alt="Xem trước Giấy Rửa Tội mới" class="img-fluid rounded-3 shadow-sm mb-2 bg-white p-1" style="max-height: 260px;" />
                                <div>
                                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="document.getElementById('inputCertFile').click()">
                                        <i class="bi bi-arrow-repeat me-1"></i> Chọn / Chụp lại ảnh khác
                                    </button>
                                </div>
                            </div>
                        </div>

                        @if (isMobile)
                        {
                            <div class="d-grid gap-2">
                                <button type="submit" id="btnSubmitResubmit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm touch-target-44">
                                    <i class="bi bi-send-check-fill me-2"></i>Lưu Bổ Sung &amp; Nộp Lại Hồ Sơ
                                </button>
                                <a asp-action="CheckStatus"
                                   asp-route-phone="@Model.OriginalParentPhone"
                                   asp-route-dob="@Model.OriginalDateOfBirth.ToString("yyyy-MM-dd")"
                                   class="btn btn-outline-secondary rounded-pill py-2 fw-semibold touch-target-44">
                                    Hủy &amp; Quay lại
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-content-end align-items-center gap-3 pt-3 border-top">
                                <a asp-action="CheckStatus"
                                   asp-route-phone="@Model.OriginalParentPhone"
                                   asp-route-dob="@Model.OriginalDateOfBirth.ToString("yyyy-MM-dd")"
                                   class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                                    Hủy bỏ
                                </a>
                                <button type="submit" id="btnSubmitResubmit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
                                    <i class="bi bi-send-check-fill me-2"></i>Lưu Bổ Sung &amp; Nộp Lại Hồ Sơ
                                </button>
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let processedUploadBlob = null;
        let processedFileName = '';

        function suggestGradeByAge() {
            const dobVal = document.getElementById('inputDob').value;
            if (!dobVal) return;

            const birthYear = new Date(dobVal).getFullYear();
            const currentYear = new Date().getFullYear();
            const age = currentYear - birthYear;

            const gradeSelect = document.getElementById('selectTargetGrade');
            const hint = document.getElementById('ageHint');

            if (age >= 4 && age <= 20) {
                let suggested = 'Khai Tâm';
                if (age >= 9 && age <= 11) suggested = 'Rước Lễ';
                else if (age >= 12 && age <= 14) suggested = 'Thêm Sức';
                else if (age >= 15) suggested = 'Bao Đồng';

                gradeSelect.value = suggested;
                hint.innerHTML = `<span class="badge bg-primary-subtle text-primary border"><i class="bi bi-magic me-1"></i>~${age} tuổi &rarr; Gợi ý: Khối ${suggested}</span>`;
            } else {
                hint.innerHTML = '';
            }
        }

        async function handleCertFileChange(input) {
            const container = document.getElementById('certPreviewContainer');
            const imgPreview = document.getElementById('certImagePreview');
            const infoText = document.getElementById('certFileInfo');
            processedUploadBlob = null;

            if (!input.files || input.files.length === 0) {
                container.classList.add('d-none');
                return;
            }

            const file = input.files[0];
            processedFileName = file.name;

            if (file.type === 'application/pdf') {
                container.classList.remove('d-none');
                imgPreview.classList.add('d-none');
                infoText.textContent = `Đã chọn tệp PDF mới: ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`;
                return;
            }

            if (file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    imgPreview.src = e.target.result;
                    imgPreview.classList.remove('d-none');
                    container.classList.remove('d-none');
                };
                reader.readAsDataURL(file);

                if (file.size > 1.2 * 1024 * 1024) {
                    infoText.textContent = 'Đang tối ưu dung lượng ảnh...';
                    processedUploadBlob = await compressImageClientSide(file, 1600, 0.82);
                    processedFileName = file.name.replace(/\.[^/.]+$/, ".jpg");
                    infoText.textContent = `Ảnh mới đã tối ưu: ${(processedUploadBlob.size / 1024).toFixed(0)} KB (Gốc: ${(file.size / 1024 / 1024).toFixed(2)} MB)`;
                } else {
                    infoText.textContent = `Đã chọn ảnh mới: ${file.name} (${(file.size / 1024).toFixed(0)} KB)`;
                }
            }
        }

        function compressImageClientSide(file, maxWidth, quality) {
            return new Promise((resolve) => {
                const img = new Image();
                img.onload = () => {
                    let width = img.width;
                    let height = img.height;
                    if (width > maxWidth) {
                        height = Math.round((height * maxWidth) / width);
                        width = maxWidth;
                    }
                    const canvas = document.createElement('canvas');
                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);
                    canvas.toBlob((blob) => resolve(blob || file), 'image/jpeg', quality);
                };
                img.src = URL.createObjectURL(file);
            });
        }

        document.getElementById('resubmitRegForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitResubmit');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu &amp; gửi lại hồ sơ...';

            const formData = new FormData(this);
            const fileInput = document.getElementById('inputCertFile');

            if (processedUploadBlob) {
                formData.set('CertificateFile', processedUploadBlob, processedFileName);
            } else if (fileInput.files.length > 0) {
                formData.set('CertificateFile', fileInput.files[0]);
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const response = await fetch('/PublicRegistration/SubmitResubmit', {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': token
                    },
                    body: formData
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    window.location.href = result.redirectUrl || '/PublicRegistration/CheckStatus';
                } else {
                    alert(result.message || 'Không thể cập nhật hồ sơ. Vui lòng kiểm tra lại thông tin.');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-send-check-fill me-2"></i>Lưu Bổ Sung &amp; Nộp Lại Hồ Sơ';
                }
            } catch (err) {
                alert('Lỗi kết nối máy chủ: ' + err.message);
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send-check-fill me-2"></i>Lưu Bổ Sung &amp; Nộp Lại Hồ Sơ';
            }
        });
    </script>
}
