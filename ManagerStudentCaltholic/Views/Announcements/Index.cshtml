@model IEnumerable<ManagerStudentCaltholic.Models.Entities.Announcement>
@using ManagerStudentCaltholic.Models.Entities
@{
    ViewData["Title"] = "Bảng Tin & Dặn Dò Lớp Học";
    bool canPostAll = ViewBag.CanPostAll ?? false;
    bool canPostGrade = ViewBag.CanPostGrade ?? false;
    bool canPostClass = ViewBag.CanPostClass ?? false;
    bool canCreateAny = canPostAll || canPostGrade || canPostClass;
    var authorizedClassIds = ViewBag.AuthorizedClassIds as HashSet<int> ?? new HashSet<int>();
    var managedGrade = ViewBag.ManagedGradeLevel as string;
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="bi bi-megaphone-fill text-primary me-2"></i>Bảng Tin &amp; Dặn Dò Lớp Học Giáo Lý
            </h4>
            <p class="text-muted small mb-0">Cập nhật tin tức sinh hoạt, lịch phụng vụ và dặn dò bài học trước Thánh Lễ / Giờ học Giáo lý.</p>
        </div>
        @if (canCreateAny)
        {
            <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#createAnnouncementModal">
                <i class="bi bi-pencil-square me-1"></i> Đăng Tin / Dặn Dò Lớp
            </button>
        }
    </div>

    <!-- Alert thông báo -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Bộ lọc bài viết -->
    <div class="card border-0 rounded-4 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-12 col-md-2">
                    <select name="scope" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="ALL" selected="@(ViewBag.SelectedScope == "ALL")">-- Tất cả phạm vi --</option>
                        <option value="PARISH" selected="@(ViewBag.SelectedScope == "PARISH")">Toàn Giáo Lý</option>
                        <option value="GRADE" selected="@(ViewBag.SelectedScope == "GRADE")">Theo Khối</option>
                        <option value="CLASS" selected="@(ViewBag.SelectedScope == "CLASS")">Dặn Dò Riêng Lớp</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <select name="gradeLevel" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="ALL" selected="@(ViewBag.SelectedGrade == "ALL")">-- Tất cả khối --</option>
                        <option value="Khai Tâm" selected="@(ViewBag.SelectedGrade == "Khai Tâm")">Khối Khai Tâm</option>
                        <option value="Rước Lễ" selected="@(ViewBag.SelectedGrade == "Rước Lễ")">Khối Rước Lễ</option>
                        <option value="Thêm Sức" selected="@(ViewBag.SelectedGrade == "Thêm Sức")">Khối Thêm Sức</option>
                        <option value="Bao Đồng" selected="@(ViewBag.SelectedGrade == "Bao Đồng")">Khối Bao Đồng</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <select name="classId" class="form-select form-select-sm" asp-items="ViewBag.Classes" onchange="this.form.submit()">
                        <option value="">-- Lọc theo lớp học --</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <input type="text" name="search" class="form-control form-control-sm" placeholder="Tìm theo tiêu đề, nội dung dặn dò..." value="@ViewBag.SearchKeyword" />
                </div>
                <div class="col-12 col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-outline-primary btn-sm w-100 fw-bold">Lọc Tin</button>
                    <a asp-action="Index" class="btn btn-light btn-sm border" title="Đặt lại"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Danh sách thẻ bài thông báo -->
    <div class="row g-3">
        @if (Model != null && Model.Any())
        {
            @foreach (var post in Model)
            {
                var borderClass = post.IsPinned ? "border-start border-4 border-warning shadow" : "border-0 shadow-sm";
                var badgePriority = post.Priority switch
                {
                    "URGENT" => "bg-danger text-white",
                    "IMPORTANT" => "bg-warning text-dark",
                    _ => "bg-secondary-subtle text-secondary"
                };

                var scopeDisplay = post.Scope == "ALL" || post.Scope == "PARISH"
                ? "Toàn Giáo Xứ"
                : post.Scope == "GRADE"
                ? $"Khối {post.TargetGradeLevel}"
                : $"Lớp {post.TargetClassRoom?.Name}";

                bool canEditThisPost = canPostAll ||
                (canPostGrade && post.Scope == "GRADE" && string.Equals(post.TargetGradeLevel, managedGrade, StringComparison.OrdinalIgnoreCase)) ||
                (post.Scope == "CLASS" && post.TargetClassRoomId.HasValue && authorizedClassIds.Contains(post.TargetClassRoomId.Value));

                <div class="col-12">
                    <div class="card rounded-4 @borderClass">
                        <div class="card-body p-4">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    @if (post.IsPinned)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-pin-angle-fill me-1"></i>Đã ghim đầu trang</span>
                                    }
                                    <span class="badge @badgePriority px-2 py-1">@post.Priority</span>
                                    <span class="badge bg-primary-subtle text-primary border px-2 py-1">
                                        <i class="bi bi-bullseye me-1"></i>@scopeDisplay
                                    </span>
                                    @if (post.ExpireAt.HasValue)
                                    {
                                        <span class="badge bg-light text-muted border">Hiệu lực đến: @post.ExpireAt.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    <!-- Nút 1-Click Copy Bài Dặn Dò gửi nhóm Zalo Lớp -->
                                    <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3"
                                            data-title="@post.Title"
                                            data-scope="@scopeDisplay"
                                            data-content="@post.Content"
                                            onclick="copyAnnouncementToZalo(this)">
                                        <i class="bi bi-clipboard-check me-1"></i> Copy gửi Zalo
                                    </button>

                                    @if (canEditThisPost)
                                    {
                                        <div class="dropdown">
                                            <button class="btn btn-light btn-sm rounded-circle p-1 border" type="button" data-bs-toggle="dropdown">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                                <li>
                                                    <form asp-action="TogglePin" asp-route-id="@post.Id" method="post" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="dropdown-item py-1">
                                                            <i class="bi bi-pin-angle me-2 text-warning"></i>@(post.IsPinned ? "Bỏ ghim" : "Ghim lên đầu")
                                                        </button>
                                                    </form>
                                                </li>
                                                <li><hr class="dropdown-divider my-1"></li>
                                                <li>
                                                    <form asp-action="Delete" asp-route-id="@post.Id" method="post" class="m-0" onsubmit="return confirm('Bạn có chắc muốn xóa bài thông báo này?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="dropdown-item py-1 text-danger">
                                                            <i class="bi bi-trash3 me-2"></i>Xóa bài
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    }
                                </div>
                            </div>

                            <h5 class="fw-bold text-dark mb-2">@post.Title</h5>
                            <p class="text-secondary mb-3 text-break" style="white-space: pre-line;">@post.Content</p>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top small text-muted">
                                <span><i class="bi bi-person-check me-1"></i>Đăng bởi: <strong>@post.CreatedBy</strong></span>
                                <span><i class="bi bi-clock me-1"></i>@post.CreatedAt.ToLocalTime().ToString("HH:mm - dd/MM/yyyy")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 py-5 text-center text-muted">
                <i class="bi bi-newspaper display-4 opacity-50"></i>
                <p class="mt-2 mb-0">Hiện chưa có bài thông báo hoặc dặn dò nào trong phạm vi này.</p>
            </div>
        }
    </div>
</div>

@if (canCreateAny)
{
    <div class="modal fade" id="createAnnouncementModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <form asp-action="Create" method="post" class="modal-content border-0 shadow rounded-4 overflow-hidden">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-megaphone me-2"></i>Đăng Thông Báo / Dặn Dò Lớp Học</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tiêu Đề Bài Viết <span class="text-danger">*</span></label>
                        <input type="text" name="Title" class="form-control" placeholder="VD: Dặn dò ôn tập Khảo hạch Giáo lý Chúa Nhật tuần này..." required maxlength="200" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Phạm Vi Hiển Thị</label>
                            <select name="Scope" id="annScopeSelect" class="form-select" onchange="toggleScopeInputs()">
                                @if (canPostAll)
                                {
                                    <option value="ALL">Toàn Gia Đình Giáo Lý</option>
                                }
                                @if (canPostGrade)
                                {
                                    <option value="GRADE">Theo Khối Giáo Lý</option>
                                }
                                @if (canPostClass)
                                {
                                    <option value="CLASS" selected="@(!canPostAll)">Theo Lớp Phụ Trách</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4 d-none" id="divGradeLevel">
                            <label class="form-label small fw-bold">Chọn Khối</label>
                            <select name="TargetGradeLevel" class="form-select">
                                @if (!canPostAll && !string.IsNullOrEmpty(managedGrade))
                                {
                                    <option value="@managedGrade">Khối @managedGrade</option>
                                }
                                else
                                {
                                    <option value="Khai Tâm">Khối Khai Tâm</option>
                                    <option value="Rước Lễ">Khối Rước Lễ</option>
                                    <option value="Thêm Sức">Khối Thêm Sức</option>
                                    <option value="Bao Đồng">Khối Bao Đồng</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4 d-none" id="divClassRoom">
                            <label class="form-label small fw-bold">Chọn Lớp Học <span class="text-danger">*</span></label>
                            <select name="TargetClassRoomId" class="form-select" asp-items="ViewBag.Classes"></select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Mức Độ Ưu Tiên</label>
                            <select name="Priority" class="form-select">
                                <option value="NORMAL">Bình thường (NORMAL)</option>
                                <option value="IMPORTANT">Quan trọng (IMPORTANT)</option>
                                <option value="URGENT">Khẩn cấp (URGENT)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nội Dung Dặn Dò / Thông Báo (Có thể đính kèm Link tài liệu) <span class="text-danger">*</span></label>
                        <textarea name="Content" class="form-control" rows="5" placeholder="Nhập nội dung chi tiết..." required></textarea>
                    </div>

                    <div class="row g-2 align-items-center">
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsPinned" value="true" id="pinSwitch">
                                <label class="form-check-label small fw-semibold" for="pinSwitch">Ghim bài dặn dò này lên đầu bảng tin</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light">Ngày hết hạn (Tùy chọn)</span>
                                <input type="date" name="ExpireAt" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary px-3 rounded-pill" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary px-4 fw-bold rounded-pill">Đăng Bảng Tin</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        function toggleScopeInputs() {
            const sel = document.getElementById('annScopeSelect');
            if (!sel) return;
            const scope = sel.value;
            const divGrade = document.getElementById('divGradeLevel');
            const divClass = document.getElementById('divClassRoom');

            if (divGrade) divGrade.classList.toggle('d-none', scope !== 'GRADE');
            if (divClass) divClass.classList.toggle('d-none', scope !== 'CLASS');
        }

        document.addEventListener('DOMContentLoaded', function () {
            toggleScopeInputs();
        });

        function copyAnnouncementToZalo(btn) {
            const title = btn.getAttribute('data-title') || '';
            const scope = btn.getAttribute('data-scope') || '';
            const content = btn.getAttribute('data-content') || '';
            const fullText = `📢 [THÔNG BÁO - ${scope.toUpperCase()}]\n📌 ${title}\n----------------------\n${content}\n----------------------\n(Ban Giáo Lý Giáo Xứ Phú Trung)`;

            navigator.clipboard.writeText(fullText).then(() => {
                const origHtml = btn.innerHTML;
                btn.className = 'btn btn-success btn-sm rounded-pill px-3';
                btn.innerHTML = '<i class="bi bi-check2-all me-1"></i> Đã Copy!';
                setTimeout(() => {
                    btn.className = 'btn btn-outline-success btn-sm rounded-pill px-3';
                    btn.innerHTML = origHtml;
                }, 2000);
            });
        }
    </script>
}