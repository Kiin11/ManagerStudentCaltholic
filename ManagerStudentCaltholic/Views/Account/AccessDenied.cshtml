@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container text-center py-5">
    <div class="card border-0 shadow-sm p-4 mx-auto" style="max-width: 550px; border-radius: 16px;">
        <div class="mb-3">
            <i class="bi bi-shield-lock-fill text-danger" style="font-size: 4rem;"></i>
        </div>
        <h3 class="fw-bold text-danger">Không có quyền truy cập</h3>
        <p class="text-muted mt-2">
            Tài khoản hiện tại không có thẩm quyền truy cập vào chức năng hoặc tài nguyên này.
            Vui lòng liên hệ <strong>Ban Điều Hành</strong> hoặc <strong>Quản trị viên</strong> nếu bạn cần được cấp quyền.
        </p>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary px-4 me-2">
                <i class="bi bi-house me-1"></i> Trang chủ
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-box-arrow-right me-1"></i> Đăng nhập tài khoản khác
                </button>
            </form>
        </div>
    </div>
</div>