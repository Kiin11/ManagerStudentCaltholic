@model ManagerStudentCaltholic.Models.ViewModels.UserProfileViewModel
@using ManagerStudentCaltholic.Models.Entities
@using ManagerStudentCaltholic.Extensions
@{
    ViewData["Title"] = "Hồ Sơ Cá Nhân";
    bool isMobile = Context.Request.IsMobileDevice();
    bool isViewingOther = ViewBag.IsViewingOther == true;
    bool canUploadAvatar = !isViewingOther || User.IsInRole(UserRole.Admin) || User.IsInRole(UserRole.ExecutiveBoard);
}

@if (isMobile)
{
    <style>
        .mobile-profile-wrap {
            padding-bottom: 1.5rem;
        }
        .mobile-profile-wrap .form-control,
        .mobile-profile-wrap .form-select {
            font-size: 16px !important;
            min-height: 44px;
            border-radius: 12px;
        }
        .mobile-profile-hero {
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
            border-radius: 18px;
            border: 1px solid rgba(13, 110, 253, 0.12);
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
            padding: 1rem;
        }
        .mobile-profile-avatar {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: rgba(13, 110, 253, 0.1);
            color: #0d6efd;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            flex-shrink: 0;
        }
        .mobile-profile-nav {
            display: flex;
            gap: 0.45rem;
            overflow-x: auto;
            padding-bottom: 0.25rem;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        .mobile-profile-nav::-webkit-scrollbar {
            display: none;
        }
        .mobile-profile-nav-pill {
            white-space: nowrap;
            min-height: 40px;
            padding: 0.45rem 0.85rem;
            border-radius: 999px;
            font-size: 0.82rem;
            font-weight: 700;
            border: 1px solid #dee2e6;
            background: #ffffff;
            color: #495057;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            text-decoration: none;
        }
        .mobile-profile-nav-pill.active {
            background: #0d6efd;
            color: #ffffff;
            border-color: #0d6efd;
        }
        .mobile-class-item {
            border-radius: 14px;
            border: 1px solid #e9ecef;
            background: #f8fafc;
            padding: 0.85rem;
        }
        .mobile-profile-submit-btn {
            min-height: 46px;
            font-size: 0.95rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
    </style>

    <div class="mobile-profile-wrap">
        <!-- Banner Quản Trị Viên Xem Hồ Sơ Người Khác -->
        @if (isViewingOther)
        {
            <div class="alert alert-primary border-0 rounded-4 shadow-sm mb-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-shield-check fs-5 text-primary"></i>
                    <div>
                        <span class="badge bg-primary rounded-pill me-1">Quản Trị</span>
                        Đang xem hồ sơ: <strong>@(!string.IsNullOrEmpty(Model.ChristianName) ? $"{Model.ChristianName} " : "")@Model.FirstName @Model.LastName</strong> (<code>@@@Model.Username</code>)
                    </div>
                </div>
                <a asp-controller="Users" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm touch-target-44 d-inline-flex align-items-center">
                    <i class="bi bi-arrow-left me-1"></i> Danh sách người dùng
                </a>
            </div>
        }

        <!-- Alert Thông Báo -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm mb-3 small" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm mb-3 small" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Thẻ Tóm Tắt Hồ Sơ Mobile -->
        <div class="mobile-profile-hero mb-3">
            <div class="d-flex align-items-center gap-3">
                <div class="mobile-profile-avatar position-relative overflow-hidden border border-primary-subtle">
                    @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                    {
                        <img id="profileAvatarImg" src="@Model.AvatarUrl" alt="Ảnh đại diện"
                             class="w-100 h-100 object-fit-cover rounded-circle"
                             onerror="this.classList.add('d-none'); document.getElementById('profileAvatarFallbackIcon')?.classList.remove('d-none');" />
                        <i id="profileAvatarFallbackIcon" class="bi bi-person-fill d-none"></i>
                    }
                    else
                    {
                        <img id="profileAvatarImg" src="" alt="Ảnh đại diện"
                             class="w-100 h-100 object-fit-cover rounded-circle d-none"
                             onerror="this.classList.add('d-none'); document.getElementById('profileAvatarFallbackIcon')?.classList.remove('d-none');" />
                        <i id="profileAvatarFallbackIcon" class="bi bi-person-fill"></i>
                    }
                </div>
                <div class="flex-grow-1 min-w-0">
                    <h6 class="fw-bold text-dark mb-0 text-truncate">
                        @(!string.IsNullOrEmpty(Model.ChristianName) ? $"{Model.ChristianName} " : "")@Model.FirstName @Model.LastName
                    </h6>
                    <div class="text-muted small font-monospace mb-2">@@@Model.Username</div>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="badge @(Model.Role == UserRole.Admin ? "bg-danger" :
                                             Model.Role == UserRole.SpiritualDirector ? "bg-info text-dark" :
                                             Model.Role == UserRole.ExecutiveBoard ? "bg-primary" :
                                             Model.Role == UserRole.BranchHead ? "bg-warning text-dark" :
                                             Model.Role == UserRole.ProbationaryTeacher ? "text-white" : "bg-secondary") rounded-pill px-2 py-1"
                              style="@(Model.Role == UserRole.ProbationaryTeacher ? "background-color: #6f42c1;" : "")">
                            @(Model.Role == UserRole.Admin ? "Quản trị viên" : Model.Role == UserRole.SpiritualDirector ? "Cha" :
                              Model.Role == UserRole.ExecutiveBoard ? "Ban Điều Hành" :
                              Model.Role == UserRole.BranchHead ? "Trưởng khối" :
                              Model.Role == UserRole.ProbationaryTeacher ? "Dự Bị" : "Giáo lý viên")
                        </span>
                        @if (!string.IsNullOrEmpty(Model.ManagedGradeLevel))
                        {
                            <span class="badge bg-primary-subtle text-primary border rounded-pill px-2 py-1">
                                Khối @Model.ManagedGradeLevel
                            </span>
                        }
                        @if (Model.FeastDay.HasValue)
                        {
                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill px-2 py-1">
                                <i class="bi bi-stars me-1"></i>Ngày kính: @Model.FeastDay.Value.ToString("dd/MM")
                            </span>
                        }
                        @if (Model.LegacyStudentCodes.Any())
                        {
                            <span class="badge bg-info-subtle text-dark border border-info-subtle rounded-pill px-2 py-1 font-monospace">
                                <i class="bi bi-clock-history me-1"></i>Mã HS cũ: @string.Join(", ", Model.LegacyStudentCodes)
                            </span>
                        }
                    </div>
                </div>
            </div>
            @if (canUploadAvatar)
            {
                <div class="mt-2 pt-2 border-top d-flex align-items-center justify-content-between gap-2">
                    <input type="file" id="profileAvatarFileInput" class="d-none" accept=".jpg,.jpeg,.png,.webp,.gif,image/*" onchange="uploadAccountAvatar(this)" />
                    <button type="button" id="btnUploadProfileAvatar"
                            class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold touch-target-44 d-inline-flex align-items-center gap-1"
                            onclick="document.getElementById('profileAvatarFileInput').click()">
                        <i class="bi bi-camera-fill"></i> Đổi ảnh đại diện
                    </button>
                    <small id="profileAvatarStatus" class="text-muted text-truncate">JPG, PNG, WebP (&le; 5 MB)</small>
                </div>
            }
        </div>

        <!-- Thanh Chọn Nhanh Phân Khu Hồ Sơ -->
        <div class="mobile-profile-nav mb-3" role="tablist">
            <button type="button" class="mobile-profile-nav-pill active" onclick="switchMobileProfileSection('sec-timeline', this)">
                <i class="bi bi-mortarboard-fill"></i> Quá trình Học &amp; Dạy (@Model.DualTimeline.Count)
            </button>
            <button type="button" class="mobile-profile-nav-pill" onclick="switchMobileProfileSection('sec-milestones', this)">
                <i class="bi bi-stars"></i> 5 Cột mốc Đức tin
            </button>
            <button type="button" class="mobile-profile-nav-pill" onclick="switchMobileProfileSection('sec-info', this)">
                <i class="bi bi-person-lines-fill"></i> Thông tin cá nhân
            </button>
            <button type="button" class="mobile-profile-nav-pill" onclick="switchMobileProfileSection('sec-password', this)">
                <i class="bi bi-shield-lock-fill"></i> @(isViewingOther ? "Bảo mật tài khoản" : "Đổi mật khẩu")
            </button>
        </div>

        <!-- 1. QUÁ TRÌNH HỌC TẬP & GIẢNG DẠY ĐÃ GỘP (MOBILE) -->
        <div id="sec-timeline" class="mb-3">
            @await Html.PartialAsync("_ProfileDualTimelineAndMilestones", Model, new ViewDataDictionary(ViewData)
            {
                ["IsCompactMobile"] = true,
                ["IsLeftColumn"] = true,
                ["RenderMode"] = "TIMELINE_ONLY"
            })
        </div>

        <!-- 1B. 5 CỘT MỐC ĐỨC TIN & TUYÊN HỨA (MOBILE) -->
        <div id="sec-milestones" class="mb-3">
            @await Html.PartialAsync("_ProfileDualTimelineAndMilestones", Model, new ViewDataDictionary(ViewData)
            {
                ["IsCompactMobile"] = true,
                ["RenderMode"] = "MILESTONES_ONLY"
            })
        </div>

        <!-- 2. FORM CẬP NHẬT THÔNG TIN CÁ NHÂN -->
        <div id="sec-info" class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-header bg-white border-0 pt-3 px-3 pb-1">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-person-lines-fill text-primary me-2"></i>Cập Nhật Thông Tin Cá Nhân
                </h6>
            </div>
            <div class="card-body p-3">
                <form asp-action="UpdateProfile" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label small fw-bold mb-1">Tên Thánh</label>
                            <input type="text" name="ChristianName" class="form-control" value="@Model.ChristianName" placeholder="Phaolô, Giuse..." />
                        </div>
                        <div class="col-7">
                            <label class="form-label small fw-bold mb-1">Họ và Tên đệm <span class="text-danger">*</span></label>
                            <input type="text" name="FirstName" class="form-control" value="@Model.FirstName" required />
                        </div>
                        <div class="col-5">
                            <label class="form-label small fw-bold mb-1">Tên <span class="text-danger">*</span></label>
                            <input type="text" name="LastName" class="form-control" value="@Model.LastName" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold mb-1">Số Điện Thoại</label>
                            <input type="tel" inputmode="tel" name="PhoneNumber" class="form-control" value="@Model.PhoneNumber" placeholder="090..." />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold mb-1">Ngày Sinh</label>
                            <input type="date" name="DateOfBirth" class="form-control" value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold mb-1">Ngày Kính (Bổn mạng)</label>
                            <input type="date" name="FeastDay" class="form-control" value="@(Model.FeastDay?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold mb-1">Email</label>
                            <input type="email" name="Email" class="form-control" value="@Model.Email" placeholder="example@gmail.com" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold mb-1">Giáo Khu / Địa Chỉ</label>
                            <input type="text" name="Address" class="form-control" value="@Model.Address" placeholder="Giáo khu..." />
                        </div>

                        <div class="col-12 mt-3 pt-2 border-top">
                            <div class="small fw-bold text-primary mb-1">
                                <i class="bi bi-stars text-warning me-1"></i>Cột Mốc Bí Tích &amp; Tuyên Hứa
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold mb-1">1. Ngày Rửa Tội</label>
                            <input type="date" name="BaptismDate" class="form-control" value="@(Model.BaptismDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold mb-1">2. Ngày Rước Lễ</label>
                            <input type="date" name="FirstCommunionDate" class="form-control" value="@(Model.FirstCommunionDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold mb-1">3. Ngày Thêm Sức</label>
                            <input type="date" name="ConfirmationDate" class="form-control" value="@(Model.ConfirmationDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold mb-1">4. Tuyên Hứa Dự Bị</label>
                            <input type="date" name="BaoDongPromiseDate" class="form-control" value="@(Model.BaoDongPromiseDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold mb-1">5. Tuyên Hứa Giáo Lý Viên <span class="text-muted fw-normal">(&ge; 18 tuổi)</span></label>
                            <input type="date" name="CatechistPromiseDate" class="form-control" value="@(Model.CatechistPromiseDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                    <div class="d-grid mt-3">
                        <button type="submit" class="btn btn-primary rounded-pill fw-bold shadow-sm mobile-profile-submit-btn touch-target-44">
                            <i class="bi bi-check2-circle me-2"></i> Lưu Thay Đổi Hồ Sơ
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- 3. FORM ĐỔI MẬT KHẨU -->
        <div id="sec-password" class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-header bg-white border-0 pt-3 px-3 pb-1">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-shield-lock-fill text-warning me-2"></i>@(isViewingOther ? "Bảo Mật & Mật Khẩu" : "Đổi Mật Khẩu Bảo Mật")
                </h6>
            </div>
            <div class="card-body p-3">
                @if (isViewingOther)
                {
                    <div class="alert alert-info border-0 rounded-3 small mb-2">
                        <i class="bi bi-info-circle-fill me-1 text-primary"></i>
                        Bạn đang xem hồ sơ của tài khoản <strong>@@@Model.Username</strong>. Để đặt lại mật khẩu cho tài khoản này, vui lòng sử dụng chức năng <strong>Đặt Lại Mật Khẩu</strong> trong danh sách Quản Trị Người Dùng.
                    </div>
                    <div class="d-grid mt-2">
                        <a asp-controller="Users" asp-action="Index" class="btn btn-outline-primary rounded-pill fw-bold touch-target-44 d-inline-flex align-items-center justify-content-center">
                            <i class="bi bi-key-fill me-2"></i> Mở Trang Quản Trị Để Đổi MK
                        </a>
                    </div>
                }
                else
                {
                    <div id="pwdAlert" class="alert d-none border-0 rounded-3 small"></div>
                    <form id="formChangePassword" onsubmit="event.preventDefault(); submitChangePassword();">
                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label small fw-bold mb-1">Mật khẩu hiện tại</label>
                                <input type="password" id="currentPassword" class="form-control" placeholder="Nhập mật khẩu đang dùng" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold mb-1">Mật khẩu mới (tối thiểu 6 ký tự)</label>
                                <input type="password" id="newPassword" class="form-control" minlength="6" placeholder="Nhập mật khẩu mới" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold mb-1">Xác nhận mật khẩu mới</label>
                                <input type="password" id="confirmPassword" class="form-control" minlength="6" placeholder="Nhập lại mật khẩu mới" required />
                            </div>
                        </div>
                        <div class="d-grid mt-3">
                            <button type="submit" class="btn btn-warning text-dark rounded-pill fw-bold shadow-sm mobile-profile-submit-btn touch-target-44">
                                <i class="bi bi-key-fill me-2"></i> Cập Nhật Mật Khẩu
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-0">
        <!-- Banner Quản Trị Viên Xem Hồ Sơ Người Khác -->
        @if (isViewingOther)
        {
            <div class="alert alert-primary border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="bi bi-shield-check fs-4"></i>
                    </div>
                    <div>
                        <span class="badge bg-primary rounded-pill me-1">Chế Độ Quản Trị</span>
                        Đang xem hồ sơ của tài khoản: <strong>@(!string.IsNullOrEmpty(Model.ChristianName) ? $"{Model.ChristianName} " : "")@Model.FirstName @Model.LastName</strong> (<code>@@@Model.Username</code>)
                    </div>
                </div>
                <a asp-controller="Users" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại Danh sách người dùng
                </a>
            </div>
        }

        <div class="row g-4">
            <!-- CỘT TRÁI: THÔNG TIN TÓM TẮT & CÁC LỚP PHỤ TRÁCH -->
            <div class="col-12 col-lg-5 col-xl-4">
                <!-- Thẻ Thông Tin Cơ Bản -->
                <div class="card border-0 shadow-sm rounded-4 mb-4 text-center overflow-hidden">
                    <div class="card-body p-4">
                        <div class="mx-auto mb-3 rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center overflow-hidden border border-2 border-primary-subtle shadow-sm"
                             style="width: 84px; height: 84px;">
                            @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                            {
                                <img id="profileAvatarImg" src="@Model.AvatarUrl" alt="Ảnh đại diện"
                                     class="w-100 h-100 object-fit-cover rounded-circle"
                                     onerror="this.classList.add('d-none'); document.getElementById('profileAvatarFallbackIcon')?.classList.remove('d-none');" />
                                <i id="profileAvatarFallbackIcon" class="bi bi-person-fill display-4 d-none"></i>
                            }
                            else
                            {
                                <img id="profileAvatarImg" src="" alt="Ảnh đại diện"
                                     class="w-100 h-100 object-fit-cover rounded-circle d-none"
                                     onerror="this.classList.add('d-none'); document.getElementById('profileAvatarFallbackIcon')?.classList.remove('d-none');" />
                                <i id="profileAvatarFallbackIcon" class="bi bi-person-fill display-4"></i>
                            }
                        </div>
                        @if (canUploadAvatar)
                        {
                            <div class="mb-3">
                                <input type="file" id="profileAvatarFileInput" class="d-none" accept=".jpg,.jpeg,.png,.webp,.gif,image/*" onchange="uploadAccountAvatar(this)" />
                                <button type="button" id="btnUploadProfileAvatar"
                                        class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold"
                                        onclick="document.getElementById('profileAvatarFileInput').click()">
                                    <i class="bi bi-camera-fill me-1"></i> Đổi ảnh đại diện
                                </button>
                                <div id="profileAvatarStatus" class="small text-muted mt-1">Ảnh JPG, PNG, WebP (tối đa 5 MB)</div>
                            </div>
                        }
                        <h5 class="fw-bold text-dark mb-1">
                            @(!string.IsNullOrEmpty(Model.ChristianName) ? $"{Model.ChristianName} " : "")@Model.FirstName @Model.LastName
                        </h5>
                        <p class="text-muted small mb-2">@@@Model.Username</p>
                        <span class="badge @(Model.Role == UserRole.Admin ? "bg-danger" :
                                             Model.Role == UserRole.SpiritualDirector ? "bg-info text-dark" :
                                             Model.Role == UserRole.ExecutiveBoard ? "bg-primary" :
                                             Model.Role == UserRole.BranchHead ? "bg-warning text-dark" :
                                             Model.Role == UserRole.ProbationaryTeacher ? "text-white" : "bg-secondary") rounded-pill px-3 py-1"
                              style="@(Model.Role == UserRole.ProbationaryTeacher ? "background-color: #6f42c1;" : "")">
                            @(Model.Role == UserRole.Admin ? "Quản trị viên" : Model.Role == UserRole.SpiritualDirector ? "Cha" :
                              Model.Role == UserRole.ExecutiveBoard ? "Ban Điều Hành" :
                              Model.Role == UserRole.BranchHead ? "Trưởng khối" :
                              Model.Role == UserRole.ProbationaryTeacher ? "Dự Bị" : "Giáo lý viên")
                        </span>
                        @if (!string.IsNullOrEmpty(Model.ManagedGradeLevel))
                        {
                            <span class="badge bg-primary-subtle text-primary border rounded-pill px-2 py-1 ms-1">
                                Khối @Model.ManagedGradeLevel
                            </span>
                        }
                        @if (Model.FeastDay.HasValue)
                        {
                            <div class="mt-2">
                                <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill px-3 py-1">
                                    <i class="bi bi-stars me-1"></i>Ngày kính: @Model.FeastDay.Value.ToString("dd/MM")
                                </span>
                            </div>
                        }
                        @if (Model.LegacyStudentCodes.Any())
                        {
                            <div class="mt-2">
                                <span class="badge bg-info-subtle text-dark border border-info-subtle rounded-pill px-3 py-1 font-monospace">
                                    <i class="bi bi-clock-history me-1"></i>Mã HS cũ: @string.Join(", ", Model.LegacyStudentCodes)
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <!-- QUÁ TRÌNH HỌC TẬP & GIẢNG DẠY (GỘP VỀ CỘT TRÁI: LỚP ĐANG HỌC / ĐANG DẠY & LỚP ĐÃ HỌC / ĐÃ DẠY) -->
                @await Html.PartialAsync("_ProfileDualTimelineAndMilestones", Model, new ViewDataDictionary(ViewData)
                {
                    ["RenderMode"] = "TIMELINE_ONLY",
                    ["IsLeftColumn"] = true
                })
            </div>

            <!-- CỘT PHẢI: 5 CỘT MỐC ĐỨC TIN, CẬP NHẬT THÔNG TIN & ĐỔI MẬT KHẨU -->
            <div class="col-12 col-lg-7 col-xl-8">
                <!-- Alert Thông Báo -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- TASK-04.3 (Phase 6): 5 Cột mốc Đức tin & Tuyên hứa -->
                @await Html.PartialAsync("_ProfileDualTimelineAndMilestones", Model, new ViewDataDictionary(ViewData)
                {
                    ["RenderMode"] = "MILESTONES_ONLY"
                })

                <!-- Form Cập Nhật Hồ Sơ -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-person-lines-fill text-primary me-2"></i>Cập Nhật Thông Tin Cá Nhân
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <form asp-action="UpdateProfile" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Id" value="@Model.Id" />
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Tên Thánh</label>
                                    <input type="text" name="ChristianName" class="form-control" value="@Model.ChristianName" placeholder="Phaolô, Giuse..." />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Họ và Tên đệm <span class="text-danger">*</span></label>
                                    <input type="text" name="FirstName" class="form-control" value="@Model.FirstName" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Tên <span class="text-danger">*</span></label>
                                    <input type="text" name="LastName" class="form-control" value="@Model.LastName" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Số Điện Thoại</label>
                                    <input type="text" name="PhoneNumber" class="form-control" value="@Model.PhoneNumber" placeholder="090..." />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Email</label>
                                    <input type="email" name="Email" class="form-control" value="@Model.Email" placeholder="example@gmail.com" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Ngày Sinh</label>
                                    <input type="date" name="DateOfBirth" class="form-control" value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Ngày Kính (Bổn mạng)</label>
                                    <input type="date" name="FeastDay" class="form-control" value="@(Model.FeastDay?.ToString("yyyy-MM-dd"))" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Giáo Khu</label>
                                    <input type="text" name="Address" class="form-control" value="@Model.Address" placeholder="Giáo khu..." />
                                </div>

                                <div class="col-12 mt-4 pt-3 border-top">
                                    <h6 class="fw-bold text-primary mb-1">
                                        <i class="bi bi-stars text-warning me-1"></i>Cột Mốc Bí Tích &amp; Tuyên Hứa
                                    </h6>
                                    <small class="text-muted">Cập nhật ngày lãnh nhận các Bí tích, Tuyên hứa Dự Bị và Tuyên hứa Giáo lý viên.</small>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">1. Ngày Rửa Tội</label>
                                    <input type="date" name="BaptismDate" class="form-control" value="@(Model.BaptismDate?.ToString("yyyy-MM-dd"))" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">2. Ngày Rước Lễ</label>
                                    <input type="date" name="FirstCommunionDate" class="form-control" value="@(Model.FirstCommunionDate?.ToString("yyyy-MM-dd"))" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">3. Ngày Thêm Sức</label>
                                    <input type="date" name="ConfirmationDate" class="form-control" value="@(Model.ConfirmationDate?.ToString("yyyy-MM-dd"))" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">4. Ngày Tuyên Hứa Dự Bị</label>
                                    <input type="date" name="BaoDongPromiseDate" class="form-control" value="@(Model.BaoDongPromiseDate?.ToString("yyyy-MM-dd"))" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">5. Ngày Tuyên Hứa Giáo Lý Viên <span class="text-muted fw-normal">(&ge; 18 tuổi)</span></label>
                                    <input type="date" name="CatechistPromiseDate" class="form-control" value="@(Model.CatechistPromiseDate?.ToString("yyyy-MM-dd"))" />
                                </div>
                            </div>
                            <div class="text-end mt-4">
                                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                                    <i class="bi bi-check2-circle me-1"></i> Lưu Thay Đổi
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Form Đổi Mật Khẩu -->
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-shield-lock-fill text-warning me-2"></i>@(isViewingOther ? "Bảo Mật & Mật Khẩu" : "Đổi Mật Khẩu")
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        @if (isViewingOther)
                        {
                            <div class="alert alert-info border-0 rounded-3 small mb-3">
                                <i class="bi bi-info-circle-fill me-1 text-primary"></i>
                                Bạn đang xem hồ sơ của tài khoản <strong>@@@Model.Username</strong>. Để đặt lại mật khẩu cho tài khoản này, vui lòng sử dụng chức năng <strong>Đặt Lại Mật Khẩu</strong> trong trang Quản Trị Người Dùng.
                            </div>
                            <a asp-controller="Users" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 fw-bold shadow-sm">
                                <i class="bi bi-key me-1"></i> Mở Trang Quản Trị Để Đổi MK
                            </a>
                        }
                        else
                        {
                            <div id="pwdAlert" class="alert d-none border-0 rounded-3 small"></div>
                            <form id="formChangePassword" onsubmit="event.preventDefault(); submitChangePassword();">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Mật khẩu hiện tại</label>
                                        <input type="password" id="currentPassword" class="form-control" required />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Mật khẩu mới</label>
                                        <input type="password" id="newPassword" class="form-control" minlength="6" required />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Xác nhận mật khẩu</label>
                                        <input type="password" id="confirmPassword" class="form-control" minlength="6" required />
                                    </div>
                                </div>
                                <div class="text-end mt-4">
                                    <button type="submit" class="btn btn-warning text-dark rounded-pill px-4 fw-bold shadow-sm">
                                        <i class="bi bi-key me-1"></i> Cập Nhật Mật Khẩu
                                    </button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function switchMobileProfileSection(targetId, btnEl) {
            document.querySelectorAll('.mobile-profile-nav-pill').forEach(p => p.classList.remove('active'));
            if (btnEl) btnEl.classList.add('active');
            const targetEl = document.getElementById(targetId);
            if (targetEl) {
                targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        async function submitChangePassword() {
            const currentPassword = document.getElementById('currentPassword').value;
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const alertBox = document.getElementById('pwdAlert');

            if (newPassword !== confirmPassword) {
                alertBox.className = "alert alert-danger border-0 rounded-3 small";
                alertBox.innerText = "Mật khẩu mới và xác nhận mật khẩu không khớp nhau.";
                alertBox.classList.remove('d-none');
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const res = await fetch('/Account/ChangePassword', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': token // SEC-02 FIX: Đổi từ 'RequestVerificationToken' sang 'X-CSRF-TOKEN'
                    },
                    body: JSON.stringify({
                        currentPassword: currentPassword,
                        newPassword: newPassword,
                        confirmPassword: confirmPassword
                    })
                });

                const data = await res.json();
                if (data.success) {
                    alertBox.className = "alert alert-success border-0 rounded-3 small";
                    alertBox.innerText = data.message;
                    alertBox.classList.remove('d-none');
                    document.getElementById('formChangePassword').reset();
                } else {
                    alertBox.className = "alert alert-danger border-0 rounded-3 small";
                    alertBox.innerText = data.message;
                    alertBox.classList.remove('d-none');
                }
            } catch (err) {
                alertBox.className = "alert alert-danger border-0 rounded-3 small";
                alertBox.innerText = "Lỗi kết nối khi đổi mật khẩu: " + err.message;
                alertBox.classList.remove('d-none');
            }
        }

        async function uploadAccountAvatar(inputEl) {
            const file = inputEl?.files?.[0];
            if (!file) return;

            const statusEl = document.getElementById('profileAvatarStatus');
            const btnEl = document.getElementById('btnUploadProfileAvatar');
            const imgEl = document.getElementById('profileAvatarImg');
            const fallbackEl = document.getElementById('profileAvatarFallbackIcon');

            const setStatus = (msg, cls) => {
                if (!statusEl) return;
                statusEl.className = cls;
                statusEl.textContent = msg;
            };

            if (file.size > 5 * 1024 * 1024) {
                setStatus('Ảnh vượt quá giới hạn tối đa 5 MB.', 'small text-danger mt-1');
                inputEl.value = '';
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const formData = new FormData();
            formData.append('avatarFile', file);
            const targetUserId = @(Model.Id);
            if (targetUserId > 0) {
                formData.append('userId', targetUserId.toString());
            }

            const prevBtnHtml = btnEl ? btnEl.innerHTML : '';
            if (btnEl) {
                btnEl.disabled = true;
                btnEl.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang tải...';
            }
            setStatus('Đang tối ưu và tải ảnh lên...', 'small text-primary mt-1');

            try {
                const res = await fetch('/Account/UploadAvatar', {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': token
                    },
                    body: formData
                });

                const rawText = await res.text();
                let result = null;
                try {
                    result = rawText ? JSON.parse(rawText) : null;
                } catch {
                    result = null;
                }

                if (res.ok && result && result.success && result.data?.proxyUrl) {
                    if (imgEl) {
                        imgEl.src = result.data.proxyUrl;
                        imgEl.classList.remove('d-none');
                    }
                    if (fallbackEl) {
                        fallbackEl.classList.add('d-none');
                    }
                    setStatus(result.message || 'Đã cập nhật ảnh đại diện!', 'small text-success fw-semibold mt-1');
                } else {
                    const errMsg = result?.message || `Không thể tải lên ảnh đại diện (HTTP ${res.status}).`;
                    setStatus(errMsg, 'small text-danger mt-1');
                }
            } catch (err) {
                setStatus('Lỗi kết nối khi tải ảnh: ' + err.message, 'small text-danger mt-1');
            } finally {
                if (btnEl) {
                    btnEl.disabled = false;
                    btnEl.innerHTML = prevBtnHtml;
                }
                inputEl.value = '';
            }
        }
    </script>
}
