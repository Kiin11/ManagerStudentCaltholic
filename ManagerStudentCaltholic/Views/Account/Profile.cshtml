@model ManagerStudentCaltholic.Models.ViewModels.UserProfileViewModel
@using ManagerStudentCaltholic.Models.Entities
@using ManagerStudentCaltholic.Extensions
@{
    ViewData["Title"] = "Hồ Sơ Cá Nhân";
    bool isMobile = Context.Request.IsMobileDevice();
}

@if (isMobile)
{
    <style>
        .mobile-profile-wrap {
            padding-bottom: 1.5rem;
        }
        .mobile-profile-wrap .form-control,
        .mobile-profile-wrap .form-select {
            font-size: 16px !important;
            min-height: 44px;
            border-radius: 12px;
        }
        .mobile-profile-hero {
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
            border-radius: 18px;
            border: 1px solid rgba(13, 110, 253, 0.12);
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
            padding: 1rem;
        }
        .mobile-profile-avatar {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: rgba(13, 110, 253, 0.1);
            color: #0d6efd;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            flex-shrink: 0;
        }
        .mobile-profile-nav {
            display: flex;
            gap: 0.45rem;
            overflow-x: auto;
            padding-bottom: 0.25rem;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        .mobile-profile-nav::-webkit-scrollbar {
            display: none;
        }
        .mobile-profile-nav-pill {
            white-space: nowrap;
            min-height: 40px;
            padding: 0.45rem 0.85rem;
            border-radius: 999px;
            font-size: 0.82rem;
            font-weight: 700;
            border: 1px solid #dee2e6;
            background: #ffffff;
            color: #495057;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            text-decoration: none;
        }
        .mobile-profile-nav-pill.active {
            background: #0d6efd;
            color: #ffffff;
            border-color: #0d6efd;
        }
        .mobile-class-item {
            border-radius: 14px;
            border: 1px solid #e9ecef;
            background: #f8fafc;
            padding: 0.85rem;
        }
        .mobile-profile-submit-btn {
            min-height: 46px;
            font-size: 0.95rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
    </style>

    <div class="mobile-profile-wrap">
        <!-- Alert Thông Báo -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm mb-3 small" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm mb-3 small" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Thẻ Tóm Tắt Hồ Sơ Mobile -->
        <div class="mobile-profile-hero mb-3">
            <div class="d-flex align-items-center gap-3">
                <div class="mobile-profile-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div class="flex-grow-1 min-w-0">
                    <h6 class="fw-bold text-dark mb-0 text-truncate">
                        @(!string.IsNullOrEmpty(Model.ChristianName) ? $"{Model.ChristianName} " : "")@Model.FirstName @Model.LastName
                    </h6>
                    <div class="text-muted small font-monospace mb-2">@@@Model.Username</div>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="badge @(Model.Role == UserRole.Admin ? "bg-danger" :
                                             Model.Role == UserRole.SpiritualDirector ? "bg-info text-dark" :
                                             Model.Role == UserRole.ExecutiveBoard ? "bg-primary" : "bg-secondary") rounded-pill px-2 py-1">
                            @(Model.Role == UserRole.Admin ? "Quản trị viên" : Model.Role == UserRole.SpiritualDirector ? "Cha" :
                              Model.Role == UserRole.ExecutiveBoard ? "Ban Điều Hành" :
                              Model.Role == UserRole.BranchHead ? "Trưởng khối" : "Giáo lý viên / Dự bị")
                        </span>
                        @if (!string.IsNullOrEmpty(Model.ManagedGradeLevel))
                        {
                            <span class="badge bg-primary-subtle text-primary border rounded-pill px-2 py-1">
                                Trưởng khối @Model.ManagedGradeLevel
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Thanh Chọn Nhanh Phân Khu Hồ Sơ -->
        <div class="mobile-profile-nav mb-3" role="tablist">
            <button type="button" class="mobile-profile-nav-pill active" onclick="switchMobileProfileSection('sec-classes', this)">
                <i class="bi bi-mortarboard-fill"></i> Lớp đang dạy (@Model.CurrentClasses.Count)
            </button>
            <button type="button" class="mobile-profile-nav-pill" onclick="switchMobileProfileSection('sec-info', this)">
                <i class="bi bi-person-lines-fill"></i> Thông tin cá nhân
            </button>
            <button type="button" class="mobile-profile-nav-pill" onclick="switchMobileProfileSection('sec-password', this)">
                <i class="bi bi-shield-lock-fill"></i> Đổi mật khẩu
            </button>
            <button type="button" class="mobile-profile-nav-pill" onclick="switchMobileProfileSection('sec-history', this)">
                <i class="bi bi-clock-history"></i> Lịch sử dạy
            </button>
        </div>

        <!-- 1. KHỐI LỚP ĐANG DẠY NIÊN KHÓA HIỆN TẠI -->
        <div id="sec-classes" class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-header bg-white border-0 pt-3 px-3 pb-2 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-mortarboard-fill text-primary me-2"></i>Lớp Đang Dạy (Niên Khóa Này)
                </h6>
                <span class="badge bg-success-subtle text-success border rounded-pill">
                    @Model.CurrentClasses.Count lớp
                </span>
            </div>
            <div class="card-body px-3 py-2 pb-3">
                @if (Model.CurrentClasses.Any())
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var cls in Model.CurrentClasses)
                        {
                            <div class="mobile-class-item">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <div class="fw-bold text-primary fs-6">@cls.ClassName</div>
                                        <div class="small text-muted">
                                            Khối: <strong>@cls.GradeLevel</strong>
                                            @(string.IsNullOrEmpty(cls.RoomNumber) ? "" : $" • Phòng: {cls.RoomNumber}")
                                        </div>
                                    </div>
                                    <span class="badge @(cls.RoleInClass == "HEAD" ? "bg-primary" : "bg-secondary") rounded-pill">
                                        @cls.RoleName
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                    <span class="small text-secondary fw-semibold">
                                        <i class="bi bi-people-fill me-1 text-primary"></i>Sĩ số: @cls.TotalStudents em
                                    </span>
                                    <a href="/Attendance/Index?classId=@cls.ClassId"
                                       class="btn btn-primary btn-sm rounded-pill px-3 py-2 fw-bold shadow-sm touch-target-44 d-inline-flex align-items-center">
                                        <i class="bi bi-qr-code-scan me-1"></i> Điểm danh ngay
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-3 text-muted small">
                        <i class="bi bi-info-circle me-1"></i>Chưa được phân công lớp nào trong niên khóa này.
                    </div>
                }
            </div>
        </div>

        <!-- 2. FORM CẬP NHẬT THÔNG TIN CÁ NHÂN -->
        <div id="sec-info" class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-header bg-white border-0 pt-3 px-3 pb-1">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-person-lines-fill text-primary me-2"></i>Cập Nhật Thông Tin Cá Nhân
                </h6>
            </div>
            <div class="card-body p-3">
                <form asp-action="UpdateProfile" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label small fw-bold mb-1">Tên Thánh</label>
                            <input type="text" name="ChristianName" class="form-control" value="@Model.ChristianName" placeholder="Phaolô, Giuse..." />
                        </div>
                        <div class="col-7">
                            <label class="form-label small fw-bold mb-1">Họ và Tên đệm <span class="text-danger">*</span></label>
                            <input type="text" name="FirstName" class="form-control" value="@Model.FirstName" required />
                        </div>
                        <div class="col-5">
                            <label class="form-label small fw-bold mb-1">Tên <span class="text-danger">*</span></label>
                            <input type="text" name="LastName" class="form-control" value="@Model.LastName" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold mb-1">Số Điện Thoại</label>
                            <input type="tel" inputmode="tel" name="PhoneNumber" class="form-control" value="@Model.PhoneNumber" placeholder="090..." />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold mb-1">Ngày Sinh</label>
                            <input type="date" name="DateOfBirth" class="form-control" value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold mb-1">Email</label>
                            <input type="email" name="Email" class="form-control" value="@Model.Email" placeholder="example@gmail.com" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold mb-1">Giáo Khu / Địa Chỉ</label>
                            <input type="text" name="Address" class="form-control" value="@Model.Address" placeholder="Giáo khu..." />
                        </div>
                    </div>
                    <div class="d-grid mt-3">
                        <button type="submit" class="btn btn-primary rounded-pill fw-bold shadow-sm mobile-profile-submit-btn touch-target-44">
                            <i class="bi bi-check2-circle me-2"></i> Lưu Thay Đổi Hồ Sơ
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- 3. FORM ĐỔI MẬT KHẨU -->
        <div id="sec-password" class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-header bg-white border-0 pt-3 px-3 pb-1">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-shield-lock-fill text-warning me-2"></i>Đổi Mật Khẩu Bảo Mật
                </h6>
            </div>
            <div class="card-body p-3">
                <div id="pwdAlert" class="alert d-none border-0 rounded-3 small"></div>
                <form id="formChangePassword" onsubmit="event.preventDefault(); submitChangePassword();">
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label small fw-bold mb-1">Mật khẩu hiện tại</label>
                            <input type="password" id="currentPassword" class="form-control" placeholder="Nhập mật khẩu đang dùng" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold mb-1">Mật khẩu mới (tối thiểu 6 ký tự)</label>
                            <input type="password" id="newPassword" class="form-control" minlength="6" placeholder="Nhập mật khẩu mới" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold mb-1">Xác nhận mật khẩu mới</label>
                            <input type="password" id="confirmPassword" class="form-control" minlength="6" placeholder="Nhập lại mật khẩu mới" required />
                        </div>
                    </div>
                    <div class="d-grid mt-3">
                        <button type="submit" class="btn btn-warning text-dark rounded-pill fw-bold shadow-sm mobile-profile-submit-btn touch-target-44">
                            <i class="bi bi-key-fill me-2"></i> Cập Nhật Mật Khẩu
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- 4. LỊCH SỬ GIẢNG DẠY CÁC NIÊN KHÓA TRƯỚC -->
        <div id="sec-history" class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-3 px-3 pb-2">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-clock-history text-secondary me-2"></i>Lịch Sử Giảng Dạy
                </h6>
            </div>
            <div class="card-body px-3 py-2 pb-3">
                @if (Model.TeachingHistory.Any())
                {
                    <div class="accordion accordion-flush" id="teachingHistoryAccordion">
                        @for (int i = 0; i < Model.TeachingHistory.Count; i++)
                        {
                            var yearGroup = Model.TeachingHistory[i];
                            <div class="accordion-item border-0 mb-2 rounded-3 overflow-hidden border">
                                <h2 class="accordion-header" id="heading_@yearGroup.AcademicYearId">
                                    <button class="accordion-button collapsed py-2 px-3 bg-light text-dark fw-semibold small touch-target-44"
                                            type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@yearGroup.AcademicYearId">
                                        <i class="bi bi-calendar-check me-2 text-primary"></i>Niên khóa @yearGroup.AcademicYearName
                                        <span class="badge bg-secondary ms-auto me-2">@yearGroup.Classes.Count lớp</span>
                                    </button>
                                </h2>
                                <div id="collapse_@yearGroup.AcademicYearId" class="accordion-collapse collapse" data-bs-parent="#teachingHistoryAccordion">
                                    <div class="accordion-body p-2 bg-white">
                                        <ul class="list-group list-group-flush small">
                                            @foreach (var c in yearGroup.Classes)
                                            {
                                                <li class="list-group-item d-flex justify-content-between align-items-center px-2 py-2 border-0">
                                                    <div>
                                                        <strong>@c.ClassName</strong> (@c.GradeLevel)
                                                        <div class="text-muted" style="font-size: 0.75rem;">Sĩ số: @c.TotalStudents em</div>
                                                    </div>
                                                    <span class="badge bg-light text-dark border">@c.RoleName</span>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-3 text-muted small fst-italic">
                        Chưa có dữ liệu lịch sử các năm trước.
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-0">
        <div class="row g-4">
            <!-- CỘT TRÁI: THÔNG TIN TÓM TẮT & CÁC LỚP PHỤ TRÁCH -->
            <div class="col-12 col-lg-5 col-xl-4">
                <!-- Thẻ Thông Tin Cơ Bản -->
                <div class="card border-0 shadow-sm rounded-4 mb-4 text-center overflow-hidden">
                    <div class="card-body p-4">
                        <div class="mx-auto mb-3 rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center"
                             style="width: 84px; height: 84px;">
                            <i class="bi bi-person-fill display-4"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">
                            @(!string.IsNullOrEmpty(Model.ChristianName) ? $"{Model.ChristianName} " : "")@Model.FirstName @Model.LastName
                        </h5>
                        <p class="text-muted small mb-2">@@@Model.Username</p>
                        <span class="badge @(Model.Role == UserRole.Admin ? "bg-danger" :
                                                                       Model.Role == UserRole.SpiritualDirector ? "bg-info text-dark" :
                                                                       Model.Role == UserRole.ExecutiveBoard ? "bg-primary" : "bg-secondary") rounded-pill px-3 py-1">
                            @(Model.Role == UserRole.Admin ? "Quản trị viên" : Model.Role == UserRole.SpiritualDirector ? "Cha" :
                                                    Model.Role == UserRole.ExecutiveBoard ? "Ban Điều Hành" :
                                                    Model.Role == UserRole.BranchHead ? "Trưởng khối" : "Giáo lý viên / Dự bị")
                        </span>
                        @if (!string.IsNullOrEmpty(Model.ManagedGradeLevel))
                        {
                            <span class="badge bg-primary-subtle text-primary border rounded-pill px-2 py-1 ms-1">
                                Trưởng khối @Model.ManagedGradeLevel
                            </span>
                        }
                    </div>
                </div>

                <!-- TASK-813: KHỐI CÁC LỚP ĐANG DẠY TRONG NIÊN KHÓA HIỆN TẠI -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-mortarboard-fill text-primary me-2"></i>Lớp Đang Dạy (Niên Khóa Này)
                        </h6>
                        <span class="badge bg-success-subtle text-success border rounded-pill">
                            @Model.CurrentClasses.Count lớp
                        </span>
                    </div>
                    <div class="card-body px-4 py-3">
                        @if (Model.CurrentClasses.Any())
                        {
                            <div class="d-flex flex-column gap-2">
                                @foreach (var cls in Model.CurrentClasses)
                                {
                                    <div class="p-3 rounded-3 border bg-light-subtle d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-bold text-primary fs-6">@cls.ClassName</div>
                                            <div class="small text-muted">
                                                Khối: <strong>@cls.GradeLevel</strong>
                                                @(string.IsNullOrEmpty(cls.RoomNumber) ? "" : $" | Phòng: {cls.RoomNumber}")
                                            </div>
                                            <div class="small text-secondary mt-1">
                                                <i class="bi bi-people me-1"></i>Sĩ số: @cls.TotalStudents em
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge @(cls.RoleInClass == "HEAD" ? "bg-primary" : "bg-secondary") rounded-pill mb-2 d-block">
                                                @cls.RoleName
                                            </span>
                                            <a href="/Attendance/Index?classId=@cls.ClassId" class="btn btn-outline-primary btn-sm rounded-pill px-2 py-0" style="font-size: 0.75rem;">
                                                Điểm danh
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-3 text-muted small">
                                <i class="bi bi-info-circle me-1"></i>Chưa được phân công lớp nào trong niên khóa này.
                            </div>
                        }
                    </div>
                </div>

                <!-- TASK-813: KHỐI LỊCH SỬ GIẢNG DẠY CÁC NIÊN KHÓA TRƯỚC -->
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-clock-history text-secondary me-2"></i>Lịch Sử Giảng Dạy
                        </h6>
                    </div>
                    <div class="card-body px-4 py-3">
                        @if (Model.TeachingHistory.Any())
                        {
                            <div class="accordion accordion-flush" id="teachingHistoryAccordion">
                                @for (int i = 0; i < Model.TeachingHistory.Count; i++)
                                {
                                    var yearGroup = Model.TeachingHistory[i];
                                    <div class="accordion-item border-0 mb-2 rounded-3 overflow-hidden border">
                                        <h2 class="accordion-header" id="heading_@yearGroup.AcademicYearId">
                                            <button class="accordion-button collapsed py-2 px-3 bg-light text-dark fw-semibold small"
                                                    type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@yearGroup.AcademicYearId">
                                                <i class="bi bi-calendar-check me-2 text-primary"></i>Niên khóa @yearGroup.AcademicYearName
                                                <span class="badge bg-secondary ms-auto me-2">@yearGroup.Classes.Count lớp</span>
                                            </button>
                                        </h2>
                                        <div id="collapse_@yearGroup.AcademicYearId" class="accordion-collapse collapse" data-bs-parent="#teachingHistoryAccordion">
                                            <div class="accordion-body p-2 bg-white">
                                                <ul class="list-group list-group-flush small">
                                                    @foreach (var c in yearGroup.Classes)
                                                    {
                                                        <li class="list-group-item d-flex justify-content-between align-items-center px-2 py-1 border-0">
                                                            <div>
                                                                <strong>@c.ClassName</strong> (@c.GradeLevel)
                                                                <div class="text-muted" style="font-size: 0.72rem;">Sĩ số: @c.TotalStudents em</div>
                                                            </div>
                                                            <span class="badge bg-light text-dark border">@c.RoleName</span>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-3 text-muted small fst-italic">
                                Chưa có dữ liệu lịch sử các năm trước.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: FORM CHỈNH SỬA THÔNG TIN & ĐỔI MẬT KHẨU -->
            <div class="col-12 col-lg-7 col-xl-8">
                <!-- Alert Thông Báo -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Form Cập Nhật Hồ Sơ -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-person-lines-fill text-primary me-2"></i>Cập Nhật Thông Tin Cá Nhân
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <form asp-action="UpdateProfile" method="post">
                            @Html.AntiForgeryToken()
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Tên Thánh</label>
                                    <input type="text" name="ChristianName" class="form-control" value="@Model.ChristianName" placeholder="Phaolô, Giuse..." />
                                </div>
                                <div>

                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Họ và Tên đệm <span class="text-danger">*</span></label>
                                    <input type="text" name="FirstName" class="form-control" value="@Model.FirstName" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Tên <span class="text-danger">*</span></label>
                                    <input type="text" name="LastName" class="form-control" value="@Model.LastName" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Số Điện Thoại</label>
                                    <input type="text" name="PhoneNumber" class="form-control" value="@Model.PhoneNumber" placeholder="090..." />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Email</label>
                                    <input type="email" name="Email" class="form-control" value="@Model.Email" placeholder="example@gmail.com" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Ngày Sinh</label>
                                    <input type="date" name="DateOfBirth" class="form-control" value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Giáo Khu</label>
                                    <input type="text" name="Address" class="form-control" value="@Model.Address" placeholder="Giáo khu..." />
                                </div>
                            </div>
                            <div class="text-end mt-4">
                                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                                    <i class="bi bi-check2-circle me-1"></i> Lưu Thay Đổi
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Form Đổi Mật Khẩu -->
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-shield-lock-fill text-warning me-2"></i>Đổi Mật Khẩu
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div id="pwdAlert" class="alert d-none border-0 rounded-3 small"></div>
                        <form id="formChangePassword" onsubmit="event.preventDefault(); submitChangePassword();">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Mật khẩu hiện tại</label>
                                    <input type="password" id="currentPassword" class="form-control" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Mật khẩu mới</label>
                                    <input type="password" id="newPassword" class="form-control" minlength="6" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Xác nhận mật khẩu</label>
                                    <input type="password" id="confirmPassword" class="form-control" minlength="6" required />
                                </div>
                            </div>
                            <div class="text-end mt-4">
                                <button type="submit" class="btn btn-warning text-dark rounded-pill px-4 fw-bold shadow-sm">
                                    <i class="bi bi-key me-1"></i> Cập Nhật Mật Khẩu
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function switchMobileProfileSection(targetId, btnEl) {
            document.querySelectorAll('.mobile-profile-nav-pill').forEach(p => p.classList.remove('active'));
            if (btnEl) btnEl.classList.add('active');
            const targetEl = document.getElementById(targetId);
            if (targetEl) {
                targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        async function submitChangePassword() {
            const currentPassword = document.getElementById('currentPassword').value;
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const alertBox = document.getElementById('pwdAlert');

            if (newPassword !== confirmPassword) {
                alertBox.className = "alert alert-danger border-0 rounded-3 small";
                alertBox.innerText = "Mật khẩu mới và xác nhận mật khẩu không khớp nhau.";
                alertBox.classList.remove('d-none');
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const res = await fetch('/Account/ChangePassword', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': token // SEC-02 FIX: Đổi từ 'RequestVerificationToken' sang 'X-CSRF-TOKEN'
                    },
                    body: JSON.stringify({
                        currentPassword: currentPassword,
                        newPassword: newPassword,
                        confirmPassword: confirmPassword
                    })
                });

                const data = await res.json();
                if (data.success) {
                    alertBox.className = "alert alert-success border-0 rounded-3 small";
                    alertBox.innerText = data.message;
                    alertBox.classList.remove('d-none');
                    document.getElementById('formChangePassword').reset();
                } else {
                    alertBox.className = "alert alert-danger border-0 rounded-3 small";
                    alertBox.innerText = data.message;
                    alertBox.classList.remove('d-none');
                }
            } catch (err) {
                alertBox.className = "alert alert-danger border-0 rounded-3 small";
                alertBox.innerText = "Lỗi kết nối khi đổi mật khẩu: " + err.message;
                alertBox.classList.remove('d-none');
            }
        }
    </script>
}
