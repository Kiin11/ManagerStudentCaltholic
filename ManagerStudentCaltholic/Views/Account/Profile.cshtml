@model ManagerStudentCaltholic.Models.ViewModels.UserProfileViewModel
@using ManagerStudentCaltholic.Models.Entities
@{
    ViewData["Title"] = "Hồ Sơ Cá Nhân";
    Layout = "_Layout";
}

<div class="container py-4">
    <!-- Thông báo kết quả -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- CỘT TRÁI: THẺ THÔNG TIN TỔNG QUAN & LỚP PHÂN CÔNG -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 mb-4">
                <div class="position-relative d-inline-block mx-auto mb-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center mx-auto"
                         style="width: 100px; height: 100px; font-size: 3rem;">
                        <i class="bi bi-person"></i>
                    </div>
                </div>
                <h5 class="fw-bold mb-0">@(string.IsNullOrEmpty(Model.ChristianName) ? "" : Model.ChristianName + " ")@Model.FirstName @Model.LastName</h5>
                <p class="text-muted small mb-2">&#64;@Model.Username</p>
                <div>
                    <span class="badge @(Model.Role == UserRole.Admin ? "bg-danger" :
                                                                   Model.Role == UserRole.SpiritualDirector ? "bg-info text-dark" :
                                                                   Model.Role == UserRole.ExecutiveBoard ? "bg-primary" :
                                                                   Model.Role == UserRole.BranchHead ? "bg-warning text-dark" : "bg-secondary") rounded-pill px-3 py-1">
                        @Model.Role
                    </span>
                </div>
                <hr class="my-3 text-muted">
                <div class="text-start small">
                    <div class="mb-2"><i class="bi bi-envelope text-primary me-2"></i><strong>Email:</strong> @(string.IsNullOrEmpty(Model.Email) ? "Chưa cập nhật" : Model.Email)</div>
                    <div class="mb-2"><i class="bi bi-telephone text-primary me-2"></i><strong>Điện thoại:</strong> @(string.IsNullOrEmpty(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)</div>
                    <div class="mb-2"><i class="bi bi-geo-alt text-primary me-2"></i><strong>Giáo khu:</strong> @(string.IsNullOrEmpty(Model.Address) ? "Chưa cập nhật" : Model.Address)</div>
                    <div><i class="bi bi-clock-history text-primary me-2"></i><strong>Đăng nhập lần cuối:</strong> @(Model.LastLoginAt.HasValue? Model.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm") : "Lần đầu")</div>
                </div>
            </div>

            <!-- Thẻ Lớp Học Phụ Trách -->
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <h6 class="fw-bold text-dark mb-3 px-2">
                    <i class="bi bi-mortarboard-fill me-2 text-primary"></i>Lớp Giáo Lý Phụ Trách
                </h6>
                @if (Model.AssignedClasses.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var c in Model.AssignedClasses)
                        {
                            <div class="list-group-item border-0 px-2 py-2 mb-2 bg-light rounded-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0 fw-bold text-dark">@c.ClassName</h6>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill">@c.RoleInClass</span>
                                </div>
                                <div class="small text-muted mt-1 d-flex justify-content-between">
                                    <span>Khối: @c.GradeLevel</span>
                                    <span>Sĩ số: <strong>@c.TotalStudents</strong> em</span>
                                </div>
                                <div class="mt-2 text-end">
                                    <a href="/Attendance/Index?classId=@c.ClassId" class="btn btn-outline-primary btn-sm rounded-pill py-0 px-2 small">
                                        <i class="bi bi-card-checklist me-1"></i>Vào Sổ Lớp
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-3 text-muted small">
                        <i class="bi bi-info-circle me-1"></i>Chưa được phân công lớp nào trong niên khóa này.
                    </div>
                }
            </div>
        </div>

        <!-- CỘT PHẢI: FORM CẬP NHẬT & ĐỔI MẬT KHẨU -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <ul class="nav nav-tabs card-header-tabs" id="profileTab" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active fw-bold" id="info-tab" data-bs-toggle="tab" data-bs-target="#infoPane" type="button">
                                <i class="bi bi-person-lines-fill me-1 text-primary"></i> Thông Tin Cá Nhân
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold" id="pwd-tab" data-bs-toggle="tab" data-bs-target="#pwdPane" type="button">
                                <i class="bi bi-key-fill me-1 text-warning"></i> Đổi Mật Khẩu
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="card-body p-4 tab-content" id="profileTabContent">
                    <!-- TAB 1: CẬP NHẬT THÔNG TIN -->
                    <div class="tab-pane fade show active" id="infoPane">
                        <form asp-action="UpdateProfile" method="post">
                            @Html.AntiForgeryToken()
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="ChristianName" class="form-label small fw-bold text-muted"></label>
                                    <input asp-for="ChristianName" class="form-control" placeholder="Tên Thánh (VD: Maria)" />
                                </div>
                                <div class="col-md-8">
                                    <label asp-for="FirstName" class="form-label small fw-bold text-muted"></label>
                                    <input asp-for="FirstName" class="form-control" required />
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="LastName" class="form-label small fw-bold text-muted"></label>
                                    <input asp-for="LastName" class="form-control" required />
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="DateOfBirth" class="form-label small fw-bold text-muted"></label>
                                    <input asp-for="DateOfBirth" class="form-control" type="date"
                                           value="@(Model.DateOfBirth.HasValue? Model.DateOfBirth.Value.ToString("yyyy-MM-dd") : "")" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="PhoneNumber" class="form-label small fw-bold text-muted"></label>
                                    <input asp-for="PhoneNumber" class="form-control" placeholder="0901234567" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="Email" class="form-label small fw-bold text-muted"></label>
                                    <input asp-for="Email" class="form-control" placeholder="name@domain.com" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="Address" class="form-label small fw-bold text-muted"></label>
                                    <input asp-for="Address" class="form-control" placeholder="Giáo khu hoặc địa chỉ thường trú" />
                                </div>

                                <div class="col-12 text-end mt-4">
                                    <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm">
                                        <i class="bi bi-save me-1"></i> Lưu Thay Đổi
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- TAB 2: ĐỔI MẬT KHẨU (AJAX FETCH) -->
                    <div class="tab-pane fade" id="pwdPane">
                        <div id="pwdAlertBox" class="alert d-none py-2 small shadow-sm border-0 mb-3"></div>

                        <form id="changePasswordForm">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Mật khẩu hiện tại</label>
                                <input type="password" id="curPassword" class="form-control" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Mật khẩu mới (Tối thiểu 6 ký tự)</label>
                                <input type="password" id="newPassword" class="form-control" minlength="6" required />
                            </div>
                            <div class="mb-4">
                                <label class="form-label small fw-bold text-muted">Xác nhận mật khẩu mới</label>
                                <input type="password" id="confPassword" class="form-control" required />
                            </div>
                            <div class="text-end">
                                <button type="button" class="btn btn-warning px-4 rounded-pill fw-bold shadow-sm" onclick="submitChangePassword()">
                                    <i class="bi bi-shield-check me-1"></i> Đổi Mật Khẩu
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        async function submitChangePassword() {
            const curPassword = document.getElementById("curPassword").value;
            const newPassword = document.getElementById("newPassword").value;
            const confPassword = document.getElementById("confPassword").value;
            const alertBox = document.getElementById("pwdAlertBox");

            if (!curPassword || !newPassword || !confPassword) {
                alertBox.className = "alert alert-danger py-2 small shadow-sm border-0 mb-3";
                alertBox.innerText = "Vui lòng nhập đầy đủ các trường mật khẩu.";
                alertBox.classList.remove("d-none");
                return;
            }

            if (newPassword !== confPassword) {
                alertBox.className = "alert alert-danger py-2 small shadow-sm border-0 mb-3";
                alertBox.innerText = "Mật khẩu mới và xác nhận mật khẩu không trùng khớp!";
                alertBox.classList.remove("d-none");
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            const res = await fetch('/Account/ChangePassword', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ currentPassword: curPassword, newPassword: newPassword, confirmPassword: confPassword })
            });

            const data = await res.json();
            if (data.success) {
                alertBox.className = "alert alert-success py-2 small shadow-sm border-0 mb-3";
                alertBox.innerText = data.message;
                alertBox.classList.remove("d-none");
                document.getElementById("changePasswordForm").reset();
            } else {
                alertBox.className = "alert alert-danger py-2 small shadow-sm border-0 mb-3";
                alertBox.innerText = data.message;
                alertBox.classList.remove("d-none");
            }
        }
    </script>
}